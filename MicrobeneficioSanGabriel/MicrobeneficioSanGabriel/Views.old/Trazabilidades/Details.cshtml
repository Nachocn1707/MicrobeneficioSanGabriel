@model MicrobeneficioSanGabriel.Models.Trazabilidad

@{
    ViewData["Title"] = "Detalle de trazabilidad";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="admin-title">Detalle de trazabilidad</h1>
<p class="admin-subtitle">
    Información detallada del seguimiento del lote seleccionado.
</p>

<div class="admin-card mb-4">
    <h4 class="fw-bold mb-3">Información del lote</h4>

    <div class="row">
        <div class="col-md-4">
            <strong>Código de lote:</strong>
            <p>@Model.Lote?.CodigoLote</p>
        </div>

        <div class="col-md-4">
            <strong>Productor:</strong>
            <p>@(Model.Lote?.Productor?.Nombre ?? "Sin productor")</p>
        </div>

        <div class="col-md-4">
            <strong>Fecha de recepción:</strong>
            <p>@Model.Lote?.FechaRecepcion.ToString("dd/MM/yyyy")</p>
        </div>

        <div class="col-md-4">
            <strong>Peso recibido:</strong>
            <p>@Model.Lote?.PesoKg kg</p>
        </div>

        <div class="col-md-4">
            <strong>Estado del lote:</strong>
            <p>@Model.Lote?.Estado</p>
        </div>

        <div class="col-md-4">
            <strong>Finca:</strong>
            <p>@(Model.Lote?.Productor?.Finca ?? "No registrada")</p>
        </div>
    </div>
</div>

<div class="admin-card mb-4">
    <h4 class="fw-bold mb-3">Información de producción</h4>

    <div class="row">
        <div class="col-md-4">
            <strong>Proceso:</strong>
            <p>@Model.Produccion?.TipoProceso</p>
        </div>

        <div class="col-md-4">
            <strong>Fecha de producción:</strong>
            <p>@Model.Produccion?.FechaProduccion.ToString("dd/MM/yyyy")</p>
        </div>

        <div class="col-md-4">
            <strong>Estado:</strong>
            <p>@Model.Produccion?.Estado</p>
        </div>

        <div class="col-md-4">
            <strong>Cantidad procesada:</strong>
            <p>@Model.Produccion?.CantidadProcesadaKg kg</p>
        </div>

        <div class="col-md-4">
            <strong>Cantidad resultante:</strong>
            <p>@Model.Produccion?.CantidadResultanteKg kg</p>
        </div>

        <div class="col-md-4">
            <strong>Producto resultante:</strong>
            <p>@(Model.Produccion?.Producto?.Nombre ?? "Sin producto")</p>
        </div>
    </div>
</div>

<div class="admin-card">
    <h4 class="fw-bold mb-3">Registro de trazabilidad</h4>

    <div class="row">
        <div class="col-md-4">
            <strong>Etapa:</strong>
            <p>@Model.Etapa</p>
        </div>

        <div class="col-md-4">
            <strong>Fecha de registro:</strong>
            <p>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <div class="col-md-4">
            <strong>Responsable:</strong>
            <p>@(Model.Responsable ?? "Sin responsable")</p>
        </div>

        <div class="col-md-12">
            <strong>Observación:</strong>
            <p>@(Model.Observacion ?? "Sin observación")</p>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Historial" asp-route-loteId="@Model.LoteId" class="btn btn-primary">Ver historial del lote</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>