@model MicrobeneficioSanGabriel.Models.Lote

@{
    ViewData["Title"] = "Nuevo Lote";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Nuevo Lote</h1>
        <p>Registro de lote de café recibido en el microbeneficio.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>

<div class="admin-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="CodigoLote" class="form-label">Código del lote</label>
                <input asp-for="CodigoLote" class="form-control" placeholder="Ej: LOT-001" />
                <span asp-validation-for="CodigoLote" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ProductorId" class="form-label">Productor</label>
                <select asp-for="ProductorId" class="form-select" asp-items="ViewBag.ProductorId">
                    <option value="">Seleccione un productor</option>
                </select>
                <span asp-validation-for="ProductorId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PesoKg" class="form-label">Peso recibido (Kg)</label>
                <input asp-for="PesoKg" class="form-control" placeholder="Ej: 150" />
                <span asp-validation-for="PesoKg" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="FechaRecepcion" class="form-label">Fecha de recepción</label>
                <input asp-for="FechaRecepcion" type="datetime-local" class="form-control" />
                <span asp-validation-for="FechaRecepcion" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Estado" class="form-label">Estado</label>
                <select asp-for="Estado" class="form-select">
                    <option value="">Seleccione un estado</option>
                    <option value="Recibido">Recibido</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Finalizado">Finalizado</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Observacion" class="form-label">Observación</label>
                <input asp-for="Observacion" class="form-control" placeholder="Detalle adicional del lote" />
                <span asp-validation-for="Observacion" class="text-danger"></span>
            </div>

        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">
                Guardar Lote
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}