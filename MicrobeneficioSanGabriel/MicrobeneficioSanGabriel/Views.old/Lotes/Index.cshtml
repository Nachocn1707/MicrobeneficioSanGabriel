@model IEnumerable<MicrobeneficioSanGabriel.Models.Lote>

@{
    ViewData["Title"] = "Lotes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Lotes</h1>
        <p>Gestión de lotes de café recibidos en el microbeneficio.</p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Nuevo Lote
    </a>
</div>

<div class="admin-card">
    <table class="table table-admin align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>Productor</th>
                <th>Peso</th>
                <th>Fecha recepción</th>
                <th>Estado</th>
                <th>Observación</th>
                <th width="220">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.CodigoLote</strong>
                    </td>

                    <td>
                        @item.Productor?.Nombre
                        <br />
                        <small class="text-muted">@item.Productor?.Cedula</small>
                    </td>

                    <td>@item.PesoKg kg</td>

                    <td>@item.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")</td>

                    <td>
                        @if (item.Estado == "Recibido")
                        {
                            <span class="badge bg-primary">Recibido</span>
                        }
                        else if (item.Estado == "En proceso")
                        {
                            <span class="badge bg-warning text-dark">En proceso</span>
                        }
                        else if (item.Estado == "Finalizado")
                        {
                            <span class="badge bg-success">Finalizado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Estado</span>
                        }
                    </td>

                    <td>@item.Observacion</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white">
                            Detalles
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>