@model MicrobeneficioSanGabriel.Models.MovimientoInventario

@{
    ViewData["Title"] = "Eliminar Movimiento";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Eliminar Movimiento</h1>
        <p>Confirma si deseas eliminar este registro.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>

<div class="admin-card">
    <div class="alert alert-warning">
        Esta acción eliminará el movimiento del historial. Verifica antes de continuar.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Producto</dt>
        <dd class="col-sm-9">@Model.Producto?.Nombre</dd>

        <dt class="col-sm-3">Tipo Movimiento</dt>
        <dd class="col-sm-9">@Model.TipoMovimiento</dd>

        <dt class="col-sm-3">Cantidad</dt>
        <dd class="col-sm-9">@Model.Cantidad</dd>

        <dt class="col-sm-3">Observación</dt>
        <dd class="col-sm-9">@Model.Observacion</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>
    </form>
</div>
