@model MicrobeneficioSanGabriel.Models.Factura

@{
    ViewData["Title"] = "Nueva Factura";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">Nueva Factura</h1>
        <p class="text-muted">Generación de factura a partir de un pedido registrado.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="PedidoId" class="form-label fw-semibold">Pedido</label>
                    <select asp-for="PedidoId" class="form-select" asp-items="ViewBag.PedidoId">
                        <option value="">Seleccione un pedido</option>
                    </select>
                    <span asp-validation-for="PedidoId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="EstadoPago" class="form-label fw-semibold">Estado de pago</label>
                    <select asp-for="EstadoPago" class="form-select">
                        <option value="Pendiente">Pendiente</option>
                        <option value="Pagado">Pagado</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>
                    <span asp-validation-for="EstadoPago" class="text-danger"></span>
                </div>

                <div class="col-md-12 mb-3">
                    <label asp-for="Observacion" class="form-label fw-semibold">Observación</label>
                    <input asp-for="Observacion" class="form-control" placeholder="Detalle adicional de la factura" />
                    <span asp-validation-for="Observacion" class="text-danger"></span>
                </div>

            </div>

            <div class="alert alert-info mt-3">
                El subtotal, IVA y total se calcularán automáticamente al guardar la factura.
            </div>

            <button type="submit" class="btn btn-success px-4">
                Guardar Factura
            </button>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}