@model MicrobeneficioSanGabriel.ViewModels.UsuarioListadoViewModel

@{
    ViewData["Title"] = "Eliminar usuario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="fw-bold text-danger">Eliminar usuario</h1>
<p class="text-muted mb-4">Confirme si desea eliminar este usuario del sistema.</p>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="alert alert-warning">
        Esta acción eliminará el usuario seleccionado. Verifique antes de continuar.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Correo</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Usuario</dt>
        <dd class="col-sm-9">@Model.UserName</dd>

        <dt class="col-sm-3">Teléfono</dt>
        <dd class="col-sm-9">@(Model.PhoneNumber ?? "Sin teléfono")</dd>

        <dt class="col-sm-3">Rol</dt>
        <dd class="col-sm-9">@Model.Rol</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                Eliminar
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
        </div>
    </form>
</div>