@using System.Linq
@using System.Collections.Generic
@{
    ViewData["Title"] = "Reportes";
    <div class="sg-visual-hero sg-hero-reportes">
        <div class="sg-visual-hero-content">
            <span class="sg-visual-badge">
                <i class="fa-solid fa-chart-pie"></i>
                Análisis del sistema
            </span>

            <h1>Reportes administrativos</h1>
            <div class="sg-visual-line"></div>

            <p>
                Consultá métricas, filtros por fecha, ventas, stock y datos generales para la toma de decisiones.
            </p>
        </div>
    </div>
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    decimal totalVentas = ViewBag.TotalVentas ?? 0;
    decimal totalStock = ViewBag.TotalStock ?? 0;
    int pedidosPendientes = ViewBag.PedidosPendientes ?? 0;
    int facturasPendientes = ViewBag.FacturasPendientes ?? 0;
    int productosStockBajo = ViewBag.ProductosStockBajo ?? 0;

    int stockPorcentaje = totalStock > 100 ? 100 : (int)totalStock;

    var productosReporte = ViewBag.Productos as IEnumerable<MicrobeneficioSanGabriel.Models.Producto>
        ?? Enumerable.Empty<MicrobeneficioSanGabriel.Models.Producto>();

    var maxStockProducto = productosReporte.Any()
        ? productosReporte.Max(p => p.Stock)
        : 0;

    var coloresStock = new[] { "coffee", "green", "gold", "tan", "brown", "sage" };
    var indiceColorStock = 0;
}

@section Styles {
    <style>
        .sg-report-progress {
            height: 28px;
            border-radius: 999px;
            background: #f1e3cf;
            overflow: hidden;
            box-shadow: inset 0 1px 3px rgba(65, 39, 20, .12);
        }

        .sg-report-progress.lg {
            height: 35px;
        }

        .sg-report-bar {
            height: 100%;
            min-width: 0;
            border-radius: 999px;
            background: linear-gradient(90deg, var(--bar-1), var(--bar-2));
            color: #fff;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 18px rgba(91, 54, 24, .18);
        }

        .sg-report-bar.ventas {
            --bar-1: #5E8450;
            --bar-2: #A15F26;
        }

        .sg-stock-bar.coffee {
            --bar-1: #9f5c22;
            --bar-2: #c47b32;
        }

        .sg-stock-bar.green {
            --bar-1: #5E8450;
            --bar-2: #7EA36A;
        }

        .sg-stock-bar.gold {
            --bar-1: #D89A25;
            --bar-2: #E8B750;
        }

        .sg-stock-bar.tan {
            --bar-1: #B58B51;
            --bar-2: #D7B97F;
        }

        .sg-stock-bar.brown {
            --bar-1: #4A2A18;
            --bar-2: #7B4A2D;
        }

        .sg-stock-bar.sage {
            --bar-1: #758A61;
            --bar-2: #9BAC82;
        }

        .sg-report-stock-value {
            color: #8f531c !important;
        }
    </style>
}

<h1 class="fw-bold"></h1>

<p class="text-muted mb-4">
</p>

<form method="get" asp-action="Index" class="row g-3 mb-4">

    <div class="col-md-3">
        <label class="form-label fw-bold">
            Fecha inicio
        </label>

        <input type="date"
               name="fechaInicio"
               value="@ViewBag.FechaInicio"
               class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-bold">
            Fecha fin
        </label>

        <input type="date"
               name="fechaFin"
               value="@ViewBag.FechaFin"
               class="form-control" />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit"
                class="btn btn-primary w-100">
            <i class="fa-solid fa-filter"></i>
            Filtrar
        </button>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <a asp-action="Index"
           class="btn btn-secondary w-100">
            <i class="fa-solid fa-rotate-left"></i>
            Limpiar
        </a>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <a asp-action="ExportarExcel"
           asp-route-fechaInicio="@ViewBag.FechaInicio"
           asp-route-fechaFin="@ViewBag.FechaFin"
           class="btn btn-success w-100">
            <i class="fa-solid fa-file-excel"></i>
            Excel
        </a>
    </div>

    <div class="col-md-12 d-flex justify-content-end">
        <a asp-action="AnalisisIA"
           asp-route-fechaInicio="@ViewBag.FechaInicio"
           asp-route-fechaFin="@ViewBag.FechaFin"
           class="btn btn-dark">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            Generar análisis con IA
        </a>
    </div>

</form>

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Productores</h6>
            <h2 class="fw-bold">@ViewBag.TotalProductores</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Productos</h6>
            <h2 class="fw-bold">@ViewBag.TotalProductos</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Pedidos</h6>
            <h2 class="fw-bold">@ViewBag.TotalPedidos</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Facturas</h6>
            <h2 class="fw-bold">@ViewBag.TotalFacturas</h2>
        </div>
    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Ventas totales</h5>

            <h2 class="text-success fw-bold">
                ₡ @totalVentas.ToString("N0")
            </h2>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Stock total disponible</h5>

            <h2 class="fw-bold">
                @totalStock kg
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Pedidos pendientes</h5>

            <h2 class="text-warning fw-bold">
                @pedidosPendientes
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Facturas pendientes</h5>

            <h2 class="text-danger fw-bold">
                @facturasPendientes
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Productos con stock bajo</h5>

            <h2 class="text-danger fw-bold">
                @productosStockBajo
            </h2>
        </div>
    </div>

</div>

<div class="row g-4 mt-2">

    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 p-4">

            <h4 class="mb-4 fw-bold">
                Ventas totales
            </h4>

            <div class="sg-report-progress lg">
                <div class="sg-report-bar ventas"
                     role="progressbar"
                     style="width: 100%;">
                    ₡ @totalVentas.ToString("N0")
                </div>
            </div>

        </div>
    </div>

    <div class="col-md-6">

        <div class="card shadow-sm border-0 rounded-4 p-4">

            <h4 class="mb-4 fw-bold">
                Stock disponible
            </h4>

            @if (productosReporte.Any())
            {
                foreach (var producto in productosReporte)
                {
                    var claseColor = coloresStock[indiceColorStock % coloresStock.Length];
                    var porcentajeStock = maxStockProducto <= 0
                        ? 0
                        : (int)Math.Round(producto.Stock * 100m / maxStockProducto);

                    if (producto.Stock > 0 && porcentajeStock < 6)
                    {
                        porcentajeStock = 6;
                    }

                    indiceColorStock++;

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="fw-semibold">
                                @producto.Nombre
                            </span>

                            <span class="fw-bold sg-report-stock-value">
                                @producto.Stock kg
                            </span>

                        </div>

                        <div class="sg-report-progress">

                            <div class="sg-report-bar sg-stock-bar @claseColor"
                                 role="progressbar"
                                 aria-valuenow="@producto.Stock"
                                 aria-valuemin="0"
                                 aria-valuemax="@maxStockProducto"
                                 style="width:@porcentajeStock%">
                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="text-muted">
                    No hay productos registrados para mostrar stock.
                </div>
            }
        </div>

    </div>

</div>