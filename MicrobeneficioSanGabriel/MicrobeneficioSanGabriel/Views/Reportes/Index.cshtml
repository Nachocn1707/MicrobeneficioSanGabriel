@{
    ViewData["Title"] = "Reportes";
    <div class="sg-visual-hero sg-hero-reportes">
        <div class="sg-visual-hero-content">
            <span class="sg-visual-badge">
                <i class="fa-solid fa-chart-pie"></i>
                Análisis del sistema
            </span>

            <h1>Reportes administrativos</h1>
            <div class="sg-visual-line"></div>

            <p>
                Consultá métricas, filtros por fecha, ventas, stock y datos generales para la toma de decisiones.
            </p>
        </div>
    </div>
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    decimal totalVentas = ViewBag.TotalVentas ?? 0;
    decimal totalStock = ViewBag.TotalStock ?? 0;
    int pedidosPendientes = ViewBag.PedidosPendientes ?? 0;
    int facturasPendientes = ViewBag.FacturasPendientes ?? 0;
    int productosStockBajo = ViewBag.ProductosStockBajo ?? 0;

    int stockPorcentaje = totalStock > 100 ? 100 : (int)totalStock;
}

<h1 class="fw-bold"></h1>

<p class="text-muted mb-4">
</p>

<form method="get" asp-action="Index" class="row g-3 mb-4">

    <div class="col-md-3">
        <label class="form-label fw-bold">
            Fecha inicio
        </label>

        <input type="date"
               name="fechaInicio"
               value="@ViewBag.FechaInicio"
               class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-bold">
            Fecha fin
        </label>

        <input type="date"
               name="fechaFin"
               value="@ViewBag.FechaFin"
               class="form-control" />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit"
                class="btn btn-primary w-100">
            <i class="fa-solid fa-filter"></i>
            Filtrar
        </button>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <a asp-action="Index"
           class="btn btn-secondary w-100">
            <i class="fa-solid fa-rotate-left"></i>
            Limpiar
        </a>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <a asp-action="ExportarExcel"
           asp-route-fechaInicio="@ViewBag.FechaInicio"
           asp-route-fechaFin="@ViewBag.FechaFin"
           class="btn btn-success w-100">
            <i class="fa-solid fa-file-excel"></i>
            Excel
        </a>
    </div>

    <div class="col-md-12 d-flex justify-content-end">
        <a asp-action="AnalisisIA"
           asp-route-fechaInicio="@ViewBag.FechaInicio"
           asp-route-fechaFin="@ViewBag.FechaFin"
           class="btn btn-dark">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            Generar análisis con IA
        </a>
    </div>

</form>

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Productores</h6>
            <h2 class="fw-bold">@ViewBag.TotalProductores</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Productos</h6>
            <h2 class="fw-bold">@ViewBag.TotalProductos</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Pedidos</h6>
            <h2 class="fw-bold">@ViewBag.TotalPedidos</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Facturas</h6>
            <h2 class="fw-bold">@ViewBag.TotalFacturas</h2>
        </div>
    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Ventas totales</h5>

            <h2 class="text-success fw-bold">
                ₡ @totalVentas.ToString("N2")
            </h2>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Stock total disponible</h5>

            <h2 class="fw-bold">
                @totalStock.ToString("N2") kg
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Pedidos pendientes</h5>

            <h2 class="text-warning fw-bold">
                @pedidosPendientes
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Facturas pendientes</h5>

            <h2 class="text-danger fw-bold">
                @facturasPendientes
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Productos con stock bajo</h5>

            <h2 class="text-danger fw-bold">
                @productosStockBajo
            </h2>
        </div>
    </div>

</div>

<div class="row g-4 mt-2">

    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 p-4">

            <h4 class="mb-4 fw-bold">
                Ventas totales
            </h4>

            <div class="progress" style="height: 35px;">
                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: 100%;">

                    ₡ @totalVentas.ToString("N2")

                </div>
            </div>

        </div>
    </div>

    <div class="col-md-6">

        <div class="card shadow-sm border-0 rounded-4 p-4">

            <h4 class="mb-4 fw-bold">
                Stock disponible
            </h4>

            @foreach (var producto in ViewBag.Productos)
            {
                <div class="mb-4">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="fw-semibold">
                            @producto.Nombre
                        </span>

                        <span class="fw-bold text-primary">
                            @producto.Stock.ToString("N2") kg
                        </span>

                    </div>

                    <div class="progress" style="height: 24px;">

                        <div class="progress-bar bg-primary"
                             role="progressbar"
                             style="width:@(producto.Stock > 100 ? 100 : producto.Stock)%">
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>