@{
    ViewData["Title"] = "Reportes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="fw-bold">Reportes</h1>
<p class="text-muted mb-4">Resumen general de información operativa y administrativa.</p>

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Productores</h6>
            <h2 class="fw-bold">@ViewBag.TotalProductores</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Productos</h6>
            <h2 class="fw-bold">@ViewBag.TotalProductos</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Pedidos</h6>
            <h2 class="fw-bold">@ViewBag.TotalPedidos</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Facturas</h6>
            <h2 class="fw-bold">@ViewBag.TotalFacturas</h2>
        </div>
    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Ventas totales</h5>
            <h2 class="text-success fw-bold">
                ₡ @ViewBag.TotalVentas.ToString("N2")
            </h2>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Stock total disponible</h5>
            <h2 class="fw-bold">
                @ViewBag.TotalStock unidades
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Pedidos pendientes</h5>
            <h2 class="text-warning fw-bold">
                @ViewBag.PedidosPendientes
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Facturas pendientes</h5>
            <h2 class="text-danger fw-bold">
                @ViewBag.FacturasPendientes
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Productos con stock bajo</h5>
            <h2 class="text-danger fw-bold">
                @ViewBag.ProductosStockBajo
            </h2>
        </div>
    </div>

</div>

<div class="row g-4 mt-2">

    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h4 class="mb-4 fw-bold">Ventas totales</h4>
            <canvas id="ventasChart"></canvas>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h4 class="mb-4 fw-bold">Stock disponible</h4>
            <canvas id="stockChart"></canvas>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ventasTotales = @ViewBag.TotalVentas;
    const stockTotal = @ViewBag.TotalStock;
    const pedidosPendientes = @ViewBag.PedidosPendientes;
    const facturasPendientes = @ViewBag.FacturasPendientes;
    const productosStockBajo = @ViewBag.ProductosStockBajo;

    const ventasCtx = document.getElementById('ventasChart');

    new Chart(ventasCtx, {
    type: 'bar',
    data: {
    labels: ['Ventas totales'],
    datasets: [{
    label: 'Monto en colones',
    data: [ventasTotales],
    borderWidth: 1
    }]
    }
    });

    const stockCtx = document.getElementById('stockChart');

    new Chart(stockCtx, {
    type: 'doughnut',
    data: {
    labels: [
    'Stock disponible',
    'Pedidos pendientes',
    'Facturas pendientes',
    'Stock bajo'
    ],
    datasets: [{
    data: [
    stockTotal,
    pedidosPendientes,
    facturasPendientes,
    productosStockBajo
    ]
    }]
    }
    });
</script>