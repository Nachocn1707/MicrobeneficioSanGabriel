@{
    ViewData["Title"] = "Reportes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    decimal totalVentas = ViewBag.TotalVentas ?? 0;
    int totalStock = ViewBag.TotalStock ?? 0;
    int pedidosPendientes = ViewBag.PedidosPendientes ?? 0;
    int facturasPendientes = ViewBag.FacturasPendientes ?? 0;
    int productosStockBajo = ViewBag.ProductosStockBajo ?? 0;

    int stockPorcentaje = totalStock > 100 ? 100 : totalStock;
}

<h1 class="fw-bold">Reportes</h1>
<a asp-action="ExportarExcel"
       class="btn btn-success mb-4">
    Exportar Excel
</a>
<p class="text-muted mb-4">Resumen general de información operativa y administrativa.</p>

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Productores</h6>
            <h2 class="fw-bold">@ViewBag.TotalProductores</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Productos</h6>
            <h2 class="fw-bold">@ViewBag.TotalProductos</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Pedidos</h6>
            <h2 class="fw-bold">@ViewBag.TotalPedidos</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="text-muted">Facturas</h6>
            <h2 class="fw-bold">@ViewBag.TotalFacturas</h2>
        </div>
    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Ventas totales</h5>
            <h2 class="text-success fw-bold">
                ₡ @totalVentas.ToString("N2")
            </h2>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Stock total disponible</h5>
            <h2 class="fw-bold">
                @totalStock unidades
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Pedidos pendientes</h5>
            <h2 class="text-warning fw-bold">
                @pedidosPendientes
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Facturas pendientes</h5>
            <h2 class="text-danger fw-bold">
                @facturasPendientes
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold">Productos con stock bajo</h5>
            <h2 class="text-danger fw-bold">
                @productosStockBajo
            </h2>
        </div>
    </div>

</div>

<div class="row g-4 mt-2">

    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h4 class="mb-4 fw-bold">Ventas totales</h4>

            <div class="progress" style="height: 35px;">
                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: 100%;">
                    ₡ @totalVentas.ToString("N2")
                </div>
            </div>

        </div>
    </div>

    <div class="col-md-6">

        <div class="card shadow-sm border-0 rounded-4 p-4">

            <h4 class="mb-4 fw-bold">
                Stock disponible
            </h4>

            @foreach (var producto in ViewBag.Productos)
            {
                <div class="mb-4">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="fw-semibold">
                            @producto.Nombre
                        </span>

                        <span class="fw-bold text-primary">
                            @producto.Stock unidades
                        </span>

                    </div>

                    <div class="progress" style="height: 24px;">

                        <div class="progress-bar bg-primary"
                             role="progressbar"
                             style="width:@(producto.Stock > 100 ? 100 : producto.Stock)%">
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>