@model MicrobeneficioSanGabriel.ViewModels.ReporteIAViewModel

@{
    ViewData["Title"] = "Análisis con IA";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaIA.css" />
}

<div class="ia-report-page">

    <div class="ia-report-header">
        <h1>Análisis con IA</h1>
        <p>Análisis automatizado basado en reglas de ventas, pedidos, facturación e inventario.</p>
    </div>

    <div class="ia-actions">
        <a asp-action="Index" class="btn-ia-secondary">
            Volver a reportes
        </a>

        <a asp-action="AnalisisIA" class="btn-ia-primary">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            Regenerar análisis
        </a>
    </div>

    <div class="ia-card ia-summary">
        <h2>Resumen ejecutivo</h2>
        <p>@Model.ResumenEjecutivo</p>
    </div>

    <div class="ia-grid">

        <div class="ia-card ia-metric">
            <span>Ventas totales</span>
            <strong>₡ @Model.VentasTotales.ToString("N0")</strong>
        </div>

        <div class="ia-card ia-metric">
            <span>Pedidos</span>
            <strong>@Model.TotalPedidos</strong>
        </div>

        <div class="ia-card ia-metric">
            <span>Facturas</span>
            <strong>@Model.TotalFacturas</strong>
        </div>

        <div class="ia-card ia-metric">
            <span>Stock total</span>
            <strong>@Model.StockTotal kg</strong>
        </div>

    </div>

    <div class="ia-two-columns">

        <div class="ia-card">
            <h2>Productos más vendidos</h2>

            <div class="ia-list">
                @if (Model.ProductosMasVendidos.Any())
                {
                    foreach (var producto in Model.ProductosMasVendidos)
                    {
                        <div class="ia-list-item">
                            <strong>@producto.Producto</strong>
                            <span>Cantidad vendida: @producto.Cantidad kg</span>
                            <span>Total generado: ₡ @producto.TotalVentas.ToString("N0")</span>
                        </div>
                    }
                }
                else
                {
                    <div class="ia-list-item">
                        <strong>Sin datos</strong>
                        <span>No hay productos vendidos para analizar.</span>
                    </div>
                }
            </div>
        </div>

        <div class="ia-card">
            <h2>Clientes frecuentes</h2>

            <div class="ia-list">
                @if (Model.ClientesFrecuentes.Any())
                {
                    foreach (var cliente in Model.ClientesFrecuentes)
                    {
                        <div class="ia-list-item">
                            <strong>@cliente.Cliente</strong>
                            <span>Pedidos realizados: @cliente.Pedidos</span>
                            <span>Total comprado: ₡ @cliente.TotalComprado.ToString("N0")</span>
                        </div>
                    }
                }
                else
                {
                    <div class="ia-list-item">
                        <strong>Sin datos</strong>
                        <span>No hay clientes frecuentes para analizar.</span>
                    </div>
                }
            </div>
        </div>

    </div>

    <div class="ia-two-columns">

        <div class="ia-card">
            <h2>Estado de pedidos</h2>

            <div class="ia-list">
                @if (Model.EstadosPedidos.Any())
                {
                    foreach (var estado in Model.EstadosPedidos)
                    {
                        <div class="ia-list-item">
                            <strong>@estado.Estado</strong>
                            <span>@estado.Cantidad pedido(s)</span>
                        </div>
                    }
                }
                else
                {
                    <div class="ia-list-item">
                        <strong>Sin datos</strong>
                        <span>No hay pedidos registrados.</span>
                    </div>
                }
            </div>
        </div>

        <div class="ia-card">
            <h2>Recomendaciones administrativas</h2>

            <div class="ia-list">
                @foreach (var recomendacion in Model.Recomendaciones)
                {
                    <div class="ia-recommendation">
                        <i class="fa-solid @recomendacion.Icono"></i>

                        <div>
                            <h3>@recomendacion.Titulo</h3>
                            <p>@recomendacion.Mensaje</p>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>

</div>