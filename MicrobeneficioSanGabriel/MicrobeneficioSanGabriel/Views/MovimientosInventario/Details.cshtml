@model MicrobeneficioSanGabriel.Models.MovimientoInventario

@{
    ViewData["Title"] = "Detalle Movimiento";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalle Movimiento</h1>
        <p>Información del movimiento de inventario.</p>
    </div>

    <div class="EstiloDetalle-card">

        <div class="EstiloDetalle-card-header">
            <h2>@Model.Producto?.Nombre</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">

            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">Producto</span>
                    <span class="detalle-value">
                        @Model.Producto?.Nombre
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Tipo Movimiento
                    </span>

                    @if (Model.TipoMovimiento == "Entrada")
                    {
                        <span class="estado-activo">
                            Entrada
                        </span>
                    }
                    else
                    {
                        <span class="estado-inactivo">
                            Salida
                        </span>
                    }
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Cantidad</span>
                    <span class="detalle-value">
                        @Model.Cantidad kg
                    </span>
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">Observación</span>
                    <span class="detalle-value">
                        @Model.Observacion
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Fecha</span>
                    <span class="detalle-value">
                        @Model.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-volver">
                    Volver a la lista
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn-editar">
                    Editar
                </a>

            </div>
        </div>
    </div>
</div>