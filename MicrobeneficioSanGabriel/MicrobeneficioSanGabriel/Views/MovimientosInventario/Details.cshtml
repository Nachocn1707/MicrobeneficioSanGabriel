@model MicrobeneficioSanGabriel.Models.MovimientoInventario

@{
    ViewData["Title"] = "Detalle EstiloDetalle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var producto = Model.Producto?.Categoria;

    string tipoClase = Model.TipoMovimiento switch
    {
        "Entrada" => "movimiento-estado movimiento-entrada",
        "Salida" => "movimiento-estado movimiento-salida",
        _ => "movimiento-estado movimiento-neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}


<section class="Detalle-page-head">
    <div>
        <h1>Detalle del inventario</h1>
        <p>Consultá la información del inventario.</p>
    </div>
    <div class="Detalle-actions">
        <span class="movimiento-badge-top">
            Movimiento #@Model.Id
        </span>
    </div>
</section>

<section class="Detalle-visual-hero Detalle-hero-inventario">
    <div class="Detalle-visual-hero-content">
        <h1>Categoría: @producto</h1>
        <div class="Detalle-visual-line"></div>
        <span class="Detalle-visual-badge">
            <i class="fa-solid fa-boxes-stacked"></i> Seguimiento de inventario
        </span>
    </div>
</section>

<div class="EstiloDetalle-detalle-page">
    <div class="EstiloDetalle-premium-card">

        <div class="EstiloDetalle-premium-header">
            <h2>Información general</h2>
        </div>

        <div class="EstiloDetalle-premium-body">

            <div class="EstiloDetalle-detail-grid">

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-tag"></i> PRODUCTO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(Model.ProductoNombreMostrar)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-arrow-right-arrow-left"></i> TIPO MOVIMIENTO
                    </span>
                    <div>
                        <span class="@tipoClase">
                            @Model.TipoMovimiento
                        </span>
                    </div>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-weight-hanging"></i> CANTIDAD
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Cantidad kg
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-calendar-days"></i> FECHA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-align-left"></i> OBSERVACIÓN
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index" class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-EstiloDetalle btn-EstiloDetalle-warning">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Editar
                    </a>
                }

            </div>

        </div>
    </div>
</div>