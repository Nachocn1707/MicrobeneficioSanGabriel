@model MicrobeneficioSanGabriel.Models.MovimientoInventario

@{
    ViewData["Title"] = "Eliminar movimiento";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string tipoClase = Model.TipoMovimiento switch
    {
        "Entrada" => "text-success",
        "Salida" => "text-danger",
        _ => "text-secondary"
    };
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaEliminar.css" />
}


<div class="sg-card border-danger">
    <h1 class="text-danger">
        <i class="fa-solid fa-trash"></i>
        Eliminar movimiento #@Model.Id
    </h1>

    <p>
        <strong>Producto:</strong> @(Model.ProductoNombreMostrar)<br />
        <strong>Tipo:</strong> <span class="@tipoClase">@Model.TipoMovimiento</span><br />
        <strong>Cantidad:</strong> @Model.Cantidad kg<br />
        <strong>Fecha:</strong> @Model.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")
    </p>

    <div class="alert alert-warning">
        <i class="fa-solid fa-circle-exclamation"></i>
        Esta acción eliminará el movimiento de inventario del historial de forma <strong>permanente</strong>.
        Esta operación no se puede deshacer.
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
            <button class="btn btn-danger" type="submit">
                <i class="fa-solid fa-trash"></i> Confirmar eliminación
            </button>
        </div>
    </form>
</div>