@model MicrobeneficioSanGabriel.Models.MovimientoInventario

@{
    ViewData["Title"] = "Editar inventario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditar-edit-page">

    <div class="EstiloEditaR-top">
        <div class="EstiloEditaR-title">
            <span class="EstiloEditaR-badge">
                <i class="fa-solid fa-pen-to-square"></i>
                Gestión de los movimientos de inventario
            </span>
            <p>Gestiona los movimientos de inventario registrados.</p>
        </div>
    </div>

    <div class="EstiloEditaR-card">
        <div class="EstiloEditaR-form-container">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <div class="Estilo-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Verificá la información antes de guardar, ya que este movimiento forma parte del historial de inventario.
                    </span>
                </div>

                <div class="EstiloEditar-section">
                    <h5>
                        <i class="fa-solid fa-right-left"></i>
                        Detalle del movimiento
                    </h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductoId" class="form-label">Producto</label>
                                <div class="input-modern">
                                    <select asp-for="ProductoId"
                                            class="form-select"
                                            asp-items="ViewBag.ProductoId">
                                        <option value="">Seleccione un producto</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ProductoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="TipoMovimiento" class="form-label">Tipo de movimiento</label>
                                <div class="input-modern">
                                    <select asp-for="TipoMovimiento" class="form-select">
                                        <option value="">Seleccione una opción</option>
                                        <option value="Entrada">Entrada</option>
                                        <option value="Salida">Salida</option>
                                    </select>
                                </div>
                                <span asp-validation-for="TipoMovimiento" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Cantidad" class="form-label">Cantidad en kg</label>
                                <div class="input-modern">
                                    <input asp-for="Cantidad" asp-format="{0:0}"
                                           class="form-control"
                                           type="text" inputmode="numeric" pattern="[0-9]+"
                                           oninput="this.value=(this.value.match(/\d+/)||[''])[0]"
                                           placeholder="Digite la cantidad en kg" />
                                </div>
                                <span asp-validation-for="Cantidad" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="FechaMovimiento" class="form-label">Fecha del movimiento</label>
                                <div class="input-modern">
                                    <input asp-for="FechaMovimiento"
                                           type="datetime-local"
                                           class="form-control"
                                           min="@(Model.FechaMovimiento.Date >= DateTime.UtcNow.AddHours(-6).Date ? DateTime.UtcNow.AddHours(-6).Date.ToString("yyyy-MM-ddTHH:mm") : string.Empty)"
                                           max="@DateTime.UtcNow.AddHours(-6).Date.ToString("yyyy-MM-ddT23:59")"
                                           data-no-past-date="true"
                                           data-today="@DateTime.UtcNow.AddHours(-6).Date.ToString("yyyy-MM-dd")"
                                           data-original-date="@Model.FechaMovimiento.ToString("yyyy-MM-dd")"
                                           data-date-message="No puede seleccionar una fecha anterior a hoy." />
                                </div>
                                <span asp-validation-for="FechaMovimiento" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Observacion" class="form-label">Observación</label>
                                <div class="input-modern textarea-modern">
                                    <textarea asp-for="Observacion"
                                              class="form-control"
                                              rows="5"
                                              placeholder="Digite una observación del movimiento"></textarea>
                                </div>
                                <span asp-validation-for="Observacion" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="EstiloEditar-actions">
                    <a asp-action="Index" class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                    <button type="submit" class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}