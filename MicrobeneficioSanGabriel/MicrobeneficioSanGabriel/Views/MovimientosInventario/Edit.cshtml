@model MicrobeneficioSanGabriel.Models.MovimientoInventario

@{
    ViewData["Title"] = "Editar inventario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditar-edit-page">

    <div class="EstiloEditar-header">
        <h1>Editar EstiloEditar</h1>
        <p>Actualizá los datos del movimiento de EstiloEditar.</p>
    </div>

    <div class="EstiloEditar-card">
        <div class="EstiloEditar-card-header">
            <h2>Movimiento #@Model.Id</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloEditar-card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="ProductoId" class="form-label">Producto</label>
                        <select asp-for="ProductoId" class="form-select" asp-items="ViewBag.ProductoId">
                            <option value="">Seleccione un producto</option>
                        </select>
                        <span asp-validation-for="ProductoId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TipoMovimiento" class="form-label">Tipo de movimiento</label>
                        <select asp-for="TipoMovimiento" class="form-select">
                            <option value="">Seleccione una opción</option>
                            <option value="Entrada">Entrada</option>
                            <option value="Salida">Salida</option>
                        </select>
                        <span asp-validation-for="TipoMovimiento" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Cantidad" class="form-label">Cantidad</label>
                        <input asp-for="Cantidad" class="form-control" />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaMovimiento" class="form-label">Fecha del movimiento</label>
                        <input asp-for="FechaMovimiento" class="form-control" />
                        <span asp-validation-for="FechaMovimiento" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Observacion" class="form-label">Observación</label>
                        <textarea asp-for="Observacion" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Observacion" class="text-danger"></span>
                    </div>
                </div>

                <div class="EstiloEditar-actions">
                    <a asp-action="Index" class="btn-volver">Volver a la lista</a>
                    <button type="submit" class="btn-guardar">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}