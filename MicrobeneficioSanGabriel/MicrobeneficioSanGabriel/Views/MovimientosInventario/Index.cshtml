@using System.Text.Json
@model IEnumerable<MicrobeneficioSanGabriel.Models.MovimientoInventario>
@{
    ViewData["Title"] = "Inventario del Microbeneficio";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var movimientos = Model.ToList();
    var entradas = movimientos.Where(m => m.TipoMovimiento == "Entrada").Sum(m => m.Cantidad);
    var salidas = movimientos.Where(m => m.TipoMovimiento == "Salida").Sum(m => m.Cantidad);
    var saldoMovimientos = entradas - salidas;

    // Se toma directamente de Productos, no solo de movimientos.
    // Así un producto nuevo se refleja de una vez en el gráfico y en la leyenda.
    var productosStock = ViewBag.ProductosStock as List<MicrobeneficioSanGabriel.Models.Producto>
        ?? new List<MicrobeneficioSanGabriel.Models.Producto>();

    var stockTotal = productosStock.Sum(p => p.Stock);
    var coloresStock = new[] { "brown", "green", "sage", "gold", "deepgreen", "tan" };
    var coloresStockHex = new[] { "#5B3A16", "#4F8738", "#9DBB8F", "#D97800", "#294B2A", "#E8D4B0" };

    string FormatoPorcentaje(decimal valor) =>
        valor.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    string CrearDonutStock()
    {
        if (stockTotal <= 0)
        {
            return "conic-gradient(#eadfce 0% 100%)";
        }

        var segmentos = new List<string>();
        decimal acumulado = 0m;

        for (var i = 0; i < productosStock.Count; i++)
        {
            var stock = productosStock[i].Stock;

            if (stock <= 0)
            {
                continue;
            }

            var inicio = acumulado;
            acumulado += stock * 100m / stockTotal;
            var color = coloresStockHex[i % coloresStockHex.Length];

            segmentos.Add($"{color} {FormatoPorcentaje(inicio)}% {FormatoPorcentaje(acumulado)}%");
        }

        return segmentos.Any()
            ? $"conic-gradient({string.Join(", ", segmentos)})"
            : "conic-gradient(#eadfce 0% 100%)";
    }

    var donutStock = CrearDonutStock();

    var desde = DateTime.Today.AddDays(-29);
    var porDia = movimientos
        .Where(m => m.FechaMovimiento.Date >= desde)
        .GroupBy(m => m.FechaMovimiento.Date)
        .ToDictionary(
            g => g.Key,
            g => new
            {
                Entradas = g.Where(x => x.TipoMovimiento == "Entrada").Sum(x => x.Cantidad),
                Salidas = g.Where(x => x.TipoMovimiento == "Salida").Sum(x => x.Cantidad)
            });

    var labels = Enumerable.Range(0, 30)
        .Select(i => desde.AddDays(i).ToString("dd/MM"))
        .ToList();

    var entradasSerie = Enumerable.Range(0, 30)
        .Select(i => porDia.TryGetValue(desde.AddDays(i), out var d) ? d.Entradas : 0)
        .ToList();

    var salidasSerie = Enumerable.Range(0, 30)
        .Select(i => porDia.TryGetValue(desde.AddDays(i), out var d) ? d.Salidas : 0)
        .ToList();
}
<section class="sg-page-head">
    <div>
        <h1>Inventario del Microbeneficio</h1>
        <p>Control y seguimiento del inventario de almacén.</p>
    </div>

    <div class="sg-actions">
        <span class="sg-btn ghost">
            <i class="fa-regular fa-calendar"></i>
            Últimos 30 días
        </span>
        <a asp-action="Create" class="sg-btn green">
            <i class="fa-solid fa-plus"></i>
            Nuevo movimiento
        </a>
        <label class="sg-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" data-table-target="tablaMovimientos" placeholder="Buscar movimiento o producto..." />
        </label>
    </div>
</section>

<section class="sg-kpi-grid">
    <article class="sg-card sg-kpi">
        <span class="sg-icon green"><i class="fa-solid fa-boxes-stacked"></i></span>
        <div>
            <span>Stock actual</span>
            <strong>@stockTotal.ToString("N2") kg</strong>
            <div class="sg-trend">Desde productos registrados</div>
        </div>
    </article>

    <article class="sg-card sg-kpi">
        <span class="sg-icon green"><i class="fa-solid fa-arrow-trend-up"></i></span>
        <div>
            <span>Entradas</span>
            <strong>@entradas.ToString("N2") kg</strong>
            <div class="sg-trend">Movimientos reales</div>
        </div>
    </article>

    <article class="sg-card sg-kpi">
        <span class="sg-icon gold"><i class="fa-solid fa-arrow-trend-down"></i></span>
        <div>
            <span>Salidas</span>
            <strong>@salidas.ToString("N2") kg</strong>
            <div class="sg-trend">Movimientos reales</div>
        </div>
    </article>

    <article class="sg-card sg-kpi">
        <span class="sg-icon tan"><i class="fa-solid fa-scale-balanced"></i></span>
        <div>
            <span>Saldo movimientos</span>
            <strong>@saldoMovimientos.ToString("N2") kg</strong>
            <div class="sg-trend">Entradas - salidas</div>
        </div>
    </article>
</section>

<section class="sg-card sg-table-card mb-3">
    <div class="sg-panel-head">
        <h3>Movimientos recientes</h3>
        <span class="sg-badge">@movimientos.Count registro(s)</span>
    </div>

    <div class="table-responsive">
        <table class="sg-table" id="tablaMovimientos">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Producto</th>
                    <th>Referencia</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                    <th>Stock actual</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in movimientos)
                {
                    var entrada = m.TipoMovimiento == "Entrada" ? m.Cantidad.ToString("N0") + " kg" : "–";
                    var salida = m.TipoMovimiento == "Salida" ? m.Cantidad.ToString("N0") + " kg" : "–";

                    <tr>
                        <td>@m.FechaMovimiento.ToString("dd MMM yyyy")</td>
                        <td><span class="sg-badge @(m.TipoMovimiento == "Entrada" ? "" : "gold")">@m.TipoMovimiento</span></td>
                        <td>@m.ProductoNombreMostrar</td>
                        <td>@(m.Observacion ?? $"MOV-{m.Id:0000}") @if (m.EsAutomatico) { <span class="sg-badge ms-1">Automático</span> }</td>
                        <td>@entrada</td>
                        <td>@salida</td>
                        <td>@(m.Producto != null ? $"{m.Producto.Stock:N2} kg" : "Producto eliminado")</td>
                        <td>
                            <span class="sg-action-icons">
                                <a asp-action="Details" asp-route-id="@m.Id"><i class="fa-solid fa-eye"></i></a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    @if (m.ProductoId.HasValue)
                                    {
                                        <a asp-action="Edit" asp-route-id="@m.Id" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                    }
                                    <a asp-action="Delete" asp-route-id="@m.Id" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                                }
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="sg-grid-2">
    <article class="sg-card sg-panel">
        <div class="sg-panel-head">
            <h3>Movimientos últimos 30 días</h3>
            <span class="sg-btn ghost">Entradas y salidas</span>
        </div>
        <div class="sg-chart sm">
            <canvas id="invChart"></canvas>
        </div>
    </article>

    <article class="sg-card sg-panel">
        <div class="sg-panel-head">
            <h3>Stock por producto</h3>
            <a class="text-success fw-bold">Ver detalles</a>
        </div>

        <div class="sg-donut-wrap">
            <div class="sg-donut" style="--donut-bg: @donutStock;">
                <div>
                    <b>@stockTotal.ToString("N0")</b><br />
                    <span>kg Total</span>
                </div>
            </div>

            <div class="sg-legend">
                @if (productosStock.Any())
                {
                    for (var i = 0; i < productosStock.Count; i++)
                    {
                        var item = productosStock[i];
                        var claseColor = coloresStock[i % coloresStock.Length];

                        <div class="sg-legend-row">
                            <span class="sg-dot @claseColor"></span>
                            <span>@item.Nombre</span>
                            <b>@item.Stock.ToString("N2") kg</b>
                        </div>
                    }
                }
                else
                {
                    <span class="text-muted">No hay productos activos registrados.</span>
                }
            </div>
        </div>
    </article>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('invChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(labels)),
                datasets: [
                    {
                        label: 'Entradas',
                        data: @Html.Raw(JsonSerializer.Serialize(entradasSerie)),
                        borderColor: '#9B470F',
                        backgroundColor: 'rgba(155,71,15,.10)',
                        fill: true,
                        tension: .35,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#9B470F'
                    },
                    {
                        label: 'Salidas',
                        data: @Html.Raw(JsonSerializer.Serialize(salidasSerie)),
                        borderColor: '#D77A1D',
                        backgroundColor: 'rgba(215,122,29,.10)',
                        fill: true,
                        tension: .35,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#D77A1D'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        grid: {
                            color: 'rgba(43,26,14,.08)'
                        }
                    }
                }
            }
        });
    </script>
}
