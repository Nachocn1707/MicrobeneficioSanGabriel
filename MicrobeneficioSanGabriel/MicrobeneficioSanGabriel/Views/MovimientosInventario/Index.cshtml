@model IEnumerable<MicrobeneficioSanGabriel.Models.MovimientoInventario>

@{
    ViewData["Title"] = "Inventario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Inventario</h1>
        <p>Historial de entradas y salidas de productos.</p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Nuevo Movimiento
    </a>
</div>

<div class="admin-card">

    <table id="tablaInventario" class="table align-middle">
        <thead class="table-dark">
            <tr>
                <th>Producto</th>
                <th>Movimiento</th>
                <th>Cantidad</th>
                <th>Observación</th>
                <th>Fecha</th>
                <th width="300">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Producto?.Nombre</strong>
                    </td>

                    <td>
                        @if (item.TipoMovimiento == "Entrada")
                        {
                            <span class="badge bg-success">Entrada</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Salida</span>
                        }
                    </td>

                    <td>@item.Cantidad kg</td>

                    <td>@item.Observacion</td>

                    <td>@item.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>

                    <td>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm text-white">
                                Editar inventario
                            </a>
                        }

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm text-white">
                            Detalles
                        </a>

                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaInventario').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20] ,
                responsive: true
            });
        });
    </script>
}