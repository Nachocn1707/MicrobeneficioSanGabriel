@model IEnumerable<MicrobeneficioSanGabriel.Models.MovimientoInventario>

@{
    ViewData["Title"] = "Inventario";
    <div class="sg-visual-hero sg-hero-inventario">
        <div class="sg-visual-hero-content">
            <span class="sg-visual-badge">
                <i class="fa-solid fa-boxes-stacked"></i>
                Control de inventario
            </span>

            <h1>Inventario del microbeneficio</h1>
            <div class="sg-visual-line"></div>

            <p>
                Consultá entradas, salidas, movimientos y disponibilidad de productos.
            </p>
        </div>
    </div>
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int totalMovimientos = Model.Count();
    int totalEntradas = Model.Count(m => m.TipoMovimiento == "Entrada");
    int totalSalidas = Model.Count(m => m.TipoMovimiento == "Salida");
    decimal totalKgMovidos = Model.Sum(m => m.Cantidad);
}

@section Styles {
    <style>
        .inventario-page {
            display: grid;
            gap: 24px;
            padding-top: 10px;
        }

        .inventario-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

            .inventario-header h1 {
                font-size: 2.35rem;
                font-weight: 950;
                margin: 0;
                color: #2b160d;
            }

        .inventario-title-line {
            width: 76px;
            height: 4px;
            background: #d8b36a;
            border-radius: 999px;
            margin: 12px 0;
        }

        .inventario-header p {
            color: #6f5b4a;
            font-weight: 650;
            margin: 0;
        }

        .btn-nuevo-movimiento {
            background: #198754;
            color: #fff;
            border-radius: 13px;
            padding: 11px 18px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 12px 28px rgba(25, 135, 84, 0.18);
            transition: 0.18s ease;
        }

            .btn-nuevo-movimiento:hover {
                background: #157347;
                color: #fff;
                transform: translateY(-1px);
            }

        .inventario-summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .inventario-summary-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 22px;
            padding: 20px;
            box-shadow: 0 16px 36px rgba(58, 33, 20, 0.08);
            position: relative;
            overflow: hidden;
        }

            .inventario-summary-card::after {
                content: "";
                position: absolute;
                right: -32px;
                bottom: -36px;
                width: 110px;
                height: 110px;
                background: rgba(243, 210, 122, 0.22);
                border-radius: 50%;
            }

        .inventario-summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #fff2d5;
            color: #a66b20;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            font-size: 18px;
        }

        .inventario-summary-label {
            color: #7a6a5d;
            font-weight: 850;
            font-size: 0.92rem;
            margin-bottom: 4px;
        }

        .inventario-summary-value {
            color: #2b160d;
            font-size: 1.85rem;
            font-weight: 950;
            line-height: 1.15;
        }

        .inventario-table-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 24px;
            box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
            padding: 18px;
            overflow: hidden;
        }

            .inventario-table-card table {
                margin-bottom: 0;
            }

                .inventario-table-card table thead th {
                    background: #1f2937 !important;
                    color: #fff !important;
                    border: none !important;
                    padding: 15px 14px !important;
                    font-weight: 900;
                    vertical-align: middle;
                }

                    .inventario-table-card table thead th:first-child {
                        border-top-left-radius: 13px;
                    }

                    .inventario-table-card table thead th:last-child {
                        border-top-right-radius: 13px;
                    }

                .inventario-table-card table tbody td {
                    padding: 16px 14px !important;
                    vertical-align: middle;
                    border-bottom: 1px solid #ece2cf;
                }

                .inventario-table-card table tbody tr:hover {
                    background: rgba(243, 210, 122, 0.12);
                }

        .inventario-producto {
            font-weight: 900;
            color: #2b160d;
        }

        .inventario-observacion {
            max-width: 330px;
            color: #5f5147;
            font-weight: 650;
            line-height: 1.35;
        }

        .inventario-cantidad {
            font-weight: 950;
            color: #2b160d;
            white-space: nowrap;
        }

        .inventario-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

            .inventario-actions .btn {
                border-radius: 10px;
                font-weight: 850;
                padding: 8px 11px;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

        .inventario-estado {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: 0.8rem;
            font-weight: 950;
            white-space: nowrap;
        }

        .inventario-entrada {
            background: #dff5e3;
            color: #1e7d32;
        }

        .inventario-salida {
            background: #fde1df;
            color: #b42318;
        }

        .inventario-neutral {
            background: #e9ecef;
            color: #495057;
        }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 15px;
            color: #2b160d;
            font-weight: 700;
        }

            .dataTables_wrapper .dataTables_filter input,
            .dataTables_wrapper .dataTables_length select {
                border: 1px solid #d9c8ab;
                border-radius: 10px;
                padding: 7px 10px;
                background: white;
            }

        .dataTables_wrapper .dataTables_info {
            color: #6f5b4a;
            font-weight: 650;
            margin-top: 14px;
        }

        .dataTables_wrapper .dataTables_paginate {
            margin-top: 14px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border-radius: 10px !important;
            }

        @@media (max-width: 1200px) {
            .inventario-summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .inventario-header {
                flex-direction: column;
            }

            .inventario-summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="inventario-page">

    <div class="inventario-header">
        <div>
            <h1></h1>
            <div class="inventario-title-line"></div>
            <p>
            </p>
        </div>

        <a asp-action="Create" class="btn-nuevo-movimiento">
            <i class="fa-solid fa-plus"></i>
            Nuevo Movimiento
        </a>
    </div>

    <section class="inventario-summary-grid">

        <div class="inventario-summary-card">
            <div class="inventario-summary-icon">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div class="inventario-summary-label">Movimientos registrados</div>
            <div class="inventario-summary-value">@totalMovimientos</div>
        </div>

        <div class="inventario-summary-card">
            <div class="inventario-summary-icon">
                <i class="fa-solid fa-arrow-trend-up"></i>
            </div>
            <div class="inventario-summary-label">Entradas</div>
            <div class="inventario-summary-value">@totalEntradas</div>
        </div>

        <div class="inventario-summary-card">
            <div class="inventario-summary-icon">
                <i class="fa-solid fa-arrow-trend-down"></i>
            </div>
            <div class="inventario-summary-label">Salidas</div>
            <div class="inventario-summary-value">@totalSalidas</div>
        </div>

        <div class="inventario-summary-card">
            <div class="inventario-summary-icon">
                <i class="fa-solid fa-weight-hanging"></i>
            </div>
            <div class="inventario-summary-label">Kg registrados</div>
            <div class="inventario-summary-value">@totalKgMovidos.ToString("N2") kg</div>
        </div>

    </section>

    <div class="inventario-table-card">

        <div class="table-responsive">

            <table id="tablaInventario" class="table align-middle">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Movimiento</th>
                        <th>Cantidad</th>
                        <th>Observación</th>
                        <th>Fecha</th>
                        <th width="330">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        string tipoClase = item.TipoMovimiento switch
                        {
                            "Entrada" => "inventario-estado inventario-entrada",
                            "Salida" => "inventario-estado inventario-salida",
                            _ => "inventario-estado inventario-neutral"
                        };

                        <tr>
                            <td class="inventario-producto">
                                @(item.Producto != null
                                    ? item.Producto.Nombre
                                    : "Sin producto")
                            </td>

                            <td>
                                <span class="@tipoClase">
                                    @item.TipoMovimiento
                                </span>
                            </td>

                            <td class="inventario-cantidad">
                                @item.Cantidad kg
                            </td>

                            <td class="inventario-observacion">
                                @(string.IsNullOrWhiteSpace(item.Observacion)
                                    ? "Sin observación"
                                    : item.Observacion)
                            </td>

                            <td>
                                @item.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <div class="inventario-actions">

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm text-white">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            Editar
                                        </a>
                                    }

                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">
                                        <i class="fa-solid fa-eye"></i>
                                        Detalles
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-trash"></i>
                                            Eliminar
                                        </a>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaInventario').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20],
                responsive: true
            });
        });
    </script>
}