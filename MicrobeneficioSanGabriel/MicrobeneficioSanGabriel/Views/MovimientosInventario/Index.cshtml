@model IEnumerable<MicrobeneficioSanGabriel.Models.MovimientoInventario>

@{
    ViewData["Title"] = "Inventario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Inventario</h1>
        <p>Historial de entradas y salidas de productos.</p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Nuevo Movimiento
    </a>
</div>

<div class="admin-card">
    <table class="table table-admin align-middle">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Movimiento</th>
                <th>Cantidad</th>
                <th>Observación</th>
                <th>Fecha</th>
                <th width="220">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Producto?.Nombre</strong>
                    </td>

                    <td>
                        @if (item.TipoMovimiento == "Entrada")
                        {
                            <span class="badge bg-success">Entrada</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Salida</span>
                        }
                    </td>

                    <td>@item.Cantidad unidades</td>

                    <td>@item.Observacion</td>

                    <td>@item.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white">
                            Detalles
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>