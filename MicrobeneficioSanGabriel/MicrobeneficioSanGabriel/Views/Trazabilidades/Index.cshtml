@model IEnumerable<MicrobeneficioSanGabriel.Models.Trazabilidad>

@{
    ViewData["Title"] = "Trazabilidad";

    if (User.IsInRole("Cliente"))
    {
        Layout = "~/Views/Shared/_ClienteLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="admin-title">Trazabilidad</h1>
        <p class="admin-subtitle">
            Seguimiento completo del café desde el productor hasta la producción.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-admin-primary">
        + Nuevo Registro
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="admin-card mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label fw-semibold">Código de lote</label>
            <input type="text" name="codigoLote" value="@ViewBag.CodigoLote" class="form-control"
                   placeholder="Buscar por código de lote..." />
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">Etapa</label>
            <select name="etapa" class="form-select" asp-items="ViewBag.Etapas">
                <option value="">Todas las etapas</option>
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
        </div>
    </form>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table id="tablaTrazabilidad" class="table admin-table align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Lote</th>
                    <th>Productor</th>
                    <th>Producción</th>
                    <th>Producto resultante</th>
                    <th>Etapa</th>
                    <th>Fecha</th>
                    <th>Responsable</th>
                    <th>Observación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Lote?.CodigoLote</strong>
                            <br />
                            <a asp-action="Historial"
                               asp-route-loteId="@item.LoteId"
                               class="small">
                                Ver historial
                            </a>
                        </td>
                        <td>@(item.Lote?.Productor?.Nombre ?? "Sin productor")</td>
                        <td>#@item.ProduccionId<br/>
                            <small class="text-muted">@item.Produccion?.TipoProceso</small>
                        </td>
                        <td>
                            @(item.Produccion?.Producto?.Nombre ?? "Sin producto")
                        </td>
                        <td>
                            @if (item.Etapa == "Recepción")
                            {
                                <span class="badge bg-primary">
                                    @item.Etapa
                                </span>
                            }
                            else if (item.Etapa == "Producción")
                            {
                                <span class="badge bg-warning text-dark">
                                    @item.Etapa
                                </span>
                            }
                            else if (item.Etapa == "Secado")
                            {
                                <span class="badge bg-info text-dark">
                                    @item.Etapa
                                </span>
                            }
                            else if (item.Etapa == "Empaque")
                            {
                                <span class="badge bg-success">
                                    @item.Etapa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @item.Etapa
                                </span>
                            }
                        </td>

                        <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(item.Responsable ?? "Sin responsable")</td>
                        <td>@(item.Observacion ?? "Sin observación")</td>
                        <td class="text-end">

                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>
                            }

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                Detalles
                            </a>

                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaTrazabilidad').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20] ,
                responsive: true
            });
        });
    </script>
}