@model IEnumerable<MicrobeneficioSanGabriel.Models.Trazabilidad>
@{
    ViewData["Title"] = "Trazabilidad";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var registros = Model.ToList();
    var total = registros.Count;
    var lotes = registros.Select(t => t.LoteId).Distinct().Count();
    var producciones = registros.Select(t => t.ProduccionId).Distinct().Count();
    var codigoLote = ViewBag.CodigoLote as string ?? string.Empty;
    var etapasConteo = registros
        .GroupBy(t => t.Etapa)
        .OrderByDescending(g => g.Count())
        .ToList();

    string ColorEtapa(string etapa) => etapa switch
    {
        "Lavado" => "#5f8f79",
        "Secado" => "#c89d58",
        "Tostado" => "#765238",
        "Molido" => "#9d7046",
        "Empaque" => "#2f5d50",
        _ => "#667a5b"
    };
}

<section class="sg-page-head">
    <div>
        <span class="sg-eyebrow">Proceso integrado</span>
        <h1>Trazabilidad</h1>
        <p>Seguimiento automático de las etapas reales de producción de cada lote.</p>
    </div>

    <div class="sg-actions">
        <a asp-controller="Producciones" asp-action="Index" class="sg-btn gold">
            <i class="fa-solid fa-industry"></i>
            Gestionar producción
        </a>
        <a asp-action="Index" class="sg-btn green">
            <i class="fa-solid fa-rotate"></i>
            Actualizar
        </a>
    </div>
</section>

<div class="alert alert-success border-0 shadow-sm mb-4" role="status">
    <div class="d-flex gap-3 align-items-start">
        <i class="fa-solid fa-circle-check mt-1"></i>
        <div>
            <strong>Trazabilidad automática.</strong>
            Cada registro se genera cuando una etapa de producción se completa. El sistema valida la secuencia del proceso para evitar estados incompatibles.
        </div>
    </div>
</div>

<form method="get" asp-action="Index" class="sg-filters sg-trazabilidad-filters">
    <label class="sg-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input name="codigoLote" value="@codigoLote" placeholder="Buscar por lote o código..." />
    </label>
    <select name="etapa" class="sg-filter form-select" asp-items="ViewBag.Etapas">
        <option value="">Todas las etapas</option>
    </select>
    <button class="sg-btn ghost" type="submit"><i class="fa-solid fa-filter"></i> Filtrar</button>
    <a asp-action="Index" class="sg-btn ghost"><i class="fa-solid fa-rotate-left"></i> Limpiar</a>
</form>

<section class="sg-kpi-grid three sg-trazabilidad-kpis">
    <article class="sg-card sg-kpi">
        <span class="sg-icon green"><i class="fa-solid fa-route"></i></span>
        <div><span>Eventos registrados</span><strong>@total</strong><div class="sg-trend">Generados desde producción</div></div>
    </article>
    <article class="sg-card sg-kpi">
        <span class="sg-icon gold"><i class="fa-solid fa-layer-group"></i></span>
        <div><span>Lotes trazados</span><strong>@lotes</strong><div class="sg-trend">Con seguimiento automático</div></div>
    </article>
    <article class="sg-card sg-kpi">
        <span class="sg-icon brown"><i class="fa-solid fa-gears"></i></span>
        <div><span>Producciones</span><strong>@producciones</strong><div class="sg-trend">Procesos vinculados</div></div>
    </article>
</section>

<section class="sg-grid-2">
    <article class="sg-card sg-panel">
        <div class="sg-panel-head">
            <div>
                <h3>Secuencia del proceso</h3>
                <small class="text-muted">Una etapa posterior requiere que las anteriores estén completadas.</small>
            </div>
        </div>
        <div class="sg-steps mt-4">
            @foreach (var etapa in new[] { "Lavado", "Secado", "Tostado", "Molido", "Empaque" })
            {
                var cantidad = registros.Count(t => t.Etapa == etapa);
                <div class="sg-step">
                    <div class="sg-step-icon"><i class="fa-solid fa-check"></i></div>
                    <b>@etapa</b><br />
                    <small>@cantidad evento(s)</small>
                </div>
                @if (etapa != "Empaque")
                {
                    <div class="sg-step-line"></div>
                }
            }
        </div>
    </article>

    <article class="sg-card sg-panel">
        <div class="sg-panel-head">
            <div>
                <h3>Eventos por etapa</h3>
                <small class="text-muted">Distribución de los registros visibles.</small>
            </div>
        </div>
        <div class="mt-3">
            @if (etapasConteo.Any())
            {
                foreach (var etapa in etapasConteo)
                {
                    var porcentaje = total == 0 ? 0 : Math.Round(etapa.Count() * 100m / total, 0);
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold"><span class="sg-dot me-2" style="background:@ColorEtapa(etapa.Key)"></span>@etapa.Key</span>
                            <span class="text-muted">@etapa.Count() · @porcentaje%</span>
                        </div>
                        <div class="progress" style="height:7px;">
                            <div class="progress-bar" role="progressbar" style="width:@porcentaje%;background:@ColorEtapa(etapa.Key)" aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-muted py-4 text-center">No hay registros de trazabilidad para los filtros seleccionados.</div>
            }
        </div>
    </article>
</section>

<section class="sg-card sg-table-card mt-4">
    <div class="sg-panel-head">
        <div>
            <h3>Historial de trazabilidad</h3>
            <small class="text-muted">Los registros automáticos no se editan manualmente.</small>
        </div>
        <span class="sg-badge">@total registro(s)</span>
    </div>

    <div class="table-responsive">
        <table class="sg-table" id="tablaTrazabilidad">
            <thead>
                <tr>
                    <th>Lote</th>
                    <th>Origen</th>
                    <th>Etapa</th>
                    <th>Fecha y hora</th>
                    <th>Producción</th>
                    <th>Responsable</th>
                    <th>Tipo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (registros.Any())
            {
                foreach (var t in registros)
                {
                    <tr>
                        <td><strong>@(t.Lote?.CodigoLote ?? $"LOTE-{t.LoteId:0000}")</strong></td>
                        <td>
                            <div>@(t.Lote?.Productor?.Nombre ?? "Sin productor")</div>
                            <small class="text-muted">@(t.Lote?.Finca?.Nombre ?? "Sin finca registrada")</small>
                        </td>
                        <td><span class="sg-badge">@t.Etapa</span></td>
                        <td>@t.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (t.Produccion != null)
                            {
                                <div><strong>#@t.Produccion.Id · @t.Produccion.TipoProceso</strong></div>
                                <small class="text-muted">@t.Produccion.Estado</small>
                            }
                            else
                            {
                                <span>#@t.ProduccionId</span>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(t.Responsable) ? "Sistema" : t.Responsable)</td>
                        <td><span class="badge bg-success-subtle text-success-emphasis"><i class="fa-solid fa-bolt me-1"></i>Automático</span></td>
                        <td>
                            <span class="sg-action-icons">
                                <a asp-action="Details" asp-route-id="@t.Id" title="Ver detalle" aria-label="Ver detalle"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Historial" asp-route-loteId="@t.LoteId" title="Ver historial del lote" aria-label="Ver historial del lote"><i class="fa-solid fa-clock-rotate-left"></i></a>
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                @* DataTables muestra el mensaje de tabla vacía sin usar colspan en tbody. *@
            }
            </tbody>
        </table>
    </div>
</section>
