@model IEnumerable<MicrobeneficioSanGabriel.Models.Trazabilidad>

@{
    ViewData["Title"] = "Trazabilidad";

    if (User.IsInRole("Cliente"))
    {
        Layout = "~/Views/Shared/_ClienteLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }

    int totalRegistros = Model.Count();
    int totalLotes = Model.Select(t => t.LoteId).Distinct().Count();
    int totalEtapas = Model
        .Where(t => !string.IsNullOrWhiteSpace(t.Etapa))
        .Select(t => t.Etapa)
        .Distinct()
        .Count();

    int totalResponsables = Model.Count(t => !string.IsNullOrWhiteSpace(t.Responsable));
}

@section Styles {
    <style>
        .trazabilidad-page {
            display: grid;
            gap: 24px;
            padding-top: 10px;
        }

        .trazabilidad-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

            .trazabilidad-header h1 {
                font-size: 2.35rem;
                font-weight: 950;
                margin: 0;
                color: #2b160d;
            }

        .trazabilidad-title-line {
            width: 76px;
            height: 4px;
            background: #d8b36a;
            border-radius: 999px;
            margin: 12px 0;
        }

        .trazabilidad-header p {
            color: #6f5b4a;
            font-weight: 650;
            margin: 0;
        }

        .btn-nueva-trazabilidad {
            background: #198754;
            color: #fff;
            border-radius: 13px;
            padding: 11px 18px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 12px 28px rgba(25, 135, 84, 0.18);
            transition: 0.18s ease;
        }

            .btn-nueva-trazabilidad:hover {
                background: #157347;
                color: #fff;
                transform: translateY(-1px);
            }

        .trazabilidad-alert {
            border: none;
            border-radius: 18px;
            padding: 15px 18px;
            font-weight: 750;
            box-shadow: 0 12px 28px rgba(58, 33, 20, 0.08);
        }

        .trazabilidad-summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .trazabilidad-summary-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 22px;
            padding: 20px;
            box-shadow: 0 16px 36px rgba(58, 33, 20, 0.08);
            position: relative;
            overflow: hidden;
        }

            .trazabilidad-summary-card::after {
                content: "";
                position: absolute;
                right: -32px;
                bottom: -36px;
                width: 110px;
                height: 110px;
                background: rgba(243, 210, 122, 0.22);
                border-radius: 50%;
            }

        .trazabilidad-summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #fff2d5;
            color: #a66b20;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            font-size: 18px;
        }

        .trazabilidad-summary-label {
            color: #7a6a5d;
            font-weight: 850;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .trazabilidad-summary-value {
            color: #2b160d;
            font-size: 1.75rem;
            font-weight: 950;
            line-height: 1.15;
        }

        .trazabilidad-filter-card,
        .trazabilidad-table-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 24px;
            box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
            padding: 18px;
            overflow: hidden;
        }

            .trazabilidad-filter-card label {
                color: #2b160d;
                font-weight: 900;
                margin-bottom: 8px;
            }

            .trazabilidad-filter-card .form-control,
            .trazabilidad-filter-card .form-select {
                min-height: 48px;
                border-radius: 14px;
                border: 1px solid #d8dee8;
                font-weight: 700;
            }

                .trazabilidad-filter-card .form-control:focus,
                .trazabilidad-filter-card .form-select:focus {
                    border-color: #d8b36a;
                    box-shadow: 0 0 0 0.2rem rgba(216, 179, 106, 0.22);
                }

            .trazabilidad-table-card table {
                margin-bottom: 0;
            }

                .trazabilidad-table-card table thead th {
                    background: #1f2937 !important;
                    color: #fff !important;
                    border: none !important;
                    padding: 15px 14px !important;
                    font-weight: 900;
                    vertical-align: middle;
                }

                    .trazabilidad-table-card table thead th:first-child {
                        border-top-left-radius: 13px;
                    }

                    .trazabilidad-table-card table thead th:last-child {
                        border-top-right-radius: 13px;
                    }

                .trazabilidad-table-card table tbody td {
                    padding: 16px 14px !important;
                    vertical-align: middle;
                    border-bottom: 1px solid #ece2cf;
                }

                .trazabilidad-table-card table tbody tr:hover {
                    background: rgba(243, 210, 122, 0.12);
                }

        .trazabilidad-lote {
            font-weight: 950;
            color: #2b160d;
        }

        .trazabilidad-link {
            color: #7a5230;
            font-weight: 850;
            text-decoration: none;
        }

            .trazabilidad-link:hover {
                color: #3a1f12;
                text-decoration: underline;
            }

        .trazabilidad-texto {
            color: #5f5147;
            font-weight: 700;
            line-height: 1.35;
        }

        .trazabilidad-observacion {
            max-width: 280px;
            color: #5f5147;
            font-weight: 650;
            line-height: 1.35;
        }

        .trazabilidad-etapa {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: 0.8rem;
            font-weight: 950;
            white-space: nowrap;
        }

        .trazabilidad-etapa-recepcion {
            background: #dff6fd;
            color: #0369a1;
        }

        .trazabilidad-etapa-produccion {
            background: #fff4d3;
            color: #8a6500;
        }

        .trazabilidad-etapa-secado {
            background: #e9e0ff;
            color: #5636a3;
        }

        .trazabilidad-etapa-tostado {
            background: #f7dfc7;
            color: #7a3e12;
        }

        .trazabilidad-etapa-empaque {
            background: #dff5e3;
            color: #1e7d32;
        }

        .trazabilidad-etapa-neutral {
            background: #e9ecef;
            color: #495057;
        }

        .trazabilidad-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            justify-content: flex-end;
            flex-wrap: wrap;
        }

            .trazabilidad-actions .btn {
                border-radius: 10px;
                font-weight: 850;
                padding: 8px 11px;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 15px;
            color: #2b160d;
            font-weight: 700;
        }

            .dataTables_wrapper .dataTables_filter input,
            .dataTables_wrapper .dataTables_length select {
                border: 1px solid #d9c8ab;
                border-radius: 10px;
                padding: 7px 10px;
                background: white;
            }

        .dataTables_wrapper .dataTables_info {
            color: #6f5b4a;
            font-weight: 650;
            margin-top: 14px;
        }

        .dataTables_wrapper .dataTables_paginate {
            margin-top: 14px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border-radius: 10px !important;
            }

        @@media (max-width: 1200px) {
            .trazabilidad-summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .trazabilidad-header {
                flex-direction: column;
            }

            .trazabilidad-summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="trazabilidad-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show trazabilidad-alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="trazabilidad-header">
        <div>
            <h1>Trazabilidad</h1>
            <div class="trazabilidad-title-line"></div>
            <p>
                Seguimiento completo del café desde el productor hasta la producción.
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn-nueva-trazabilidad">
                <i class="fa-solid fa-plus"></i>
                Nuevo registro
            </a>
        }
    </div>

    <section class="trazabilidad-summary-grid">

        <div class="trazabilidad-summary-card">
            <div class="trazabilidad-summary-icon">
                <i class="fa-solid fa-route"></i>
            </div>
            <div class="trazabilidad-summary-label">Registros</div>
            <div class="trazabilidad-summary-value">@totalRegistros</div>
        </div>

        <div class="trazabilidad-summary-card">
            <div class="trazabilidad-summary-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div class="trazabilidad-summary-label">Lotes trazados</div>
            <div class="trazabilidad-summary-value">@totalLotes</div>
        </div>

        <div class="trazabilidad-summary-card">
            <div class="trazabilidad-summary-icon">
                <i class="fa-solid fa-diagram-project"></i>
            </div>
            <div class="trazabilidad-summary-label">Etapas registradas</div>
            <div class="trazabilidad-summary-value">@totalEtapas</div>
        </div>

        <div class="trazabilidad-summary-card">
            <div class="trazabilidad-summary-icon">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div class="trazabilidad-summary-label">Responsables</div>
            <div class="trazabilidad-summary-value">@totalResponsables</div>
        </div>

    </section>

    <div class="trazabilidad-filter-card">

        <form asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-md-5">
                <label class="form-label">Código de lote</label>

                <input type="text"
                       name="codigoLote"
                       value="@ViewBag.CodigoLote"
                       class="form-control"
                       placeholder="Buscar por código de lote..." />
            </div>

            <div class="col-md-4">
                <label class="form-label">Etapa</label>

                <select name="etapa"
                        class="form-select"
                        asp-items="ViewBag.Etapas">
                    <option value="">Todas las etapas</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-filter"></i>
                    Filtrar
                </button>

                <a asp-action="Index" class="btn btn-secondary w-100">
                    <i class="fa-solid fa-rotate-left"></i>
                    Limpiar
                </a>
            </div>

        </form>

    </div>

    <div class="trazabilidad-table-card">

        <div class="table-responsive">

            <table id="tablaTrazabilidad" class="table align-middle">

                <thead>
                    <tr>
                        <th>Lote</th>
                        <th>Productor</th>
                        <th>Producción</th>
                        <th>Producto resultante</th>
                        <th>Etapa</th>
                        <th>Fecha</th>
                        <th>Responsable</th>
                        <th>Observación</th>
                        <th class="text-end" width="320">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        string etapaClase = item.Etapa switch
                        {
                            "Recepción" => "trazabilidad-etapa trazabilidad-etapa-recepcion",
                            "Producción" => "trazabilidad-etapa trazabilidad-etapa-produccion",
                            "Secado" => "trazabilidad-etapa trazabilidad-etapa-secado",
                            "Tostado" => "trazabilidad-etapa trazabilidad-etapa-tostado",
                            "Empaque" => "trazabilidad-etapa trazabilidad-etapa-empaque",
                            _ => "trazabilidad-etapa trazabilidad-etapa-neutral"
                        };

                        <tr>
                            <td>
                                <span class="trazabilidad-lote">
                                    @(item.Lote != null ? item.Lote.CodigoLote : "Sin lote")
                                </span>

                                <br />

                                <a asp-action="Historial"
                                       asp-route-loteId="@item.LoteId"
                                       class="trazabilidad-link small">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                    Ver historial
                                </a>
                            </td>

                            <td class="trazabilidad-texto">
                                @(item.Lote?.Productor?.Nombre ?? "Sin productor")
                            </td>

                            <td class="trazabilidad-texto">
                                #@item.ProduccionId
                                <br />
                                <small>
                                    @(item.Produccion?.TipoProceso ?? "Sin proceso")
                                </small>
                            </td>

                            <td class="trazabilidad-texto">
                                @(item.Produccion?.Producto?.Nombre ?? "Sin producto")
                            </td>

                            <td>
                                <span class="@etapaClase">
                                    @(string.IsNullOrWhiteSpace(item.Etapa)
                                        ? "Sin etapa"
                                        : item.Etapa)
                                </span>
                            </td>

                            <td>
                                @item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td class="trazabilidad-texto">
                                @(string.IsNullOrWhiteSpace(item.Responsable)
                                    ? "Sin responsable"
                                    : item.Responsable)
                            </td>

                            <td class="trazabilidad-observacion">
                                @(string.IsNullOrWhiteSpace(item.Observacion)
                                    ? "Sin observación"
                                    : item.Observacion)
                            </td>

                            <td>
                                <div class="trazabilidad-actions">

                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">
                                        <i class="fa-solid fa-eye"></i>
                                        Detalles
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            Editar
                                        </a>

                                        <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-trash"></i>
                                            Eliminar
                                        </a>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaTrazabilidad').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20],
                responsive: true
            });
        });
    </script>
}