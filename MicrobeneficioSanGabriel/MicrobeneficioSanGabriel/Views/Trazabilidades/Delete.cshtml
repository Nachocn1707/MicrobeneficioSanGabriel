@model MicrobeneficioSanGabriel.Models.Trazabilidad

@{
    ViewData["Title"] = "Eliminar trazabilidad";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEliminar.css" />
}

<div class="sg-card border-danger">
    <h1 class="text-danger">
        <i class="fa-solid fa-trash"></i>
        Eliminar trazabilidad
    </h1>

    <p>
        <strong>Etapa:</strong> @Model.Etapa<br />
        <strong>Lote:</strong> @(Model.Lote != null ? Model.Lote.CodigoLote : "Sin lote")<br />
        <strong>Producción:</strong> @(Model.Produccion != null ? $"Producción #{Model.Produccion.Id} - {Model.Produccion.Estado}" : "Sin producción")<br />
        <strong>Fecha de registro:</strong> @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")<br />
        <strong>Responsable:</strong> @(string.IsNullOrWhiteSpace(Model.Responsable) ? "Sin responsable" : Model.Responsable)
    </p>

    <div class="alert alert-warning">
        <i class="fa-solid fa-circle-exclamation"></i>
        Esta acción eliminará el registro de trazabilidad del sistema de forma <strong>permanente</strong>.
        La trazabilidad permite dar seguimiento al proceso del café y esta operación no se puede deshacer.
    </div>

    @if (Model.Produccion != null && Model.Produccion.Estado == "Completado")
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-check-circle"></i>
            <strong>Producción completada:</strong> Esta trazabilidad está asociada a una producción completada.
            Eliminarla puede afectar el historial del lote.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Observacion))
    {
        <div class="trazabilidad-details">
            <div class="detail-item">
                <strong><i class="fa-solid fa-comment-dots"></i> Observación:</strong>
                <span>@Model.Observacion</span>
            </div>
        </div>
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
            <button class="btn btn-danger" type="submit">
                <i class="fa-solid fa-trash"></i> Confirmar eliminación
            </button>
        </div>
    </form>
</div>