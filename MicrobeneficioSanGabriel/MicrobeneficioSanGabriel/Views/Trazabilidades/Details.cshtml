@model MicrobeneficioSanGabriel.Models.Trazabilidad

@{
    ViewData["Title"] = "Detalle de trazabilidad";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalle de trazabilidad</h1>
        <p>
            Información detallada del seguimiento del lote seleccionado.
        </p>
    </div>

    <div class="EstiloDetalle-card">

        <div class="EstiloDetalle-card-header">
            <h2>Información del lote</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">
            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">
                        Código de lote
                    </span>

                    <span class="detalle-value">
                        @Model.Lote?.CodigoLote
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Productor
                    </span>

                    <span class="detalle-value">
                        @(Model.Lote?.Productor?.Nombre ?? "Sin productor")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Fecha de recepción
                    </span>

                    <span class="detalle-value">
                        @Model.Lote?.FechaRecepcion.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Peso recibido
                    </span>

                    <span class="detalle-value">
                        @Model.Lote?.PesoKg kg
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Estado del lote
                    </span>

                    <span class="detalle-value">
                        @Model.Lote?.Estado
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Finca
                    </span>

                    <span class="detalle-value">
                        @(Model.Lote?.Productor?.Finca ?? "No registrada")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="EstiloDetalle-card mt-4">

        <div class="EstiloDetalle-card-header">
            <h2>Información de producción</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">

            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">
                        Proceso
                    </span>

                    <span class="detalle-value">
                        @Model.Produccion?.TipoProceso
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Fecha de producción
                    </span>

                    <span class="detalle-value">
                        @Model.Produccion?.FechaProduccion.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Estado
                    </span>

                    <span class="detalle-value">
                        @Model.Produccion?.Estado
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Cantidad procesada
                    </span>

                    <span class="detalle-value">
                        @Model.Produccion?.CantidadProcesadaKg kg
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Cantidad resultante
                    </span>

                    <span class="detalle-value">
                        @Model.Produccion?.CantidadResultanteKg kg
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Producto resultante
                    </span>

                    <span class="detalle-value">
                        @(Model.Produccion?.Producto?.Nombre ?? "Sin producto")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="EstiloDetalle-card mt-4">

        <div class="EstiloDetalle-card-header">
            <h2>Registro de trazabilidad</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">

            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">
                        Etapa
                    </span>

                    <span class="detalle-value">
                        @Model.Etapa
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Fecha de registro
                    </span>

                    <span class="detalle-value">
                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Responsable
                    </span>

                    <span class="detalle-value">
                        @(Model.Responsable ?? "Sin responsable")
                    </span>
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">
                        Observación
                    </span>

                    <span class="detalle-value">
                        @(Model.Observacion ?? "Sin observación")
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-volver">
                    Volver a la lista
                </a>

                <a asp-action="Historial"
                   asp-route-loteId="@Model.LoteId"
                   class="btn-volver">
                    Ver historial
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-editar">
                        Editar
                    </a>
                }

            </div>
        </div>
    </div>
</div>