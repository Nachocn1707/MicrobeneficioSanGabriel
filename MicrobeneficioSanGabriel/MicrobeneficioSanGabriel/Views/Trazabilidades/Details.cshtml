@model MicrobeneficioSanGabriel.Models.Trazabilidad

@{
    ViewData["Title"] = "Detalle de trazabilidad";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalle de trazabilidad</h1>
        <p>Información registrada del seguimiento del lote.</p>
    </div>

    <div class="EstiloDetalle-card">

        <div class="EstiloDetalle-card-header">

            <h2>
                @(Model.Lote != null
                    ? Model.Lote.CodigoLote
                    : $"Registro #{Model.Id}")
            </h2>

            <span>
                Microbeneficio San Gabriel
            </span>

        </div>

        <div class="EstiloDetalle-card-body">

            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">
                        Lote
                    </span>

                    <span class="detalle-value">
                        @(Model.Lote?.CodigoLote ?? "Sin lote")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Producción asociada
                    </span>

                    <span class="detalle-value">
                        @(Model.Produccion != null
                            ? $"#{Model.Produccion.Id}"
                            : "Sin producción")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Etapa
                    </span>

                    <span class="detalle-value">
                        @Model.Etapa
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Fecha de registro
                    </span>

                    <span class="detalle-value">
                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Responsable
                    </span>

                    <span class="detalle-value">
                        @Model.Responsable
                    </span>
                </div>

                <div class="detalle-item full">

                    <span class="detalle-label">
                        Observación
                    </span>

                    <span class="detalle-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>

                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-volver">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-editar">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Editar
                    </a>
                }

            </div>
        </div>
    </div>
</div>