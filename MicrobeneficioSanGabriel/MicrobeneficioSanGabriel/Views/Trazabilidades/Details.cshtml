@model MicrobeneficioSanGabriel.Models.Trazabilidad

@{
    ViewData["Title"] = "Detalle de Trazabilidad";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var loteCodigo = Model.Lote?.CodigoLote ?? $"LOTE-{Model.LoteId:0000}";
    var productor = Model.Lote?.Productor?.Nombre ?? "Sin productor asociado";
    var finca = Model.Lote?.Finca?.Nombre ?? "Sin finca asociada";
    var produccionTexto = Model.Produccion != null
        ? $"Producción #{Model.Produccion.Id} · {Model.Produccion.TipoProceso}"
        : $"Producción #{Model.ProduccionId}";
    var producto = Model.Produccion?.ProductoNombreMostrar ?? "Sin producto resultante";

    string etapaClase = Model.Etapa switch
    {
        "Lavado" => "movimiento-estado movimiento-neutral",
        "Secado" => "movimiento-estado movimiento-neutral",
        "Tostado" => "movimiento-estado movimiento-entrada",
        "Molido" => "movimiento-estado movimiento-entrada",
        "Empaque" => "movimiento-estado movimiento-entrada",
        _ => "movimiento-estado movimiento-neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<section class="Detalle-page-head trazabilidad-detail-head sg-centered-detail-head">
    <div>
        <h1>Detalle de trazabilidad</h1>
        <p>Consulta el seguimiento del lote, su etapa actual y la producción asociada.</p>
    </div>
    <div class="Detalle-actions">
        <span class="movimiento-badge-top">
            Registro #@Model.Id
        </span>
    </div>
</section>

<div class="EstiloDetalle-detalle-page">
    <div class="EstiloDetalle-premium-card">

        <div class="EstiloDetalle-premium-header">
            <h2>Información del registro</h2>
        </div>

        <div class="EstiloDetalle-premium-body">

            <div class="EstiloDetalle-detail-grid">

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-barcode"></i> CÓDIGO DE LOTE
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @loteCodigo
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-user-gear"></i> PRODUCTOR
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @productor
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-mountain-sun"></i> FINCA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @finca
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-list-check"></i> ETAPA
                    </span>
                    <div>
                        <span class="@etapaClase">
                            @Model.Etapa
                        </span>
                    </div>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-calendar-days"></i> FECHA DE REGISTRO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-user-check"></i> RESPONSABLE
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Responsable) ? "Sin responsable registrado" : Model.Responsable)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-industry"></i> PRODUCCIÓN ASOCIADA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @produccionTexto
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-box-open"></i> PRODUCTO RESULTANTE
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @producto
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-bolt"></i> TIPO DE REGISTRO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(Model.EsAutomatico ? "Automático desde producción" : "Histórico manual")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-align-left"></i> OBSERVACIÓN
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación registrada."
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index" class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver
                </a>

                @if (User.IsInRole("Administrador") || User.IsInRole("Operador"))
                {
                    <a asp-controller="Producciones"
                       asp-action="Edit"
                       asp-route-id="@Model.ProduccionId"
                       class="btn-EstiloDetalle btn-EstiloDetalle-warning">
                        <i class="fa-solid fa-industry"></i>
                        Gestionar producción
                    </a>
                }

            </div>

        </div>
    </div>
</div>