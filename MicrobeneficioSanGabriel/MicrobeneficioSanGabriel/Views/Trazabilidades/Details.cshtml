@model MicrobeneficioSanGabriel.Models.Trazabilidad

@{
    ViewData["Title"] = "Detalle de trazabilidad";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var loteCodigo = Model.Lote?.CodigoLote ?? $"LOTE-{Model.LoteId:0000}";
    var productor = Model.Lote?.Productor?.Nombre ?? "Sin productor asociado";
    var finca = Model.Lote?.Finca?.Nombre ?? "Sin finca asociada";
    var produccionTexto = Model.Produccion != null
        ? $"Producción #{Model.Produccion.Id} · {Model.Produccion.TipoProceso}"
        : $"Producción #{Model.ProduccionId}";
    var producto = Model.Produccion?.Producto?.Nombre ?? "Sin producto resultante";
}

<section class="sg-page-head">
    <div>
        <h1>Detalle de trazabilidad</h1>
        <p>Consulta el seguimiento del lote, su etapa actual y la producción asociada.</p>
    </div>
    <div class="sg-actions">
        <span class="sg-badge gold">@Model.Etapa</span>
    </div>
</section>

<section class="sg-visual-hero sg-hero-trazabilidad">
    <div class="sg-visual-hero-content">
        <span class="sg-visual-badge"><i class="fa-solid fa-route"></i> Seguimiento del café</span>
        <h1>@loteCodigo</h1>
        <div class="sg-visual-line"></div>
        <p>@productor · @finca</p>
    </div>
</section>

<section class="sg-card sg-panel">
    <div class="sg-panel-head">
        <h3>Información del registro</h3>
        <span class="sg-badge">Registro #@Model.Id</span>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-4">
            <small class="text-muted">Código de lote</small>
            <h5>@loteCodigo</h5>
        </div>
        <div class="col-md-4">
            <small class="text-muted">Productor</small>
            <h5>@productor</h5>
        </div>
        <div class="col-md-4">
            <small class="text-muted">Finca</small>
            <h5>@finca</h5>
        </div>
        <div class="col-md-4">
            <small class="text-muted">Etapa</small>
            <p class="mb-0"><span class="sg-badge gold">@Model.Etapa</span></p>
        </div>
        <div class="col-md-4">
            <small class="text-muted">Fecha de registro</small>
            <p class="fw-bold mb-0">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="col-md-4">
            <small class="text-muted">Responsable</small>
            <p class="fw-bold mb-0">@(string.IsNullOrWhiteSpace(Model.Responsable) ? "Sin responsable registrado" : Model.Responsable)</p>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Producción asociada</small>
            <p class="fw-bold mb-0">@produccionTexto</p>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Producto resultante</small>
            <p class="fw-bold mb-0">@producto</p>
        </div>
        <div class="col-12">
            <small class="text-muted">Observación</small>
            <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Observacion) ? "Sin observación registrada." : Model.Observacion)</p>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="sg-btn ghost"><i class="fa-solid fa-arrow-left"></i>Volver</a>
        @if (User.IsInRole("Administrador") || User.IsInRole("Operador"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="sg-btn gold"><i class="fa-solid fa-pen"></i>Editar</a>
        }
    </div>
</section>
