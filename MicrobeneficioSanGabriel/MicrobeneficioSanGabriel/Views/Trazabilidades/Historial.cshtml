@model MicrobeneficioSanGabriel.ViewModels.TrazabilidadHistorialViewModel

@{
    ViewData["Title"] = "Historial del lote";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="admin-title">Historial del lote @Model.Lote?.CodigoLote</h1>
<p class="admin-subtitle">
    Seguimiento completo desde el productor hasta la producción final.
</p>

<div class="admin-card mb-4">
    <h4 class="fw-bold mb-3">Origen del café</h4>

    <div class="row">
        <div class="col-md-4">
            <strong>Productor:</strong>
            <p>@Model.Productor?.Nombre</p>
        </div>

        <div class="col-md-4">
            <strong>Cédula:</strong>
            <p>@Model.Productor?.Cedula</p>
        </div>

        <div class="col-md-4">
            <strong>Finca:</strong>
            <p>@(Model.Productor?.Finca ?? "No registrada")</p>
        </div>

        <div class="col-md-4">
            <strong>Teléfono:</strong>
            <p>@Model.Productor?.Telefono</p>
        </div>

        <div class="col-md-8">
            <strong>Dirección:</strong>
            <p>@Model.Productor?.Direccion</p>
        </div>
    </div>
</div>

<div class="admin-card mb-4">
    <h4 class="fw-bold mb-3">Datos del lote</h4>

    <div class="row">
        <div class="col-md-3">
            <strong>Código:</strong>
            <p>@Model.Lote?.CodigoLote</p>
        </div>

        <div class="col-md-3">
            <strong>Peso recibido:</strong>
            <p>@Model.Lote?.PesoKg kg</p>
        </div>

        <div class="col-md-3">
            <strong>Fecha recepción:</strong>
            <p>@Model.Lote?.FechaRecepcion.ToString("dd/MM/yyyy")</p>
        </div>

        <div class="col-md-3">
            <strong>Estado:</strong>
            <p>@Model.Lote?.Estado</p>
        </div>

        <div class="col-md-12">
            <strong>Observación:</strong>
            <p>@(Model.Lote?.Observacion ?? "Sin observación")</p>
        </div>
    </div>
</div>

<div class="admin-card mb-4">
    <h4 class="fw-bold mb-3">Procesos de producción asociados</h4>

    @if (!Model.Producciones.Any())
    {
        <p class="text-muted">No hay procesos de producción registrados para este lote.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Proceso</th>
                        <th>Procesado</th>
                        <th>Resultante</th>
                        <th>Producto</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Producciones)
                    {
                        <tr>
                            <td>@p.FechaProduccion.ToString("dd/MM/yyyy")</td>
                            <td>@p.TipoProceso</td>
                            <td>@p.CantidadProcesadaKg kg</td>
                            <td>@p.CantidadResultanteKg kg</td>
                            <td>@(p.Producto?.Nombre ?? "Sin producto")</td>
                            <td>@p.Estado</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="admin-card">
    <h4 class="fw-bold mb-3">Línea de trazabilidad</h4>

    @if (!Model.Trazabilidades.Any())
    {
        <p class="text-muted">No hay registros de trazabilidad para este lote.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Etapa</th>
                        <th>Producción</th>
                        <th>Producto</th>
                        <th>Responsable</th>
                        <th>Observación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Trazabilidades)
                    {
                        <tr>
                            <td>@t.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@t.Etapa</td>
                            <td>#@t.ProduccionId - @t.Produccion?.TipoProceso</td>
                            <td>@(t.Produccion?.Producto?.Nombre ?? "Sin producto")</td>
                            <td>@(t.Responsable ?? "Sin responsable")</td>
                            <td>@(t.Observacion ?? "Sin observación")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>