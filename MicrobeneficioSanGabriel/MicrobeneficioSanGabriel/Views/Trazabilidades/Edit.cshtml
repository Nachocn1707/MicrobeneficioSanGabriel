@model MicrobeneficioSanGabriel.Models.Trazabilidad

@{
    ViewData["Title"] = "Editar trazabilidad";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var soloEtapa = (bool?)ViewBag.SoloEtapa ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditaR-page">

    <div class="EstiloEditaR-top">
        <div class="EstiloEditaR-title">
            <span class="EstiloEditaR-badge">
                <i class="fa-solid fa-route"></i>
                Gestión de trazabilidad
            </span>
            <h1>Editar trazabilidad</h1>
            <p>Actualizá los datos y el seguimiento del lote registrado.</p>
        </div>
    </div>

    <div class="EstiloEditaR-card">
        <div class="EstiloEditaR-form-container">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <div class="Estilo-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Verificá los datos antes de guardar para mantener la precisión del historial de trazabilidad del Microbeneficio San Gabriel.
                    </span>
                </div>

                <div class="EstiloEditaR-section">
                    <h5>
                        <i class="fa-solid fa-diagram-project"></i>
                        @(soloEtapa ? "Actualización de la etapa operativa" : "Detalle del seguimiento")
                    </h5>

                    @if (soloEtapa)
                    {
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        <i class="fa-solid fa-hashtag label-icon"></i>
                                        Registro
                                    </label>
                                    <input value="#@Model.Id" class="form-control" readonly />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Etapa" class="form-label">
                                        <i class="fa-solid fa-bars-progress label-icon"></i>
                                        Etapa
                                    </label>
                                    <select asp-for="Etapa" class="form-select">
                                        <option value="">Seleccione una etapa</option>
                                        <option value="Recepción">Recepción</option>
                                        <option value="Producción">Producción</option>
                                        <option value="Secado">Secado</option>
                                        <option value="Tostado">Tostado</option>
                                        <option value="Molido">Molido</option>
                                        <option value="Empaque">Empaque</option>
                                        <option value="Almacenamiento">Almacenamiento</option>
                                    </select>
                                    <span asp-validation-for="Etapa" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="LoteId" class="form-label">
                                        <i class="fa-solid fa-layer-group label-icon"></i>
                                        Lote
                                    </label>
                                    <select asp-for="LoteId" class="form-select" asp-items="ViewBag.LoteId">
                                        <option value="">Seleccione un lote</option>
                                    </select>
                                    <span asp-validation-for="LoteId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ProduccionId" class="form-label">
                                        <i class="fa-solid fa-industry label-icon"></i>
                                        Producción asociada
                                    </label>
                                    <select asp-for="ProduccionId" class="form-select" asp-items="ViewBag.ProduccionId">
                                        <option value="">Seleccione una producción</option>
                                    </select>
                                    <span asp-validation-for="ProduccionId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Etapa" class="form-label">
                                        <i class="fa-solid fa-bars-progress label-icon"></i>
                                        Etapa
                                    </label>
                                    <select asp-for="Etapa" class="form-select">
                                        <option value="">Seleccione una etapa</option>
                                        <option value="Recepción">Recepción</option>
                                        <option value="Producción">Producción</option>
                                        <option value="Secado">Secado</option>
                                        <option value="Tostado">Tostado</option>
                                        <option value="Molido">Molido</option>
                                        <option value="Empaque">Empaque</option>
                                        <option value="Almacenamiento">Almacenamiento</option>
                                    </select>
                                    <span asp-validation-for="Etapa" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="FechaRegistro" class="form-label">
                                        <i class="fa-regular fa-calendar-days label-icon"></i>
                                        Fecha de registro
                                    </label>
                                    <input asp-for="FechaRegistro" type="datetime-local" class="form-control"
                                           min="@(Model.FechaRegistro.Date >= DateTime.Today ? DateTime.Today.ToString("yyyy-MM-ddTHH:mm") : string.Empty)"
                                           data-no-past-date="true"
                                           data-today="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           data-original-date="@Model.FechaRegistro.ToString("yyyy-MM-dd")"
                                           data-date-message="No puede seleccionar una fecha anterior a hoy." />
                                    <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="Responsable" class="form-label">
                                        <i class="fa-regular fa-user label-icon"></i>
                                        Responsable
                                    </label>
                                    <input asp-for="Responsable" class="form-control" maxlength="100" required
                                           data-not-whitespace="true"
                                           data-whitespace-message="El responsable no puede contener únicamente espacios."
                                           placeholder="Nombre del responsable" />
                                    <span asp-validation-for="Responsable" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="Observacion" class="form-label">
                                        <i class="fa-regular fa-comment-dots label-icon"></i>
                                        Observación
                                    </label>
                                    <textarea asp-for="Observacion" class="form-control" rows="4" placeholder="Detalle adicional del seguimiento"></textarea>
                                    <span asp-validation-for="Observacion" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="EstiloEditaR-actions">
                    <a asp-action="Index" class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                    <button type="submit" class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}