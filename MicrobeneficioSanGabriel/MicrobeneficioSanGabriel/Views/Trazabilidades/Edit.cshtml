@model MicrobeneficioSanGabriel.Models.Trazabilidad

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Edit</h1>

<h4>Trazabilidad</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="LoteId" class="control-label"></label>

                <select asp-for="LoteId"
                        class="form-control"
                        asp-items="ViewBag.LoteId">
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ProduccionId" class="control-label"></label>

                <select asp-for="ProduccionId"
                        class="form-control"
                        asp-items="ViewBag.ProduccionId">
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Etapa" class="control-label"></label>

                <input asp-for="Etapa" class="form-control" />

                <span asp-validation-for="Etapa" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaRegistro" class="control-label"></label>

                <input asp-for="FechaRegistro" class="form-control" />

                <span asp-validation-for="FechaRegistro" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Responsable" class="control-label"></label>

                <input asp-for="Responsable" class="form-control" />

                <span asp-validation-for="Responsable" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Observacion" class="control-label"></label>

                <input asp-for="Observacion" class="form-control" />

                <span asp-validation-for="Observacion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}