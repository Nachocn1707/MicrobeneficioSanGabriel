@model MicrobeneficioSanGabriel.Models.Producto

@{
    ViewData["Title"] = "Detalles del producto";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    body,
    .admin-main,
    .admin-content {
        background: #fff8df !important;
    }

    .producto-detalle-page {
        padding: 32px;
        min-height: calc(100vh - 90px);
    }

    .producto-header {
        margin-bottom: 24px;
    }

        .producto-header h1 {
            color: #2b160d;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .producto-header p {
            color: #6f5b4a;
            margin: 0;
        }

    .producto-card {
        max-width: 980px;
        background: #fffdf2;
        border: 1px solid #ead8a2;
        border-top: 6px solid #f3d27a;
        border-radius: 18px;
        box-shadow: 0 16px 34px rgba(74, 44, 26, 0.14);
        overflow: hidden;
    }

    .producto-card-header {
        background: linear-gradient(90deg, #4a2c1a, #7a5230);
        color: #fff8df;
        padding: 24px 30px;
    }

        .producto-card-header h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
        }

        .producto-card-header span {
            color: #fff3c4;
            font-size: 14px;
        }

    .producto-card-body {
        padding: 30px;
    }

    .detalle-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .detalle-item {
        background: #fff8df;
        border: 1px solid #ead8a2;
        border-radius: 14px;
        padding: 16px 18px;
    }

        .detalle-item.full {
            grid-column: 1 / -1;
        }

    .detalle-label {
        display: block;
        color: #7a5230;
        font-weight: 800;
        font-size: 13px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .detalle-value {
        color: #2b160d;
        font-size: 17px;
        font-weight: 600;
    }

    .estado-activo {
        display: inline-block;
        background: #f3d27a;
        color: #2b160d;
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: 800;
    }

    .estado-inactivo {
        display: inline-block;
        background: #ead8a2;
        color: #6f5b4a;
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: 800;
    }

    .producto-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 26px;
        padding-top: 22px;
        border-top: 1px solid #ead8a2;
    }

    .btn-editar {
        background: #4a2c1a;
        border: 1px solid #4a2c1a;
        color: #fff8df;
        font-weight: 800;
        border-radius: 10px;
        padding: 10px 22px;
        text-decoration: none;
    }

        .btn-editar:hover {
            background: #2b160d;
            border-color: #2b160d;
            color: #fff8df;
        }

    .btn-volver {
        background: #fff3c4;
        border: 1px solid #d8bd77;
        color: #4a2c1a;
        font-weight: 800;
        border-radius: 10px;
        padding: 10px 22px;
        text-decoration: none;
    }

        .btn-volver:hover {
            background: #f3d27a;
            color: #2b160d;
        }

    @@media (max-width: 768px) {
        .producto-detalle-page {
            padding: 20px;
        }

        .producto-card-body {
            padding: 22px;
        }

        .detalle-grid {
            grid-template-columns: 1fr;
        }

        .producto-actions {
            flex-direction: column-reverse;
        }

        .btn-editar,
        .btn-volver {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="producto-detalle-page">

    <div class="producto-header">
        <h1>Detalles del producto</h1>
        <p>Información registrada para este producto del microbeneficio.</p>
    </div>

    <div class="producto-card">
        <div class="producto-card-header">
            <h2>@Model.Nombre</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="producto-card-body">
            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">Nombre</span>
                    <span class="detalle-value">@Model.Nombre</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Categoría</span>
                    <span class="detalle-value">@Model.Categoria</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Precio</span>
                    <span class="detalle-value">₡ @Model.Precio.ToString("N2")</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Stock</span>
                    <span class="detalle-value">@Model.Stock unidades</span>
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">Descripción</span>
                    <span class="detalle-value">@Model.Descripcion</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Estado</span>

                    @if (Model.Activo)
                    {
                        <span class="estado-activo">Activo</span>
                    }
                    else
                    {
                        <span class="estado-inactivo">Inactivo</span>
                    }
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Fecha de registro</span>
                    <span class="detalle-value">@Model.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</span>
                </div>

            </div>

            <div class="producto-actions">
                <a asp-action="Index" class="btn-volver">
                    Volver a la lista
                </a>

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-editar">
                    Editar
                </a>
            </div>
        </div>
    </div>

</div>