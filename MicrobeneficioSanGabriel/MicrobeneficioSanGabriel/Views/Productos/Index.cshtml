@model IEnumerable<MicrobeneficioSanGabriel.Models.Producto>
@{
    ViewData["Title"] = "Productos";
    Layout = User.IsInRole("Cliente") ? "~/Views/Shared/_ClienteLayout.cshtml" : "~/Views/Shared/_AdminLayout.cshtml";

    var productos = Model?.ToList() ?? new List<MicrobeneficioSanGabriel.Models.Producto>();
    var activos = productos.Count(p => p.Activo);
    var stockTotal = productos.Sum(p => p.Stock);
    var stockBajo = productos.Count(p => p.Stock <= p.StockMinimo);

    string ImagenProducto(string nombre)
    {
        var valor = (nombre ?? string.Empty).ToLowerInvariant();
        if (valor.Contains("premium")) return "/images/products/cafe-premium.jpg";
        if (valor.Contains("normal")) return "/images/products/cafe-normal.jpg";
        return "/images/products/default-coffee.jpg";
    }
}

<div class="sg-visual-hero sg-hero-productos">
    <div class="sg-visual-hero-content">
        <span class="sg-visual-badge"><i class="fa-solid fa-mug-hot"></i> Catálogo del café</span>
        <h1>@(User.IsInRole("Cliente") ? "Elegí tu café" : "Productos")</h1>
        <div class="sg-visual-line"></div>
        <p>@(User.IsInRole("Cliente") ? "Explorá productos, precios y disponibilidad antes de realizar tu pedido." : "Administrá productos, precios, categorías, stock disponible y estado comercial.")</p>
    </div>
</div>

@if (User.IsInRole("Cliente"))
{
    <section class="rc-client-panel mb-4">
        <div class="rc-panel-head">
            <div>
                <span class="rc-section-label">Catálogo San Gabriel</span>
                <h3>Café artesanal disponible</h3>
                <p>Productos activos con información de precio, categoría y existencias.</p>
            </div>
            <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline-dark"><i class="fa-solid fa-clipboard-list me-2"></i>Mis pedidos</a>
        </div>

        <div class="rc-client-products">
            @foreach (var item in productos.Where(p => p.Activo))
            {
                <article class="rc-client-product">
                    <img src="@ImagenProducto(item.Nombre)" alt="@item.Nombre" />
                    <div class="rc-client-product-body">
                        <span class="rc-product-category">@item.Categoria</span>
                        <h3>@item.Nombre</h3>
                        <p>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Café procesado por Microbeneficio San Gabriel con calidad y trazabilidad." : item.Descripcion)</p>
                        <div class="rc-client-product-footer">
                            <strong>₡ @item.Precio.ToString("N0")</strong>
                            <span class="rc-status-tag">@item.Stock kg</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <a asp-controller="Pedidos" asp-action="Create" asp-route-productoId="@item.Id" class="btn btn-primary"><i class="fa-solid fa-cart-plus me-2"></i>Realizar pedido</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark"><i class="fa-solid fa-eye me-2"></i>Detalles</a>
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (!productos.Any(p => p.Activo))
        {
            <div class="text-muted text-center py-5">No hay productos activos disponibles.</div>
        }
    </section>
}
else
{
    <section class="rc-dashboard-kpis mb-4">
        <article class="rc-dashboard-kpi"><i class="fa-solid fa-mug-hot"></i><strong>@productos.Count</strong><span>Productos registrados</span></article>
        <article class="rc-dashboard-kpi"><i class="fa-solid fa-circle-check"></i><strong>@activos</strong><span>Productos activos</span></article>
        <article class="rc-dashboard-kpi"><i class="fa-solid fa-boxes-stacked"></i><strong>@stockTotal kg</strong><span>Stock total</span></article>
        <article class="rc-dashboard-kpi"><i class="fa-solid fa-triangle-exclamation"></i><strong>@stockBajo</strong><span>Alertas de stock</span></article>
    </section>

    <section class="rc-dashboard-panel">
        <div class="rc-panel-head">
            <div><h3>Catálogo administrativo</h3><p>Control de productos, precios, existencias y publicación.</p></div>
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Nuevo producto</a>
            }
        </div>

        <div class="table-responsive">
            <table id="tablaProductos" class="table align-middle w-100">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in productos)
                    {
                        <tr>
                            <td><strong>@item.Nombre</strong><br /><small class="text-muted">@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)</small></td>
                            <td>@item.Categoria</td>
                            <td>₡ @item.Precio.ToString("N2")</td>
                            <td><span class="badge @(item.Stock <= item.StockMinimo ? "bg-danger" : "bg-success")">@item.Stock kg</span></td>
                            <td><span class="badge @(item.Activo ? "bg-success" : "bg-danger")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                            <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="fa-solid fa-eye"></i><span class="ms-1">Detalles</span></a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning"><i class="fa-solid fa-pen"></i><span class="ms-1">Editar</span></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i><span class="ms-1">Eliminar</span></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@section Scripts {
    @if (!User.IsInRole("Cliente"))
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                if (window.jQuery && jQuery.fn.DataTable) {
                    jQuery('#tablaProductos').DataTable({
                        language: { url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                        pageLength: 5,
                        lengthMenu: [5, 10, 15, 20],
                        responsive: true
                    });
                }
            });
        </script>
    }
}
