@model IEnumerable<MicrobeneficioSanGabriel.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Productos</h1>
        <p>Gestión de productos registrados en el microbeneficio.</p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Nuevo Producto
    </a>
</div>

<div class="admin-card">

    <table class="table table-admin align-middle">

        <thead>
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th width="220">Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        <strong>@item.Nombre</strong>
                    </td>

                    <td>
                        @item.Categoria
                    </td>

                    <td>
                        ₡ @item.Precio.ToString("N2")
                    </td>

                    <td>

                        @if (item.Stock <= item.StockMinimo)
                        {
                            <span class="badge bg-danger">
                                Stock Bajo (@item.Stock)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                @item.Stock unidades
                            </span>
                        }

                    </td>

                    <td>
                        @if (item.Activo)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        }
                    </td>

                    <td>
                        @item.FechaRegistro.ToShortDateString()
                    </td>

                    <td>

                        @if (User.IsInRole("Administrador"))
                        {
                        <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                Editar
                            </a>
                        }

                        <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm text-white">
                            Detalles
                        </a>

                        @if (User.IsInRole("Administrador"))
                        {
                        <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                Eliminar
                            </a>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>