@model IEnumerable<MicrobeneficioSanGabriel.Models.Producto>
@{
    ViewData["Title"] = "Productos";
    Layout = User.IsInRole("Cliente") ? "~/Views/Shared/_ClienteLayout.cshtml" : "~/Views/Shared/_AdminLayout.cshtml";

    var productos = Model?.ToList() ?? new List<MicrobeneficioSanGabriel.Models.Producto>();
    var activos = productos.Count(p => p.Activo);
    var stockTotal = productos.Sum(p => p.Stock);
    var stockBajo = productos.Count(p => p.Stock <= p.StockMinimo);

    string ImagenProducto(MicrobeneficioSanGabriel.Models.Producto producto)
    {
        if (!string.IsNullOrWhiteSpace(producto.ImagenUrl)) return producto.ImagenUrl;

        var valor = (producto.Nombre ?? string.Empty).ToLowerInvariant();
        if (valor.Contains("premium")) return "/images/products/cafe-premium.jpg";
        if (valor.Contains("normal")) return "/images/products/cafe-normal.jpg";
        return "/images/products/default-coffee.jpg";
    }
}

@if (User.IsInRole("Cliente"))
{
    <div class="sg-page-head">
        <div>
            <h1>Elegí tu café</h1>
            <p>Explorá productos, precios y disponibilidad antes de realizar tu pedido.</p>
        </div>
        <div class="sg-actions">
            <a asp-controller="Pedidos" asp-action="Index" class="sg-btn ghost"><i class="fa-solid fa-clipboard-list"></i>Mis pedidos</a>
        </div>
    </div>

    <section class="sg-grid-3">
        @foreach (var item in productos.Where(p => p.Activo))
        {
            <article class="sg-card sg-product-card">
                <div class="sg-product-media" aria-label="Imagen de @item.Nombre">
                    <img src="@ImagenProducto(item)" alt="@item.Nombre" loading="lazy" />
                </div>
                <div class="sg-product-body">
                    <span class="sg-badge gold">@item.Categoria</span>
                    <h3>@item.Nombre</h3>
                    <p>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Café procesado por Microbeneficio San Gabriel con calidad y trazabilidad." : item.Descripcion)</p>
                    <div class="sg-product-footer">
                        <strong>₡ @item.Precio.ToString("N0")</strong>
                        <span class="sg-badge">@item.Stock kg</span>
                    </div>
                    <div class="sg-actions mt-3">
                        <a asp-controller="Pedidos" asp-action="Create" asp-route-productoId="@item.Id" class="sg-btn gold"><i class="fa-solid fa-cart-plus"></i>Realizar pedido</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="sg-btn ghost"><i class="fa-solid fa-eye"></i>Detalles</a>
                    </div>
                </div>
            </article>
        }
    </section>

    @if (!productos.Any(p => p.Activo))
    {
        <div class="sg-card sg-panel text-center py-5 text-muted">No hay productos activos disponibles.</div>
    }
}
else
{
    <div class="sg-page-head">
        <div>
            <h1>Productos</h1>
            <p>Administrá productos, precios, categorías, stock disponible y estado comercial.</p>
        </div>
        <div class="sg-actions">
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Create" class="sg-btn gold"><i class="fa-solid fa-plus"></i>Nuevo producto</a>
            }
            <label class="sg-search" for="sgProductSearch"><i class="fa-solid fa-magnifying-glass"></i><input id="sgProductSearch" type="search" placeholder="Buscar producto..." /></label>
        </div>
    </div>

    <section class="sg-hero sg-product-hero" style="background-image:url('/images/visual/productos.jpg')">
        <div class="sg-hero-content">
            <span class="sg-visual-badge"><i class="fa-solid fa-mug-hot"></i> Catálogo del café</span>
            <h2>Catálogo administrativo</h2>
            <p>Control de productos, existencias, precios y publicación comercial.</p>
        </div>
    </section>

    <section class="sg-kpi-grid mb-3">
        <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-mug-hot"></i></span><div><span>Productos registrados</span><strong>@productos.Count</strong><div class="sg-trend">Catálogo activo</div></div></article>
        <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-circle-check"></i></span><div><span>Productos activos</span><strong>@activos</strong><div class="sg-trend">Disponibles para venta</div></div></article>
        <article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-boxes-stacked"></i></span><div><span>Stock total</span><strong>@stockTotal kg</strong><div class="sg-trend warn">Inventario actual</div></div></article>
        <article class="sg-card sg-kpi"><span class="sg-icon brown"><i class="fa-solid fa-triangle-exclamation"></i></span><div><span>Alertas de stock</span><strong>@stockBajo</strong><div class="sg-trend @(stockBajo > 0 ? "down" : "")">@(stockBajo > 0 ? "Revisar mínimos" : "Sin alertas")</div></div></article>
    </section>

    <section class="sg-card sg-table-card">
        <div class="sg-panel-head">
            <div>
                <h2>Lista de productos</h2>
                <small>Productos registrados para venta, inventario y facturación.</small>
            </div>
            <span class="sg-badge">@productos.Count registro(s)</span>
        </div>

        <div class="table-responsive">
            <table id="tablaProductos" class="sg-table w-100">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in productos)
                    {
                        <tr>
                            <td>
                                <div class="sg-product-cell">
                                    <img src="@ImagenProducto(item)" alt="@item.Nombre" />
                                    <div><strong>@item.Nombre</strong><small>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)</small></div>
                                </div>
                            </td>
                            <td>@item.Categoria</td>
                            <td>₡ @item.Precio.ToString("N0")</td>
                            <td><span class="sg-badge @(item.Stock <= item.StockMinimo ? "red" : "")">@item.Stock kg</span></td>
                            <td><span class="sg-badge @(item.Activo ? "" : "red")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                            <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <div class="sg-action-icons justify-content-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" title="Detalles" aria-label="Detalles"><i class="fa-solid fa-eye"></i></a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" title="Editar" aria-label="Editar"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" title="Eliminar" aria-label="Eliminar"><i class="fa-solid fa-trash"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
