@model MicrobeneficioSanGabriel.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string imagenProducto;

    if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
    {
        imagenProducto = Model.ImagenUrl;
    }
    else
    {
        var nombreProducto = (Model.Nombre ?? "").ToLowerInvariant();

        if (nombreProducto.Contains("premium"))
        {
            imagenProducto = "/images/products/cafe-premium.jpg";
        }
        else if (nombreProducto.Contains("normal"))
        {
            imagenProducto = "/images/products/cafe-normal.jpg";
        }
        else
        {
            imagenProducto = "/images/products/default-coffee.jpg";
        }
    }

    string estadoClase = Model.Activo ? "text-success" : "text-danger";
    string estadoTexto = Model.Activo ? "Activo" : "Inactivo";
    bool stockBajo = Model.Stock <= Model.StockMinimo;
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEliminar.css" />
}

<div class="sg-card border-danger">
    <h1 class="text-danger">
        <i class="fa-solid fa-trash"></i>
        Eliminar producto
    </h1>

    <div class="product-image-container">
        <img src="@imagenProducto"
             alt="@Model.Nombre"
             class="product-image"
             onerror="this.src='/images/products/default-coffee.jpg'" />
    </div>

    <p>
        <strong>Nombre:</strong> @Model.Nombre<br />
        <strong>Categoría:</strong> @Model.Categoria<br />
        <strong>Precio:</strong> ₡ @Model.Precio.ToString("N0")<br />
        <strong>Stock:</strong>
        @if (stockBajo)
        {
            <span class="text-danger">@Model.Stock kg · ¡Stock bajo!</span>
        }
        else
        {
            <span class="text-success">@Model.Stock kg disponibles</span>
        }
        <br />
        <strong>Estado:</strong> <span class="@estadoClase">@estadoTexto</span><br />
        <strong>Fecha de registro:</strong> @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
    </p>

    <div class="alert alert-warning">
        <i class="fa-solid fa-circle-exclamation"></i>
        Esta acción eliminará el producto del catálogo de forma <strong>permanente</strong>.
        Los pedidos, movimientos de inventario, producciones, facturas y trazabilidades relacionados
        se conservarán con el nombre y el precio histórico del producto.
    </div>

    @if (!Model.Activo)
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-check-circle"></i>
            Este producto ya se encuentra inactivo. Al eliminarlo, su historial relacionado se conservará.
        </div>
    }

    @if (stockBajo && Model.Activo)
    {
        <div class="alert alert-warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <strong>Stock bajo:</strong> Este producto tiene @Model.Stock kg disponibles,
            por debajo del mínimo de @Model.StockMinimo kg.
        </div>
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
            <button class="btn btn-danger" type="submit">
                <i class="fa-solid fa-trash"></i> Confirmar eliminación
            </button>
        </div>
    </form>
</div>