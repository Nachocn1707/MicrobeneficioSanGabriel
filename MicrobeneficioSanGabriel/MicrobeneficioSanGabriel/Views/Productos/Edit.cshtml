@model MicrobeneficioSanGabriel.Models.Producto

@{
    ViewData["Title"] = "Editar producto";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditar-edit-page">

    <div class="EstiloEditar-header">
        <h1>Editar producto</h1>
        <p>Actualizá los datos del producto registrado.</p>
    </div>

    <div class="EstiloEditar-card">

        <div class="EstiloEditar-card-header">
            <h2>@Model.Nombre</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloEditar-card-body">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label">
                            Nombre
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               placeholder="Ej: Café Normal" />

                        <span asp-validation-for="Nombre"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Categoria" class="form-label">
                            Categoría
                        </label>

                        <select asp-for="Categoria" class="form-select">
                            <option value="">-- Seleccione una categoría -- </option>
                            <option value="Caturra"> Caturra</option>
                            <option value="Catuaí">Catuaí</option>
                        </select>

                        <span asp-validation-for="Categoria"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Precio" class="form-label">
                            Precio
                        </label>

                        <input asp-for="Precio"
                               class="form-control"
                               min="0"
                               placeholder="Digite el precio del producto" />

                        <span asp-validation-for="Precio"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Stock" class="form-label">
                            Stock disponible
                        </label>

                        <input asp-for="Stock"
                               class="form-control"
                               min="0"
                               placeholder="Digite el stock en kg" />

                        <span asp-validation-for="Stock"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StockMinimo" class="form-label">
                            Stock mínimo
                        </label>

                        <input asp-for="StockMinimo"
                               class="form-control"
                               min="0"
                               placeholder="Cantidad mínima antes de alerta" />

                        <span asp-validation-for="StockMinimo"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaRegistro" class="form-label">
                            Fecha de registro
                        </label>

                        <input asp-for="FechaRegistro"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FechaRegistro"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label">
                            Descripción
                        </label>

                        <input asp-for="Descripcion"
                               class="form-control"
                               placeholder="Descripcion del producto" />

                        <span asp-validation-for="Descripcion"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input"
                                   asp-for="Activo" />

                            <label class="form-check-label"
                                   asp-for="Activo">
                                Producto activo
                            </label>
                        </div>
                    </div>

                </div>

                <div class="EstiloEditar-actions">

                    <a asp-action="Index"
                           class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver a la lista
                    </a>

                    <button type="submit"
                            class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}