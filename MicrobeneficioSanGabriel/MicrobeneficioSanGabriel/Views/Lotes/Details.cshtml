@model MicrobeneficioSanGabriel.Models.Lote

@{
    ViewData["Title"] = "Detalle del lote";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string estadoClase = Model.Estado == "Activo"
        ? "estado-activo"
        : "estado-inactivo";
}

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalle del lote</h1>
        <p>Información registrada del lote en el sistema.</p>
    </div>

    <div class="EstiloDetalle-card">

        <div class="EstiloDetalle-card-header">
            <h2>@Model.CodigoLote</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">

            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">
                        Código de lote
                    </span>

                    <span class="detalle-value">
                        @Model.CodigoLote
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Productor
                    </span>

                    <span class="detalle-value">
                        @(Model.Productor?.Nombre ?? "Sin productor")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Cédula productor
                    </span>

                    <span class="detalle-value">
                        @(Model.Productor?.Cedula ?? "Sin cédula")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Peso recibido
                    </span>

                    <span class="detalle-value">
                        @Model.PesoKg kg
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Fecha de recepción
                    </span>

                    <span class="detalle-value">
                        @Model.FechaRecepcion.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Estado
                    </span>

                    <span class="@estadoClase">
                        @Model.Estado
                    </span>
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">
                        Observación
                    </span>

                    <span class="detalle-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-volver">
                    Volver
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-editar">
                        Editar
                    </a>
                }
            </div>
        </div>
    </div>
</div>