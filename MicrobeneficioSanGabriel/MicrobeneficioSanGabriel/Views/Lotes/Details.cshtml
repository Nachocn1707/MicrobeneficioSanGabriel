@model MicrobeneficioSanGabriel.Models.Lote

@{
    ViewData["Title"] = "Detalles de los lotes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalle del lote</h1>
        <p>Información registrada del lote en el microbeneficio.</p>
    </div>

    <div class="EstiloDetalle-card">

        <div class="EstiloDetalle-card-header">
            <h2>@Model.CodigoLote</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">

            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">
                        Código de lote
                    </span>

                    <span class="detalle-value">
                        @Model.CodigoLote
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Productor
                    </span>

                    <span class="detalle-value">
                        @Model.Productor?.Cedula
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Peso
                    </span>

                    <span class="detalle-value">
                        @Model.PesoKg kg
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Fecha de recepción
                    </span>

                    <span class="detalle-value">
                        @Model.FechaRecepcion.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Estado
                    </span>

                    @if (Model.Estado == "Activo")
                    {
                        <span class="estado-activo">
                            @Model.Estado
                        </span>
                    }
                    else
                    {
                        <span class="estado-inactivo">
                            @Model.Estado
                        </span>
                    }
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">
                        Observación
                    </span>

                    <span class="detalle-value">
                        @(Model.Observacion ?? "Sin observación")
                    </span>
                </div>
            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-volver">
                    Volver a la lista
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model?.Id"
                       class="btn-editar">
                        Editar
                    </a>
                }
            </div>
        </div>
    </div>
</div>
