@model IEnumerable<MicrobeneficioSanGabriel.Models.Lote>

@{
    ViewData["Title"] = "Lotes";

    <div class="sg-visual-hero sg-hero-lotes">
        <div class="sg-visual-hero-content">
            <span class="sg-visual-badge">
                <i class="fa-solid fa-layer-group"></i>
                Recepción de café
            </span>

            <h1>Lotes recibidos</h1>
            <div class="sg-visual-line"></div>

            <p>
                Visualizá el origen, peso, productor y estado de cada lote registrado.
            </p>
        </div>
    </div>

    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int totalLotes = Model.Count();
    int lotesRecibidos = Model.Count(l => l.Estado == "Recibido");
    int lotesProceso = Model.Count(l => l.Estado == "En proceso");
    int lotesFinalizados = Model.Count(l => l.Estado == "Finalizado");
    double totalPeso = Model.Sum(l => l.PesoKg);
}

@section Styles {
    <style>
        .lotes-page {
            display: grid;
            gap: 24px;
            padding-top: 10px;
        }

        .lotes-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

            .lotes-header h1 {
                font-size: 2.35rem;
                font-weight: 950;
                margin: 0;
                color: #2b160d;
            }

        .lotes-title-line {
            width: 76px;
            height: 4px;
            background: #d8b36a;
            border-radius: 999px;
            margin: 12px 0;
        }

        .lotes-header p {
            color: #6f5b4a;
            font-weight: 650;
            margin: 0;
        }

        .btn-nuevo-lote {
            background: #198754;
            color: #fff;
            border-radius: 13px;
            padding: 11px 18px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 12px 28px rgba(25, 135, 84, 0.18);
            transition: 0.18s ease;
        }

            .btn-nuevo-lote:hover {
                background: #157347;
                color: #fff;
                transform: translateY(-1px);
            }

        .lotes-alert {
            border: none;
            border-radius: 18px;
            padding: 15px 18px;
            font-weight: 750;
            box-shadow: 0 12px 28px rgba(58, 33, 20, 0.08);
        }

        .lotes-summary-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 18px;
        }

        .lote-summary-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 22px;
            padding: 20px;
            box-shadow: 0 16px 36px rgba(58, 33, 20, 0.08);
            position: relative;
            overflow: hidden;
        }

            .lote-summary-card::after {
                content: "";
                position: absolute;
                right: -32px;
                bottom: -36px;
                width: 110px;
                height: 110px;
                background: rgba(243, 210, 122, 0.22);
                border-radius: 50%;
            }

        .lote-summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #fff2d5;
            color: #a66b20;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            font-size: 18px;
        }

        .lote-summary-label {
            color: #7a6a5d;
            font-weight: 850;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .lote-summary-value {
            color: #2b160d;
            font-size: 1.65rem;
            font-weight: 950;
            line-height: 1.15;
        }

        .lotes-table-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 24px;
            box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
            padding: 18px;
            overflow: hidden;
        }

            .lotes-table-card table {
                margin-bottom: 0;
            }

                .lotes-table-card table thead th {
                    background: #1f2937 !important;
                    color: #fff !important;
                    border: none !important;
                    padding: 15px 14px !important;
                    font-weight: 900;
                    vertical-align: middle;
                }

                    .lotes-table-card table thead th:first-child {
                        border-top-left-radius: 13px;
                    }

                    .lotes-table-card table thead th:last-child {
                        border-top-right-radius: 13px;
                    }

                .lotes-table-card table tbody td {
                    padding: 16px 14px !important;
                    vertical-align: middle;
                    border-bottom: 1px solid #ece2cf;
                }

                .lotes-table-card table tbody tr:hover {
                    background: rgba(243, 210, 122, 0.12);
                }

        .lote-codigo {
            font-weight: 950;
            color: #2b160d;
        }

        .lote-productor {
            font-weight: 850;
            color: #2b160d;
        }

            .lote-productor small {
                color: #7a6a5d;
                font-weight: 700;
            }

        .lote-peso {
            font-weight: 950;
            color: #2b160d;
            white-space: nowrap;
        }

        .lote-observacion {
            max-width: 280px;
            color: #5f5147;
            font-weight: 650;
            line-height: 1.35;
        }

        .lote-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

            .lote-actions .btn {
                border-radius: 10px;
                font-weight: 850;
                padding: 8px 11px;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

        .lote-estado {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: 0.8rem;
            font-weight: 950;
            white-space: nowrap;
        }

        .lote-estado-recibido {
            background: #dff6fd;
            color: #0369a1;
        }

        .lote-estado-proceso {
            background: #fff4d3;
            color: #8a6500;
        }

        .lote-estado-finalizado {
            background: #dff5e3;
            color: #1e7d32;
        }

        .lote-estado-cancelado {
            background: #fde1df;
            color: #b42318;
        }

        .lote-estado-neutral {
            background: #e9ecef;
            color: #495057;
        }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 15px;
            color: #2b160d;
            font-weight: 700;
        }

            .dataTables_wrapper .dataTables_filter input,
            .dataTables_wrapper .dataTables_length select {
                border: 1px solid #d9c8ab;
                border-radius: 10px;
                padding: 7px 10px;
                background: white;
            }

        .dataTables_wrapper .dataTables_info {
            color: #6f5b4a;
            font-weight: 650;
            margin-top: 14px;
        }

        .dataTables_wrapper .dataTables_paginate {
            margin-top: 14px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border-radius: 10px !important;
            }

        @@media (max-width: 1400px) {
            .lotes-summary-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 900px) {
            .lotes-summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .lotes-header {
                flex-direction: column;
            }
        }

        @@media (max-width: 650px) {
            .lotes-summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="lotes-page">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show lotes-alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show lotes-alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="lotes-header">
        <div>
            <h1></h1>
            <div class="lotes-title-line"></div>
            <p>
            </p>
        </div>
    </div>

    <section class="lotes-summary-grid">

        <div class="lote-summary-card">
            <div class="lote-summary-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div class="lote-summary-label">Lotes registrados</div>
            <div class="lote-summary-value">@totalLotes</div>
        </div>

        <div class="lote-summary-card">
            <div class="lote-summary-icon">
                <i class="fa-solid fa-truck-ramp-box"></i>
            </div>
            <div class="lote-summary-label">Recibidos</div>
            <div class="lote-summary-value">@lotesRecibidos</div>
        </div>

        <div class="lote-summary-card">
            <div class="lote-summary-icon">
                <i class="fa-solid fa-gears"></i>
            </div>
            <div class="lote-summary-label">En proceso</div>
            <div class="lote-summary-value">@lotesProceso</div>
        </div>

        <div class="lote-summary-card">
            <div class="lote-summary-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="lote-summary-label">Finalizados</div>
            <div class="lote-summary-value">@lotesFinalizados</div>
        </div>

        <div class="lote-summary-card">
            <div class="lote-summary-icon">
                <i class="fa-solid fa-weight-hanging"></i>
            </div>
            <div class="lote-summary-label">Peso total recibido</div>
            <div class="lote-summary-value">@totalPeso.ToString("N2") kg</div>
        </div>

    </section>

    <div class="lotes-table-card">

        <div class="table-responsive">

            <table id="tablaLotes" class="table align-middle">

                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Productor</th>
                        <th>Peso</th>
                        <th>Fecha recepción</th>
                        <th>Estado</th>
                        <th>Observación</th>
                        <th width="280">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        string estadoClase = item.Estado switch
                        {
                            "Recibido" => "lote-estado lote-estado-recibido",
                            "En proceso" => "lote-estado lote-estado-proceso",
                            "Finalizado" => "lote-estado lote-estado-finalizado",
                            "Cancelado" => "lote-estado lote-estado-cancelado",
                            _ => "lote-estado lote-estado-neutral"
                        };

                        <tr>
                            <td class="lote-codigo">
                                @item.CodigoLote
                            </td>

                            <td class="lote-productor">
                                @(item.Productor != null ? item.Productor.Nombre : "Sin productor")
                                <br />
                                <small>
                                    @(item.Productor != null ? item.Productor.Cedula : "Sin cédula")
                                </small>
                            </td>

                            <td class="lote-peso">
                                @item.PesoKg kg
                            </td>

                            <td>
                                @item.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <span class="@estadoClase">
                                    @item.Estado
                                </span>
                            </td>

                            <td class="lote-observacion">
                                @(string.IsNullOrWhiteSpace(item.Observacion)
                                    ? "Sin observación"
                                    : item.Observacion)
                            </td>

                            <td>
                                <div class="lote-actions">

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            Editar
                                        </a>
                                    }

                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">
                                        <i class="fa-solid fa-eye"></i>
                                        Detalles
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-trash"></i>
                                            Eliminar
                                        </a>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaLotes').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20],
                responsive: true
            });
        });
    </script>
}