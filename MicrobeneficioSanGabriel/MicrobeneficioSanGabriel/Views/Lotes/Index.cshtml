@model IEnumerable<MicrobeneficioSanGabriel.Models.Lote>
@{
    ViewData["Title"] = "Lotes y Producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var lotes = Model.ToList();
    var total = lotes.Count;
    var activos = lotes.Count(l => l.Estado != "Cancelado" && l.Estado != "Finalizado");
    var finalizados = lotes.Count(l => l.Estado == "Finalizado");
    var cancelados = lotes.Count(l => l.Estado == "Cancelado");
    var enProceso = lotes.Count(l => (l.Estado ?? string.Empty).Contains("proceso", StringComparison.OrdinalIgnoreCase));
    var peso = lotes.Sum(l => l.PesoKg);
    decimal Porcentaje(int valor) => total == 0 ? 0 : Math.Round(valor * 100m / total, 0);
}
<section class="sg-page-head">
    <div><h1>Lotes y Producción</h1><p>Gestión integral de lotes y procesos de producción con datos reales del sistema.</p></div>
    <div class="sg-actions"><a asp-action="Create" class="sg-btn gold"><i class="fa-solid fa-plus"></i>Nuevo lote</a><a asp-controller="Producciones" asp-action="Create" class="sg-btn ghost"><i class="fa-solid fa-plus"></i>Registrar producción</a></div>
</section>
<section class="sg-kpi-grid">
    <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-layer-group"></i></span><div><span>Lotes totales</span><strong>@total</strong><div class="sg-trend">Registros en base de datos</div></div></article>
    <article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-arrows-rotate"></i></span><div><span>Lotes activos</span><strong>@activos</strong><div class="sg-trend">Recibido / En proceso</div></div></article>
    <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-weight-scale"></i></span><div><span>Peso recibido</span><strong>@peso.ToString("N0") kg</strong><div class="sg-trend">Suma real de lotes</div></div></article>
    <article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-circle-check"></i></span><div><span>Finalizados</span><strong>@finalizados</strong><div class="sg-trend">Según estado actual</div></div></article>
</section>
<section class="sg-grid-2">
    <article class="sg-card sg-panel">
        <div class="sg-panel-head"><h3>Estado de lotes</h3></div>
        <div class="sg-donut-wrap">
            <div class="sg-donut" style="--p:@Porcentaje(finalizados)"><div><b>@Porcentaje(finalizados)%</b><br/><span>Finalizados</span></div></div>
            <div class="sg-legend">
                <div class="sg-legend-row"><span class="sg-dot"></span><span>Finalizados</span><b>@finalizados</b></div>
                <div class="sg-legend-row"><span class="sg-dot gold"></span><span>En proceso</span><b>@enProceso</b></div>
                <div class="sg-legend-row"><span class="sg-dot tan"></span><span>Activos</span><b>@activos</b></div>
                <div class="sg-legend-row"><span class="sg-dot brown"></span><span>Cancelados</span><b>@cancelados</b></div>
            </div>
        </div>
    </article>
    <article class="sg-card sg-panel">
        <h3 class="mb-4">Resumen operativo</h3>
        <div class="sg-mini-list">
            <div class="sg-mini-row"><i class="fa-solid fa-layer-group text-success"></i><span>Total de lotes</span><b>@total</b></div>
            <div class="sg-mini-row"><i class="fa-solid fa-seedling text-success"></i><span>Productores con lote</span><b>@lotes.Where(l => l.ProductorId > 0).Select(l => l.ProductorId).Distinct().Count()</b></div>
            <div class="sg-mini-row"><i class="fa-solid fa-mountain-sun text-success"></i><span>Fincas con lote</span><b>@lotes.Where(l => l.FincaId.HasValue).Select(l => l.FincaId).Distinct().Count()</b></div>
            <div class="sg-mini-row"><i class="fa-solid fa-weight-scale text-success"></i><span>Peso promedio</span><b>@(total == 0 ? "0" : (peso / total).ToString("N1")) kg</b></div>
        </div>
    </article>
</section>
<section class="sg-card sg-table-card">
    <div class="sg-panel-head"><h3>Lotes registrados</h3><span class="sg-badge">@total registro(s)</span></div>
    <div class="table-responsive">
        <table class="sg-table" id="tablaLotes">
            <thead><tr><th>Código</th><th>Productor</th><th>Finca</th><th>Cantidad</th><th>Estado</th><th>Fecha</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var l in lotes)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(l.CodigoLote) ? $"LO-{l.Id:0000}" : l.CodigoLote)</td>
                        <td>@l.Productor?.Nombre</td>
                        <td>@l.Finca?.Nombre</td>
                        <td>@l.PesoKg.ToString("N0") kg</td>
                        <td><span class="sg-badge @((l.Estado ?? string.Empty).Contains("Finalizado") ? "" : (l.Estado ?? string.Empty).Contains("Cancelado") ? "brown" : "gold")">@l.Estado</span></td>
                        <td>@l.FechaRecepcion.ToString("dd MMM yyyy")</td>
                        <td><span class="sg-action-icons"><a asp-action="Details" asp-route-id="@l.Id"><i class="fa-solid fa-eye"></i></a>@if(User.IsInRole("Administrador") || User.IsInRole("Operador")){<a asp-action="Edit" asp-route-id="@l.Id" title="Cambiar/editar"><i class="fa-solid fa-pen"></i></a>}@if(User.IsInRole("Administrador")){<a asp-action="Delete" asp-route-id="@l.Id"><i class="fa-solid fa-trash"></i></a>}</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
