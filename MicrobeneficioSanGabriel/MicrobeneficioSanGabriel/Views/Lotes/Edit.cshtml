@model MicrobeneficioSanGabriel.Models.Lote
@{
    ViewData["Title"] = "Editar lote";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var soloEstado = (bool?)ViewBag.SoloEstado ?? false;
}
<div class="sg-visual-hero sg-hero-lotes">
    <div class="sg-visual-hero-content">
        <span class="sg-visual-badge"><i class="fa-solid fa-pen"></i> Lote</span>
        <h1>@(soloEstado ? "Cambiar estado" : "Editar") @Model.CodigoLote</h1>
        <div class="sg-visual-line"></div>
        <p>@(soloEstado ? "Como operador solo podés actualizar el estado del lote." : "El código permanece protegido para conservar la trazabilidad.")</p>
    </div>
</div>
<div class="sg-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        @if (soloEstado)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label">Código de lote</label>
                    <input value="@Model.CodigoLote" class="form-control" readonly />
                </div>
                <div class="col-md-6">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" class="form-select">
                        <option value="Recibido">Recibido</option>
                        <option value="En proceso">En proceso</option>
                        <option value="Finalizado">Finalizado</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                    <small class="text-muted">Los demás datos del lote quedan protegidos.</small>
                </div>
            </div>
        }
        else
        {
            <partial name="_Form" model="Model" />
        }
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Guardar cambios</button>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
