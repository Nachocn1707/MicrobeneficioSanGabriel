@model MicrobeneficioSanGabriel.Models.Lote
@{ ViewData["Title"]="Editar lote"; Layout="~/Views/Shared/_AdminLayout.cshtml"; }
<div class="sg-visual-hero sg-hero-lotes"><div class="sg-visual-hero-content"><span class="sg-visual-badge"><i class="fa-solid fa-pen"></i> Lote</span><h1>Editar @Model.CodigoLote</h1><div class="sg-visual-line"></div><p>El código permanece protegido para conservar la trazabilidad.</p></div></div>
<div class="sg-card"><form asp-action="Edit" method="post"><input type="hidden" asp-for="Id"/><partial name="_Form" model="Model"/><div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Guardar cambios</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
