@model MicrobeneficioSanGabriel.Models.Lote
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-4">
    @if (Model.Id > 0)
    {
        <div class="col-md-6"><label class="form-label">Código generado</label><input value="@Model.CodigoLote" class="form-control" readonly /></div>
    }
    else
    {
        <div class="col-12"><div class="alert alert-info"><i class="fa-solid fa-wand-magic-sparkles me-2"></i>El código se generará automáticamente al guardar, por ejemplo: <strong>SG-2026-00015</strong>.</div></div>
    }
    <div class="col-md-6">
        <label asp-for="FincaId" class="form-label"></label>
        <select asp-for="FincaId" asp-items="ViewBag.FincaId" class="form-select"><option value="">Seleccione productor y finca</option></select>
        <span asp-validation-for="FincaId" class="text-danger"></span>
        <small class="text-muted">El productor se asigna automáticamente según la finca.</small>
    </div>
    <div class="col-md-3">
        <label asp-for="PesoKg" class="form-label"></label>
        <input asp-for="PesoKg" class="form-control" step="0.01" min="0.01" />
        <span asp-validation-for="PesoKg" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="FechaRecepcion" class="form-label"></label>
        <input asp-for="FechaRecepcion" class="form-control" type="datetime-local" />
        <span asp-validation-for="FechaRecepcion" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" class="form-select"><option value="Recibido">Recibido</option><option value="En proceso">En proceso</option><option value="Finalizado">Finalizado</option><option value="Cancelado">Cancelado</option></select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
    <div class="col-12"><label asp-for="Observacion" class="form-label"></label><textarea asp-for="Observacion" class="form-control" rows="3"></textarea><span asp-validation-for="Observacion" class="text-danger"></span></div>
</div>
