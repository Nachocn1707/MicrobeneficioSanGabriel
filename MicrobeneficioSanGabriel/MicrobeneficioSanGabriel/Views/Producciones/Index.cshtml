@model IEnumerable<MicrobeneficioSanGabriel.Models.Produccion>

@{
    ViewData["Title"] = "Producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int totalProducciones = Model.Count();
    int produccionesCompletadas = Model.Count(p => p.Estado == "Completado");
    int produccionesProceso = Model.Count(p => p.Estado == "En proceso");
    double totalProcesado = Model.Sum(p => p.CantidadProcesadaKg);
    double totalResultante = Model.Sum(p => p.CantidadResultanteKg);
}

@section Styles {
    <style>
        .produccion-page {
            display: grid;
            gap: 24px;
            padding-top: 10px;
        }

        .produccion-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

            .produccion-header h1 {
                font-size: 2.35rem;
                font-weight: 950;
                margin: 0;
                color: #2b160d;
            }

        .produccion-title-line {
            width: 76px;
            height: 4px;
            background: #d8b36a;
            border-radius: 999px;
            margin: 12px 0;
        }

        .produccion-header p {
            color: #6f5b4a;
            font-weight: 650;
            margin: 0;
        }

        .btn-nueva-produccion {
            background: #198754;
            color: #fff;
            border-radius: 13px;
            padding: 11px 18px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 12px 28px rgba(25, 135, 84, 0.18);
            transition: 0.18s ease;
        }

            .btn-nueva-produccion:hover {
                background: #157347;
                color: #fff;
                transform: translateY(-1px);
            }

        .produccion-summary-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 18px;
        }

        .produccion-summary-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 22px;
            padding: 20px;
            box-shadow: 0 16px 36px rgba(58, 33, 20, 0.08);
            position: relative;
            overflow: hidden;
        }

            .produccion-summary-card::after {
                content: "";
                position: absolute;
                right: -32px;
                bottom: -36px;
                width: 110px;
                height: 110px;
                background: rgba(243, 210, 122, 0.22);
                border-radius: 50%;
            }

        .produccion-summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #fff2d5;
            color: #a66b20;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            font-size: 18px;
        }

        .produccion-summary-label {
            color: #7a6a5d;
            font-weight: 850;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .produccion-summary-value {
            color: #2b160d;
            font-size: 1.65rem;
            font-weight: 950;
            line-height: 1.15;
        }

        .produccion-table-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 24px;
            box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
            padding: 18px;
            overflow: hidden;
        }

            .produccion-table-card table {
                margin-bottom: 0;
            }

                .produccion-table-card table thead th {
                    background: #1f2937 !important;
                    color: #fff !important;
                    border: none !important;
                    padding: 15px 14px !important;
                    font-weight: 900;
                    vertical-align: middle;
                }

                    .produccion-table-card table thead th:first-child {
                        border-top-left-radius: 13px;
                    }

                    .produccion-table-card table thead th:last-child {
                        border-top-right-radius: 13px;
                    }

                .produccion-table-card table tbody td {
                    padding: 16px 14px !important;
                    vertical-align: middle;
                    border-bottom: 1px solid #ece2cf;
                }

                .produccion-table-card table tbody tr:hover {
                    background: rgba(243, 210, 122, 0.12);
                }

        .produccion-lote {
            font-weight: 900;
            color: #2b160d;
        }

        .produccion-observacion {
            max-width: 260px;
            color: #5f5147;
            font-weight: 650;
            line-height: 1.35;
        }

        .produccion-kg {
            font-weight: 950;
            color: #2b160d;
            white-space: nowrap;
        }

        .produccion-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

            .produccion-actions .btn {
                border-radius: 10px;
                font-weight: 850;
                padding: 8px 11px;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

        .produccion-estado {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: 0.8rem;
            font-weight: 950;
            white-space: nowrap;
        }

        .produccion-estado-completado {
            background: #dff5e3;
            color: #1e7d32;
        }

        .produccion-estado-proceso {
            background: #fff4d3;
            color: #8a6500;
        }

        .produccion-estado-cancelado {
            background: #fde1df;
            color: #b42318;
        }

        .produccion-estado-neutral {
            background: #e9ecef;
            color: #495057;
        }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 15px;
            color: #2b160d;
            font-weight: 700;
        }

            .dataTables_wrapper .dataTables_filter input,
            .dataTables_wrapper .dataTables_length select {
                border: 1px solid #d9c8ab;
                border-radius: 10px;
                padding: 7px 10px;
                background: white;
            }

        .dataTables_wrapper .dataTables_info {
            color: #6f5b4a;
            font-weight: 650;
            margin-top: 14px;
        }

        .dataTables_wrapper .dataTables_paginate {
            margin-top: 14px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border-radius: 10px !important;
            }

        @@media (max-width: 1400px) {
            .produccion-summary-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 900px) {
            .produccion-summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .produccion-header {
                flex-direction: column;
            }
        }

        @@media (max-width: 650px) {
            .produccion-summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="produccion-page">

    <div class="produccion-header">
        <div>
            <h1>Producción</h1>
            <div class="produccion-title-line"></div>
            <p>
                Gestión de procesos de producción del microbeneficio.
            </p>
        </div>

        <a asp-action="Create" class="btn-nueva-produccion">
            <i class="fa-solid fa-plus"></i>
            Nueva Producción
        </a>
    </div>

    <section class="produccion-summary-grid">

        <div class="produccion-summary-card">
            <div class="produccion-summary-icon">
                <i class="fa-solid fa-industry"></i>
            </div>
            <div class="produccion-summary-label">Producciones registradas</div>
            <div class="produccion-summary-value">@totalProducciones</div>
        </div>

        <div class="produccion-summary-card">
            <div class="produccion-summary-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="produccion-summary-label">Completadas</div>
            <div class="produccion-summary-value">@produccionesCompletadas</div>
        </div>

        <div class="produccion-summary-card">
            <div class="produccion-summary-icon">
                <i class="fa-solid fa-gears"></i>
            </div>
            <div class="produccion-summary-label">En proceso</div>
            <div class="produccion-summary-value">@produccionesProceso</div>
        </div>

        <div class="produccion-summary-card">
            <div class="produccion-summary-icon">
                <i class="fa-solid fa-weight-hanging"></i>
            </div>
            <div class="produccion-summary-label">Kg procesados</div>
            <div class="produccion-summary-value">@totalProcesado.ToString("N2") kg</div>
        </div>

        <div class="produccion-summary-card">
            <div class="produccion-summary-icon">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <div class="produccion-summary-label">Kg resultantes</div>
            <div class="produccion-summary-value">@totalResultante.ToString("N2") kg</div>
        </div>

    </section>

    <div class="produccion-table-card">
        <div class="table-responsive">

            <table id="tablaProduccion" class="table align-middle">

                <thead>
                    <tr>
                        <th>Lote</th>
                        <th>Fecha</th>
                        <th>Proceso</th>
                        <th>Procesado</th>
                        <th>Resultado</th>
                        <th>Estado</th>
                        <th>Observación</th>
                        <th width="280">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        string estadoClase = item.Estado switch
                        {
                            "Completado" => "produccion-estado produccion-estado-completado",
                            "En proceso" => "produccion-estado produccion-estado-proceso",
                            "Cancelado" => "produccion-estado produccion-estado-cancelado",
                            _ => "produccion-estado produccion-estado-neutral"
                        };

                        <tr>

                            <td class="produccion-lote">
                                @(item.Lote != null
                                    ? item.Lote.CodigoLote
                                    : "Sin lote")
                            </td>

                            <td>
                                @item.FechaProduccion.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @item.TipoProceso
                            </td>

                            <td class="produccion-kg">
                                @item.CantidadProcesadaKg kg
                            </td>

                            <td class="produccion-kg">
                                @item.CantidadResultanteKg kg
                            </td>

                            <td>
                                <span class="@estadoClase">
                                    @item.Estado
                                </span>
                            </td>

                            <td class="produccion-observacion">
                                @(string.IsNullOrWhiteSpace(item.Observacion)
                                    ? "Sin observación"
                                    : item.Observacion)
                            </td>

                            <td>
                                <div class="produccion-actions">

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            Editar
                                        </a>
                                    }

                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">
                                        <i class="fa-solid fa-eye"></i>
                                        Detalles
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-trash"></i>
                                            Eliminar
                                        </a>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaProduccion').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20],
                responsive: true
            });
        });
    </script>
}