@model IEnumerable<MicrobeneficioSanGabriel.Models.Produccion>
@{
    ViewData["Title"] = "Producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var producciones = Model.ToList();
    var totalProducciones = producciones.Count;
    var totalProcesada = producciones.Sum(p => p.CantidadProcesadaKg);
    var totalResultante = producciones.Sum(p => p.CantidadResultanteKg);
    var curso = producciones.Count(p => p.Estado == "En proceso");
    var completadas = producciones.Count(p => p.Estado == "Completado");
    var canceladas = producciones.Count(p => p.Estado == "Cancelado");
    var rendimiento = totalProcesada <= 0 ? 0 : Math.Round(totalResultante * 100 / totalProcesada, 1);
    decimal Porcentaje(int valor) => totalProducciones == 0 ? 0 : Math.Round(valor * 100m / totalProducciones, 0);
}
<section class="sg-page-head"><div><h1>Lotes y Producción</h1><p>Procesos de beneficiado, rendimiento y control de etapas con datos reales.</p></div><div class="sg-actions"><a asp-action="Create" class="sg-btn gold"><i class="fa-solid fa-plus"></i>Registrar producción</a><a asp-controller="Lotes" asp-action="Create" class="sg-btn ghost"><i class="fa-solid fa-plus"></i>Nuevo lote</a></div></section>
<section class="sg-kpi-grid">
    <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-industry"></i></span><div><span>Kg resultantes</span><strong>@totalResultante.ToString("N0") kg</strong><div class="sg-trend">Suma real registrada</div></div></article>
    <article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-arrows-rotate"></i></span><div><span>Procesos en curso</span><strong>@curso</strong><div class="sg-trend">Estado actual</div></div></article>
    <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-leaf"></i></span><div><span>Rendimiento promedio</span><strong>@rendimiento%</strong><div class="sg-trend">Resultante / procesada</div></div></article>
    <article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-box"></i></span><div><span>Productos resultantes</span><strong>@producciones.Where(p => p.ProductoId.HasValue).Select(p => p.ProductoId).Distinct().Count()</strong><div class="sg-trend warn">Según producción</div></div></article>
</section>
<section class="sg-grid-2">
    <article class="sg-card sg-panel"><h3>Estado de producción</h3><div class="sg-donut-wrap mt-3"><div class="sg-donut" style="--p:@Porcentaje(completadas)"><div><b>@Porcentaje(completadas)%</b><br/><span>Completadas</span></div></div><div class="sg-legend"><div class="sg-legend-row"><span class="sg-dot"></span><span>Completadas</span><b>@completadas</b></div><div class="sg-legend-row"><span class="sg-dot gold"></span><span>En proceso</span><b>@curso</b></div><div class="sg-legend-row"><span class="sg-dot brown"></span><span>Canceladas</span><b>@canceladas</b></div></div></div></article>
    <article class="sg-card sg-panel"><h3>Volumen procesado</h3><div class="sg-mini-list mt-3"><div class="sg-mini-row"><i class="fa-solid fa-weight-scale text-success"></i><span>Kg procesados</span><b>@totalProcesada.ToString("N0") kg</b></div><div class="sg-mini-row"><i class="fa-solid fa-scale-balanced text-success"></i><span>Kg resultantes</span><b>@totalResultante.ToString("N0") kg</b></div><div class="sg-mini-row"><i class="fa-solid fa-chart-simple text-success"></i><span>Rendimiento</span><b>@rendimiento%</b></div></div></article>
</section>
<section class="sg-card sg-table-card"><div class="sg-panel-head"><h3>Producciones registradas</h3><span class="sg-badge">@totalProducciones registro(s)</span></div><div class="table-responsive"><table class="sg-table" id="tablaProducciones"><thead><tr><th>Lote</th><th>Proceso</th><th>Cantidad procesada</th><th>Cantidad resultante</th><th>Producto</th><th>Estado</th><th>Fecha</th><th>Acciones</th></tr></thead><tbody>@foreach(var p in producciones){<tr><td>@(p.Lote?.CodigoLote ?? $"LO-{p.LoteId:0000}")</td><td>@p.TipoProceso</td><td>@p.CantidadProcesadaKg.ToString("N0") kg</td><td>@p.CantidadResultanteKg.ToString("N0") kg</td><td>@p.Producto?.Nombre</td><td><span class="sg-badge @((p.Estado ?? string.Empty).Contains("Complet") ? "" : (p.Estado ?? string.Empty).Contains("Cancel") ? "brown" : "gold")">@p.Estado</span></td><td>@p.FechaProduccion.ToString("dd MMM yyyy")</td><td><span class="sg-action-icons"><a asp-action="Details" asp-route-id="@p.Id"><i class="fa-solid fa-eye"></i></a>@if(User.IsInRole("Administrador") || User.IsInRole("Operador")){<a asp-action="Edit" asp-route-id="@p.Id" title="Cambiar/editar"><i class="fa-solid fa-pen"></i></a>}@if(User.IsInRole("Administrador")){<a asp-action="Delete" asp-route-id="@p.Id"><i class="fa-solid fa-trash"></i></a>}</span></td></tr>}</tbody></table></div></section>
