@model IEnumerable<MicrobeneficioSanGabriel.Models.Produccion>

@{
    ViewData["Title"] = "Producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="admin-title">Producción</h1>
        <p class="admin-subtitle">
            Gestión de procesos de producción del microbeneficio.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-admin-primary">
        + Nueva Producción
    </a>
</div>

<div class="admin-card">
    <div class="table-responsive">

        <table id="tablaProduccion" class="table admin-table align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Lote</th>
                    <th>Fecha</th>
                    <th>Proceso</th>
                    <th>Procesado</th>
                    <th>Resultado</th>
                    <th>Estado</th>
                    <th>Observación</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>@item.Lote?.CodigoLote</strong>
                        </td>

                        <td>
                            @item.FechaProduccion.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @item.TipoProceso
                        </td>

                        <td>
                            @item.CantidadProcesadaKg Kg
                        </td>

                        <td>
                            @item.CantidadResultanteKg Kg
                        </td>

                        <td>

                            @if (item.Estado == "Completado")
                            {
                                <span class="badge bg-success">
                                    @item.Estado
                                </span>
                            }
                            else if (item.Estado == "En proceso")
                            {
                                <span class="badge bg-warning text-dark">
                                    @item.Estado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @item.Estado
                                </span>
                            }

                        </td>

                        <td>
                            @item.Observacion
                        </td>

                        <td>

                            @if (User.IsInRole("Administrador"))
                            {
                            <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                    Editar
                                </a>
                            }

                            <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">
                                Detalles
                            </a>

                            @if (User.IsInRole("Administrador"))
                            {
                            <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaProduccion').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20] ,
                responsive: true
            });
        });
    </script>
}