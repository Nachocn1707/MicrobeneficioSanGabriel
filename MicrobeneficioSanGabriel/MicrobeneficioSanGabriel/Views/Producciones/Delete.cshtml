@model MicrobeneficioSanGabriel.Models.Produccion

@{
    ViewData["Title"] = "Eliminar producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string estadoClase = Model.Estado switch
    {
        "Pendiente" => "text-warning",
        "En proceso" => "text-primary",
        "Completado" => "text-success",
        "Cancelado" => "text-danger",
        _ => "text-secondary"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEliminar.css" />
}

<div class="sg-card border-danger">
    <h1 class="text-danger">
        <i class="fa-solid fa-trash"></i>
        Eliminar producción #@Model.Id
    </h1>

    <p>
        <strong>Lote:</strong> @(Model.Lote != null ? Model.Lote.CodigoLote : "Sin lote")<br />
        <strong>Producto:</strong> @(Model.ProductoNombreMostrar)<br />
        <strong>Fecha:</strong> @Model.FechaProduccion.ToString("dd/MM/yyyy HH:mm")<br />
        <strong>Tipo de proceso:</strong> @Model.TipoProceso<br />
        <strong>Cantidad procesada:</strong> @Model.CantidadProcesadaKg kg<br />
        <strong>Cantidad resultante:</strong> @Model.CantidadResultanteKg kg<br />
        <strong>Estado:</strong> <span class="@estadoClase">@Model.Estado</span>
    </p>

    <div class="alert alert-warning">
        <i class="fa-solid fa-circle-exclamation"></i>
        Esta acción eliminará la producción del sistema de forma <strong>permanente</strong>.
        Si esta producción está relacionada con inventario o trazabilidad,
        el sistema podría bloquear la operación.
    </div>

    @if (Model.Estado == "Cancelado")
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-check-circle"></i>
            Esta producción ya se encuentra cancelada. Puedes eliminarla sin restricciones.
        </div>
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
            <button class="btn btn-danger" type="submit">
                <i class="fa-solid fa-trash"></i> Confirmar eliminación
            </button>
        </div>
    </form>
</div>