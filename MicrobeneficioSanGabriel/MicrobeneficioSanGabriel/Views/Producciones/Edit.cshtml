@model MicrobeneficioSanGabriel.Models.Produccion

@{
    ViewData["Title"] = "Editar producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var soloEstado = (bool?)ViewBag.SoloEstado ?? false;
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaEditar.css" />

}

<div class="EstiloEditar-page">
    <div class="EstiloEditar-header">
        <h1>Editar producción</h1>
        <p>Actualizá los datos de la producción.</p>
    </div>

    <div class="EstiloEditaR-card">
        <div class="EstiloEditaR-form-container">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <div class="Estilo-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Si el estado se marca como completado, el sistema ajustará el inventario real del producto resultante.
                    </span>
                </div>

                <div class="EstiloEditar-section">
                    <h5>
                        <i class="fa-solid fa-industry"></i>
                        @(soloEstado ? "Actualización del estado operativo" : "Detalle de la producción")
                    </h5>

                    @if (soloEstado)
                    {
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Producción</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-hashtag"></i>
                                        <input value="#@Model.Id" class="form-control" readonly />
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Lote</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-layer-group"></i>
                                        <input value="@(Model.Lote?.CodigoLote ?? $"LO-{Model.LoteId:0000}")" class="form-control" readonly />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="Estado" class="form-label">Estado</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-circle-info"></i>
                                        <select asp-for="Estado" class="form-select">
                                            <option value="En proceso">En proceso</option>
                                            <option value="Completado">Completado</option>
                                            <option value="Cancelado">Cancelado</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Estado" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="LoteId" class="form-label">Lote</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-layer-group"></i>
                                        <select asp-for="LoteId" class="form-select" asp-items="ViewBag.LoteId">
                                            <option value="">Seleccione un lote</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="LoteId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ProductoId" class="form-label">Producto resultante</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-mug-hot"></i>
                                        <select asp-for="ProductoId" class="form-select" asp-items="ViewBag.ProductoId">
                                            <option value="">Seleccione un producto</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="ProductoId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="FechaProduccion" class="form-label">Fecha de producción</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-calendar"></i>
                                        <input asp-for="FechaProduccion" type="datetime-local" class="form-control" min="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-ddT00:00")" max="@DateTime.Today.ToString("yyyy-MM-ddT23:59")" />
                                    </div>
                                    <span asp-validation-for="FechaProduccion" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="TipoProceso" class="form-label">Tipo de proceso</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-gears"></i>
                                        <select asp-for="TipoProceso" class="form-select">
                                            <option value="">Seleccione un proceso</option>
                                            <option value="Lavado">Lavado</option>
                                            <option value="Secado">Secado</option>
                                            <option value="Tostado">Tostado</option>
                                            <option value="Molido">Molido</option>
                                            <option value="Empaque">Empaque</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="TipoProceso" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="CantidadProcesadaKg" class="form-label">Cantidad procesada en kg</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-weight-scale"></i>
                                        <input asp-for="CantidadProcesadaKg" asp-format="{0:0}" class="form-control"
                                               type="text" inputmode="numeric" pattern="[0-9]+"
                                               oninput="this.value=(this.value.match(/\d+/)||[''])[0]" />
                                    </div>
                                    <span asp-validation-for="CantidadProcesadaKg" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="CantidadResultanteKg" class="form-label">Cantidad resultante en kg</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-scale-balanced"></i>
                                        <input asp-for="CantidadResultanteKg" asp-format="{0:0}" class="form-control"
                                               type="text" inputmode="numeric" pattern="[0-9]+"
                                               oninput="this.value=(this.value.match(/\d+/)||[''])[0]" />
                                    </div>
                                    <span asp-validation-for="CantidadResultanteKg" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="Estado" class="form-label">Estado</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-circle-info"></i>
                                        <select asp-for="Estado" class="form-select">
                                            <option value="En proceso">En proceso</option>
                                            <option value="Completado">Completado</option>
                                            <option value="Cancelado">Cancelado</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Estado" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="Observacion" class="form-label">Observación</label>
                                    <div class="input-modern textarea-modern">
                                        <i class="fa-solid fa-comment"></i>
                                        <textarea asp-for="Observacion" class="form-control" rows="5" placeholder="Digite una observación de la producción"></textarea>
                                    </div>
                                    <span asp-validation-for="Observacion" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="EstiloEditar-actions">
                    <a asp-action="Index" class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver a la lista
                    </a>
                    <button type="submit" class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}