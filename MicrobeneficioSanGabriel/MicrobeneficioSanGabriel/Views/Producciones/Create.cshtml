@model MicrobeneficioSanGabriel.Models.Produccion

@{
    ViewData["Title"] = "Nueva Producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .produccion-create-page {
            display: grid;
            gap: 24px;
            padding-top: 14px;
        }

        .produccion-create-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

        .produccion-create-title h1 {
            font-size: 2.4rem;
            font-weight: 950;
            margin: 0;
            color: #2b160d;
        }

        .produccion-create-line {
            width: 78px;
            height: 4px;
            border-radius: 999px;
            background: #d8b36a;
            margin: 12px 0;
        }

        .produccion-create-title p {
            color: #6f5b4a;
            font-weight: 650;
            margin: 0;
        }

        .produccion-create-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #e2f4df;
            color: #147a3d;
            border-radius: 999px;
            padding: 8px 14px;
            font-weight: 900;
            font-size: 13px;
            margin-bottom: 14px;
        }

        .produccion-create-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 28px;
            box-shadow: 0 22px 55px rgba(58, 33, 20, 0.10);
            overflow: hidden;
            display: grid;
            grid-template-columns: 0.36fr 0.64fr;
            min-height: 620px;
        }

        .produccion-create-side {
            background: linear-gradient(180deg, rgba(22, 32, 47, 0.94), rgba(13, 22, 35, 0.96)), url("/images/dashboard/coffee-banner.jpg");
            background-size: cover;
            background-position: center;
            padding: 36px;
            color: #fff8df;
            display: flex;
            align-items: center;
        }

        .produccion-create-side-content {
            max-width: 360px;
        }

        .produccion-create-icon {
            width: 72px;
            height: 72px;
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.12);
            color: #fff3c4;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin-bottom: 26px;
        }

        .produccion-create-side h2 {
            color: #fff3c4;
            font-size: 2rem;
            font-weight: 950;
            margin: 0;
        }

        .produccion-side-line {
            width: 70px;
            height: 4px;
            border-radius: 999px;
            background: #f3d27a;
            margin: 14px 0 18px;
        }

        .produccion-create-side p {
            color: #fff8df;
            opacity: 0.95;
            font-weight: 650;
            line-height: 1.55;
            margin-bottom: 28px;
        }

        .produccion-create-info {
            display: grid;
            gap: 16px;
        }

        .produccion-create-info-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #fff8df;
            font-weight: 800;
        }

            .produccion-create-info-item i {
                color: #f3d27a;
                width: 18px;
            }

        .produccion-create-form-container {
            padding: 38px;
        }

        .produccion-alert {
            background: #dff6fd;
            color: #0369a1;
            border: 1px solid #bde8f7;
            border-radius: 18px;
            padding: 15px 18px;
            font-weight: 750;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .produccion-field label {
            color: #2b160d;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .input-modern {
            position: relative;
        }

            .input-modern i {
                position: absolute;
                left: 17px;
                top: 50%;
                transform: translateY(-50%);
                color: #a1a8b3;
                z-index: 2;
            }

            .input-modern .form-control,
            .input-modern .form-select {
                min-height: 56px;
                border-radius: 18px;
                border: 1px solid #d8dee8;
                background: #fff;
                padding-left: 48px;
                font-weight: 700;
                color: #2b160d;
            }

                .input-modern .form-control:focus,
                .input-modern .form-select:focus {
                    border-color: #d8b36a;
                    box-shadow: 0 0 0 0.2rem rgba(216, 179, 106, 0.22);
                }

        .textarea-modern i {
            top: 25px;
            transform: none;
        }

        .textarea-modern textarea.form-control {
            min-height: 115px;
            padding-top: 17px;
            resize: vertical;
        }

        .produccion-create-actions {
            border-top: 1px solid #ead8a2;
            margin-top: 26px;
            padding-top: 22px;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-produccion-create {
            border: none;
            border-radius: 14px;
            padding: 12px 20px;
            font-weight: 950;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: 0.18s ease;
        }

            .btn-produccion-create:hover {
                transform: translateY(-1px);
            }

        .btn-produccion-volver {
            background: #f3f4f6;
            color: #111827;
        }

            .btn-produccion-volver:hover {
                background: #e5e7eb;
                color: #111827;
            }

        .btn-produccion-guardar {
            background: #4a2c1a;
            color: #fff8df;
        }

            .btn-produccion-guardar:hover {
                background: #7a5230;
                color: #fff8df;
            }

        @@media (max-width: 1100px) {
            .produccion-create-card {
                grid-template-columns: 1fr;
            }

            .produccion-create-side {
                min-height: 300px;
            }
        }

        @@media (max-width: 768px) {
            .produccion-create-header {
                flex-direction: column;
            }

            .produccion-create-form-container {
                padding: 24px;
            }

            .produccion-create-side {
                padding: 28px;
            }

            .produccion-create-title h1 {
                font-size: 2rem;
            }
        }
    </style>
}

<div class="produccion-create-page">

    <div class="produccion-create-header">
        <div class="produccion-create-title">
            <span class="produccion-create-badge">
                <i class="fa-solid fa-industry"></i>
                Gestión de producción
            </span>

            <h1>Nueva producción</h1>
            <div class="produccion-create-line"></div>

            <p>
                Registrá procesos de producción y transformación del café dentro del microbeneficio.
            </p>
        </div>
    </div>

    <div class="produccion-create-card">

        <div class="produccion-create-side">
            <div class="produccion-create-side-content">

                <div class="produccion-create-icon">
                    <i class="fa-solid fa-industry"></i>
                </div>

                <h2>Producción</h2>
                <div class="produccion-side-line"></div>

                <p>
                    Gestioná procesos, cantidades, productos resultantes y estados de producción
                    para mantener el control operativo.
                </p>

                <div class="produccion-create-info">
                    <div class="produccion-create-info-item">
                        <i class="fa-solid fa-gears"></i>
                        Procesos productivos
                    </div>

                    <div class="produccion-create-info-item">
                        <i class="fa-solid fa-weight-scale"></i>
                        Control de cantidades
                    </div>

                    <div class="produccion-create-info-item">
                        <i class="fa-solid fa-chart-line"></i>
                        Seguimiento operativo
                    </div>
                </div>

            </div>
        </div>

        <div class="produccion-create-form-container">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>

                <div class="produccion-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Si la producción queda completada, el sistema puede registrar el resultado en inventario según tu lógica actual.
                    </span>
                </div>

                <div class="row g-4">

                    <div class="col-md-6 produccion-field">
                        <label asp-for="LoteId" class="form-label">
                            Lote
                        </label>

                        <div class="input-modern">
                            <i class="fa-solid fa-layer-group"></i>

                            <select asp-for="LoteId"
                                    class="form-select"
                                    asp-items="ViewBag.LoteId">
                                <option value="">Seleccione un lote</option>
                            </select>
                        </div>

                        <span asp-validation-for="LoteId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 produccion-field">
                        <label asp-for="ProductoId" class="form-label">
                            Producto resultante
                        </label>

                        <div class="input-modern">
                            <i class="fa-solid fa-mug-hot"></i>

                            <select asp-for="ProductoId"
                                    class="form-select"
                                    asp-items="ViewBag.ProductoId">
                                <option value="">Seleccione un producto</option>
                            </select>
                        </div>

                        <span asp-validation-for="ProductoId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 produccion-field">
                        <label asp-for="TipoProceso" class="form-label">
                            Tipo de proceso
                        </label>

                        <div class="input-modern">
                            <i class="fa-solid fa-gears"></i>

                            <select asp-for="TipoProceso"
                                    class="form-select">
                                <option value="">Seleccione un proceso</option>
                                <option value="Lavado">Lavado</option>
                                <option value="Secado">Secado</option>
                                <option value="Tostado">Tostado</option>
                                <option value="Molido">Molido</option>
                                <option value="Empaque">Empaque</option>
                            </select>
                        </div>

                        <span asp-validation-for="TipoProceso"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 produccion-field">
                        <label asp-for="FechaProduccion" class="form-label">
                            Fecha de producción
                        </label>

                        <div class="input-modern">
                            <i class="fa-solid fa-calendar"></i>

                            <input asp-for="FechaProduccion"
                                   type="datetime-local"
                                   class="form-control"
                                   min="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-ddT00:00")"
                                   max="@DateTime.Today.ToString("yyyy-MM-ddT23:59")" />
                        </div>

                        <span asp-validation-for="FechaProduccion"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 produccion-field">
                        <label asp-for="CantidadProcesadaKg" class="form-label">
                            Cantidad procesada en kg
                        </label>

                        <div class="input-modern">
                            <i class="fa-solid fa-weight-scale"></i>

                            <input asp-for="CantidadProcesadaKg"
                                   class="form-control"
                                   min="1"
                                   placeholder="Digite la cantidad procesada" />
                        </div>

                        <span asp-validation-for="CantidadProcesadaKg"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 produccion-field">
                        <label asp-for="CantidadResultanteKg" class="form-label">
                            Cantidad resultante en kg
                        </label>

                        <div class="input-modern">
                            <i class="fa-solid fa-scale-balanced"></i>

                            <input asp-for="CantidadResultanteKg"
                                   class="form-control"
                                   min="1"
                                   placeholder="Digite la cantidad resultante" />
                        </div>

                        <span asp-validation-for="CantidadResultanteKg"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 produccion-field">
                        <label asp-for="Estado" class="form-label">
                            Estado
                        </label>

                        <div class="input-modern">
                            <i class="fa-solid fa-circle-info"></i>

                            <select asp-for="Estado"
                                    class="form-select">
                                <option value="En proceso">En proceso</option>
                                <option value="Completado">Completado</option>
                                <option value="Cancelado">Cancelado</option>
                            </select>
                        </div>

                        <span asp-validation-for="Estado"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-12 produccion-field">
                        <label asp-for="Observacion" class="form-label">
                            Observación
                        </label>

                        <div class="input-modern textarea-modern">
                            <i class="fa-solid fa-comment"></i>

                            <textarea asp-for="Observacion"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Digite una observación de la producción"></textarea>
                        </div>

                        <span asp-validation-for="Observacion"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="produccion-create-actions">

                    <a asp-action="Index"
                           class="btn-produccion-create btn-produccion-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>

                    <button type="submit"
                            class="btn-produccion-create btn-produccion-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar producción
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}