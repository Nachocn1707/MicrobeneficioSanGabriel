@model MicrobeneficioSanGabriel.Models.Produccion

@{
    ViewData["Title"] = "Nueva Producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaCrear.css" />
}

<div class="VistaCreaR-page">
    <div class="VistaCreaR-top">
        <div class="VistaCreaR-title">
            <span class="VistaCreaR-badge">
                <i class="fa-solid fa-industry"></i>
                Gestión de producción
            </span>
            <h1>Nueva producción</h1>
            <p>
                Registrá procesos de producción y transformación del café dentro del microbeneficio.
            </p>
        </div>
    </div>

    <div class="VistaCreaR-card">
        <div class="VistaCreaR-form-container">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="Mensaje-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Si la producción queda completada, el sistema puede registrar el resultado en inventario según tu lógica actual.
                    </span>
                </div>

                <div class="VistaCreaR-section">
                    <h5>
                        <i class="fa-solid fa-industry"></i>
                        Detalle de la producción
                    </h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="LoteId" class="form-label">Lote</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-layer-group"></i>
                                    <select asp-for="LoteId"
                                            class="form-select"
                                            asp-items="ViewBag.LoteId">
                                        <option value="">Seleccione un lote</option>
                                    </select>
                                </div>
                                <span asp-validation-for="LoteId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductoId" class="form-label">Producto resultante</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-mug-hot"></i>
                                    <select asp-for="ProductoId"
                                            class="form-select"
                                            asp-items="ViewBag.ProductoId">
                                        <option value="">Seleccione un producto</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ProductoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="TipoProceso" class="form-label">Tipo de proceso</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-gears"></i>
                                    <select asp-for="TipoProceso" class="form-select">
                                        <option value="">Seleccione un proceso</option>
                                        <option value="Lavado">Lavado</option>
                                        <option value="Secado">Secado</option>
                                        <option value="Tostado">Tostado</option>
                                        <option value="Molido">Molido</option>
                                        <option value="Empaque">Empaque</option>
                                    </select>
                                </div>
                                <span asp-validation-for="TipoProceso" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="FechaProduccion" class="form-label">Fecha de producción</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-calendar"></i>
                                    <input asp-for="FechaProduccion"
                                           type="datetime-local"
                                           class="form-control"
                                           min="@DateTime.UtcNow.AddHours(-6).Date.AddDays(-1).ToString("yyyy-MM-ddT00:00")"
                                           max="@DateTime.UtcNow.AddHours(-6).Date.ToString("yyyy-MM-ddT23:59")" />
                                </div>
                                <span asp-validation-for="FechaProduccion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CantidadProcesadaKg" class="form-label">Cantidad procesada en kg</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-weight-scale"></i>
                                    <input asp-for="CantidadProcesadaKg" asp-format="{0:0}"
                                           class="form-control"
                                           type="text" inputmode="numeric" pattern="[0-9]+"
                                           oninput="this.value=(this.value.match(/\d+/)||[''])[0]"
                                           placeholder="Digite la cantidad procesada" />
                                </div>
                                <span asp-validation-for="CantidadProcesadaKg" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CantidadResultanteKg" class="form-label">Cantidad resultante en kg</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-scale-balanced"></i>
                                    <input asp-for="CantidadResultanteKg" asp-format="{0:0}"
                                           class="form-control"
                                           type="text" inputmode="numeric" pattern="[0-9]+"
                                           oninput="this.value=(this.value.match(/\d+/)||[''])[0]"
                                           placeholder="Digite la cantidad resultante" />
                                </div>
                                <span asp-validation-for="CantidadResultanteKg" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Estado" class="form-label">Estado</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-circle-info"></i>
                                    <select asp-for="Estado" class="form-select">
                                        <option value="En proceso">En proceso</option>
                                        <option value="Completado">Completado</option>
                                        <option value="Cancelado">Cancelado</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Observacion" class="form-label">Observación</label>
                                <div class="input-modern textarea-modern">
                                    <i class="fa-solid fa-comment"></i>
                                    <textarea asp-for="Observacion"
                                              class="form-control"
                                              rows="2"
                                              placeholder="Digite una observación de la producción"></textarea>
                                </div>
                                <span asp-validation-for="Observacion" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div> 

                <div class="VistaCreaR-actions">
                    <a asp-action="Index" class="btn-cancelar">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                    <button type="submit" class="btn-crear">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar producción
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}