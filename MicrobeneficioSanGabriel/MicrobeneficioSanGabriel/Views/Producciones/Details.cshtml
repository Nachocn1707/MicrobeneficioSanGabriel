@model MicrobeneficioSanGabriel.Models.Produccion

@{
    ViewData["Title"] = "Detalle de Producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var loteCodigo = Model.Lote?.CodigoLote ?? $"LOTE-{Model.LoteId:0000}";
    var productor = Model.Lote?.Productor?.Nombre ?? "Sin productor asociado";
    var finca = Model.Lote?.Finca?.Nombre ?? "Sin finca asociada";
    var producto = Model.ProductoNombreMostrar ?? "Sin producto resultante";
    var rendimiento = Model.CantidadProcesadaKg > 0
        ? Math.Round((Model.CantidadResultanteKg / Model.CantidadProcesadaKg) * 100, 2)
        : 0;

    var historialLote = ViewBag.HistorialLote as List<MicrobeneficioSanGabriel.Models.Produccion>
        ?? new List<MicrobeneficioSanGabriel.Models.Produccion>();
    var etapasLote = new[] { "Lavado", "Secado", "Tostado", "Molido", "Empaque" };

    string estadoClase = Model.Estado switch
    {
        "Completado" or "Completada" => "movimiento-estado movimiento-entrada",
        "En Proceso" or "Pendiente" => "movimiento-estado movimiento-neutral",
        "Cancelado" or "Anulado" => "movimiento-estado movimiento-salida",
        _ => "movimiento-estado movimiento-neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<section class="Detalle-page-head">
    <div>
        <h1>Detalle de producción</h1>
        <p>Consulta el proceso aplicado al lote, cantidades procesadas y producto resultante.</p>
    </div>
    <div class="Detalle-actions">
        <span class="movimiento-badge-top">
            Producción #@Model.Id
        </span>
    </div>
</section>

<div class="EstiloDetalle-detalle-page">
    <div class="EstiloDetalle-premium-card">

        <div class="EstiloDetalle-premium-header">
            <h2>Información general</h2>
        </div>

        <div class="EstiloDetalle-premium-body">

            <div class="EstiloDetalle-detail-grid">

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-barcode"></i> LOTE
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @loteCodigo
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-user-gear"></i> PRODUCTOR
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @productor
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-mountain-sun"></i> FINCA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @finca
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-gears"></i> TIPO DE PROCESO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.TipoProceso
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-box-open"></i> PRODUCTO RESULTANTE
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @producto
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-circle-check"></i> ESTADO
                    </span>
                    <div>
                        <span class="@estadoClase">
                            @Model.Estado
                        </span>
                    </div>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-weight-scale"></i> CANTIDAD PROCESADA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.CantidadProcesadaKg.ToString("N2") kg
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-scale-balanced"></i> CANTIDAD RESULTANTE
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.CantidadResultanteKg.ToString("N2") kg
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-chart-simple"></i> RENDIMIENTO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @rendimiento%
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-calendar-days"></i> FECHA DE PRODUCCIÓN
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.FechaProduccion.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-align-left"></i> OBSERVACIÓN
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación registrada."
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <section class="mt-4 pt-3 border-top">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                    <div>
                        <h3 class="h5 mb-1">Recorrido completo del lote</h3>
                        <small class="text-muted">Etapas registradas con su estado, fecha y hora.</small>
                    </div>
                    <a asp-controller="Trazabilidades" asp-action="Index" class="sg-btn ghost"><i class="fa-solid fa-route"></i>Ver módulo de trazabilidad</a>
                </div>
                <div class="sg-process-timeline">
                    @foreach (var etapa in etapasLote)
                    {
                        var registroEtapa = historialLote
                            .Where(p => string.Equals(p.TipoProceso, etapa, StringComparison.OrdinalIgnoreCase))
                            .OrderByDescending(p => p.FechaProduccion)
                            .FirstOrDefault();
                        var etapaCompletada = registroEtapa != null && (registroEtapa.Estado ?? "").Contains("Complet", StringComparison.OrdinalIgnoreCase);
                        var etapaActual = registroEtapa != null && !etapaCompletada && !(registroEtapa.Estado ?? "").Contains("Cancel", StringComparison.OrdinalIgnoreCase);
                        <div class="sg-process-step @(etapaCompletada ? "done" : "") @(etapaActual ? "current" : "")">
                            <i class="fa-solid @(etapaCompletada ? "fa-circle-check" : etapaActual ? "fa-spinner" : "fa-circle")"></i>
                            <strong>@etapa</strong>
                            @if (registroEtapa != null)
                            {
                                <small>@registroEtapa.Estado</small>
                                <small class="d-block">@registroEtapa.FechaProduccion.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                            else
                            {
                                <small>Pendiente</small>
                            }
                        </div>
                    }
                </div>
            </section>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index" class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver
                </a>

                @if (User.IsInRole("Administrador") || User.IsInRole("Operador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-EstiloDetalle btn-EstiloDetalle-warning">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Editar
                    </a>
                }

            </div>

        </div>
    </div>
</div>