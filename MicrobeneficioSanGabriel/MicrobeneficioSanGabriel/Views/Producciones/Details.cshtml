@model MicrobeneficioSanGabriel.Models.Produccion

@{
    ViewData["Title"] = "Detalle de producción";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string estadoClase = Model.Estado switch
    {
        "Completado" => "estado-activo",
        "En proceso" => "estado-activo",
        _ => "estado-inactivo"
    };
}

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalle de producción</h1>
        <p>Información registrada del proceso productivo.</p>
    </div>

    <div class="EstiloDetalle-card">

        <div class="EstiloDetalle-card-header">
            <h2>
                @(Model.Lote?.CodigoLote ?? $"Producción #{Model.Id}")
            </h2>

            <span>
                Microbeneficio San Gabriel
            </span>
        </div>

        <div class="EstiloDetalle-card-body">

            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">
                        Lote asociado
                    </span>

                    <span class="detalle-value">
                        @(Model.Lote?.CodigoLote ?? "Sin lote")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Producto resultante
                    </span>

                    <span class="detalle-value">
                        @(Model.Producto?.Nombre ?? "Sin producto")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Fecha de producción
                    </span>

                    <span class="detalle-value">
                        @Model.FechaProduccion.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Tipo de proceso
                    </span>

                    <span class="detalle-value">
                        @Model.TipoProceso
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Cantidad procesada
                    </span>

                    <span class="detalle-value">
                        @Model.CantidadProcesadaKg kg
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Cantidad resultante
                    </span>

                    <span class="detalle-value">
                        @Model.CantidadResultanteKg kg
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Estado
                    </span>

                    <span class="@estadoClase">
                        @Model.Estado
                    </span>
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">
                        Observación
                    </span>

                    <span class="detalle-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-volver">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-editar">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Editar
                    </a>
                }

            </div>
        </div>
    </div>
</div>