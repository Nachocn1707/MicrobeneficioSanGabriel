@{
    ViewData["Title"] = "Portal cliente";
    Layout = "~/Views/Shared/_ClienteLayout.cshtml";
}

<style>
    .cliente-dashboard {
        display: grid;
        gap: 18px;
    }

    .cliente-hero {
        min-height: 145px;
        background: linear-gradient(90deg, rgba(255, 250, 242, 0.96) 0%, rgba(255, 250, 242, 0.86) 55%, rgba(255, 250, 242, 0.35) 100%), url("https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1200&q=80");
        background-size: cover;
        background-position: center;
        border: 1px solid #eadfce;
        border-radius: 16px;
        box-shadow: 0 18px 42px rgba(58, 33, 20, 0.10);
        padding: 28px;
        display: flex;
        align-items: center;
    }

        .cliente-hero h1 {
            margin: 0;
            color: #2a1a12;
            font-size: 28px;
            font-weight: 950;
        }

        .cliente-hero p {
            margin: 5px 0 0;
            color: #6f6258;
            font-size: 13px;
            font-weight: 700;
        }

    .cliente-modules {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .cliente-module {
        background: #fffdf8;
        border: 1px solid #eadfce;
        border-radius: 15px;
        padding: 18px;
        min-height: 165px;
        box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
        text-decoration: none;
        color: #2a1a12;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: 0.18s ease;
    }

        .cliente-module:hover {
            color: #2a1a12;
            transform: translateY(-3px);
        }

    .module-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: #fff2d5;
        color: #a66b20;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        font-size: 17px;
    }

    .cliente-module h3 {
        margin: 0 0 7px;
        font-size: 18px;
        font-weight: 950;
        color: #2a1a12;
    }

    .cliente-module p {
        margin: 0 0 14px;
        color: #7a6a5d;
        font-size: 12px;
        font-weight: 650;
        line-height: 1.35;
    }

    .module-button {
        width: fit-content;
        min-width: 108px;
        background: #7a532d;
        color: #fff7e8;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 900;
        text-align: center;
    }

    .quality-banner {
        min-height: 105px;
        background: linear-gradient(90deg, rgba(255, 250, 242, 0.98) 0%, rgba(255, 250, 242, 0.90) 58%, rgba(255, 250, 242, 0.20) 100%), url("https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1200&q=80");
        background-size: cover;
        background-position: center;
        border: 1px solid #eadfce;
        border-radius: 16px;
        box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
        padding: 24px;
        display: flex;
        align-items: center;
    }

        .quality-banner h2 {
            margin: 0;
            color: #2a1a12;
            font-size: 20px;
            font-weight: 950;
        }

        .quality-banner p {
            margin: 5px 0 0;
            color: #6f6258;
            font-size: 13px;
            font-weight: 700;
        }

    @@media (max-width: 1200px) {
        .cliente-modules {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .cliente-modules {
            grid-template-columns: 1fr;
        }

        .cliente-hero h1 {
            font-size: 24px;
        }
    }
</style>

<div class="cliente-dashboard">

    <section class="cliente-hero">
        <div>
            <h1>¡Bienvenido!</h1>
            <p>Portal cliente de Microbeneficio San Gabriel</p>
        </div>
    </section>

    <section class="cliente-modules">

        <a asp-controller="Productos" asp-action="Index" class="cliente-module">
            <div>
                <div class="module-icon">
                    <i class="fa-solid fa-mug-hot"></i>
                </div>

                <h3>Productos</h3>
                <p>Explora nuestro café disponible.</p>
            </div>

            <span class="module-button">Ver productos</span>
        </a>

        <a asp-controller="Pedidos" asp-action="Create" class="cliente-module">
            <div>
                <div class="module-icon">
                    <i class="fa-solid fa-cart-shopping"></i>
                </div>

                <h3>Realizar pedido</h3>
                <p>Haz tu solicitud de compra fácilmente.</p>
            </div>

            <span class="module-button">Hacer pedido</span>
        </a>

        <a asp-controller="Pedidos" asp-action="Index" class="cliente-module">
            <div>
                <div class="module-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <h3>Mis pedidos</h3>
                <p>Consulta el estado de tus pedidos.</p>
            </div>

            <span class="module-button">Ver mis pedidos</span>
        </a>

        <a asp-controller="Trazabilidades" asp-action="Index" class="cliente-module">
            <div>
                <div class="module-icon">
                    <i class="fa-solid fa-route"></i>
                </div>

                <h3>Trazabilidad</h3>
                <p>Conoce el origen y proceso de tu café.</p>
            </div>

            <span class="module-button">Ver trazabilidad</span>
        </a>

    </section>

    <section class="quality-banner">
        <div>
            <h2>Calidad que se siente en cada taza</h2>
            <p>Café de origen · Proceso artesanal · Compromiso con la calidad</p>
        </div>
    </section>

</div>