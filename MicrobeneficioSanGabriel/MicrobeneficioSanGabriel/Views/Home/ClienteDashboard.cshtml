@using MicrobeneficioSanGabriel.Models

@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_ClienteLayout.cshtml";

    var productosDestacados =
        ViewBag.ProductosDestacados as List<Producto>
        ?? new List<Producto>();

    var ultimosPedidos =
        ViewBag.UltimosPedidosCliente as List<Pedido>
        ?? new List<Pedido>();

    var totalProductos =
        (int?)ViewBag.TotalProductos ?? 0;

    var totalPedidos =
        (int?)ViewBag.TotalPedidosCliente ?? 0;

    var pedidosPendientes =
        (int?)ViewBag.PedidosPendientesCliente ?? 0;

    var pedidosCompletados =
        (int?)ViewBag.PedidosCompletadosCliente ?? 0;

    var totalKgDisponibles =
        Convert.ToDecimal(ViewBag.TotalKgDisponibles ?? 0m);

    string ImagenProducto(Producto producto)
    {
        if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
        {
            return producto.ImagenUrl;
        }

        var valor = (producto.Nombre ?? string.Empty).ToLowerInvariant();

        if (valor.Contains("premium"))
        {
            return "/images/products/cafe-premium.jpg";
        }

        if (valor.Contains("normal"))
        {
            return "/images/products/cafe-normal.jpg";
        }

        return "/images/products/default-coffee.jpg";
    }
}

<div class="cafe-client-home">

    <section class="cafe-welcome sg-ref-hero">
        <div class="sg-ref-hero-body">
            
            <div class="sg-ref-hero-left">
                <div class="sg-ref-eyebrow">
                    <span class="sg-ref-eyebrow-line"></span>
                    <span class="sg-ref-eyebrow-icon">
                        <i class="fa-solid fa-leaf"></i>
                    </span>
                    <span class="sg-ref-eyebrow-text">CAFÉ DE ORIGEN • SAN GABRIEL</span>
                    <span class="sg-ref-eyebrow-line"></span>
                </div>

                <h1 class="sg-ref-title">
                    El sabor <span class="sg-ref-title-gold">perfecto</span><br />
                    para tu mañana
                </h1>

                <div class="sg-ref-title-underline"></div>

                <p class="sg-ref-desc">
                    Descubrí cafés seleccionados, realizá tus pedidos y consultá
                    cada etapa de tu compra desde un solo lugar.
                </p>

                <div class="sg-ref-actions">
                    <a asp-controller="Productos"
                       asp-action="Index"
                       class="sg-ref-btn-primary">
                        <i class="fa-solid fa-mug-hot"></i>
                        <span>Explorar catálogo</span>
                        <i class="fa-solid fa-arrow-right sg-ref-arrow"></i>
                    </a>

                    <a asp-controller="Pedidos"
                       asp-action="Create"
                       class="sg-ref-btn-secondary">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span>Nuevo pedido</span>
                        <i class="fa-solid fa-arrow-right sg-ref-arrow"></i>
                    </a>
                </div>

                <div class="sg-ref-stock-badge">
                    <div class="sg-ref-stock-icon">
                        <i class="fa-solid fa-boxes-stacked"></i>
                    </div>
                    <div class="sg-ref-stock-data">
                        <div class="sg-ref-stock-header">
                            <span class="sg-ref-stock-label">DISPONIBLE AHORA</span>
                            <span class="sg-ref-stock-dot"></span>
                        </div>
                        <div class="sg-ref-stock-qty">@totalKgDisponibles.ToString("N0") kg</div>
                        <span class="sg-ref-stock-sub">Disponibles para compra</span>
                    </div>
                </div>
            </div>

            <div class="sg-ref-hero-right">
                <div class="sg-ref-harvest-card">
                    <div class="sg-ref-harvest-tag">
                        COSECHA ACTUAL
                    </div>

                    <div class="sg-ref-spec-list">
                        @if (productosDestacados.Any())
                        {
                            var prodPrincipal = productosDestacados.First();
                            <div class="sg-ref-spec-item">
                                <div class="sg-ref-spec-icon">
                                    <i class="fa-solid fa-leaf"></i>
                                </div>
                                <div class="sg-ref-spec-info">
                                    <small>VARIEDAD / PRODUCTO</small>
                                    <strong>@prodPrincipal.Nombre</strong>
                                </div>
                            </div>

                            <div class="sg-ref-spec-item">
                                <div class="sg-ref-spec-icon">
                                    <i class="fa-solid fa-droplet"></i>
                                </div>
                                <div class="sg-ref-spec-info">
                                    <small>PROCESO / CATEGORÍA</small>
                                    <strong>@(string.IsNullOrWhiteSpace(prodPrincipal.Categoria) ? "Especialidad" : prodPrincipal.Categoria)</strong>
                                </div>
                            </div>

                            <div class="sg-ref-spec-item">
                                <div class="sg-ref-spec-icon">
                                    <i class="fa-solid fa-mug-hot"></i>
                                </div>
                                <div class="sg-ref-spec-info">
                                    <small>PRECIO & DISPONIBILIDAD</small>
                                    <strong>&#8353; @prodPrincipal.Precio.ToString("N0") / kg · @prodPrincipal.Stock.ToString("N0") kg</strong>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="sg-ref-spec-item">
                                <div class="sg-ref-spec-icon">
                                    <i class="fa-solid fa-leaf"></i>
                                </div>
                                <div class="sg-ref-spec-info">
                                    <small>VARIEDAD</small>
                                    <strong>Arábica San Gabriel</strong>
                                </div>
                            </div>

                            <div class="sg-ref-spec-item">
                                <div class="sg-ref-spec-icon">
                                    <i class="fa-solid fa-droplet"></i>
                                </div>
                                <div class="sg-ref-spec-info">
                                    <small>PROCESO</small>
                                    <strong>Honey / Lavado</strong>
                                </div>
                            </div>

                            <div class="sg-ref-spec-item">
                                <div class="sg-ref-spec-icon">
                                    <i class="fa-solid fa-mug-hot"></i>
                                </div>
                                <div class="sg-ref-spec-info">
                                    <small>ESTADO</small>
                                    <strong>Cosecha en preparación</strong>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="sg-ref-harvest-footer">
                        <span>COSECHA @DateTime.UtcNow.AddHours(-6).Year @(totalProductos > 0 ? $"• {totalProductos} {(totalProductos == 1 ? "VARIEDAD" : "VARIEDADES")}" : "")</span>
                    </div>
                </div>
            </div>

        </div>

        <div class="sg-ref-bottom-bar">
            <div class="sg-ref-benefit-col">
                <div class="sg-ref-benefit-icon">
                    <i class="fa-solid fa-leaf"></i>
                </div>
                <div class="sg-ref-benefit-text">
                    <strong>Café de origen</strong>
                    <small>Cultivado con pasión</small>
                </div>
            </div>

            <div class="sg-ref-benefit-divider"></div>

            <div class="sg-ref-benefit-col">
                <div class="sg-ref-benefit-icon">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div class="sg-ref-benefit-text">
                    <strong>Trazabilidad garantizada</strong>
                    <small>Transparencia en cada etapa</small>
                </div>
            </div>

            <div class="sg-ref-benefit-divider"></div>

            <div class="sg-ref-benefit-col">
                <div class="sg-ref-benefit-icon">
                    <i class="fa-solid fa-bag-shopping"></i>
                </div>
                <div class="sg-ref-benefit-text">
                    <strong>Compra organizada</strong>
                    <small>Gestión simple y eficiente</small>
                </div>
            </div>
        </div>
    </section>

    <section class="cafe-summary-grid">
        <article class="cafe-summary-card">
            <i class="fa-solid fa-mug-hot"></i>

            <div>
                <span>Cafés disponibles</span>
                <strong>@totalProductos</strong>
            </div>
        </article>

        <article class="cafe-summary-card">
            <i class="fa-solid fa-bag-shopping"></i>

            <div>
                <span>Total de pedidos</span>
                <strong>@totalPedidos</strong>
            </div>
        </article>

        <article class="cafe-summary-card">
            <i class="fa-solid fa-hourglass-half"></i>

            <div>
                <span>En seguimiento</span>
                <strong>@pedidosPendientes</strong>
            </div>
        </article>

        <article class="cafe-summary-card">
            <i class="fa-solid fa-circle-check"></i>

            <div>
                <span>Completados</span>
                <strong>@pedidosCompletados</strong>
            </div>
        </article>
    </section>

    <section class="cafe-quick-section">
        <header class="cafe-section-header">
            <div>
                <span class="cafe-section-label">
                    Tu portal
                </span>

                <h2>Accesos rápidos</h2>

                <p>
                    Todo lo necesario para gestionar tus compras.
                </p>
            </div>
        </header>

        <div class="cafe-quick-grid">
            <a asp-controller="Productos"
               asp-action="Index"
               class="cafe-quick-card">

                <span class="cafe-quick-icon">
                    <i class="fa-solid fa-store"></i>
                </span>

                <div>
                    <strong>Productos</strong>
                    <small>
                        Explorá cafés, precios y disponibilidad.
                    </small>
                </div>

                <i class="fa-solid fa-arrow-right"></i>
            </a>

            <a asp-controller="Pedidos"
               asp-action="Create"
               class="cafe-quick-card">

                <span class="cafe-quick-icon">
                    <i class="fa-solid fa-cart-plus"></i>
                </span>

                <div>
                    <strong>Nuevo pedido</strong>
                    <small>
                        Solicitá tu café desde el portal.
                    </small>
                </div>

                <i class="fa-solid fa-arrow-right"></i>
            </a>

            <a asp-controller="Pedidos"
               asp-action="Index"
               class="cafe-quick-card">

                <span class="cafe-quick-icon">
                    <i class="fa-solid fa-clipboard-list"></i>
                </span>

                <div>
                    <strong>Mis pedidos</strong>
                    <small>
                        Consultá estados, pagos y entregas.
                    </small>
                </div>

                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </section>

    <section class="cafe-main-grid">

        <article class="cafe-section-card cafe-products-section">
            <header class="cafe-section-header">
                <div>
                    <span class="cafe-section-label">
                        Productos disponibles
                    </span>

                    <h2>Cafés disponibles para vos</h2>

                    <p>
                        Productos disponibles con mayor existencia.
                    </p>
                </div>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="cafe-small-button">
                    Ver catálogo
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </header>

            <div class="cafe-products-grid">
                @if (productosDestacados.Any())
                {
                    foreach (var producto in productosDestacados)
                    {
                        <article class="cafe-product-card">
                            <div class="cafe-product-image cafe-product-image-completa">
                                <img src="@ImagenProducto(producto)"
                                     alt="@producto.Nombre"
                                     loading="lazy" />

                                <span>
                                    @producto.Categoria
                                </span>
                            </div>

                            <div class="cafe-product-info">
                                <h3>@producto.Nombre</h3>

                                <p>
                                    @(string.IsNullOrWhiteSpace(producto.Descripcion)
                                        ? "Café de origen con calidad artesanal y trazabilidad."
                                        : producto.Descripcion)
                                </p>

                                <div class="cafe-product-footer">
                                    <strong>
                                        &#8353; @producto.Precio.ToString("N0")
                                    </strong>

                                    <span>
                                        @producto.Stock kg
                                    </span>
                                </div>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div class="cafe-empty-state">
                        <i class="fa-solid fa-mug-saucer"></i>

                        <p>
                            No hay productos destacados disponibles.
                        </p>
                    </div>
                }
            </div>
        </article>

        <aside class="cafe-section-card cafe-orders-section">
            <header class="cafe-section-header">
                <div>
                    <span class="cafe-section-label">
                        Tu actividad
                    </span>

                    <h2>Pedidos recientes</h2>

                    <p>
                        Consultá el estado de tus compras.
                    </p>
                </div>

                <a asp-controller="Pedidos"
                   asp-action="Index"
                   class="cafe-icon-link"
                   title="Ver historial"
                   aria-label="Ver historial">
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </header>

            <div class="cafe-orders-list">
                @if (ultimosPedidos.Any())
                {
                    foreach (var pedido in ultimosPedidos.Take(5))
                    {
                        <article class="cafe-order-item">
                            <div class="cafe-order-icon">
                                <i class="fa-solid fa-bag-shopping"></i>
                            </div>

                            <div class="cafe-order-data">
                                <strong>
                                    Pedido #@pedido.Id
                                </strong>

                                <span>
                                    @(pedido.ProductoNombreMostrar)
                                    · @pedido.Cantidad kg
                                </span>

                                <small>
                                    @pedido.FechaPedido.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                            <span class="cafe-order-status">
                                @pedido.Estado
                            </span>
                        </article>
                    }
                }
                else
                {
                    <div class="cafe-empty-state">
                        <i class="fa-solid fa-clipboard-list"></i>

                        <p>
                            Todavía no hay pedidos registrados.
                        </p>
                    </div>
                }
            </div>

            <a asp-controller="Pedidos"
               asp-action="Create"
               class="cafe-order-button">
                <i class="fa-solid fa-plus"></i>
                Realizar un nuevo pedido
            </a>
        </aside>

    </section>


</div>