@using System.Text.Json
@using MicrobeneficioSanGabriel.Models
@{
    ViewData["Title"] = "Dashboard Ejecutivo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var pedidos = ViewBag.UltimosPedidos as List<Pedido> ?? new List<Pedido>();
    var productosInventario = ViewBag.ProductosInventario as List<Producto> ?? new List<Producto>();
    var estadosPedidos = ViewBag.EstadosPedidos as Dictionary<string, int> ?? new Dictionary<string, int>();
    var procesosPorEstado = ViewBag.ProcesosPorEstado as Dictionary<string, int> ?? new Dictionary<string, int>();

    var ventasMes = Convert.ToDecimal(ViewBag.VentasMes ?? 0m);
    var produccionMesKg = Convert.ToDouble(ViewBag.ProduccionMesKg ?? 0d);
    var lotesActivos = Convert.ToInt32(ViewBag.LotesActivos ?? 0);
    var pedidosPendientes = Convert.ToInt32(ViewBag.PedidosPendientes ?? 0);
    var totalStockKg = Convert.ToDecimal(ViewBag.TotalStockKg ?? 0m);
    var puedeVerOperacion = User.IsInRole("Administrador") || User.IsInRole("Operador");
    var puedeVerComercial = User.IsInRole("Administrador") || User.IsInRole("Vendedor");
    var produccionesEnProceso = Convert.ToInt32(ViewBag.ProduccionesEnProceso ?? 0);
    var produccionesCompletadasHoy = Convert.ToInt32(ViewBag.ProduccionesCompletadasHoy ?? 0);
    var totalRegistrosTrazabilidad = Convert.ToInt32(ViewBag.TotalRegistrosTrazabilidad ?? 0);
    var lotesConTrazabilidad = Convert.ToInt32(ViewBag.LotesConTrazabilidad ?? 0);
    var porcentajeTrazabilidad = Convert.ToDecimal(ViewBag.PorcentajeTrazabilidad ?? 0m);
    var periodoActual = ViewBag.PeriodoActual as string ?? DateTime.Today.ToString("MMMM yyyy");
    var anioActual = Convert.ToInt32(ViewBag.AnioActual ?? DateTime.Today.Year);

    var completados = estadosPedidos.ContainsKey("Completado") ? estadosPedidos["Completado"] : 0;
    var enProcesoPedidos = estadosPedidos.ContainsKey("En proceso") ? estadosPedidos["En proceso"] : 0;
    var pendientesPedidos = estadosPedidos.ContainsKey("Pendiente") ? estadosPedidos["Pendiente"] : 0;
    var canceladosPedidos = estadosPedidos.ContainsKey("Cancelado") ? estadosPedidos["Cancelado"] : 0;
    var totalPedidosEstados = estadosPedidos.Values.Sum();
    decimal Porcentaje(int valor) => totalPedidosEstados == 0 ? 0 : Math.Round(valor * 100m / totalPedidosEstados, 0);

    var coloresPedidos = new[]
    {
        new { Clase = "green", Hex = "#5F7F57", Label = "Completados", Valor = completados },
        new { Clase = "gold", Hex = "#C46816", Label = "En proceso", Valor = enProcesoPedidos },
        new { Clase = "tan", Hex = "#E8B66F", Label = "Pendientes", Valor = pendientesPedidos },
        new { Clase = "brown", Hex = "#AD4939", Label = "Cancelados", Valor = canceladosPedidos }
    };

    string FormatoPorcentaje(decimal valor) =>
        valor.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    string CrearDonutPedidos()
    {
        if (totalPedidosEstados <= 0)
        {
            return "conic-gradient(#eadfce 0% 100%)";
        }

        var segmentos = new List<string>();
        decimal acumulado = 0m;

        foreach (var estado in coloresPedidos)
        {
            if (estado.Valor <= 0)
            {
                continue;
            }

            var inicio = acumulado;
            acumulado += estado.Valor * 100m / totalPedidosEstados;
            segmentos.Add($"{estado.Hex} {FormatoPorcentaje(inicio)}% {FormatoPorcentaje(acumulado)}%");
        }

        return segmentos.Any()
            ? $"conic-gradient({string.Join(", ", segmentos)})"
            : "conic-gradient(#eadfce 0% 100%)";
    }

    var donutPedidos = CrearDonutPedidos();

    int ValorProceso(params string[] nombres)
    {
        return procesosPorEstado
            .Where(e => nombres.Any(n => string.Equals(e.Key, n, StringComparison.OrdinalIgnoreCase)))
            .Sum(e => e.Value);
    }

    var procesosCompletados = ValorProceso("Completado", "Completada", "Completados", "Completadas");
    var procesosCancelados = ValorProceso("Cancelado", "Cancelada", "Cancelados", "Canceladas");
    var procesosPendientes = ValorProceso("Pendiente", "Pendientes");
    var procesosEnProceso = ValorProceso("En proceso", "En Proceso", "Proceso");
    var totalProcesosEstados = procesosPorEstado.Values.Sum();
    var procesosOtros = Math.Max(0, totalProcesosEstados - procesosCompletados - procesosEnProceso - procesosPendientes - procesosCancelados);

    var coloresProduccion = new[]
    {
        new { Clase = "green", Hex = "#5F7F57", Label = "Completado", Valor = procesosCompletados },
        new { Clase = "gold", Hex = "#C46816", Label = "En proceso", Valor = procesosEnProceso },
        new { Clase = "tan", Hex = "#E8B66F", Label = "Pendiente", Valor = procesosPendientes },
        new { Clase = "brown", Hex = "#AD4939", Label = "Cancelado", Valor = procesosCancelados },
        new { Clase = "coffee", Hex = "#74320D", Label = "Otros", Valor = procesosOtros }
    };

    string CrearDonutProduccion()
    {
        if (totalProcesosEstados <= 0)
        {
            return "conic-gradient(#eadfce 0% 100%)";
        }

        var segmentos = new List<string>();
        decimal acumulado = 0m;

        foreach (var estado in coloresProduccion)
        {
            if (estado.Valor <= 0)
            {
                continue;
            }

            var inicio = acumulado;
            acumulado += estado.Valor * 100m / totalProcesosEstados;
            segmentos.Add($"{estado.Hex} {FormatoPorcentaje(inicio)}% {FormatoPorcentaje(acumulado)}%");
        }

        return segmentos.Any()
            ? $"conic-gradient({string.Join(", ", segmentos)})"
            : "conic-gradient(#eadfce 0% 100%)";
    }

    var donutProduccion = CrearDonutProduccion();

    var ventasMensuales = JsonSerializer.Serialize(ViewBag.VentasMensuales ?? new List<decimal>());

    string ImagenProducto(Producto producto)
    {
        if (!string.IsNullOrWhiteSpace(producto.ImagenUrl)) return producto.ImagenUrl;

        var valor = (producto.Nombre ?? string.Empty).ToLowerInvariant();
        if (valor.Contains("premium")) return "/images/products/cafe-premium.jpg";
        if (valor.Contains("normal")) return "/images/products/cafe-normal.jpg";
        return "/images/products/default-coffee.jpg";
    }
}
<section class="sg-page-head">
    <div>
        <h1>Dashboard Ejecutivo</h1>
        <p>Resumen general con información real registrada en la base de datos.</p>
    </div>
    <div class="sg-actions">
        <span class="sg-btn ghost"><i class="fa-regular fa-calendar"></i> @periodoActual</span>
        <a asp-controller="Home" asp-action="Dashboard" class="sg-btn green"><i class="fa-solid fa-rotate"></i> Actualizar</a>
    </div>
</section>

<section class="sg-kpi-grid">
    @if (puedeVerOperacion)
    {
        <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-seedling"></i></span><div><span>Producción del mes</span><strong>@produccionMesKg.ToString("N1") kg</strong><div class="sg-trend">Dato real del mes actual</div></div></article>
        <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-layer-group"></i></span><div><span>Lotes activos</span><strong>@lotesActivos</strong><div class="sg-trend">Según estado del lote</div></div></article>
    }
    @if (puedeVerComercial)
    {
        <article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-cart-shopping"></i></span><div><span>Ventas del mes</span><strong>₡@ventasMes.ToString("N0")</strong><div class="sg-trend">Pagos completados</div></div></article>
        <article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-clipboard-list"></i></span><div><span>Pedidos pendientes</span><strong>@pedidosPendientes</strong><div class="sg-trend warn">Pendiente / En proceso</div></div></article>
    }
</section>

@if (puedeVerComercial)
{
<section class="sg-grid-2">
    <article class="sg-card sg-panel">
        <div class="sg-panel-head">
            <div><h2>Ventas mensuales</h2><small><span class="sg-dot"></span> Cobros confirmados @anioActual</small></div>
            <span class="sg-btn ghost">@anioActual</span>
        </div>
        <div class="sg-chart"><canvas id="ventasChart"></canvas></div>
    </article>
    <article class="sg-card sg-panel">
        <div class="sg-panel-head"><h2>Estado de pedidos</h2></div>
        <div class="sg-donut-wrap">
            <div class="sg-donut" style="--donut-bg: @donutPedidos;"><div><b>@Porcentaje(completados)%</b><br/><span>Completados</span></div></div>
            <div class="sg-legend">
                @foreach (var estado in coloresPedidos)
                {
                    <div class="sg-legend-row">
                        <span class="sg-dot @estado.Clase"></span>
                        <span>@estado.Label</span>
                        <b>@estado.Valor (@Porcentaje(estado.Valor)%)</b>
                    </div>
                }
            </div>
        </div>
    </article>
</section>
}

@if (puedeVerOperacion)
{
<section class="sg-grid-3">
    <article class="sg-card sg-panel">
        <div class="sg-panel-head"><h3>Inventario por producto</h3><a class="text-success fw-bold" asp-controller="MovimientosInventario" asp-action="Index">Ver detalles</a></div>
        <div class="sg-mini-list">
            @if (productosInventario.Any())
            {
                foreach (var producto in productosInventario)
                {
                    var porcentajeStock = totalStockKg == 0 ? 0 : Math.Min(100, (int)Math.Round(producto.Stock * 100m / totalStockKg));
                    <div class="sg-mini-row">
                        <img class="sg-thumb" src="@ImagenProducto(producto)" alt="@producto.Nombre" />
                        <span>@producto.Nombre<div class="sg-bar"><span style="width:@porcentajeStock%"></span></div></span>
                        <b>@producto.Stock kg</b>
                    </div>
                }
            }
            else
            {
                <div class="text-muted py-3">No hay productos activos registrados.</div>
            }
        </div>
    </article>
    <article class="sg-card sg-panel">
        <div class="sg-panel-head"><h3>Procesos de producción</h3><a class="text-success fw-bold" asp-controller="Producciones" asp-action="Index">Ver detalles</a></div>
        <div class="sg-donut-wrap">
            <div class="sg-donut" style="--donut-bg: @donutProduccion; width:138px;height:138px"><div><b>@totalProcesosEstados</b><br/><span>Procesos</span></div></div>
            <div class="sg-legend">
                @if (coloresProduccion.Any(e => e.Valor > 0))
                {
                    foreach (var estado in coloresProduccion.Where(e => e.Valor > 0))
                    {
                        <div class="sg-legend-row">
                            <span class="sg-dot @estado.Clase"></span>
                            <b>@estado.Valor</b>
                            <span>@estado.Label</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">No hay procesos registrados.</div>
                }
            </div>
        </div>
    </article>
    <article class="sg-card sg-panel">
        <div class="sg-panel-head"><h3>Rendimiento de trazabilidad</h3><a class="text-success fw-bold" asp-controller="Trazabilidades" asp-action="Index">Ver detalles</a></div>
        <div class="sg-donut-wrap">
            <div class="sg-donut"><div><b>@porcentajeTrazabilidad%</b><br/><span>Trazabilidad</span></div></div>
            <div class="sg-mini-list">
                <div class="sg-mini-row"><i class="fa-solid fa-shield-halved text-success"></i><span>Registros de trazabilidad</span><b>@totalRegistrosTrazabilidad</b></div>
                <div class="sg-mini-row"><i class="fa-solid fa-layer-group text-success"></i><span>Lotes con trazabilidad</span><b>@lotesConTrazabilidad</b></div>
            </div>
        </div>
    </article>
</section>
}

@if (puedeVerComercial)
{
<section class="sg-card sg-table-card">
    <div class="sg-panel-head"><h3>Pedidos recientes</h3><a class="text-success fw-bold" asp-controller="Pedidos" asp-action="Index">Ver todos</a></div>
    <div class="table-responsive">
        <table class="sg-table">
            <thead><tr><th>Pedido</th><th>Cliente</th><th>Producto</th><th>Cantidad</th><th>Estado</th><th>Fecha</th><th>Total</th><th></th></tr></thead>
            <tbody>
                @if (pedidos.Any())
                {
                    foreach(var p in pedidos.Take(5))
                    {
                        <tr><td>#P-@p.Id.ToString("0000")</td><td>@p.ClienteNombre</td><td>@(p.Producto?.Nombre ?? "Producto")</td><td>@p.Cantidad kg</td><td><span class="sg-badge @(p.Estado == "Completado" ? "" : p.Estado == "Pendiente" ? "tan" : "gold")">@p.Estado</span></td><td>@p.FechaPedido.ToString("dd MMM yyyy")</td><td>₡@(((p.Producto?.Precio ?? 0) * p.Cantidad).ToString("N0"))</td><td><a asp-controller="Pedidos" asp-action="Details" asp-route-id="@p.Id"><i class="fa-solid fa-eye"></i></a></td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-muted text-center py-4">No hay pedidos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
}

@section Scripts {
    <script>
        let ventasChart;
        const ventasMensuales = @Html.Raw(ventasMensuales);

        crearGrafico();

        function crearGrafico() {
            const canvas = document.getElementById("ventasChart");
            if (!canvas) return;

            const darkMode = localStorage.getItem("theme") === "dark";
            const textColor = darkMode ? "#E8E1D8" : "#5B4A3C";
            const gridColor = darkMode ? "rgba(255, 255, 255, .10)" : "rgba(43, 26, 14, .08)";

            ventasChart = new Chart(canvas, {
                type: "bar",
                data: {
                    labels: [
                        "Ene", "Feb", "Mar", "Abr", "May", "Jun",
                        "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"
                    ],
                    datasets: [{
                        data: ventasMensuales,
                        backgroundColor: "#C46816",
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                color: textColor
                            },
                            grid: {
                                display: false
                            },
                            border: {
                                color: gridColor
                            }
                        },
                        y: {
                            ticks: {
                                color: textColor,
                                callback: value => "₡" + Number(value).toLocaleString("es-CR")
                            },
                            grid: {
                                color: gridColor
                            },
                            border: {
                                color: gridColor
                            }
                        }
                    }
                }
            });
        }

        function actualizarGraficoTema() {
            if (!ventasChart) return;

            const darkMode = document.body.classList.contains("dark");
            const textColor = darkMode ? "#E8E1D8" : "#5B4A3C";
            const gridColor = darkMode ? "rgba(255, 255, 255, .10)" : "rgba(43, 26, 14, .08)";

            ventasChart.options.scales.x.ticks.color = textColor;
            ventasChart.options.scales.y.ticks.color = textColor;
            ventasChart.options.scales.x.border.color = gridColor;
            ventasChart.options.scales.y.border.color = gridColor;
            ventasChart.options.scales.y.grid.color = gridColor;

            ventasChart.update();
        }
    </script>
}
