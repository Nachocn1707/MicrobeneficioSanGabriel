@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">

    <div>
        <h1>Dashboard Administrativo</h1>
        <p>
            Panel general del sistema Microbeneficio San Gabriel.
        </p>
    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="admin-card dashboard-card">

            <div class="dashboard-number">
                1
            </div>

            <div class="dashboard-label">
                Usuarios registrados
            </div>

        </div>
    </div>

    <div class="col-md-3">
        <div class="admin-card dashboard-card">

            <div class="dashboard-number">
                1
            </div>

            <div class="dashboard-label">
                Productores activos
            </div>

        </div>
    </div>

    <div class="col-md-3">
        <div class="admin-card dashboard-card">

            <div class="dashboard-number">
                1
            </div>

            <div class="dashboard-label">
                Productos registrados
            </div>

        </div>
    </div>

    <div class="col-md-3">
        <div class="admin-card dashboard-card">

            <div class="dashboard-number">
                0
            </div>

            <div class="dashboard-label">
                Movimientos inventario
            </div>

        </div>
    </div>

</div>

<div class="row g-4">

    <div class="col-md-4">

        <div class="admin-card dashboard-module">

            <h4>Productores</h4>

            <p>
                Gestión de productores asociados al microbeneficio.
            </p>

            <a asp-controller="Productores"
                   asp-action="Index"
                   class="btn btn-admin-primary">
                Ir al módulo
            </a>

        </div>

    </div>

    <div class="col-md-4">

        <div class="admin-card dashboard-module">

            <h4>Productos</h4>

            <p>
                Administración de productos y stock disponible.
            </p>

            <a asp-controller="Productos"
                   asp-action="Index"
                   class="btn btn-admin-primary">
                Ir al módulo
            </a>

        </div>

    </div>

    <div class="col-md-4">

        <div class="admin-card dashboard-module">

            <h4>Inventario</h4>

            <p>
                Control de entradas, salidas y movimientos internos.
            </p>

            <a asp-controller="MovimientosInventario"
                   asp-action="Index"
                   class="btn btn-admin-primary">
                Ir al módulo
            </a>

        </div>

    </div>

</div>