@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="sidebar">

    <h3>San Gabriel</h3>

    <a href="#">Dashboard</a>
    <a href="#">Usuarios</a>
    <a href="#">Productores</a>
    <a href="#">Inventario</a>
    <a href="#">Recepción Café</a>
    <a href="#">Productos</a>
    <a href="#">Reportes</a>

</div>

<div class="main-content">

    <div class="topbar">
        <h2 class="mb-0">Dashboard Administrativo</h2>
    </div>

    <div class="row g-4">

        <div class="col-md-3">
            <div class="card-dashboard">
                <h6>Usuarios</h6>
                <h2>@ViewBag.TotalUsuarios</h2>
                <p>Usuarios registrados</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-dashboard">
                <h6>Productores</h6>
                <h2>@ViewBag.TotalProductores</h2>
                <p>Productores registrados</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-dashboard">
                <h6>Productos</h6>
                <h2>@ViewBag.TotalProductos</h2>
                <p>Productos disponibles</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-dashboard">
                <h6>Inventario</h6>
                <h2>@ViewBag.TotalInventario</h2>
                <p>Movimientos registrados</p>
            </div>
        </div>

    </div>

    <div class="row mt-5 g-4">

        <div class="col-md-4">
            <div class="module-card">
                <h4>Gestión de productores</h4>
                <p>
                    Registro y administración de productores asociados al microbeneficio.
                </p>

                <button class="btn btn-dark">
                    Próximamente
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="module-card">
                <h4>Inventario</h4>
                <p>
                    Control de existencias, entradas y salidas.
                </p>

                <button class="btn btn-dark">
                    Próximamente
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="module-card">
                <h4>Reportes</h4>
                <p>
                    Visualización de información operativa y administrativa.
                </p>

                <button class="btn btn-dark">
                    Próximamente
                </button>
            </div>
        </div>

    </div>

</div>