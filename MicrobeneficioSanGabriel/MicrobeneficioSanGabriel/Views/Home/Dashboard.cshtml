@using System.Text.Json
@using MicrobeneficioSanGabriel.Models

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var ultimosPedidos = ViewBag.UltimosPedidos as List<Pedido>;
    var ultimasFacturas = ViewBag.UltimasFacturas as List<Factura>;
    var productosStockBajo = ViewBag.ProductosStockBajo as List<Producto>;

    var nombresProductosJson = JsonSerializer.Serialize(ViewBag.NombresProductos);
    var stockProductosJson = JsonSerializer.Serialize(ViewBag.StockProductos);
    var ventasProductosJson = JsonSerializer.Serialize(ViewBag.VentasProductos);

    var fechaActual = DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy");
}

<style>
    .dashboard-page {
        display: grid;
        gap: 22px;
    }

    .dashboard-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
    }

    .dashboard-title h1 {
        margin: 0;
        color: #2a1a12;
        font-size: 24px;
        font-weight: 950;
    }

    .dashboard-title p {
        margin: 4px 0 0;
        color: #8b7a6c;
        font-size: 13px;
        font-weight: 600;
    }

    .date-pill {
        background: #fffaf2;
        border: 1px solid #eadfce;
        border-radius: 10px;
        padding: 10px 14px;
        color: #2a1a12;
        font-size: 13px;
        font-weight: 900;
        box-shadow: 0 10px 24px rgba(58, 33, 20, 0.07);
        white-space: nowrap;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .summary-card {
        background: #fffdf8;
        border: 1px solid #eadfce;
        border-radius: 15px;
        padding: 18px;
        min-height: 132px;
        box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
        position: relative;
        overflow: hidden;
    }

    .summary-icon {
        width: 34px;
        height: 34px;
        border-radius: 11px;
        background: #fff2d5;
        color: #bd812c;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
    }

    .summary-card.green .summary-icon {
        background: #e5f4e8;
        color: #3f8f4d;
    }

    .summary-card.blue .summary-icon {
        background: #e3f1fb;
        color: #4f98d4;
    }

    .summary-card.red .summary-icon {
        background: #fde7e4;
        color: #d85d4c;
    }

    .summary-card span {
        display: block;
        color: #6f6258;
        font-size: 12px;
        font-weight: 900;
        margin-bottom: 3px;
    }

    .summary-card strong {
        display: block;
        color: #2a1a12;
        font-size: 28px;
        line-height: 1;
        font-weight: 950;
    }

    .summary-card small {
        display: block;
        margin-top: 8px;
        color: #b58a45;
        font-size: 11px;
        font-weight: 800;
    }

    .sparkline {
        position: absolute;
        right: 12px;
        bottom: 10px;
        width: 120px;
        height: 44px;
        opacity: 0.75;
    }

    .main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 18px;
    }

    .dashboard-panel {
        background: #fffdf8;
        border: 1px solid #eadfce;
        border-radius: 16px;
        box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
        overflow: hidden;
    }

    .panel-header {
        padding: 18px 20px 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .panel-header h2 {
            margin: 0;
            color: #2a1a12;
            font-size: 17px;
            font-weight: 950;
        }

    .panel-link {
        color: #7a532d;
        text-decoration: none;
        font-size: 12px;
        font-weight: 900;
    }

    .dashboard-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        .dashboard-table thead th {
            color: #8b7a6c;
            background: transparent;
            padding: 12px 20px;
            font-size: 11px;
            font-weight: 950;
            border-bottom: 1px solid #eee2d1;
        }

        .dashboard-table tbody td {
            padding: 12px 20px;
            border-bottom: 1px solid #f0e6d8;
            color: #2a1a12;
            font-weight: 650;
        }

        .dashboard-table tbody tr:last-child td {
            border-bottom: none;
        }

    .status-badge {
        border-radius: 999px;
        padding: 5px 9px;
        font-size: 10px;
        font-weight: 950;
        display: inline-block;
    }

    .status-ok {
        background: #dff2e3;
        color: #2f7d4f;
    }

    .status-warn {
        background: #fff1c7;
        color: #9a6b13;
    }

    .status-info {
        background: #dceefb;
        color: #2f80a7;
    }

    .chart-panel {
        padding-bottom: 18px;
    }

    .stock-chart-wrap {
        height: 210px;
        padding: 4px 20px 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stock-legend {
        display: grid;
        gap: 9px;
        padding: 4px 24px 0;
    }

    .legend-item {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        color: #6f6258;
        font-size: 12px;
        font-weight: 800;
    }

    .legend-name {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #d9a44a;
    }

        .legend-dot.green {
            background: #3f8f4d;
        }

    .modules-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .module-card {
        background: #fffdf8;
        border: 1px solid #eadfce;
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
    }

        .module-card h3 {
            margin: 0 0 8px;
            color: #2a1a12;
            font-size: 18px;
            font-weight: 950;
        }

        .module-card p {
            min-height: 42px;
            margin: 0 0 14px;
            color: #7a6a5d;
            font-size: 13px;
            font-weight: 600;
        }

    .module-number {
        color: #7a532d;
        font-size: 28px;
        font-weight: 950;
        margin-bottom: 12px;
    }

    .module-card .btn {
        width: 100%;
        background: #3a2114 !important;
        border-color: #3a2114 !important;
        color: #fffaf2 !important;
        border-radius: 9px !important;
        font-weight: 950 !important;
    }

    @@media (max-width: 1200px) {
        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .main-grid {
            grid-template-columns: 1fr;
        }

        .modules-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-head {
            flex-direction: column;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-page">

    <div class="dashboard-head">
        <div class="dashboard-title">
            <h1>Resumen general</h1>
            <p>Bienvenido de vuelta, Administrador</p>
        </div>

        <div class="date-pill">
            @fechaActual
        </div>
    </div>

    <div class="summary-grid">

        <div class="summary-card">
            <div class="summary-icon">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <span>Pedidos registrados</span>
            <strong>@ViewBag.TotalPedidos</strong>
            <small>Ver pedidos</small>

            <svg class="sparkline" viewBox="0 0 120 44" preserveAspectRatio="none">
                <path d="M2 34 C18 28, 28 36, 42 30 S66 18, 80 22 S100 31, 118 10"
                      fill="none" stroke="#d9a44a" stroke-width="3" />
            </svg>
        </div>

        <div class="summary-card">
            <div class="summary-icon">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <span>Facturas emitidas</span>
            <strong>@ViewBag.TotalFacturas</strong>
            <small>Ver facturas</small>

            <svg class="sparkline" viewBox="0 0 120 44" preserveAspectRatio="none">
                <path d="M2 32 C18 34, 28 27, 42 30 S65 35, 78 24 S96 13, 118 19"
                      fill="none" stroke="#d9a44a" stroke-width="3" />
            </svg>
        </div>

        <div class="summary-card green">
            <div class="summary-icon">
                <i class="fa-solid fa-mug-hot"></i>
            </div>
            <span>Productos activos</span>
            <strong>@ViewBag.TotalProductos</strong>
            <small>Ver productos</small>

            <svg class="sparkline" viewBox="0 0 120 44" preserveAspectRatio="none">
                <path d="M2 33 C18 31, 32 35, 45 29 S67 19, 82 21 S100 12, 118 8"
                      fill="none" stroke="#78b884" stroke-width="3" />
            </svg>
        </div>

        <div class="summary-card blue">
            <div class="summary-icon">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <span>Productos con stock bajo</span>
            <strong>@ViewBag.StockBajo</strong>
            <small>Ver inventario</small>

            <svg class="sparkline" viewBox="0 0 120 44" preserveAspectRatio="none">
                <path d="M2 35 C20 29, 32 33, 46 26 S67 15, 80 20 S96 30, 118 12"
                      fill="none" stroke="#7bb6e8" stroke-width="3" />
            </svg>
        </div>

    </div>

    <div class="main-grid">

        <div class="dashboard-panel">
            <div class="panel-header">
                <h2>Pedidos recientes</h2>
                <a asp-controller="Pedidos" asp-action="Index" class="panel-link">
                    Ver todos los pedidos
                </a>
            </div>

            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (ultimosPedidos != null && ultimosPedidos.Any())
                    {
                        foreach (var pedido in ultimosPedidos)
                        {
                            <tr>
                                <td>@pedido.ClienteNombre</td>
                                <td>@pedido.Producto?.Nombre</td>
                                <td>@pedido.Cantidad kg</td>
                                <td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (pedido.Estado == "Completado")
                                    {
                                        <span class="status-badge status-ok">Completado</span>
                                    }
                                    else if (pedido.Estado == "Pendiente")
                                    {
                                        <span class="status-badge status-warn">Pendiente</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-info">@pedido.Estado</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Pedidos"
                                       asp-action="Details"
                                       asp-route-id="@pedido.Id"
                                       class="panel-link">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">No hay pedidos registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="dashboard-panel chart-panel">
            <div class="panel-header">
                <h2>Stock por producto</h2>
            </div>

            <div class="stock-chart-wrap">
                <canvas id="stockChart"></canvas>
            </div>

            <div class="stock-legend" id="stockLegend"></div>
        </div>

    </div>

    <div class="modules-grid">

        <div class="module-card">
            <h3>Pedidos</h3>
            <p>Gestión de pedidos realizados por clientes.</p>
            <div class="module-number">@ViewBag.TotalPedidos</div>

            <a asp-controller="Pedidos"
               asp-action="Index"
               class="btn btn-success">
                Ir al módulo
            </a>
        </div>

        <div class="module-card">
            <h3>Facturación</h3>
            <p>Administración de facturas y pagos.</p>
            <div class="module-number">@ViewBag.TotalFacturas</div>

            <a asp-controller="Facturas"
               asp-action="Index"
               class="btn btn-success">
                Ir al módulo
            </a>
        </div>

        <div class="module-card">
            <h3>Ventas totales</h3>
            <p>Total acumulado de ventas realizadas.</p>
            <div class="module-number">
                ₡ @ViewBag.TotalVentas.ToString("N2")
            </div>

            <a asp-controller="Reportes"
               asp-action="Index"
               class="btn btn-success">
                Ver reportes
            </a>
        </div>

    </div>

    <div class="main-grid">

        <div class="dashboard-panel chart-panel">
            <div class="panel-header">
                <h2>Ventas por producto</h2>
            </div>

            <div class="stock-chart-wrap">
                <canvas id="ventasChart"></canvas>
            </div>
        </div>

        <div class="dashboard-panel">
            <div class="panel-header">
                <h2>Alertas de stock</h2>
            </div>

            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @if (productosStockBajo != null && productosStockBajo.Any())
                    {
                        foreach (var producto in productosStockBajo)
                        {
                            <tr>
                                <td>@producto.Nombre</td>
                                <td>
                                    <span class="status-badge status-warn">
                                        @producto.Stock
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2">No hay alertas de stock.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const productos = @Html.Raw(nombresProductosJson);
    const stockProductos = @Html.Raw(stockProductosJson);
    const ventasProductos = @Html.Raw(ventasProductosJson);

    const stockColors = [
    "#d9a44a",
    "#3f8f4d",
    "#8a5a36",
    "#7bb6e8",
    "#f5dfb0",
    "#6f4528"
    ];

    const stockCtx = document.getElementById("stockChart");

    new Chart(stockCtx, {
    type: "doughnut",
    data: {
    labels: productos,
    datasets: [{
    data: stockProductos,
    backgroundColor: stockColors,
    borderColor: "#fffdf8",
    borderWidth: 4
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    cutout: "68%",
    plugins: {
    legend: {
    display: false
    }
    }
    }
    });

    const stockLegend = document.getElementById("stockLegend");

    if (stockLegend && productos && productos.length) {
    stockLegend.innerHTML = productos.slice(0, 4).map((producto, index) => `
    <div class="legend-item">
    <span class="legend-name">
    <span class="legend-dot" style="background:${stockColors[index % stockColors.length]}"></span>
    ${producto}
    </span>
    <strong>${stockProductos[index] ?? 0} kg</strong>
    </div>
    `).join("");
    }

    const ventasCtx = document.getElementById("ventasChart");

    new Chart(ventasCtx, {
    type: "doughnut",
    data: {
    labels: ventasProductos.map(v => v.Producto),
    datasets: [{
    label: "Ventas por producto",
    data: ventasProductos.map(v => v.Total),
    backgroundColor: [
    "#3f8f4d",
    "#d9a44a",
    "#6f4528",
    "#7bb6e8",
    "#f5dfb0"
    ],
    borderColor: "#fffdf8",
    borderWidth: 4
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    cutout: "68%",
    plugins: {
    legend: {
    position: "bottom",
    labels: {
    boxWidth: 10,
    color: "#6f6258",
    font: {
    size: 11,
    weight: "bold"
    }
    }
    }
    }
    }
    });
</script>