@model MicrobeneficioSanGabriel.Models.Finca

@{
    ViewData["Title"] = "Nueva finca";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaCrear.css" />
}

<div class="VistaCreaR-top">
    <div class="VistaCreaR-title">
        <span class="VistaCreaR-badge">
            <i class="fa-solid fa-mountain-sun"></i> Gestión de fincas
        </span>
        <h1>Nueva finca</h1>
        <p>
            Agregá una nueva finca al sistema del Microbeneficio San Gabriel.
        </p>
    </div>
</div>

<div class="sg-card">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-cancelar">
                <i class="fa-solid fa-arrow-left me-1"></i>Cancelar
            </a>
            <button type="submit" class="btn btn-success btn-crear">
                <i class="fa-solid fa-floppy-disk me-2"></i>Registrar finca
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
