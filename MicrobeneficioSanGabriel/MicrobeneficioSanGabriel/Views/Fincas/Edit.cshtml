@model MicrobeneficioSanGabriel.Models.Finca
@{
    ViewData["Title"] = "Editar finca";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditaR-top">
    <div class="EstiloEditaR-title">
        <span class="EstiloEditaR-badge">
            <i class="fa-solid fa-pen-to-square"></i>
            Actualización
        </span>
        <h1>Editar finca</h1>
        <p>Actualizá los datos y estados de las fincas registradas.</p>
    </div>
</div>

<div class="sg-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button class="btn btn-primary" type="submit"><i class="fa-solid fa-floppy-disk me-2"></i>Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
