@model IEnumerable<MicrobeneficioSanGabriel.Models.Finca>
@{
    ViewData["Title"] = "Fincas Registradas";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var fincas = Model.ToList();
    var total = fincas.Count;
    var activas = fincas.Count(f => f.Activa);
    var inactivas = fincas.Count(f => !f.Activa);
    var productores = fincas.Select(f => f.ProductorId).Distinct().Count();
}
<section class="sg-page-head"><div><h1>Fincas Registradas</h1><p>Gestiona y consulta todas las fincas productoras.</p></div><div class="sg-actions"><a asp-action="Create" class="sg-btn gold"><i class="fa-solid fa-plus"></i>Nueva finca</a><label class="sg-search"><i class="fa-solid fa-magnifying-glass"></i><input placeholder="Buscar finca, productor o ubicación..." /></label></div></section>
<section class="sg-hero" style="background-image:url('/images/visual/coffee-farm-admin-hd.jpg')"><div class="sg-hero-content"><span class="sg-brand-mark" style="width:58px;height:58px;color:white;border-color:white"><i class="fa-solid fa-seedling"></i></span><h2>Nuestra red de fincas</h2><p>Trabajamos junto a productores comprometidos con la calidad y la sostenibilidad del café.</p></div></section>
<section class="sg-kpi-grid three"><article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-seedling"></i></span><div><span>Fincas activas</span><strong>@activas</strong><div class="sg-trend">Según estado registrado</div></div></article><article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-users"></i></span><div><span>Productores asociados</span><strong>@productores</strong><div class="sg-trend">Productores con finca</div></div></article><article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-map-location-dot"></i></span><div><span>Fincas totales</span><strong>@total</strong><div class="sg-trend">@inactivas inactiva(s)</div></div></article></section>
<section class="sg-card sg-table-card"><div class="sg-panel-head"><h3>Listado de fincas</h3><span class="sg-badge">@total registro(s)</span></div><div class="table-responsive"><table class="sg-table" id="tablaFincas"><thead><tr><th>Finca</th><th>Productor</th><th>Provincia</th><th>Cantón</th><th>Distrito</th><th>Dirección exacta</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in fincas){<tr><td>@item.Nombre</td><td>@item.Productor?.Nombre</td><td>@item.Provincia</td><td>@item.Canton</td><td>@item.Distrito</td><td>@item.DireccionExacta</td><td><span class="sg-badge @(item.Activa?"":"tan")">@(item.Activa?"Activa":"Inactiva")</span></td><td><span class="sg-action-icons"><a asp-action="Details" asp-route-id="@item.Id"><i class="fa-solid fa-eye"></i></a>@if(User.IsInRole("Administrador")){<a asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pen"></i></a><a asp-action="Delete" asp-route-id="@item.Id"><i class="fa-solid fa-trash"></i></a>}</span></td></tr>}</tbody></table></div></section>
