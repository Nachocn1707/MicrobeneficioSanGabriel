@model MicrobeneficioSanGabriel.Models.Factura

@{
    ViewData["Title"] = "Nueva Factura";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaCrear.css" />
}

<div class="VistaCrear-page">
    <div class="VistaCrear-top">

        <div class="VistaCrear-title">

            <span class="VistaCrear-badge">
                Sistema de facturación
            </span>

            <h1>Nueva factura</h1>

            <p>
                Generá facturas automáticamente a partir
                de pedidos registrados en el sistema.
            </p>

        </div>

    </div>
    <div class="VistaCrear-card">

        <div class="VistaCrear-side">

            <div class="VistaCrear-side-content">

                <div class="VistaCrear-icon">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>

                <h2>Facturación</h2>

                <p>
                    Gestioná pagos, pedidos y facturas
                    para mantener el control financiero.
                </p>

                <div class="VistaCrear-info">

                    <div class="VistaCrear-info-item">
                        <i class="fa-solid fa-cart-shopping"></i>
                        Relación con pedidos
                    </div>

                    <div class="VistaCrear-info-item">
                        <i class="fa-solid fa-money-check-dollar"></i>
                        Control de pagos
                    </div>

                    <div class="VistaCrear-info-item">
                        <i class="fa-solid fa-receipt"></i>
                        Facturación automática
                    </div>

                </div>

            </div>

        </div>
        <div class="VistaCrear-form-container">

            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>

                <div class="row g-4">
                    <div class="col-md-6">

                        <label asp-for="PedidoId"
                               class="form-label">
                            Pedido
                        </label>

                        <div class="input-modern">

                            <i class="fa-solid fa-cart-shopping"></i>

                            <select asp-for="PedidoId"
                                    class="form-select"
                                    asp-items="ViewBag.PedidoId">

                                <option value="">
                                    Seleccione un pedido
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="PedidoId"
                              class="text-danger">
                        </span>

                    </div>
                    <div class="col-md-6">

                        <label asp-for="EstadoPago"
                               class="form-label">
                            Estado de pago
                        </label>

                        <div class="input-modern">

                            <i class="fa-solid fa-wallet"></i>

                            <select asp-for="EstadoPago"
                                    class="form-select">

                                <option value="Pendiente">
                                    Pendiente
                                </option>

                                <option value="Pagado">
                                    Pagado
                                </option>

                                <option value="Cancelado">
                                    Cancelado
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="EstadoPago"
                              class="text-danger">
                        </span>

                    </div>
                    <div class="col-md-12">

                        <label asp-for="Observacion"
                               class="form-label">
                            Observación
                        </label>

                        <div class="input-modern">

                            <i class="fa-solid fa-comment"></i>

                            <input asp-for="Observacion"
                                   class="form-control"
                                   placeholder="Detalle adicional de la factura" />

                        </div>

                        <span asp-validation-for="Observacion"
                              class="text-danger">
                        </span>

                    </div>

                </div>
                <div class="VistaCrear-alert">

                    <i class="fa-solid fa-circle-info"></i>

                    El subtotal, IVA y total se calcularán
                    automáticamente al guardar la factura.

                </div>
                <div class="VistaCrear-actions">

                    <a asp-action="Index"
                       class="btn-cancelar">
                        Volver
                    </a>

                    <button type="submit"
                            class="btn-crear">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Guardar factura

                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}