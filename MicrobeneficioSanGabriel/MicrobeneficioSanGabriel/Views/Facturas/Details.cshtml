@model MicrobeneficioSanGabriel.Models.Factura

@{
    ViewData["Title"] = "Detalles de factura";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var cliente = Model.Pedido?.ClienteNombre ?? "Sin cliente";
    var producto = Model.Pedido?.ProductoNombreMostrar ?? "Sin producto";
    var cantidad = Model.Pedido != null ? $"{Model.Pedido.Cantidad} kg" : "Sin cantidad";
    var telefono = Model.Pedido?.ClienteTelefono ?? "Sin teléfono";
    var observacion = string.IsNullOrWhiteSpace(Model.Observacion)
        ? "Sin observaciones"
        : Model.Observacion;

    string estadoClase = Model.EstadoPago switch
    {
        "Pago completado" => "movimiento-estado estado-pagado",
        "Pagado" => "movimiento-estado estado-pagado",
        "Pendiente" => "movimiento-estado estado-pendiente",
        "Anulada" => "movimiento-estado estado-anulada",
        _ => "movimiento-estado estado-neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<section class="Detalle-page-head">
    <div>
        <h1>Detalle de factura</h1>
        <p>Consultá la información registrada para esta factura.</p>
    </div>
    <div class="Detalle-actions">
        <span class="movimiento-badge-top">
            Factura #@Model.Id
        </span>
    </div>
</section>

<section class="Detalle-visual-hero Detalle-hero-inventario">
    <div class="Detalle-visual-hero-content">
        <h1>Cliente: @cliente</h1>
        <div class="Detalle-visual-line"></div>
        <span class="Detalle-visual-badge">
            <i class="fa-solid fa-file-invoice-dollar"></i> Comprobante de venta
        </span>
    </div>
</section>

<div class="EstiloDetalle-detalle-page">
    <div class="EstiloDetalle-premium-card">

        <div class="EstiloDetalle-premium-header">
            <h2>Información general</h2>
        </div>

        <div class="EstiloDetalle-premium-body">

            <div class="EstiloDetalle-detail-grid">

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-user"></i> CLIENTE
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @cliente
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-phone"></i> TELÉFONO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @telefono
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-tag"></i> PRODUCTO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @producto
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-weight-hanging"></i> CANTIDAD
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @cantidad
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-calendar-days"></i> FECHA DE FACTURA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.FechaFactura.ToString("dd/MM/yyyy hh:mm tt")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-circle-check"></i> ESTADO
                    </span>
                    <div>
                        <span class="@estadoClase">
                            @Model.EstadoPago
                        </span>
                    </div>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-calculator"></i> SUBTOTAL
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        ₡ @Model.Subtotal.ToString("N0")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-percent"></i> IVA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        ₡ @Model.IVA.ToString("N0")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-money-bill-wave"></i> TOTAL
                    </span>
                    <span class="EstiloDetalle-detail-value EstiloDetalle-detail-value-total">
                        ₡ @Model.Total.ToString("N0")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-align-left"></i> OBSERVACIÓN
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @observacion
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver a la lista
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-EstiloDetalle btn-EstiloDetalle-warning">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Editar
                    </a>
                }

                <a asp-action="Imprimir"
                   asp-route-id="@Model.Id"
                   class="btn-EstiloDetalle btn-EstiloDetalle-secondary">
                    <i class="fa-solid fa-file-pdf"></i>
                    PDF
                </a>

            </div>

        </div>
    </div>
</div>