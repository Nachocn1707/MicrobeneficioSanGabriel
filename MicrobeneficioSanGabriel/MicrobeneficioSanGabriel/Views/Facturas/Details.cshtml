@model MicrobeneficioSanGabriel.Models.Factura

@{
    ViewData["Title"] = "Detalles de factura";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var cliente = Model.Pedido?.ClienteNombre ?? "Sin cliente";
    var observacion = string.IsNullOrWhiteSpace(Model.Observacion) ? "Sin observaciones" : Model.Observacion;
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}


<div class="EstiloDetalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalles de la factura</h1>
        <p>Información registrada para esta EstiloDetalle.</p>
    </div>

    <div class="EstiloDetalle-card">
        <div class="EstiloDetalle-card-header">
            <h2>Factura #@Model.Id</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">
            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">Cliente</span>
                    <span class="detalle-value">@cliente</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Fecha de EstiloDetalle</span>
                    <span class="detalle-value">@Model.FechaFactura.ToString("dd/MM/yyyy hh:mm tt")</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Subtotal</span>
                    <span class="detalle-value">₡ @Model.Subtotal.ToString("N2")</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">IVA</span>
                    <span class="detalle-value">₡ @Model.IVA.ToString("N2")</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Total</span>
                    <span class="detalle-value">₡ @Model.Total.ToString("N2")</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Estado de pago</span>
                    <span class="estado-pill">@Model.EstadoPago</span>
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">Observación</span>
                    <span class="detalle-value">@observacion</span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">
                <a asp-action="Index" class="btn-volver">Volver a la lista</a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-editar">Editar</a>
                }
            </div>
        </div>
    </div>

</div>