@model IEnumerable<MicrobeneficioSanGabriel.Models.Factura>

@{
    ViewData["Title"] = "Facturación";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int totalFacturas = Model.Count();
    int facturasPagadas = Model.Count(f => f.EstadoPago == "Pagado");
    int facturasPendientes = Model.Count(f => f.EstadoPago == "Pendiente");
    int facturasAnuladas = Model.Count(f => f.EstadoPago == "Anulada");
    decimal totalFacturado = Model.Where(f => f.EstadoPago != "Anulada").Sum(f => f.Total);
}

@section Styles {
    <style>
        .facturas-page {
            display: grid;
            gap: 24px;
            padding-top: 10px;
        }

        .facturas-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

            .facturas-header h1 {
                font-size: 2.35rem;
                font-weight: 950;
                margin: 0;
                color: #2b160d;
            }

        .facturas-title-line {
            width: 76px;
            height: 4px;
            background: #d8b36a;
            border-radius: 999px;
            margin: 12px 0;
        }

        .facturas-header p {
            color: #6f5b4a;
            font-weight: 650;
            margin: 0;
        }

        .btn-nueva-factura {
            background: #198754;
            color: #fff;
            border-radius: 13px;
            padding: 11px 18px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 12px 28px rgba(25, 135, 84, 0.18);
            transition: 0.18s ease;
        }

            .btn-nueva-factura:hover {
                background: #157347;
                color: #fff;
                transform: translateY(-1px);
            }

        .facturas-summary-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 18px;
        }

        .factura-summary-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 22px;
            padding: 20px;
            box-shadow: 0 16px 36px rgba(58, 33, 20, 0.08);
            position: relative;
            overflow: hidden;
        }

            .factura-summary-card::after {
                content: "";
                position: absolute;
                right: -32px;
                bottom: -36px;
                width: 110px;
                height: 110px;
                background: rgba(243, 210, 122, 0.22);
                border-radius: 50%;
            }

        .factura-summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #fff2d5;
            color: #a66b20;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            font-size: 18px;
        }

        .factura-summary-label {
            color: #7a6a5d;
            font-weight: 850;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .factura-summary-value {
            color: #2b160d;
            font-size: 1.65rem;
            font-weight: 950;
            line-height: 1.15;
        }

        .facturas-table-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 24px;
            box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
            padding: 18px;
            overflow: hidden;
        }

            .facturas-table-card table {
                margin-bottom: 0;
            }

                .facturas-table-card table thead th {
                    background: #1f2937 !important;
                    color: #fff !important;
                    border: none !important;
                    padding: 15px 14px !important;
                    font-weight: 900;
                    vertical-align: middle;
                }

                    .facturas-table-card table thead th:first-child {
                        border-top-left-radius: 13px;
                    }

                    .facturas-table-card table thead th:last-child {
                        border-top-right-radius: 13px;
                    }

                .facturas-table-card table tbody td {
                    padding: 16px 14px !important;
                    vertical-align: middle;
                    border-bottom: 1px solid #ece2cf;
                }

                .facturas-table-card table tbody tr:hover {
                    background: rgba(243, 210, 122, 0.12);
                }

        .factura-cliente {
            font-weight: 900;
            color: #2b160d;
        }

        .factura-total {
            font-weight: 950;
            color: #198754;
            white-space: nowrap;
        }

        .factura-monto {
            white-space: nowrap;
            font-weight: 750;
        }

        .factura-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

            .factura-actions .btn {
                border-radius: 10px;
                font-weight: 850;
                padding: 8px 11px;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

            .factura-actions form {
                margin: 0;
            }

        .factura-estado {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: 0.8rem;
            font-weight: 950;
            white-space: nowrap;
        }

        .factura-estado-pagado {
            background: #dff5e3;
            color: #1e7d32;
        }

        .factura-estado-pendiente {
            background: #fff4d3;
            color: #8a6500;
        }

        .factura-estado-anulada {
            background: #e9ecef;
            color: #495057;
        }

        .factura-estado-otro {
            background: #fde1df;
            color: #b42318;
        }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 15px;
            color: #2b160d;
            font-weight: 700;
        }

            .dataTables_wrapper .dataTables_filter input,
            .dataTables_wrapper .dataTables_length select {
                border: 1px solid #d9c8ab;
                border-radius: 10px;
                padding: 7px 10px;
                background: white;
            }

        .dataTables_wrapper .dataTables_info {
            color: #6f5b4a;
            font-weight: 650;
            margin-top: 14px;
        }

        .dataTables_wrapper .dataTables_paginate {
            margin-top: 14px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border-radius: 10px !important;
            }

        @@media (max-width: 1400px) {
            .facturas-summary-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 900px) {
            .facturas-summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .facturas-header {
                flex-direction: column;
            }
        }

        @@media (max-width: 650px) {
            .facturas-summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="facturas-page">

    <div class="facturas-header">
        <div>
            <h1>Facturación</h1>
            <div class="facturas-title-line"></div>
            <p>
                Gestión de facturas, pagos, anulaciones e impresión de comprobantes del microbeneficio.
            </p>
        </div>

        <a asp-action="Create" class="btn-nueva-factura">
            <i class="fa-solid fa-plus"></i>
            Nueva Factura
        </a>
    </div>

    <section class="facturas-summary-grid">

        <div class="factura-summary-card">
            <div class="factura-summary-icon">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <div class="factura-summary-label">Facturas registradas</div>
            <div class="factura-summary-value">@totalFacturas</div>
        </div>

        <div class="factura-summary-card">
            <div class="factura-summary-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="factura-summary-label">Pagadas</div>
            <div class="factura-summary-value">@facturasPagadas</div>
        </div>

        <div class="factura-summary-card">
            <div class="factura-summary-icon">
                <i class="fa-solid fa-clock"></i>
            </div>
            <div class="factura-summary-label">Pendientes</div>
            <div class="factura-summary-value">@facturasPendientes</div>
        </div>

        <div class="factura-summary-card">
            <div class="factura-summary-icon">
                <i class="fa-solid fa-ban"></i>
            </div>
            <div class="factura-summary-label">Anuladas</div>
            <div class="factura-summary-value">@facturasAnuladas</div>
        </div>

        <div class="factura-summary-card">
            <div class="factura-summary-icon">
                <i class="fa-solid fa-coins"></i>
            </div>
            <div class="factura-summary-label">Total facturado</div>
            <div class="factura-summary-value">₡ @totalFacturado.ToString("N2")</div>
        </div>

    </section>

    <div class="facturas-table-card">

        <div class="table-responsive">

            <table id="tablaFacturas" class="table align-middle">

                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th>IVA</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th width="330">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        string estadoClase = item.EstadoPago switch
                        {
                            "Pagado" => "factura-estado factura-estado-pagado",
                            "Pendiente" => "factura-estado factura-estado-pendiente",
                            "Anulada" => "factura-estado factura-estado-anulada",
                            _ => "factura-estado factura-estado-otro"
                        };

                        <tr>

                            <td class="factura-cliente">
                                @(item.Pedido != null
                                    ? item.Pedido.ClienteNombre
                                    : "Sin cliente")
                            </td>

                            <td>
                                @(item.Pedido?.Producto != null
                                    ? item.Pedido.Producto.Nombre
                                    : "Sin producto")
                            </td>

                            <td>
                                @(item.Pedido != null
                                    ? $"{item.Pedido.Cantidad} kg"
                                    : "Sin cantidad")
                            </td>

                            <td class="factura-monto">
                                ₡ @item.Subtotal.ToString("N2")
                            </td>

                            <td class="factura-monto">
                                ₡ @item.IVA.ToString("N2")
                            </td>

                            <td class="factura-total">
                                ₡ @item.Total.ToString("N2")
                            </td>

                            <td>
                                <span class="@estadoClase">
                                    @item.EstadoPago
                                </span>
                            </td>

                            <td>
                                @item.FechaFactura.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                <div class="factura-actions">

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            Editar
                                        </a>
                                    }

                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">
                                        <i class="fa-solid fa-eye"></i>
                                        Detalles
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        @if (item.EstadoPago != "Anulada")
                                        {
                                            <form asp-action="Anular"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  onsubmit="return confirm('¿Seguro que desea anular esta factura?');">

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    <i class="fa-solid fa-ban"></i>
                                                    Anular
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="btn btn-secondary btn-sm disabled">
                                                <i class="fa-solid fa-circle-xmark"></i>
                                                Anulada
                                            </span>
                                        }
                                    }

                                    <a asp-action="Imprimir"
                                           asp-route-id="@item.Id"
                                           class="btn btn-secondary btn-sm">
                                        <i class="fa-solid fa-file-pdf"></i>
                                        PDF
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaFacturas').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20],
                responsive: true
            });
        });
    </script>
}