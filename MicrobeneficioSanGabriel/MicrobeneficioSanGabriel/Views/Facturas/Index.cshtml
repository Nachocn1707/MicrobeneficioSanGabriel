@model IEnumerable<MicrobeneficioSanGabriel.Models.Factura>

@{
    ViewData["Title"] = "Facturación";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">Facturación</h1>
        <p class="text-muted">
            Gestión de facturas y pagos del microbeneficio.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Nueva Factura
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">

        <div class="table-responsive">

            <table class="table align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th>IVA</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @item.Pedido?.ClienteNombre
                            </td>

                            <td>
                                @item.Pedido?.Producto?.Nombre
                            </td>

                            <td>
                                @item.Pedido?.Cantidad unidades
                            </td>

                            <td>
                                ₡ @item.Subtotal.ToString("N2")
                            </td>

                            <td>
                                ₡ @item.IVA.ToString("N2")
                            </td>

                            <td class="fw-bold text-success">
                                ₡ @item.Total.ToString("N2")
                            </td>

                            <td>
                                @if (item.EstadoPago == "Pagado")
                                {
                                    <span class="badge bg-success">
                                        Pagado
                                    </span>
                                }
                                else if (item.EstadoPago == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                                else if (item.EstadoPago == "Anulada")
                                {
                                    <span class="badge bg-secondary">
                                        Anulada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        @item.EstadoPago
                                    </span>
                                }
                            </td>

                            <td>
                                @item.FechaFactura.ToString("dd/MM/yyyy")
                            </td>

                            <td>

                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>
                                }

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm text-white">
                                    Detalles
                                </a>

                                @if (User.IsInRole("Administrador"))
                                {
                                    @if (item.EstadoPago != "Anulada")
                                    {
                                        <form asp-action="Anular"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Seguro que desea anular esta factura?');">

                                            <button type="submit" class="btn btn-danger btn-sm">
                                                Anular factura
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="btn btn-secondary btn-sm disabled">
                                            Anulada
                                        </span>
                                    }
                                }

                                <a asp-action="Imprimir"
                                   asp-route-id="@item.Id"
                                   class="btn btn-secondary btn-sm">
                                    PDF
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>