@model IEnumerable<MicrobeneficioSanGabriel.Models.Factura>
@{
    ViewData["Title"] = "Facturación";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var facturas = Model.ToList();
    var inicioMes = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var finMes = inicioMes.AddMonths(1);
    var total = facturas.Count;
    var pagadas = facturas.Count(f => (f.EstadoPago ?? string.Empty).Contains("Pag") || (f.EstadoPago ?? string.Empty).Contains("completado", StringComparison.OrdinalIgnoreCase));
    var pendientes = facturas.Count(f => (f.EstadoPago ?? string.Empty).Contains("Pend"));
    var anuladas = facturas.Count(f => f.EstadoPago == "Anulada");
    var montoMes = facturas.Where(f => f.FechaFactura >= inicioMes && f.FechaFactura < finMes && f.EstadoPago != "Anulada").Sum(f => f.Total);
}
<section class="sg-page-head"><div><h1>Pedidos y Facturación</h1><p>Control de facturas, pagos y documentos comerciales.</p></div><div class="sg-actions"><a asp-action="Create" class="sg-btn gold"><i class="fa-solid fa-plus"></i>Nueva factura</a><label class="sg-search"><i class="fa-solid fa-magnifying-glass"></i><input placeholder="Buscar factura o cliente..." /></label></div></section>
<section class="sg-kpi-grid"><article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-file-invoice-dollar"></i></span><div><span>Facturación del mes</span><strong>₡@montoMes.ToString("N0")</strong><div class="sg-trend">Facturas no anuladas</div></div></article><article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-receipt"></i></span><div><span>Facturas totales</span><strong>@total</strong><div class="sg-trend">Registros reales</div></div></article><article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-circle-check"></i></span><div><span>Pagadas</span><strong>@pagadas</strong><div class="sg-trend">Según estado de pago</div></div></article><article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-ban"></i></span><div><span>Anuladas</span><strong>@anuladas</strong><div class="sg-trend warn">No eliminadas</div></div></article></section>
<section class="sg-card sg-table-card"><div class="sg-panel-head"><h3>Facturas recientes</h3><span class="sg-badge">@total registro(s)</span></div><div class="table-responsive"><table class="sg-table" id="tablaFacturas"><thead><tr><th>Factura</th><th>Pedido</th><th>Cliente</th><th>Fecha</th><th>Subtotal</th><th>IVA</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var f in facturas){<tr><td>FAC-@f.Id.ToString("0000")</td><td>PP-@f.PedidoId.ToString("0000")</td><td>@f.Pedido?.ClienteNombre</td><td>@f.FechaFactura.ToString("dd MMM yyyy")</td><td>₡@f.Subtotal.ToString("N0")</td><td>₡@f.IVA.ToString("N0")</td><td>₡@f.Total.ToString("N0")</td><td><span class="sg-badge @((f.EstadoPago ?? string.Empty).Contains("Pend")?"tan":f.EstadoPago=="Anulada"?"brown":"")">@f.EstadoPago</span></td><td><span class="sg-action-icons"><a asp-action="Details" asp-route-id="@f.Id"><i class="fa-solid fa-eye"></i></a>@if(User.IsInRole("Administrador")){<a asp-action="Edit" asp-route-id="@f.Id"><i class="fa-solid fa-pen"></i></a>@if (f.EstadoPago != "Anulada"){<form asp-action="Anular" asp-route-id="@f.Id" method="post" class="d-inline sg-inline-action-form" onsubmit="return confirm('¿Desea anular esta factura? Esta acción no elimina el registro.');">@Html.AntiForgeryToken()<button type="submit" title="Anular factura" aria-label="Anular factura"><i class="fa-solid fa-ban"></i></button></form>}}</span></td></tr>}</tbody></table></div></section>
