@model IEnumerable<MicrobeneficioSanGabriel.Models.Factura>

@{
    ViewData["Title"] = "Facturación";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var facturas = Model.ToList();
    var inicioMes = new DateTime(
        DateTime.UtcNow.AddHours(-6).Date.Year,
        DateTime.UtcNow.AddHours(-6).Date.Month,
        1);

    var finMes = inicioMes.AddMonths(1);
    var total = facturas.Count;

    var pagadas = facturas.Count(f =>
        f.EstadoPago == "Pago completado");

    var pendientes = facturas.Count(f =>
        (f.EstadoPago ?? string.Empty).Contains("Pend"));

    var anuladas = facturas.Count(f =>
        f.EstadoPago == "Anulada");

    var montoMes = facturas
        .Where(f =>
            f.FechaFactura >= inicioMes &&
            f.FechaFactura < finMes &&
            f.EstadoPago == "Pago completado")
        .Sum(f => f.Total);
}


@section Styles {
    <link rel="stylesheet" href="~/css/CancelarPedido.css" asp-append-version="true" />
}


<section class="sg-page-head">
    <div>
        <h1>Pedidos y Facturación</h1>
        <p>Control de facturas, pagos y documentos comerciales.</p>
    </div>

    <div class="sg-actions">
        @if (User.IsInRole("Administrador") ||
             User.IsInRole("Vendedor"))
        {
            <a asp-action="Create"
               class="sg-btn gold">
                <i class="fa-solid fa-plus"></i>
                Nueva factura
            </a>
        }

        <label class="sg-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search"
                   placeholder="Buscar factura o cliente..." />
        </label>
    </div>
</section>

<section class="sg-kpi-grid">
    <article class="sg-card sg-kpi">
        <span class="sg-icon green">
            <i class="fa-solid fa-file-invoice-dollar"></i>
        </span>

        <div>
            <span>Facturación del mes</span>
            <strong>₡@montoMes.ToString("N0")</strong>
            <div class="sg-trend">Cobros confirmados</div>
        </div>
    </article>

    <article class="sg-card sg-kpi">
        <span class="sg-icon gold">
            <i class="fa-solid fa-receipt"></i>
        </span>

        <div>
            <span>Facturas totales</span>
            <strong>@total</strong>
            <div class="sg-trend">Registros reales</div>
        </div>
    </article>

    <article class="sg-card sg-kpi">
        <span class="sg-icon green">
            <i class="fa-solid fa-circle-check"></i>
        </span>

        <div>
            <span>Pagadas</span>
            <strong>@pagadas</strong>
            <div class="sg-trend">Según estado de pago</div>
        </div>
    </article>

    <article class="sg-card sg-kpi">
        <span class="sg-icon gold">
            <i class="fa-solid fa-ban"></i>
        </span>

        <div>
            <span>Anuladas</span>
            <strong>@anuladas</strong>
            <div class="sg-trend warn">No eliminadas</div>
        </div>
    </article>
</section>

<section class="sg-card sg-table-card">
    <div class="sg-panel-head">
        <h3>Facturas recientes</h3>
        <span class="sg-badge">
            @total registro(s)
        </span>
    </div>

    <div class="table-responsive">
        <table class="sg-table" id="tablaFacturas">
            <thead>
                <tr>
                    <th>Factura</th>
                    <th>Pedido</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Subtotal</th>
                    <th>IVA</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var f in facturas)
                {
                    var claseEstado =
                        (f.EstadoPago ?? string.Empty).Contains("Pend")
                            ? "tan"
                            : f.EstadoPago == "Anulada"
                                ? "brown"
                                : string.Empty;

                    <tr>
                        <td>FAC-@f.Id.ToString("0000")</td>
                        <td>PP-@f.PedidoId.ToString("0000")</td>
                        <td>@f.Pedido?.ClienteNombre</td>
                        <td>@f.FechaFactura.ToString("dd MMM yyyy")</td>
                        <td>₡@f.Subtotal.ToString("N0")</td>
                        <td>₡@f.IVA.ToString("N0")</td>
                        <td>₡@f.Total.ToString("N0")</td>

                        <td>
                            <span class="sg-badge @claseEstado">
                                @f.EstadoPago
                            </span>
                        </td>

                        <td>
                            <span class="sg-action-icons">
                                <a asp-action="Details"
                                   asp-route-id="@f.Id"
                                   title="Ver factura"
                                   aria-label="Ver factura">
                                    <i class="fa-solid fa-eye"></i>
                                </a>

                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@f.Id"
                                       title="Editar factura"
                                       aria-label="Editar factura">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    @if (f.EstadoPago != "Anulada")
                                    {
                                        <button type="button"
                                                class="js-open-anular-modal"
                                                data-factura-id="@f.Id"
                                                data-factura-code="FAC-@f.Id.ToString("0000")"
                                                data-cliente="@(f.Pedido?.ClienteNombre ?? "Sin cliente")"
                                                data-total="₡@f.Total.ToString("N0")"
                                                title="Anular factura"
                                                aria-label="Anular factura">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    }
                                }
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal fade"
     id="anularFacturaModal"
     tabindex="-1"
     aria-labelledby="anularFacturaModalTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered sg-cancel-dialog">
        <div class="modal-content sg-cancel-modal">
            <div class="modal-header sg-cancel-header">
                <div class="sg-cancel-heading">
                    <span class="sg-cancel-heading-icon" aria-hidden="true">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>
                    <div>
                        <small>Confirmación requerida</small>
                        <h2 id="anularFacturaModalTitle">Anular factura</h2>
                    </div>
                </div>

                <button type="button"
                        class="btn-close sg-cancel-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <div class="modal-body sg-cancel-body">
                <form asp-action="Anular"
                      method="post"
                      id="modalAnularFacturaForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="anularFacturaId" />

                    <div class="sg-cancel-notice">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>
                            ¿Desea anular esta factura? <strong>Esta acción no elimina el registro.</strong>
                        </span>
                    </div>

                    <div class="sg-cancel-order-summary">
                        <div class="sg-cancel-order-head">
                            <span class="sg-cancel-order-badge" id="anularFacturaCode">FAC-0000</span>
                            <span class="sg-cancel-status-pill warn">Factura</span>
                        </div>

                        <div class="sg-cancel-details-grid">
                            <div class="sg-cancel-detail-item">
                                <small><i class="fa-solid fa-user"></i> Cliente</small>
                                <strong id="anularFacturaCliente">—</strong>
                            </div>

                            <div class="sg-cancel-detail-item">
                                <small><i class="fa-solid fa-money-bill-wave"></i> Total</small>
                                <strong id="anularFacturaTotal">—</strong>
                            </div>
                        </div>
                    </div>

                    <div class="sg-cancel-actions">
                        <button type="button"
                                class="sg-cancel-button secondary"
                                data-bs-dismiss="modal">
                            <i class="fa-solid fa-arrow-left"></i>
                            Cancelar
                        </button>
                        <button type="submit"
                                class="sg-cancel-button danger"
                                id="anularSubmitButton">
                            <i class="fa-solid fa-ban"></i>
                            Confirmar anulación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Cancelar-Pedido.js" asp-append-version="true"></script>
}