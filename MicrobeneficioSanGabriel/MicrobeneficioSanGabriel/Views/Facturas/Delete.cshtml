@model MicrobeneficioSanGabriel.Models.Factura

@{
    ViewData["Title"] = "Anular factura";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var cliente = Model.Pedido?.ClienteNombre ?? "Sin cliente";
    var producto = Model.Pedido?.Producto?.Nombre ?? "Sin producto";
    var cantidad = Model.Pedido != null ? $"{Model.Pedido.Cantidad} kg" : "Sin cantidad";

    string estadoClase = Model.EstadoPago switch
    {
        "Pago completado" => "text-success",
        "Pagado" => "text-success",
        "Pendiente" => "text-warning",
        "Anulada" => "text-danger",
        _ => "text-secondary"
    };
}

<div class="sg-card border-danger">
    <h1 class="text-danger">
        <i class="fa-solid fa-ban"></i>
        Anular factura #@Model.Id
    </h1>

    <p>
        <strong>Cliente:</strong> @cliente<br />
        <strong>Producto:</strong> @producto<br />
        <strong>Cantidad:</strong> @cantidad<br />
        <strong>Total:</strong> ₡ @Model.Total.ToString("N0")<br />
        <strong>Estado actual:</strong> <span class="@estadoClase">@Model.EstadoPago</span>
    </p>

    <div class="alert alert-warning">
        <i class="fa-solid fa-circle-info"></i>
        Esta acción no eliminará la factura, solo cambiará su estado a <strong>Anulada</strong>.
        La factura permanecerá registrada como comprobante histórico.
    </div>

    @if (Model.EstadoPago == "Anulada")
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-check-circle"></i>
            Esta factura ya se encuentra anulada.
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Volver
            </a>
        </div>
    }
    else
    {
        <form asp-action="Anular" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Cancelar
                </a>
                <button class="btn btn-danger" type="submit">
                    <i class="fa-solid fa-ban"></i> Confirmar anulación
                </button>
            </div>
        </form>
    }
</div>