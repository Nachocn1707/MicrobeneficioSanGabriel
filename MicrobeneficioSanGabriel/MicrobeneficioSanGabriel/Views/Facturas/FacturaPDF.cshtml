@model MicrobeneficioSanGabriel.Models.Factura

@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/FacturaPDF.css" />

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Factura</title>
</head>

<body>

    <div class="header">

        <img src="@Url.Content("~/img/logo.png")"
             style="width:120px; margin-bottom:15px;" />

        <div class="title">
            Microbeneficio San Gabriel
        </div>

        <div class="subtitle">
            Factura electrónica
        </div>

    </div>

    <div class="card">

        <h2>Información de factura</h2>

        <p>
            <strong>Factura #:</strong> @Model.Id
        </p>

        <p>
            <strong>Fecha:</strong> @Model.FechaFactura.ToString("dd/MM/yyyy")
        </p>

        <p>
            <strong>Estado:</strong> @Model.EstadoPago
        </p>

        <hr />

        <h2>Cliente</h2>

        <p>
            @Model.Pedido?.ClienteNombre
        </p>

        <table>
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad (kg)</th>
                    <th>Subtotal</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>@Model.Pedido?.Producto?.Nombre</td>
                    <td>@Model.Pedido?.Cantidad kg</td>
                    <td>₡ @Model.Subtotal.ToString("N0")</td>
                </tr>
            </tbody>
        </table>

        <div class="total-box">

            <div class="total-row">
                <span class="total-label">IVA:</span>
                <span class="total-value">₡ @Model.IVA.ToString("N0")</span>
            </div>

            <div class="total-row">
                <span class="total-label">TOTAL:</span>
                <span class="total-value">₡ @Model.Total.ToString("N0")</span>
            </div>

        </div>

    </div>

    <div class="footer">
        Gracias por su compra - Microbeneficio San Gabriel
    </div>

</body>
</html>