@model MicrobeneficioSanGabriel.Models.Factura

@{
    ViewData["Title"] = "Editar factura";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/VistaEditar.css" />

}

<div class="EstiloEditar-page">
    <div class="EstiloEditar-header">
        <h1>Editar factura</h1>
        <p>Actualizá los datos de la factura registrada.</p>
    </div>

    <div class="EstiloEditaR-card">
        <div class="EstiloEditaR-form-container">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <div class="Estilo-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Verificá que el estado de pago y los montos correspondan con el pedido facturado.
                    </span>
                </div>

                <div class="EstiloEditar-section">
                    <h5>
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                        Detalle de la factura
                    </h5>

                    <div class="row g-4">
                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="PedidoId" class="form-label">Pedido</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                    <select asp-for="PedidoId" class="form-select" asp-items="ViewBag.PedidoId">
                                    </select>
                                </div>
                                <span asp-validation-for="PedidoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="FechaFactura" class="form-label">Fecha de factura</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-calendar"></i>
                                    <input asp-for="FechaFactura" type="datetime-local" class="form-control" />
                                </div>
                                <span asp-validation-for="FechaFactura" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="EstadoPago" class="form-label">Estado de pago</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-wallet"></i>
                                    <select asp-for="EstadoPago" class="form-select">
                                        <option value="Pendiente">Pendiente</option>
                                        <option value="Pago completado">Pago completado</option>
                                        <option value="Anulada">Anulada</option>
                                    </select>
                                </div>
                                <span asp-validation-for="EstadoPago" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Subtotal" class="form-label">Subtotal</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-coins"></i>
                                    <input asp-for="Subtotal"
                                           type="number"
                                           min="0"
                                           step="1"
                                           inputmode="numeric"
                                           pattern="[0-9]*"
                                           data-whole-number="true"
                                           value="@Model.Subtotal.ToString("0")"
                                           class="form-control" />
                                </div>
                                <span asp-validation-for="Subtotal" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="IVA" class="form-label">IVA</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-percent"></i>
                                    <input asp-for="IVA"
                                           type="number"
                                           min="0"
                                           step="1"
                                           inputmode="numeric"
                                           pattern="[0-9]*"
                                           data-whole-number="true"
                                           value="@Model.IVA.ToString("0")"
                                           class="form-control" />
                                </div>
                                <span asp-validation-for="IVA" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Total" class="form-label">Total</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-money-bill-wave"></i>
                                    <input asp-for="Total"
                                           type="number"
                                           min="0"
                                           step="1"
                                           inputmode="numeric"
                                           pattern="[0-9]*"
                                           data-whole-number="true"
                                           value="@Model.Total.ToString("0")"
                                           class="form-control" />
                                </div>
                                <span asp-validation-for="Total" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Observacion" class="form-label">Observación</label>
                                <div class="input-modern textarea-modern">
                                    <i class="fa-solid fa-comment"></i>
                                    <textarea asp-for="Observacion"
                                              class="form-control"
                                              rows="5"
                                              placeholder="Detalle adicional de la factura"></textarea>
                                </div>
                                <span asp-validation-for="Observacion" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="EstiloEditar-actions">
                    <a asp-action="Index" class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                    <button type="submit" class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[data-whole-number="true"]').forEach(input => {
                const clean = () => {
                    const raw = (input.value || '').replace(/[^0-9]/g, '');
                    input.value = raw;
                };
                input.addEventListener('input', clean);
                input.addEventListener('blur', clean);
                clean();
            });
        });
    </script>
}