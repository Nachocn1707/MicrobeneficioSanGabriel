@model MicrobeneficioSanGabriel.Models.Factura

@{
    ViewData["Title"] = "Editar factura";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditar-page">

    <div class="EstiloEditar-header">
        <h1>Editar EstiloEditar</h1>
        <p>Actualizá los datos de la EstiloEditar registrada.</p>
    </div>

    <div class="EstiloEditar-card">
        <div class="EstiloEditar-card-header">
            <h2>Factura #@Model.Id</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloEditar-card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-md-12">
                        <label asp-for="PedidoId" class="form-label">Pedido</label>
                        <select asp-for="PedidoId" class="form-select" asp-items="ViewBag.PedidoId"></select>
                        <span asp-validation-for="PedidoId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaFactura" class="form-label">Fecha de EstiloEditar</label>
                        <input asp-for="FechaFactura" class="form-control" />
                        <span asp-validation-for="FechaFactura" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EstadoPago" class="form-label">Estado de pago</label>
                        <select asp-for="EstadoPago" class="form-select">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Pagado">Pagado</option>
                            <option value="Anulado">Anulado</option>
                        </select>
                        <span asp-validation-for="EstadoPago" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Subtotal" class="form-label">Subtotal</label>
                        <input asp-for="Subtotal" class="form-control" />
                        <span asp-validation-for="Subtotal" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="IVA" class="form-label">IVA</label>
                        <input asp-for="IVA" class="form-control" />
                        <span asp-validation-for="IVA" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Total" class="form-label">Total</label>
                        <input asp-for="Total" class="form-control" />
                        <span asp-validation-for="Total" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Observacion" class="form-label">Observación</label>
                        <textarea asp-for="Observacion" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Observacion" class="text-danger"></span>
                    </div>
                </div>

                <div class="EstiloEditar-actions">
                    <a asp-action="Index" class="btn-volver">Volver a la lista</a>
                    <button type="submit" class="btn-guardar">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}