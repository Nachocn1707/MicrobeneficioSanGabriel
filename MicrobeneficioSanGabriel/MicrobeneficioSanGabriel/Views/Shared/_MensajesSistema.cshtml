@using System.Text.Json
@{
    var mensajes = new List<object>();
    if (TempData["Success"] is string mensajeExito && !string.IsNullOrWhiteSpace(mensajeExito))
        mensajes.Add(new { tipo = "success", titulo = "Operación exitosa", texto = mensajeExito });
    if (TempData["Error"] is string mensajeError && !string.IsNullOrWhiteSpace(mensajeError))
        mensajes.Add(new { tipo = "error", titulo = "No se pudo completar", texto = mensajeError });
    if (TempData["Warning"] is string mensajeAdvertencia && !string.IsNullOrWhiteSpace(mensajeAdvertencia))
        mensajes.Add(new { tipo = "warning", titulo = "Atención", texto = mensajeAdvertencia });
    if (TempData["Info"] is string mensajeInfo && !string.IsNullOrWhiteSpace(mensajeInfo))
        mensajes.Add(new { tipo = "info", titulo = "Información", texto = mensajeInfo });
    var mensajesJson = JsonSerializer.Serialize(mensajes);
}
@if (mensajes.Count > 0)
{
    <script type="application/json" id="sgSystemMessages">@Html.Raw(mensajesJson)</script>
}
