@if (TempData["Success"] is string mensajeExito)
{
    <div class="sg-system-message alert alert-success alert-dismissible fade show" role="alert" data-auto-dismiss="true">
        <i class="fa-solid fa-circle-check me-2"></i>@mensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string mensajeError)
{
    <div class="sg-system-message alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@mensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Warning"] is string mensajeAdvertencia)
{
    <div class="sg-system-message alert alert-warning alert-dismissible fade show" role="alert" data-auto-dismiss="true">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@mensajeAdvertencia
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
