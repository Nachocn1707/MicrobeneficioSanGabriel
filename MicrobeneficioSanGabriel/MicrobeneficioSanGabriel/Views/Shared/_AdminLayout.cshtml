<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Microbeneficio San Gabriel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
    <link rel="stylesheet" href="~/css/VistaCrear.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">

    @RenderSection("Styles", required: false)
</head>

<body>
    <div class="admin-shell">

        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <div class="brand-mark">
                    <i class="fa-solid fa-seedling"></i>
                </div>

                <div>
                    <h4>San Gabriel</h4>
                    <span>Microbeneficio</span>
                </div>
            </div>

            <nav class="sidebar-menu">
                <a asp-controller="Home" asp-action="Dashboard">
                    <i class="fa-solid fa-border-all"></i>
                    <span>Dashboard</span>
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Usuarios" asp-action="Index">
                        <i class="fa-solid fa-users"></i>
                        <span>Usuarios</span>
                    </a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Operador"))
                {
                    <a asp-controller="Productores" asp-action="Index">
                        <i class="fa-solid fa-user-tie"></i>
                        <span>Productores</span>
                    </a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Operador") || User.IsInRole("Vendedor"))
                {
                    <a asp-controller="Productos" asp-action="Index">
                        <i class="fa-solid fa-box-open"></i>
                        <span>Productos</span>
                    </a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Operador"))
                {
                    <a asp-controller="MovimientosInventario" asp-action="Index">
                        <i class="fa-solid fa-warehouse"></i>
                        <span>Inventario</span>
                    </a>

                    <a asp-controller="Lotes" asp-action="Index">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>Lotes</span>
                    </a>

                    <a asp-controller="Producciones" asp-action="Index">
                        <i class="fa-solid fa-industry"></i>
                        <span>Producción</span>
                    </a>

                    <a asp-controller="Trazabilidades" asp-action="Index">
                        <i class="fa-solid fa-route"></i>
                        <span>Trazabilidad</span>
                    </a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                {
                    <a asp-controller="Pedidos" asp-action="Index">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span>Pedidos</span>
                    </a>

                    <a asp-controller="Facturas" asp-action="Index">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                        <span>Facturación</span>
                    </a>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="RegistrosFinancieros" asp-action="Index">
                        <i class="fa-solid fa-coins"></i>
                        <span>Contabilidad</span>
                    </a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                {
                    <a asp-controller="Reportes" asp-action="Index">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Reportes</span>
                    </a>
                }
            </nav>
        </aside>

        <main class="admin-main">

            <header class="admin-topbar">
                <div class="topbar-left">
                    <button type="button" class="menu-button">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <div class="topbar-title">
                        <h5>@ViewData["Title"]</h5>
                        <small>Sistema de gestión administrativa</small>
                    </div>
                </div>

                <div class="admin-search">
                    <div class="admin-search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>

                        <input id="globalSearchInput"
                               type="search"
                               placeholder="Buscar en el sistema..."
                               autocomplete="off" />

                        <button type="button" id="globalSearchClear" class="search-clear">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <div id="globalSearchResults" class="search-results" hidden></div>
                </div>

                <div class="topbar-actions">
                    <button type="button" class="topbar-icon">
                        <i class="fa-regular fa-bell"></i>
                        <span></span>
                    </button>

                    <div class="admin-user-card">
                        <div class="admin-avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>
                            @if (User.IsInRole("Administrador"))
                            {
                                <strong>Administrador</strong>
                                <small>Admin</small>
                            }
                            else if (User.IsInRole("Operador"))
                            {
                                <strong>Operador</strong>
                                <small>Operador</small>
                            }
                            else if (User.IsInRole("Vendedor"))
                            {
                                <strong>Vendedor</strong>
                                <small>Ventas</small>
                            }
                            else if (User.IsInRole("Cliente"))
                            {
                                <strong>Cliente</strong>
                                <small>Portal</small>
                            }
                            else
                            {
                                <strong>Usuario</strong>
                                <small>Sistema</small>
                            }
                        </div>
                    </div>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/Identity/Account/Login"
                          method="post">

                        <button type="submit" class="logout-btn">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </header>

            <section class="admin-content">
                @RenderBody()
            </section>

        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/Eliminar.js"></script>

    <script>
        (() => {
        const input = document.getElementById("globalSearchInput");
        const results = document.getElementById("globalSearchResults");
        const clearButton = document.getElementById("globalSearchClear");

        if (!input || !results || !clearButton) return;

        const normalize = (text) =>
        (text || "")
        .toString()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();

        const getModules = () => {
        return Array.from(document.querySelectorAll(".sidebar-menu a"))
        .map(link => ({
        name: link.textContent.trim(),
        url: link.href
        }))
        .filter(item => item.name && item.url);
        };

        const getTableRows = () => {
        return Array.from(document.querySelectorAll("table tbody tr"));
        };

        const filterTable = (query) => {
        const rows = getTableRows();

        if (!rows.length) return;

        rows.forEach(row => {
        const text = normalize(row.textContent);

        if (!query || text.includes(query)) {
        row.classList.remove("search-hidden-row");
        } else {
        row.classList.add("search-hidden-row");
        }
        });
        };

        const renderResults = (query) => {
        const modules = getModules();
        const matches = modules.filter(module =>
        normalize(module.name).includes(query)
        );

        results.innerHTML = "";

        if (!query) {
        results.hidden = true;
        return;
        }

        if (matches.length === 0) {
        results.innerHTML = '<div class="search-empty">No se encontraron módulos.</div>';
        results.hidden = false;
        return;
        }

        matches.slice(0, 6).forEach(module => {
        const link = document.createElement("a");
        link.href = module.url;
        link.textContent = module.name;
        results.appendChild(link);
        });

        results.hidden = false;
        };

        input.addEventListener("input", () => {
        const query = normalize(input.value);

        clearButton.style.display = query ? "block" : "none";

        filterTable(query);
        renderResults(query);
        });

        input.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;

        const query = normalize(input.value);
        const firstResult = results.querySelector("a");

        if (firstResult && query) {
        window.location.href = firstResult.href;
        }
        });

        clearButton.addEventListener("click", () => {
        input.value = "";
        clearButton.style.display = "none";
        results.hidden = true;
        filterTable("");
        input.focus();
        });

        document.addEventListener("click", (event) => {
        if (!event.target.closest(".admin-search")) {
        results.hidden = true;
        }
        });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>