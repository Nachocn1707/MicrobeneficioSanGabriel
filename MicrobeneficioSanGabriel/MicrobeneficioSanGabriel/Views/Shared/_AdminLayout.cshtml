<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Microbeneficio San Gabriel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">

    <style>
            .admin-wrapper {
                background: #fff8df !important;
            }

            .admin-sidebar {
                background: linear-gradient(180deg, #3a1f12 0%, #5a351f 55%, #7a5230 100%) !important;
                color: #fff8df !important;
                border-right: 4px solid #f3d27a !important;
                box-shadow: 8px 0 24px rgba(58, 31, 18, 0.35) !important;
            }

            .sidebar-brand {
                border-bottom: 1px solid rgba(243, 210, 122, 0.28) !important;
            }

                .sidebar-brand h4 {
                    color: #fff3c4 !important;
                    font-weight: 800;
                }

                .sidebar-brand span {
                    color: #fff8df !important;
                }

            .sidebar-menu a {
                color: #fff8df !important;
                background: transparent !important;
                border-left: 4px solid transparent !important;
            }

                .sidebar-menu a:hover {
                    background: rgba(243, 210, 122, 0.25) !important;
                    border-left-color: #f3d27a !important;
                    color: white !important;
                }

            .admin-main,
            .admin-content {
                background: #fff8df !important;
            }

            .admin-topbar {
                background: #fff3c4 !important;
                border-bottom: 1px solid #ead8a2 !important;
                box-shadow: 0 4px 16px rgba(74, 44, 26, 0.10) !important;
                gap: 20px;
            }

                .admin-topbar h5 {
                    color: #2b160d !important;
                    font-weight: 800;
                }

                .admin-topbar small {
                    color: #6f5b4a !important;
                }

            .admin-user {
                color: #2b160d !important;
            }

            .logout-btn {
                background: #4a2c1a !important;
                border: 1px solid #4a2c1a !important;
                color: #fff8df !important;
                border-radius: 8px;
                padding: 6px 12px;
                font-weight: 700;
            }

                .logout-btn:hover {
                    background: #2b160d !important;
                    border-color: #2b160d !important;
                    color: #fff8df !important;
                }

            .admin-search {
                position: relative;
                width: min(520px, 36vw);
                margin-left: auto;
            }

            .admin-search-box {
                display: flex;
                align-items: center;
                gap: 10px;
                background: #fffdf2;
                border: 1px solid #d8bd77;
                border-radius: 999px;
                padding: 9px 14px;
                box-shadow: 0 6px 16px rgba(74, 44, 26, 0.08);
            }

                .admin-search-box i {
                    color: #7a5230;
                }

                .admin-search-box input {
                    width: 100%;
                    border: none;
                    outline: none;
                    background: transparent;
                    color: #2b160d;
                    font-weight: 600;
                }

                    .admin-search-box input::placeholder {
                        color: #8a735f;
                    }

            .search-clear {
                border: none;
                background: transparent;
                color: #7a5230;
                cursor: pointer;
                display: none;
            }

            .search-results {
                position: absolute;
                top: calc(100% + 8px);
                left: 0;
                right: 0;
                background: #fffdf2;
                border: 1px solid #ead8a2;
                border-radius: 14px;
                box-shadow: 0 14px 30px rgba(74, 44, 26, 0.18);
                padding: 8px;
                z-index: 1000;
            }

                .search-results a,
                .search-results div {
                    display: block;
                    padding: 10px 12px;
                    border-radius: 10px;
                    color: #2b160d;
                    text-decoration: none;
                    font-weight: 700;
                }

                    .search-results a:hover {
                        background: #fff3c4;
                    }

            .search-empty {
                color: #6f5b4a !important;
                font-weight: 600 !important;
            }

            .search-hidden-row {
                display: none !important;
            }

            @@media (max-width: 992px) {
                .admin-topbar {
                    height: auto;
                    flex-wrap: wrap;
                    padding: 16px 24px;
                }

                .admin-search {
                    width: 100%;
                    order: 3;
                    margin-left: 0;
                }
            }
    </style>
</head>
<body>

    <div class="admin-wrapper">

        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <h4>San Gabriel</h4>
                <span>Microbeneficio</span>
            </div>

            <nav class="sidebar-menu">
                <a asp-controller="Home" asp-action="Dashboard">Dashboard</a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Operador"))
                {
                    <a asp-controller="Productores" asp-action="Index">Productores</a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Operador") || User.IsInRole("Vendedor"))
                {
                    <a asp-controller="Productos" asp-action="Index">Productos</a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Operador"))
                {
                    <a asp-controller="MovimientosInventario" asp-action="Index">Inventario</a>
                    <a asp-controller="Lotes" asp-action="Index">Lotes</a>
                    <a asp-controller="Producciones" asp-action="Index">Producción</a>
                    <a asp-controller="Trazabilidades" asp-action="Index">Trazabilidad</a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                {
                    <a asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                    <a asp-controller="Facturas" asp-action="Index">Facturación</a>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="RegistrosFinancieros" asp-action="Index">Contabilidad</a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                {
                    <a asp-controller="Reportes" asp-action="Index">Reportes</a>
                }
            </nav>
        </aside>

        <main class="admin-main">

            <header class="admin-topbar">
                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <small>Sistema de gestión administrativa</small>
                </div>

                <div class="admin-search">
                    <div class="admin-search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>

                        <input id="globalSearchInput"
                               type="search"
                               placeholder="Buscar módulo o registro..."
                               autocomplete="off" />

                        <button type="button" id="globalSearchClear" class="search-clear">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <div id="globalSearchResults" class="search-results" hidden></div>
                </div>

                <div class="topbar-user d-flex align-items-center gap-3">

                    <span class="admin-user">
                        <i class="fa-solid fa-user"></i>

                        @if (User.IsInRole("Administrador"))
                        {
                            <span>Administrador</span>
                        }
                        else if (User.IsInRole("Operador"))
                        {
                            <span>Operador</span>
                        }
                        else if (User.IsInRole("Vendedor"))
                        {
                            <span>Vendedor</span>
                        }
                        else if (User.IsInRole("Cliente"))
                        {
                            <span>Cliente</span>
                        }
                        else
                        {
                            <span>Usuario</span>
                        }
                    </span>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/Identity/Account/Login"
                          method="post">

                        <button type="submit" class="logout-btn">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Cerrar sesión
                        </button>

                    </form>

                </div>
            </header>

            <section class="admin-content">
                @RenderBody()
            </section>

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>

    <script>
        (() => {
        const input = document.getElementById("globalSearchInput");
        const results = document.getElementById("globalSearchResults");
        const clearButton = document.getElementById("globalSearchClear");

        if (!input || !results || !clearButton) return;

        const normalize = (text) =>
        (text || "")
        .toString()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();

        const getModules = () => {
        return Array.from(document.querySelectorAll(".sidebar-menu a"))
        .map(link => ({
        name: link.textContent.trim(),
        url: link.href
        }))
        .filter(item => item.name && item.url);
        };

        const getTableRows = () => {
        return Array.from(document.querySelectorAll("table tbody tr"));
        };

        const filterTable = (query) => {
        const rows = getTableRows();

        if (!rows.length) return;

        rows.forEach(row => {
        const text = normalize(row.textContent);

        if (!query || text.includes(query)) {
        row.classList.remove("search-hidden-row");
        } else {
        row.classList.add("search-hidden-row");
        }
        });
        };

        const renderResults = (query) => {
        const modules = getModules();
        const matches = modules.filter(module =>
        normalize(module.name).includes(query)
        );

        results.innerHTML = "";

        if (!query) {
        results.hidden = true;
        return;
        }

        if (matches.length === 0) {
        results.innerHTML = '<div class="search-empty">No se encontraron módulos.</div>';
        results.hidden = false;
        return;
        }

        matches.slice(0, 6).forEach(module => {
        const link = document.createElement("a");
        link.href = module.url;
        link.textContent = module.name;
        results.appendChild(link);
        });

        results.hidden = false;
        };

        input.addEventListener("input", () => {
        const query = normalize(input.value);

        clearButton.style.display = query ? "block" : "none";

        filterTable(query);
        renderResults(query);
        });

        input.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;

        const query = normalize(input.value);
        const firstResult = results.querySelector("a");

        if (firstResult && query) {
        window.location.href = firstResult.href;
        }
        });

        clearButton.addEventListener("click", () => {
        input.value = "";
        clearButton.style.display = "none";
        results.hidden = true;
        filterTable("");
        input.focus();
        });

        document.addEventListener("click", (event) => {
        if (!event.target.closest(".admin-search")) {
        results.hidden = true;
        }
        });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>