@{
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    string Active(string keyword)
    {
        return currentPath.Contains(keyword.ToLower()) ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - San Gabriel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-theme.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="sg-admin-wrapper">

        <aside class="sg-sidebar">
            <div class="sg-sidebar-brand">
                <div class="sg-brand-mark">
                    <i class="fa-solid fa-seedling"></i>
                </div>

                <div>
                    <h4>San Gabriel</h4>
                    <span>Microbeneficio</span>
                </div>
            </div>

            <nav class="sg-sidebar-menu">
                <a asp-controller="Home"
                       asp-action="Dashboard"
                       class="@Active("/home/dashboard")">
                    <i class="fa-solid fa-chart-line"></i>
                    Dashboard
                </a>

                <a asp-controller="Usuarios"
                       asp-action="Index"
                       class="@Active("/usuarios")">
                    <i class="fa-solid fa-users"></i>
                    Usuarios
                </a>

                <a asp-controller="Productores"
                       asp-action="Index"
                       class="@Active("/productores")">
                    <i class="fa-solid fa-user-tie"></i>
                    Productores
                </a>

                <a asp-controller="Productos"
                       asp-action="Index"
                       class="@Active("/productos")">
                    <i class="fa-solid fa-mug-hot"></i>
                    Productos
                </a>

                <a asp-controller="MovimientosInventario"
                       asp-action="Index"
                       class="@Active("/movimientosinventario")">
                    <i class="fa-solid fa-boxes-stacked"></i>
                    Inventario
                </a>

                <a asp-controller="Lotes"
                       asp-action="Index"
                       class="@Active("/lotes")">
                    <i class="fa-solid fa-layer-group"></i>
                    Lotes
                </a>

                <a asp-controller="Producciones"
                       asp-action="Index"
                       class="@Active("/producciones")">
                    <i class="fa-solid fa-industry"></i>
                    Producción
                </a>

                <a asp-controller="Trazabilidades"
                       asp-action="Index"
                       class="@Active("/trazabilidades")">
                    <i class="fa-solid fa-route"></i>
                    Trazabilidad
                </a>

                <a asp-controller="Pedidos"
                       asp-action="Index"
                       class="@Active("/pedidos")">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Pedidos
                </a>

                <a asp-controller="Facturas"
                       asp-action="Index"
                       class="@Active("/facturas")">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                    Facturación
                </a>

                <a asp-controller="RegistrosFinancieros"
                       asp-action="Index"
                       class="@Active("/registrosfinancieros")">
                    <i class="fa-solid fa-coins"></i>
                    Contabilidad
                </a>

                <a asp-controller="Reportes"
                       asp-action="Index"
                       class="@Active("/reportes")">
                    <i class="fa-solid fa-chart-pie"></i>
                    Reportes
                </a>
            </nav>
        </aside>

        <main class="sg-main">

            <header class="sg-topbar">
                <div class="sg-topbar-title">
                    <h5>@ViewData["Title"]</h5>
                    <small>Sistema de gestión administrativa</small>
                </div>

                <div class="sg-topbar-actions">
                    <form class="sg-search d-none d-md-block">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text"
                               placeholder="Buscar módulo o registro..." />
                    </form>

                    <span class="sg-user-pill">
                        <i class="fa-solid fa-user"></i>
                        Administrador
                    </span>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/Identity/Account/Login"
                          method="post">
                        <button type="submit" class="sg-logout-btn">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </header>

            <section class="sg-content">
                @RenderBody()
            </section>

        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>