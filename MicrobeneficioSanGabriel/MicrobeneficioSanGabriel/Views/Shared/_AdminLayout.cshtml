<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Microbeneficio San Gabriel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

    <div class="admin-wrapper">

        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <h4>San Gabriel</h4>
                <span>Microbeneficio</span>
            </div>

            <nav class="sidebar-menu">
                <a asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                <a asp-controller="Productores" asp-action="Index">Productores</a>
                <a asp-controller="Productos" asp-action="Index">Productos</a>
                <a asp-controller="MovimientosInventario" asp-action="Index">Inventario</a>
                <a asp-controller="Lotes" asp-action="Index">Lotes</a>
                <a asp-controller="Producciones" asp-action="Index">Producción</a>
                <a asp-controller="Trazabilidades" asp-action="Index">Trazabilidad</a>
                <a asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                <a asp-controller="Facturas" asp-action="Index">Facturación</a>
                <a asp-controller="RegistrosFinancieros" asp-action="Index">Contabilidad</a>
                <a asp-controller="Reportes" asp-action="Index">Reportes</a>
            </nav>
        </aside>

        <main class="admin-main">

            <header class="admin-topbar">
                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <small>Sistema de gestión administrativa</small>
                </div>

                <div class="topbar-user d-flex align-items-center gap-3">

                    <span class="admin-user">
                        <i class="fa-solid fa-user"></i>
                        Administrador
                    </span>

                    <form asp-area="Identity"
                          asp-page="/Account/Login"
                          method="post">

                        <button type="submit" class="logout-btn">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Cerrar sesión
                        </button>

                    </form>

                </div>
            </header>

            <section class="admin-content">
                @RenderBody()
            </section>

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>