@using Microsoft.AspNetCore.Identity
@using MicrobeneficioSanGabriel.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
    var clientName = currentUser?.NombreCompleto
        ?? User.Identity?.Name
        ?? "Cliente";

    string Active(string keyword)
    {
        return currentPath.Contains(keyword.ToLower()) ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href=~/favicon_io/favicon-32x32.png>
    <link rel="icon" type="image/png" sizes="16x16" href=~/favicon_io/favicon-16x16.png>
    <link rel="manifest" href="/site.webmanifest">
    <title>@ViewData["Title"] - San Gabriel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/notificaciones.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sg-coffee-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cliente-estetico.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/sg-crud-overrides.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal-unificado.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <!-- Carga al final para que los ajustes de jerarquía visual prevalezcan también en vistas con CSS propio. -->
    <link rel="stylesheet" href="~/css/sprint4-final.css" asp-append-version="true" />
</head>
<body class="sg-coffee-bg rc-client-body cafe-portal-body">
    <div class="cafe-portal-shell">
        <header class="cafe-portal-header">

            <a asp-controller="Home"
               asp-action="ClienteDashboard"
               class="cafe-portal-brand"
               aria-label="Ir al inicio">
                <span class="cafe-portal-brand-icon">
                    <i class="fa-solid fa-mug-hot"></i>
                </span>

                <span class="cafe-portal-brand-text">
                    <strong>San Gabriel</strong>
                    <small>Coffee Club</small>
                </span>
            </a>

            <nav class="cafe-portal-nav" aria-label="Navegacion principal">
                <a asp-controller="Home"
                   asp-action="ClienteDashboard"
                   class="@Active("/home/clientedashboard")">
                    Inicio
                </a>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="@Active("/productos")">
                    Productos
                </a>

                <a asp-controller="Pedidos"
                   asp-action="Index"
                   class="@(currentPath == "/pedidos" || currentPath.Contains("/pedidos/index") ? "active" : "")">
                    Mis pedidos
                </a>
            </nav>

            <div class="cafe-portal-actions">
                <div class="cafe-client-session" title="Cliente en sesión: @clientName">
                    <span class="cafe-client-session-icon" aria-hidden="true">
                        <i class="fa-regular fa-user"></i>
                    </span>
                    <span class="cafe-client-session-text">
                        <small>Cliente</small>
                        <strong>@clientName</strong>
                    </span>
                </div>

                <partial name="_CentroNotificaciones" />

                <a asp-controller="Pedidos"
                   asp-action="Create"
                   class="cafe-header-order-button">
                    <i class="fa-solid fa-cart-plus"></i>
                    Pedir ahora
                </a>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="/Identity/Account/Login"
                      method="post">
                    <button type="submit" class="cafe-header-logout" title="Cerrar sesion">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Salir</span>
                    </button>
                </form>

            </div>

        </header>

        <form id="sgGlobalAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>
        <main class="cafe-portal-main">
            <partial name="_MensajesSistema" />
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/Validaciones.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/sg-datatables.js" asp-append-version="true"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    <script src="~/js/costa-rica-ubicaciones.js" asp-append-version="true"></script>
    <script src="~/js/sistema-ui.js" asp-append-version="true"></script>
</body>
</html>