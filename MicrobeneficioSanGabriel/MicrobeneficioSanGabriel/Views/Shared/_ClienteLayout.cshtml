@using Microsoft.AspNetCore.Identity
@using MicrobeneficioSanGabriel.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var usuarioActual = await UserManager.GetUserAsync(User);

    var nombreCliente = usuarioActual != null
        ? usuarioActual.NombreCompleto
        : "Cliente";

    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    string Active(string keyword)
    {
        return currentPath.Contains(keyword.ToLower()) ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - San Gabriel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/visual-backgrounds.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/client-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/respawn-coffee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notificaciones.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sg-coffee-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sg-crud-overrides.css" asp-append-version="true" />
</head>

<body class="sg-coffee-bg rc-client-body">
    <div class="sg-client-wrapper">

        <aside class="sg-client-sidebar">
            <div class="sg-sidebar-brand">
                <div class="sg-brand-mark">
                    <i class="fa-solid fa-mug-hot"></i>
                </div>

                <div>
                    <h4>San Gabriel</h4>
                    <span>Coffee Club</span>
                </div>
            </div>

            <nav class="sg-sidebar-menu">
                <a asp-controller="Home"
                   asp-action="ClienteDashboard"
                   class="@Active("/home/clientedashboard")">
                    <i class="fa-solid fa-house"></i>
                    Inicio
                </a>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="@Active("/productos")">
                    <i class="fa-solid fa-mug-hot"></i>
                    Productos
                </a>

                <a asp-controller="Pedidos"
                   asp-action="Index"
                   class="@(currentPath == "/pedidos" || currentPath.Contains("/pedidos/index") ? "active" : "")">
                    <i class="fa-solid fa-clipboard-list"></i>
                    Mis pedidos
                </a>

            </nav>
        </aside>

        <main class="sg-client-main">
            <header class="sg-topbar">
                <div class="sg-topbar-title">
                    <h5>@ViewData["Title"]</h5>
                    <small>Sistema de compras del microbeneficio</small>
                </div>

                <div class="sg-topbar-actions ">
                    <partial name="_CentroNotificaciones" />
                    <span class="sg-user-pill" title="Usuario activo">
                        <i class="fa-solid fa-user"></i>
                        <div class="sg-user-info">
                            <strong>@nombreCliente</strong>
                            <small>Cliente</small>
                        </div>
                    </span>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/Identity/Account/Login"
                          method="post">
                        <button type="submit" class="sg-logout-btn">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Cerrar sesion
                        </button>
                    </form>
                </div>
            </header>

            <section class="sg-content sg-bg-page sg-client-content">
                <partial name="_MensajesSistema" />
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/Validaciones.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("[data-auto-dismiss='true']").forEach(message => {
        setTimeout(() => bootstrap.Alert.getOrCreateInstance(message).close(), 5000);
        });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
</body>
</html>


