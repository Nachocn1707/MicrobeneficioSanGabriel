<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - San Gabriel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
            :root {
                --sg-bg: #f7efe4;
                --sg-panel: #fffaf2;
                --sg-panel-soft: #fffdf8;
                --sg-border: #eadfce;
                --sg-sidebar: #3a2114;
                --sg-sidebar-2: #4a2b19;
                --sg-active: #f7efe4;
                --sg-text: #2a1a12;
                --sg-muted: #8b7a6c;
                --sg-gold: #d9a44a;
                --sg-gold-soft: #f5dfb0;
                --sg-green: #3f8f4d;
                --sg-shadow: 0 18px 42px rgba(58, 33, 20, 0.10);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--sg-bg);
                color: var(--sg-text);
                font-family: "Segoe UI", Arial, sans-serif;
                font-size: 14px;
            }

            .cliente-shell {
                min-height: 100vh;
                display: flex;
                background: var(--sg-bg);
            }

            .cliente-sidebar {
                width: 190px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, var(--sg-sidebar), var(--sg-sidebar-2));
                color: #fff;
                padding: 18px 14px;
                box-shadow: 10px 0 28px rgba(58, 33, 20, 0.22);
                z-index: 100;
            }

            .cliente-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 4px 4px 24px;
                margin-bottom: 16px;
            }

            .cliente-brand-mark {
                width: 34px;
                height: 34px;
                border-radius: 12px;
                background: rgba(245, 223, 176, 0.14);
                color: var(--sg-gold-soft);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
            }

            .cliente-brand h4 {
                margin: 0;
                color: #fff3cf;
                font-size: 17px;
                font-weight: 900;
                line-height: 1.1;
            }

            .cliente-brand span {
                color: #e9d8bf;
                font-size: 11px;
                font-weight: 600;
            }

            .cliente-menu {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

                .cliente-menu a {
                    height: 39px;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 0 12px;
                    border-radius: 10px;
                    color: #f5eadb;
                    text-decoration: none;
                    font-size: 13px;
                    font-weight: 800;
                    transition: 0.18s ease;
                }

                    .cliente-menu a i {
                        width: 16px;
                        color: #e7c98e;
                        text-align: center;
                        font-size: 13px;
                    }

                    .cliente-menu a:hover,
                    .cliente-menu a.active {
                        background: var(--sg-active);
                        color: var(--sg-sidebar);
                    }

                        .cliente-menu a:hover i,
                        .cliente-menu a.active i {
                            color: var(--sg-gold);
                        }

            .cliente-main {
                margin-left: 190px;
                width: calc(100% - 190px);
                min-height: 100vh;
            }

            .cliente-topbar {
                height: 68px;
                background: rgba(255, 250, 242, 0.96);
                border-bottom: 1px solid var(--sg-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 18px;
                padding: 0 28px;
                position: sticky;
                top: 0;
                z-index: 90;
                box-shadow: 0 6px 20px rgba(58, 33, 20, 0.06);
            }

                .cliente-topbar h5 {
                    margin: 0;
                    color: var(--sg-text);
                    font-size: 17px;
                    font-weight: 950;
                }

                .cliente-topbar small {
                    color: var(--sg-muted);
                    font-size: 11px;
                    font-weight: 700;
                }

            .cliente-content {
                padding: 28px;
            }

            .cliente-user-actions {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .cliente-user-chip {
                height: 36px;
                background: #fff;
                border: 1px solid var(--sg-border);
                border-radius: 999px;
                padding: 0 13px;
                display: flex;
                align-items: center;
                gap: 8px;
                color: var(--sg-text);
                font-size: 12px;
                font-weight: 900;
                box-shadow: 0 8px 20px rgba(58, 33, 20, 0.05);
            }

            .logout-btn {
                height: 36px;
                border: none;
                border-radius: 9px;
                background: var(--sg-sidebar);
                color: #fff7e8;
                padding: 0 13px;
                font-size: 12px;
                font-weight: 900;
            }

                .logout-btn:hover {
                    background: #24120a;
                    color: #fff7e8;
                }

            .cliente-card,
            .card {
                background: var(--sg-panel-soft) !important;
                border: 1px solid var(--sg-border) !important;
                border-radius: 16px !important;
                box-shadow: var(--sg-shadow) !important;
            }

            .btn-success,
            .btn-primary {
                background: var(--sg-sidebar) !important;
                border-color: var(--sg-sidebar) !important;
                color: #fff7e8 !important;
                border-radius: 9px !important;
                font-size: 12px;
                font-weight: 900 !important;
                padding: 8px 12px;
            }

                .btn-success:hover,
                .btn-primary:hover {
                    background: #24120a !important;
                    border-color: #24120a !important;
                }

            @@media (max-width: 992px) {
                .cliente-shell {
                    display: block;
                }

                .cliente-sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                }

                .cliente-menu {
                    display: grid;
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .cliente-main {
                    margin-left: 0;
                    width: 100%;
                }

                .cliente-topbar {
                    height: auto;
                    padding: 16px;
                    flex-wrap: wrap;
                }
            }

            @@media (max-width: 576px) {
                .cliente-menu {
                    grid-template-columns: 1fr;
                }

                .cliente-content {
                    padding: 18px;
                }
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="cliente-shell">

        <aside class="cliente-sidebar">
            <div class="cliente-brand">
                <div class="cliente-brand-mark">
                    <i class="fa-solid fa-seedling"></i>
                </div>

                <div>
                    <h4>San Gabriel</h4>
                    <span>Microbeneficio</span>
                </div>
            </div>

            <nav class="cliente-menu">
                <a asp-controller="Home" asp-action="ClienteDashboard">
                    <i class="fa-solid fa-house"></i>
                    <span>Inicio</span>
                </a>

                <a asp-controller="Productos" asp-action="Index">
                    <i class="fa-solid fa-box-open"></i>
                    <span>Productos</span>
                </a>

                <a asp-controller="Pedidos" asp-action="Create">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Realizar pedido</span>
                </a>

                <a asp-controller="Pedidos" asp-action="Index">
                    <i class="fa-solid fa-calendar-check"></i>
                    <span>Mis pedidos</span>
                </a>

                <a asp-controller="Trazabilidades" asp-action="Index">
                    <i class="fa-solid fa-route"></i>
                    <span>Trazabilidad</span>
                </a>
            </nav>
        </aside>

        <main class="cliente-main">
            <header class="cliente-topbar">
                <div>
                    <h5>@ViewData["Title"]</h5>
                    <small>Portal cliente de Microbeneficio San Gabriel</small>
                </div>

                <div class="cliente-user-actions">
                    <div class="cliente-user-chip">
                        <i class="fa-solid fa-user"></i>
                        Cliente
                    </div>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/Identity/Account/Login"
                          method="post">

                        <button type="submit" class="logout-btn">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </header>

            <section class="cliente-content">
                @RenderBody()
            </section>
        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (() => {
        const currentPath = window.location.pathname.toLowerCase();

        document.querySelectorAll(".cliente-menu a").forEach(link => {
        const linkPath = new URL(link.href).pathname.toLowerCase();

        if (currentPath === linkPath || currentPath.startsWith(linkPath + "/")) {
        link.classList.add("active");
        }
        });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>