@using Microsoft.AspNetCore.Identity
@using MicrobeneficioSanGabriel.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var usuarioActual = await UserManager.GetUserAsync(User);

var nombreCliente = usuarioActual != null
    ? usuarioActual.NombreCompleto
    : "Cliente";

    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    string Active(string keyword)
    {
        return currentPath.Contains(keyword.ToLower()) ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - San Gabriel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-theme.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="sg-client-wrapper">

        <aside class="sg-client-sidebar">
            <div class="sg-sidebar-brand">
                <div class="sg-brand-mark">
                    <i class="fa-solid fa-mug-hot"></i>
                </div>

                <div>
                    <h4>San Gabriel</h4>
                    <span>Portal cliente</span>
                </div>
            </div>

            <nav class="sg-sidebar-menu">
                <a asp-controller="Home"
                       asp-action="ClienteDashboard"
                       class="@Active("/home/clientedashboard")">
                    <i class="fa-solid fa-house"></i>
                    Inicio
                </a>

                <a asp-controller="Productos"
                       asp-action="Index"
                       class="@Active("/productos")">
                    <i class="fa-solid fa-mug-hot"></i>
                    Productos
                </a>

                <a asp-controller="Pedidos"
                       asp-action="Create"
                       class="@Active("/pedidos/create")">
                    <i class="fa-solid fa-cart-plus"></i>
                    Realizar pedido
                </a>

                <a asp-controller="Pedidos"
                       asp-action="Index"
                       class="@(currentPath == "/pedidos" || currentPath.Contains("/pedidos/index") ? "active" : "")">
                    <i class="fa-solid fa-clipboard-list"></i>
                    Mis pedidos
                </a>

            </nav>
        </aside>

        <main class="sg-client-main">

            <header class="sg-topbar">
                <div class="sg-topbar-title">
                    <h5>@ViewData["Title"]</h5>
                    <small>Sistema de compras del microbeneficio</small>
                </div>

                <div class="sg-topbar-actions">
                    <form class="sg-search d-none d-md-block">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text"
                               placeholder="Buscar módulo o registro..." />
                    </form>
                    <span class="sg-user-pill">
                        <i class="fa-solid fa-user"></i>
                        @nombreCliente
                    </span>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/Identity/Account/Login"
                          method="post">
                        <button type="submit" class="sg-logout-btn">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </header>

            <section class="sg-client-content">
                @RenderBody()
            </section>

        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>