@model IEnumerable<MicrobeneficioSanGabriel.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";

    if (User.IsInRole("Cliente"))
    {
        Layout = "~/Views/Shared/_ClienteLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">Pedidos</h1>
        <p class="text-muted">
            Gestión de pedidos y solicitudes de clientes.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Nuevo Pedido
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">

        <div class="table-responsive">

            <table id="tablaPedidos" class="table align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Observación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @item.ClienteNombre
                            </td>

                            <td>@item.ClienteTelefono</td>

                            <td>
                                @item.Producto?.Nombre
                            </td>

                            <td>
                                @item.Cantidad unidades
                            </td>

                            <td>
                                @item.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @if (item.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                                else if (item.Estado == "En proceso")
                                {
                                    <span class="badge bg-primary">En proceso</span>
                                }
                                else if (item.Estado == "En camino")
                                {
                                    <span class="badge bg-info text-dark">En camino</span>
                                }
                                else if (item.Estado == "Listo para retirar")
                                {
                                    <span class="badge bg-secondary">Listo para retirar</span>
                                }
                                else if (item.Estado == "Completado")
                                {
                                    <span class="badge bg-success">Completado</span>
                                }
                                else if (item.Estado == "Cancelado")
                                {
                                    <span class="badge bg-danger">Cancelado</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">@item.Estado</span>
                                }
                            </td>

                            <td>
                                @item.Observacion
                            </td>

                            <td>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
                                        Detalles
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        Eliminar
                                    </a>
                                }
                                else if (User.IsInRole("Cliente"))
                                {
                                    @if (item.Estado != null && item.Estado.Trim() == "Pendiente")
                                    {
                                        <a asp-action="EditCliente"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">
                                            Actualizar
                                        </a>

                                        <a asp-action="Cancelar"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm">
                                            Cancelar
                                        </a>
                                    }

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
                                        Detalles
                                    </a>
                                }
                                else if (User.IsInRole("Vendedor"))
                                {
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
                                        Detalles
                                    </a>
                                }
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaPedidos').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20] ,
                responsive: true
            });
        });
    </script>
}