                    <i class="fa-solid fa-circle-check"></i>
                </span>
                <div><small>Completados</small><strong>@completados</strong></div>
            </article>

            <article>
                <span class="client-orders-summary-icon brown">
                    <i class="fa-solid fa-wallet"></i>
                </span>
                <div><small>Pagos pendientes</small><strong>@pagosPendientes</strong></div>
            </article>
        </section>

        <section class="client-orders-section">
            <header class="client-orders-section-head">
                <div>
                    <span>Historial personal</span>
                    <h2>Tus compras recientes</h2>
                    <p>Encontrá los detalles y acciones disponibles para cada pedido.</p>
                </div>

                <a asp-action="Create" class="client-orders-new-link">
                    Nuevo pedido
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </header>

            @if (pedidos.Any())
            {
                <div class="client-orders-list">
                    @foreach (var p in pedidos)
                    {
                        var totalPedido = (p.Producto?.Precio ?? 0) * p.Cantidad;
                        var pagoPendiente = p.EstadoPago == "Pendiente" || p.EstadoPago == "Pendiente de pago" || p.EstadoPago == "Sin pago";

                        <article class="client-purchase-card">
                            <div class="client-purchase-main">
                                <div class="client-purchase-number">
                                    <span>Pedido</span>
                                    <strong>PP-@p.Id.ToString("0000")</strong>
                                </div>

                                <div class="client-purchase-product-icon">
                                    <i class="fa-solid fa-mug-hot"></i>
                                </div>

                                <div class="client-purchase-product">
                                    <small>Producto seleccionado</small>
                                    <h3>@(p.Producto?.Nombre ?? "Producto")</h3>
                                    <span>@p.Cantidad kg · @p.FechaPedido.ToString("dd MMM yyyy")</span>
                                </div>

                                <div class="client-purchase-total">
                                    <small>Total</small>
                                    <strong>₡@totalPedido.ToString("N0")</strong>
                                </div>

                                <div class="client-purchase-statuses">
                                    <span class="client-status-pill @EstadoClase(p.Estado)">
                                        <i class="fa-solid fa-box"></i>
                                        @p.Estado
                                    </span>

                                    <span class="client-payment-pill @(pagoPendiente ? "pending" : "paid")">
                                        <i class="fa-solid fa-wallet"></i>
                                        @(string.IsNullOrWhiteSpace(p.EstadoPago) ? "Pendiente" : p.EstadoPago)
                                    </span>
                                </div>
                            </div>

                            <div class="client-purchase-actions">
                                <a asp-action="Details"
                                   asp-route-id="@p.Id"
                                   class="client-purchase-action details">
                                    <i class="fa-solid fa-eye"></i>
                                    Ver detalles
                                </a>

                                @if (p.Estado == "Pendiente")
                                {
                                    <a asp-action="EditCliente"
                                       asp-route-id="@p.Id"
                                       class="client-purchase-action edit">
                                        <i class="fa-solid fa-pen"></i>
                                        Editar
                                    </a>

                                    <a asp-action="Cancelar"
                                       asp-route-id="@p.Id"
                                       class="client-purchase-action cancel">
                                        <i class="fa-solid fa-ban"></i>
                                        Cancelar
                                    </a>
                                }

                                @if (pagoPendiente)
                                {
                                    @* <button type="button"
                                            class="client-purchase-action pay js-open-payment-modal"
                                            data-pedido-id="@p.Id"
                                            data-pedido-code="PP-@p.Id.ToString("0000")"
                                            data-product="@(p.Producto?.Nombre ?? "Producto")"
                                            data-quantity="@p.Cantidad.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-date="@p.FechaPedido.ToString("dd MMM yyyy")"
                                            data-total-display="₡@totalPedido.ToString("N0")"
                                            aria-haspopup="dialog"
                                            aria-controls="paymentModal">
                                        <i class="fa-solid fa-credit-card"></i>
                                        Realizar pago
                                    </button> *@
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="client-orders-empty">
                    <span><i class="fa-solid fa-mug-saucer"></i></span>
                    <h3>Todavía no tenés pedidos</h3>
                    <p>Explorá el catálogo y elegí el café que más te guste.</p>
                    <a asp-controller="Productos" asp-action="Index">Ver catálogo</a>
                </div>
            }
        </section>
    </div>

    <div class="modal fade"
         id="paymentModal"
         tabindex="-1"
         aria-labelledby="paymentModalTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable sg-payment-dialog">
            <div class="modal-content sg-payment-modal">
                <div class="modal-header sg-payment-header">
                    <div class="sg-payment-heading">
                        <span class="sg-payment-heading-icon" aria-hidden="true">
                            <i class="fa-solid fa-shield-halved"></i>
                        </span>
                        <div>
                            <small>Proceso seguro</small>
                            <h2 id="paymentModalTitle">Método de pago</h2>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close sg-payment-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>

                <div class="modal-body sg-payment-body">
                    <div id="paymentFormView">
                        <form asp-controller="Pedidos"
                              asp-action="Pago"
                              method="post"
                              id="modalPaymentForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="pedidoId" id="modalPedidoId" />

                            <div class="sg-payment-layout">
                                <div class="sg-payment-main">
                                    <div class="sg-payment-section-label">
                                        <span>Seleccioná cómo pagar</span>
                                        <span class="sg-payment-secure-badge">
                                            <i class="fa-solid fa-lock"></i>
                                            Datos protegidos
                                        </span>
                                    </div>

                                    <div class="sg-payment-methods" role="radiogroup" aria-label="Métodos de pago">
                                        <label class="sg-payment-method">
                                            <input type="radio"
                                                   name="metodoPago"
                                                   value="SINPE Móvil"
                                                   checked />
                                            <span class="sg-payment-method-card">
                                                <span class="sg-payment-method-icon" aria-hidden="true">
                                                    <i class="fa-solid fa-mobile-screen-button"></i>
                                                </span>
                                                <span class="sg-payment-method-copy">
                                                    <strong>SINPE Móvil</strong>
                                                    <small>Transferencia rápida desde tu banco</small>
                                                </span>
                                                <span class="sg-payment-radio-mark" aria-hidden="true"></span>
                                            </span>
                                        </label>

                                        <label class="sg-payment-method cash">
                                            <input type="radio"
                                                   name="metodoPago"
                                                   value="Efectivo" />
                                            <span class="sg-payment-method-card">
                                                <span class="sg-payment-method-icon" aria-hidden="true">
                                                    <i class="fa-solid fa-money-bill-wave"></i>
                                                </span>
                                                <span class="sg-payment-method-copy">
                                                    <strong>Efectivo</strong>
                                                    <small>Pagá al retirar el pedido en el establecimiento</small>
                                                </span>
                                                <span class="sg-payment-radio-mark" aria-hidden="true"></span>
                                            </span>
                                        </label>
                                    </div>

                                    <div class="sg-payment-details" id="modalSinpeDetails">
                                        <div class="sg-payment-details-head">
                                            <i class="fa-solid fa-circle-info"></i>
                                            <div>
                                                <strong>Información para realizar el SINPE</strong>
                                                <span>Usá el número indicado y colocá el código del pedido como referencia.</span>
                                            </div>
                                        </div>

                                        <div class="sg-sinpe-number-box">
                                            <div>
                                                <small>Número SINPE Móvil</small>
                                                <strong>8954-6434</strong>
                                            </div>
                                            <button type="button"
                                                    class="sg-copy-button"
                                                    id="copySinpeNumber"
                                                    data-number="89546434"
                                                    aria-label="Copiar número SINPE">
                                                <i class="fa-regular fa-copy"></i>
                                            </button>
                                        </div>

                                        <p class="sg-payment-note">
                                            <i class="fa-solid fa-receipt"></i>
                                            <span>
                                                Referencia: <strong id="modalReference">Pedido</strong>.
                                                El pago quedará pendiente hasta validar el comprobante.
                                            </span>
                                        </p>
                                    </div>

                                    <div class="sg-payment-details" id="modalCashDetails" hidden>
                                        <div class="sg-payment-details-head">
                                            <i class="fa-solid fa-store"></i>
                                            <div>
                                                <strong>Pago en el establecimiento</strong>
                                                <span>Cancelá el monto total en efectivo cuando retirés tu pedido.</span>
                                            </div>
                                        </div>
                                        <p class="sg-payment-note">
                                            <i class="fa-solid fa-circle-check"></i>
                                            <span>No necesitás realizar ningún depósito anticipado.</span>
                                        </p>
                                    </div>

                                    <div class="sg-payment-feedback"
                                         id="paymentModalFeedback"
                                         role="alert">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                        <span>No fue posible procesar la solicitud.</span>
                                    </div>

                                    <div class="sg-payment-actions">
                                        <button type="button"
                                                class="sg-payment-button secondary"
                                                data-bs-dismiss="modal">
                                            Cancelar
                                        </button>
                                        <button type="submit"
                                                class="sg-payment-button primary"
                                                id="paymentSubmitButton">
                                            <i class="fa-solid fa-lock"></i>
                                            <span id="paymentSubmitText">Confirmar método de pago</span>
                                        </button>
                                    </div>
                                </div>

                                <aside class="sg-payment-sidebar" aria-label="Resumen del pedido">
                                    <div class="sg-order-summary">
                                        <div class="sg-order-summary-head">
                                            <span class="sg-order-summary-icon" aria-hidden="true">
                                                <i class="fa-solid fa-mug-hot"></i>
                                            </span>
                                            <div>
                                                <small>Resumen del pedido</small>
                                                <strong id="modalOrderCode">Pedido</strong>
                                            </div>
                                        </div>

                                        <div class="sg-order-summary-body">
                                            <div class="sg-order-summary-row">
                                                <span>Producto</span>
                                                <strong id="modalProduct">Producto</strong>
                                            </div>
                                            <div class="sg-order-summary-row">
                                                <span>Cantidad</span>
                                                <strong id="modalQuantity">0 kg</strong>
                                            </div>
                                            <div class="sg-order-summary-row">
                                                <span>Fecha del pedido</span>
                                                <strong id="modalDate">—</strong>
                                            </div>
                                        </div>

                                        <div class="sg-order-summary-total">
                                            <span>Total a pagar</span>
                                            <strong id="modalTotal">₡0</strong>
                                        </div>
                                    </div>

                                    <div class="sg-payment-trust">
                                        <div>
                                            <i class="fa-solid fa-shield-halved"></i>
                                            <span>Proceso confiable</span>
                                        </div>
                                        <div>
                                            <i class="fa-solid fa-headset"></i>
                                            <span>Soporte disponible</span>
                                        </div>
                                    </div>
                                </aside>
                            </div>
                        </form>
                    </div>

                    <section class="sg-payment-success"
                             id="paymentSuccessView"
                             aria-live="polite"
                             hidden>
                        <span class="sg-payment-success-icon" aria-hidden="true">
                            <i class="fa-solid fa-check"></i>
                        </span>
                        <h3>Método de pago registrado</h3>
                        <p id="paymentSuccessMessage">
                            La información se guardó correctamente.
                        </p>

                        <div class="sg-payment-success-box">
                            <div>
                                <small>Pedido</small>
                                <strong id="paymentSuccessOrder">—</strong>
                            </div>
                            <div>
                                <small>Método</small>
                                <strong id="paymentSuccessMethod">—</strong>
                            </div>
                            <div>
                                <small>Estado</small>
                                <strong id="paymentSuccessStatus">Pendiente de pago</strong>
                            </div>
                        </div>

                        <div class="sg-payment-success-box"
                             id="paymentSuccessSinpeBlock">
                            <div>
                                <small>Número SINPE</small>
                                <strong id="paymentSuccessSinpeNumber">89546434</strong>
                            </div>
                            <div>
                                <small>Monto</small>
                                <strong id="paymentSuccessTotal">₡0</strong>
                            </div>
                            <div>
                                <small>Comprobante</small>
                                <strong>Requerido</strong>
                            </div>
                        </div>

                        <a href="#"
                           class="sg-payment-button sg-payment-whatsapp"
                           id="paymentWhatsappButton"
                           target="_blank"
                           rel="noopener noreferrer">
                            <i class="fa-brands fa-whatsapp"></i>
                            Enviar comprobante
                        </a>

                        <button type="button"
                                class="sg-payment-button primary"
                                data-bs-dismiss="modal">
                            Entendido
                        </button>
                    </section>
                </div>
            </div>
        </div>
    </div>
}
else
{
    var inicioMes = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var finMes = inicioMes.AddMonths(1);
    var ventasMes = pedidos.Where(p => p.FechaPedido >= inicioMes && p.FechaPedido < finMes && p.EstadoPago == "Pago completado").Sum(p => (p.Producto?.Precio ?? 0) * p.Cantidad);

    <section class="sg-page-head">
        <div><h1>Pedidos y Facturación</h1><p>Gestión de pedidos, entregas y facturación.</p></div>
        <div class="sg-actions"><label class="sg-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-table-target="tablaPedidos" placeholder="Buscar pedido, cliente, producto o pago..." /></label></div>
    </section>
    <section class="sg-kpi-grid">
        <article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-cart-shopping"></i></span><div><span>Ventas del mes</span><strong>₡@ventasMes.ToString("N0")</strong><div class="sg-trend">Solo pagos completados</div></div></article>
        <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-layer-group"></i></span><div><span>Pedidos totales</span><strong>@total</strong><div class="sg-trend">Registros reales</div></div></article>
        <article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-clipboard-list"></i></span><div><span>Pedidos pendientes</span><strong>@pendientes</strong><div class="sg-trend warn">Pendiente / En proceso</div></div></article>
        <article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-circle-check"></i></span><div><span>Completados</span><strong>@completados</strong><div class="sg-trend">Según estado actual</div></div></article>
    </section>
    <section class="sg-grid-2">
        <article class="sg-card sg-panel">
            <h3>Estado de pedidos</h3>
            <div class="sg-donut-wrap mt-3">
                <div class="sg-donut" style="--donut-bg: @donutEstadoPedidos;">
                    <div>
                        <b>@porcentajeCompletados%</b><br />
                        <span>Completados</span>
                    </div>
                </div>
                <div class="sg-legend">
                    <div class="sg-legend-row"><span class="sg-dot green"></span><span>Completados</span><b>@completados</b></div>
                    <div class="sg-legend-row"><span class="sg-dot gold"></span><span>En proceso</span><b>@enProceso</b></div>
                    <div class="sg-legend-row"><span class="sg-dot tan"></span><span>Pendientes</span><b>@pendientesSolo</b></div>
                    <div class="sg-legend-row"><span class="sg-dot brown"></span><span>Cancelados</span><b>@cancelados</b></div>
                </div>
            </div>
        </article>
        <article class="sg-card sg-panel"><h3>Resumen de pagos</h3><div class="sg-legend mt-4"><div class="sg-legend-row"><span class="sg-dot tan"></span><span>Pagos pendientes</span><b>@pagosPendientes</b></div><div class="sg-legend-row"><span class="sg-dot"></span><span>Pedidos con pago completado</span><b>@pedidos.Count(p => string.Equals(p.EstadoPago, "Pago completado", StringComparison.OrdinalIgnoreCase))</b></div><div class="sg-legend-row"><span class="sg-dot gold"></span><span>Monto cobrado</span><b>₡@ventas.ToString("N0")</b></div></div><hr /><div class="d-flex justify-content-between fw-bold text-success"><span>Total de pedidos</span><span>@total</span></div></article>
    </section>
    <section class="sg-card sg-table-card">
        <div class="sg-panel-head"><h3>Pedidos recientes</h3><span class="sg-badge">@total registro(s)</span></div><div class="table-responsive">
        <table class="sg-table" id="tablaPedidos">
            <thead><tr><th>Pedido</th><th>Cliente</th><th>Producto</th><th>Cantidad</th><th>Fecha</th><th>Estado</th><th>Pago</th><th>Total</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var p in pedidos)
                {
                    <tr>
                        <td>PP-@p.Id.ToString("0000")</td>
                        <td>@p.ClienteNombre</td>
                        <td>@(p.Producto?.Nombre ?? "Producto")</td>
                        <td>@p.Cantidad kg</td>
                        <td>@p.FechaPedido.ToString("dd MMM yyyy")</td>
                        <td><span class="sg-badge @EstadoClase(p.Estado)">@p.Estado</span></td>
                        <td><span class="sg-badge @(p.EstadoPago?.Contains("Pend") == true || p.EstadoPago == "Sin pago" ? "tan" : "")">@(string.IsNullOrWhiteSpace(p.EstadoPago) ? "Pendiente" : p.EstadoPago)</span></td>
                        <td>₡@(((p.Producto?.Precio ?? 0) * p.Cantidad).ToString("N0"))</td>
                        <td>
                            <span class="sg-action-icons">
                                <a asp-action="Details" asp-route-id="@p.Id" title="Ver detalles" aria-label="Ver detalles"><i class="fa-solid fa-eye"></i></a>@if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                                {
                                    <a asp-action="CambiarEstadoPago" asp-route-id="@p.Id" title="Cambiar estado de pago" aria-label="Cambiar estado de pago"><i class="fa-solid fa-wallet"></i></a>
                                }
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit" asp-route-id="@p.Id" title="Editar pedido" aria-label="Editar pedido"><i class="fa-solid fa-pen"></i></a>
                                    <a asp-action="CambiarEstado" asp-route-id="@p.Id" title="Cambiar estado del pedido" aria-label="Cambiar estado del pedido"><i class="fa-solid fa-list-check"></i></a>
                                    <a asp-action="Delete" asp-route-id="@p.Id" title="Eliminar pedido" aria-label="Eliminar pedido"><i class="fa-solid fa-trash"></i></a>
                                }
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
}
