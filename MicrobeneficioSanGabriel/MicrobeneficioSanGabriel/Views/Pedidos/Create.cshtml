@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Nuevo Pedido";
    var productoNombre = ViewBag.ProductoNombre as string;

    if (User.IsInRole("Cliente"))
    {
        Layout = "~/Views/Shared/_ClienteLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaCreaR.css" />
    <link rel="stylesheet" href="~/css/pago-modal.css" asp-append-version="true" />
}

<div class="VistaCreaR-page">
    <div class="VistaCreaR-top">
        <div class="VistaCreaR-title">
            <span class="VistaCreaR-badge">
                <i class="fa-solid fa-cart-shopping"></i>
                Gestión de pedidos
            </span>
            <h1>Nuevo pedido</h1>
            <p id="pago-texto">
                Registrá pedidos realizados por clientes dentro del sistema del microbeneficio.
            </p>
        </div>
    </div>

    <div class="VistaCreaR-card">
        <div class="VistaCreaR-form-container">
            <form asp-action="Create" method="post" id="createOrderForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <input type="hidden" asp-for="ClienteCorreo" />

                @if (User.IsInRole("Cliente"))
                {
                    <input type="hidden" asp-for="Estado" value="Pendiente" />
                    <input type="hidden" asp-for="FechaPedido" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />

                    <div class="pedido-alert">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>
                            El pedido se registrará automáticamente en estado <strong>Pendiente</strong>.
                        </span>
                    </div>
                }

                <div class="VistaCreaR-section">
                    <h5>
                        <i class="fa-solid fa-box-archive"></i>
                        Detalle del pedido
                    </h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ClienteNombre" class="form-label">Cliente</label>
                                <div class="input-modern">
                                    <i class="fa-regular fa-user"></i>
                                    <input asp-for="ClienteNombre"
                                           class="form-control"
                                           placeholder="Digite el nombre completo del cliente" />
                                </div>
                                <span asp-validation-for="ClienteNombre" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ClienteTelefono" class="form-label">Teléfono</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-phone"></i>
                                    <input asp-for="ClienteTelefono"
                                           class="form-control" type="tel" inputmode="numeric"
                                           maxlength="8" pattern="[0-9]{8}" placeholder="88888888"
                                           oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,8)" />
                                </div>
                                <span asp-validation-for="ClienteTelefono" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductoId" class="form-label">Producto</label>
                                @if (!string.IsNullOrWhiteSpace(productoNombre))
                                {
                                    <div class="input-modern readonly-product">
                                        <i class="fa-solid fa-box"></i>
                                        <span class="product-name">@productoNombre</span>
                                        <input type="hidden" asp-for="ProductoId" />
                                    </div>
                                }
                                else
                                {
                                    <div class="input-modern">
                                        <i class="fa-solid fa-box"></i>
                                        <select asp-for="ProductoId" asp-items="ViewBag.ProductoId" class="form-select">
                                            <option value="">Seleccione un producto disponible</option>
                                        </select>
                                    </div>
                                }
                                <span asp-validation-for="ProductoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Cantidad" class="form-label">Cantidad en kg</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-weight-scale"></i>
                                    <input asp-for="Cantidad" asp-format="{0:0}" class="form-control"
                                           type="text" inputmode="numeric" pattern="[0-9]+"
                                           placeholder="Ej: 5"
                                           oninput="this.value=(this.value.match(/\d+/)||[''])[0]" />
                                </div>
                                <span asp-validation-for="Cantidad" class="text-danger"></span>
                            </div>
                        </div>

                        @if (!User.IsInRole("Cliente"))
                        {
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="FechaPedido" class="form-label">Fecha del pedido</label>
                                    <div class="input-modern">
                                        <i class="fa-regular fa-calendar-days"></i>
                                        <input asp-for="FechaPedido" type="datetime-local" class="form-control" />
                                    </div>
                                    <span asp-validation-for="FechaPedido" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Estado" class="form-label">Estado</label>
                                    <div class="input-modern">
                                        <i class="fa-solid fa-circle-info"></i>
                                        <select asp-for="Estado" class="form-select">
                                            <option value="Pendiente">Pendiente</option>
                                            <option value="En proceso">En proceso</option>
                                            <option value="En camino">En camino</option>
                                            <option value="Listo para retirar">Listo para retirar</option>
                                            <option value="Completado">Completado</option>
                                            <option value="Cancelado">Cancelado</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Estado" class="text-danger"></span>
                                </div>
                            </div>
                        }

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Observacion" class="form-label">Observaciones</label>
                                <div class="input-modern textarea-modern">
                                    <i class="fa-regular fa-comment-dots"></i>
                                    <textarea asp-for="Observacion"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Escriba alguna indicación o nota especial para el pedido"></textarea>
                                </div>
                                <span asp-validation-for="Observacion" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="VistaCreaR-actions">
                    <a asp-controller="Productos" asp-action="Index" class="btn-cancelar">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver a la lista
                    </a>
                    <button type="submit" class="btn-crear">
                        <i class="fa-solid fa-credit-card"></i>
                        Continuar al pago
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="_PaymentModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pago-modal.js" asp-append-version="true"></script>
    <script src="~/js/pedido-create-modal.js" asp-append-version="true"></script>
}