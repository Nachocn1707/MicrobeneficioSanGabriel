@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Cambiar estado del pedido";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditar-edit-page">

    <div class="EstiloEditaR-top">
        <div class="EstiloEditaR-title">
            <span class="EstiloEditaR-badge">
                <i class="fa-solid fa-pen-to-square"></i>
                Gestión de metodos de pago
            </span>
            <p>Información de los métodos de pago disponibles.</p>
        </div>
    </div>

    <div class="EstiloEditar-card">

        <div class="EstiloEditar-card-header">
            <h2>Pedido #@Model.Id</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloEditar-card-body">

            <form asp-action="CambiarEstado" method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label">Cliente</label>
                        <input value="@Model.ClienteNombre"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Producto</label>
                        <input value="@Model.ProductoNombreMostrar"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cantidad</label>
                        <input value="@Model.Cantidad kg"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Estado</label>

                        <select name="estado" class="form-select">
                            <option value="Pendiente" selected="@(Model.Estado == "Pendiente")">Pendiente</option>
                            <option value="En proceso" selected="@(Model.Estado == "En proceso")">En proceso</option>
                            <option value="En camino" selected="@(Model.Estado == "En camino")">En camino</option>
                            <option value="Listo para retirar" selected="@(Model.Estado == "Listo para retirar")">Listo para retirar</option>
                            <option value="Completado" selected="@(Model.Estado == "Completado")">Completado</option>
                            <option value="Cancelado" selected="@(Model.Estado == "Cancelado")">Cancelado</option>
                        </select>

                        <small class="text-muted d-block mt-2">
                            El estado de pago se sincroniza automáticamente según el estado del pedido.
                        </small>
                    </div>

                </div>

                <div class="EstiloEditar-actions">

                    <a asp-action="Index"
                           class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver a la lista
                    </a>

                    <button type="submit"
                            class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar estado
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>