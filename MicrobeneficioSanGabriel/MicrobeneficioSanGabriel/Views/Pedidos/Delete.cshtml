@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Eliminar pedido";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string estadoClase = Model.Estado switch
    {
        "Pendiente" => "text-warning",
        "En proceso" => "text-primary",
        "En camino" => "text-info",
        "Listo para retirar" => "text-success",
        "Completado" => "text-success",
        "Cancelado" => "text-danger",
        _ => "text-secondary"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEliminar.css" />
}

<div class="sg-card border-danger">
    <h1 class="text-danger">
        <i class="fa-solid fa-trash"></i>
        Eliminar pedido #@Model.Id
    </h1>

    <p>
        <strong>Cliente:</strong> @Model.ClienteNombre<br />
        <strong>Teléfono:</strong> @(string.IsNullOrWhiteSpace(Model.ClienteTelefono) ? "Sin teléfono" : Model.ClienteTelefono)<br />
        <strong>Producto:</strong> @(Model.Producto != null ? Model.Producto.Nombre : "Sin producto")<br />
        <strong>Cantidad:</strong> @Model.Cantidad kg<br />
        <strong>Fecha:</strong> @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")<br />
        <strong>Estado:</strong> <span class="@estadoClase">@Model.Estado</span>
    </p>

    <div class="alert alert-warning">
        <i class="fa-solid fa-circle-exclamation"></i>
        Esta acción eliminará el pedido del sistema de forma <strong>permanente</strong>.
        Esta operación no se puede deshacer y el pedido no aparecerá en el listado.
    </div>

    @if (Model.Estado == "Cancelado")
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-check-circle"></i>
            Este pedido ya se encuentra cancelado. Puedes eliminarlo sin restricciones.
        </div>
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
            <button class="btn btn-danger" type="submit">
                <i class="fa-solid fa-trash"></i> Confirmar eliminación
            </button>
        </div>
    </form>
</div>