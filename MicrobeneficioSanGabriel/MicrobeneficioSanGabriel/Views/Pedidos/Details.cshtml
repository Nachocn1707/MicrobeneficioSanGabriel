@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Detalles del pedido";

    if (User.IsInRole("Cliente"))
    {
        Layout = "~/Views/Shared/_ClienteLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }

    var historialEstados = ViewBag.HistorialEstados as List<MicrobeneficioSanGabriel.Models.PedidoEstadoHistorial>
        ?? new List<MicrobeneficioSanGabriel.Models.PedidoEstadoHistorial>();

    string estadoClase = Model.Estado switch
    {
        "Pendiente" => "movimiento-estado estado-pendiente",
        "En proceso" => "movimiento-estado estado-proceso",
        "En camino" => "movimiento-estado estado-camino",
        "Listo para retirar" => "movimiento-estado estado-retiro",
        "Completado" => "movimiento-estado estado-activo",
        "Cancelado" => "movimiento-estado estado-inactivo",
        _ => "movimiento-estado estado-neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<section class="Detalle-page-head">
    <div>
        <h1>Detalle del pedido</h1>
        <p>Consultá la información registrada para este pedido.</p>
    </div>
    <div class="Detalle-actions">
        <span class="movimiento-badge-top">
            Pedido #@Model.Id
        </span>
    </div>
</section>

<div class="EstiloDetalle-detalle-page">
    <div class="EstiloDetalle-premium-card">

        <div class="EstiloDetalle-premium-header">
            <h2>Información general</h2>
        </div>

        <div class="EstiloDetalle-premium-body">

            <div class="EstiloDetalle-detail-grid">

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-user"></i> CLIENTE
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.ClienteNombre
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-phone"></i> TELÉFONO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.ClienteTelefono)
                            ? "Sin teléfono"
                            : Model.ClienteTelefono)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-tag"></i> PRODUCTO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(Model.ProductoNombreMostrar)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-weight-hanging"></i> CANTIDAD
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Cantidad kg
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-calendar-days"></i> FECHA DEL PEDIDO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.FechaPedido.ToString("dd/MM/yyyy hh:mm tt")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-circle-check"></i> ESTADO
                    </span>
                    <div>
                        <span class="@estadoClase">
                            @Model.Estado
                        </span>
                    </div>
                </div>

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-align-left"></i> OBSERVACIÓN
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <section class="pedido-trace-section" aria-labelledby="pedido-trace-title">
                <div class="pedido-trace-head">
                    <div>
                        <span class="pedido-trace-kicker"><i class="fa-solid fa-route"></i> Trazabilidad del pedido</span>
                        <h3 id="pedido-trace-title">Historial completo de estados</h3>
                        <p>Cada cambio queda registrado con fecha y hora para conservar el recorrido real del pedido.</p>
                    </div>
                    <span class="pedido-trace-count">@historialEstados.Count evento(s)</span>
                </div>

                @if (historialEstados.Any())
                {
                    <ol class="pedido-trace-list">
                        @foreach (var evento in historialEstados)
                        {
                            var esActual = string.Equals(evento.EstadoNuevo, Model.Estado, StringComparison.OrdinalIgnoreCase)
                                && evento.Id == historialEstados.Last().Id;
                            <li class="pedido-trace-item @(esActual ? "is-current" : "")">
                                <span class="pedido-trace-dot"><i class="fa-solid fa-check"></i></span>
                                <div class="pedido-trace-copy">
                                    <div class="pedido-trace-row">
                                        <strong>@evento.EstadoNuevo</strong>
                                        @if (esActual)
                                        {
                                            <span class="pedido-trace-current">Estado actual</span>
                                        }
                                    </div>
                                    <time datetime="@evento.FechaCambio.ToString("O")">
                                        @evento.FechaCambio.ToString("dd/MM/yyyy · HH:mm")
                                    </time>
                                    @if (!string.IsNullOrWhiteSpace(evento.Observacion))
                                    {
                                        <small>@evento.Observacion</small>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <div class="pedido-trace-empty">
                        <i class="fa-regular fa-clock"></i>
                        <span>El historial comenzará a mostrarse con el próximo cambio de estado.</span>
                    </div>
                }
            </section>

            <div class="EstiloDetalle-actions">

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Index"
                       class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>

                    <a asp-action="CambiarEstadoPago"
                       asp-route-id="@Model.Id"
                       class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                        <i class="fa-solid fa-wallet"></i>
                        Cambiar pago
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-EstiloDetalle btn-EstiloDetalle-warning">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Editar
                    </a>
                }
                else if (User.IsInRole("Vendedor"))
                {
                    <a asp-action="Index"
                       class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>

                    <a asp-action="CambiarEstadoPago"
                       asp-route-id="@Model.Id"
                       class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                        <i class="fa-solid fa-wallet"></i>
                        Cambiar pago
                    </a>
                }
                else if (User.IsInRole("Cliente"))
                {
                    <a asp-action="Index"
                       class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>

                }
                else
                {
                    <a asp-action="Index"
                       class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                }

            </div>

        </div>
    </div>
</div>