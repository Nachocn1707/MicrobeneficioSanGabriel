@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Detalles del pedido";

    if (User.IsInRole("Cliente"))
    {
        Layout = "~/Views/Shared/_ClienteLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalles del pedido</h1>
        <p>Información registrada para este pedido.</p>
    </div>

    <div class="EstiloDetalle-card">

        <div class="EstiloDetalle-card-header">
            <h2>Pedido #@Model.Id</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">

            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">
                        Cliente
                    </span>

                    <span class="detalle-value">
                        @Model.ClienteNombre
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Teléfono
                    </span>

                    <span class="detalle-value">
                        @Model.ClienteTelefono
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Producto
                    </span>

                    <span class="detalle-value">
                        @(Model.Producto != null
                            ? Model.Producto.Nombre
                            : "Sin producto")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Cantidad
                    </span>

                    <span class="detalle-value">
                        @Model.Cantidad kg
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Fecha del pedido
                    </span>

                    <span class="detalle-value">
                        @Model.FechaPedido.ToString("dd/MM/yyyy hh:mm tt")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Estado
                    </span>

                    @if (Model.Estado == "Pendiente")
                    {
                        <span class="estado-pendiente">
                            Pendiente
                        </span>
                    }
                    else if (Model.Estado == "En proceso")
                    {
                        <span class="estado-proceso">
                            En proceso
                        </span>
                    }
                    else if (Model.Estado == "En camino")
                    {
                        <span class="estado-camino">
                            En camino
                        </span>
                    }
                    else if (Model.Estado == "Listo para retirar")
                    {
                        <span class="estado-retiro">
                            Listo para retirar
                        </span>
                    }
                    else if (Model.Estado == "Completado")
                    {
                        <span class="estado-activo">
                            Completado
                        </span>
                    }
                    else if (Model.Estado == "Cancelado")
                    {
                        <span class="estado-inactivo">
                            Cancelado
                        </span>
                    }
                    else
                    {
                        <span class="detalle-value">
                            @Model.Estado
                        </span>
                    }
                </div>
                <div class="detalle-item full">
                    <span class="detalle-label">
                        Observación
                    </span>

                    <span class="detalle-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>
                </div>
            </div>
            <div class="EstiloDetalle-actions">

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-editar">
                        Editar
                    </a>

                    <a asp-action="Index"
                       class="btn-volver">
                        Volver
                    </a>
                }
                else if (User.IsInRole("Cliente"))
                {
                    <a asp-action="Index"
                       class="btn-volver">
                        Volver
                    </a>

                    @if (Model.Estado == "Pendiente")
                    {
                        <a asp-action="Cancelar"
                           asp-route-id="@Model.Id"
                           class="btn-eliminar">
                            Cancelar
                        </a>
                    }
                }
                else
                {
                    <a asp-action="Index"
                       class="btn-volver">
                        Volver
                    </a>
                }
            </div>
        </div>
    </div>
</div>