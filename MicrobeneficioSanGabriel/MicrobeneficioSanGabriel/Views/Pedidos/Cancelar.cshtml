@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Cancelar pedido";
    Layout = "~/Views/Shared/_ClienteLayout.cshtml";
}

@section Styles {
    <style>
        .pedido-cancel-page {
            --sg-primary: #293F25;
            --sg-primary-2: #3A5333;
            --sg-secondary: #834003;
            --sg-muted: #666859;
            --sg-surface: #FEFCFA;
            --sg-surface-soft: #F7F3EA;
            --sg-surface-tint: #E7EEE3;
            --sg-line: #E4DED2;
            --sg-accent: #EDAE3E;
            --sg-accent-2: #D4730B;
            --sg-danger: #D16F5A;
            --sg-danger-hover: #B85B49;
            display: grid;
            gap: 24px;
            padding-top: 14px;
        }

        .pedido-cancel-header h1 {
            font-size: 2.4rem;
            font-weight: 950;
            margin: 0;
            color: var(--sg-primary);
        }

        .pedido-cancel-line {
            width: 78px;
            height: 4px;
            border-radius: 999px;
            background: linear-gradient(90deg, var(--sg-accent), var(--sg-accent-2));
            margin: 12px 0;
        }

        .pedido-cancel-header p {
            color: var(--sg-muted);
            font-weight: 650;
            margin: 0;
        }

        .pedido-cancel-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(41, 63, 37, 0.10);
            color: var(--sg-primary);
            border: 1px solid rgba(41, 63, 37, 0.12);
            border-radius: 999px;
            padding: 8px 14px;
            font-weight: 900;
            font-size: 13px;
            margin-bottom: 14px;
        }

        .pedido-cancel-card {
            background: var(--sg-surface);
            border: 1px solid var(--sg-line);
            border-radius: 28px;
            box-shadow: 0 22px 55px rgba(41, 55, 31, 0.10);
            overflow: hidden;
            display: grid;
            grid-template-columns: 0.38fr 0.62fr;
            min-height: 520px;
        }

        .pedido-cancel-side {
            background:
                linear-gradient(180deg, rgba(41, 63, 37, 0.96), rgba(41, 63, 37, 0.88)),
                url("/images/orders/order-detail-coffee.jpg");
            background-size: cover;
            background-position: center;
            padding: 36px;
            color: #FEFCFA;
            display: flex;
            align-items: center;
        }

        .pedido-cancel-side-content {
            max-width: 360px;
        }

        .pedido-cancel-icon {
            width: 72px;
            height: 72px;
            border-radius: 22px;
            background: linear-gradient(135deg, var(--sg-accent), var(--sg-accent-2));
            color: #FEFCFA;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin-bottom: 26px;
            box-shadow: 0 14px 28px rgba(212, 115, 11, 0.25);
        }

        .pedido-cancel-side h2 {
            color: #FEFCFA;
            font-size: 2rem;
            font-weight: 950;
            margin: 0;
        }

        .pedido-cancel-side-line {
            width: 70px;
            height: 4px;
            border-radius: 999px;
            background: linear-gradient(90deg, var(--sg-accent), var(--sg-accent-2));
            margin: 14px 0 18px;
        }

        .pedido-cancel-side p {
            color: rgba(254, 252, 250, 0.92);
            font-weight: 650;
            line-height: 1.55;
            margin-bottom: 28px;
        }

        .pedido-cancel-info {
            display: grid;
            gap: 16px;
        }

        .pedido-cancel-info-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(254, 252, 250, 0.96);
            font-weight: 800;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 12px 14px;
            backdrop-filter: blur(3px);
        }

            .pedido-cancel-info-item i {
                color: var(--sg-accent);
                width: 18px;
            }

        .pedido-cancel-body {
            padding: 38px;
        }

        .pedido-cancel-warning {
            background: var(--sg-surface-tint);
            color: var(--sg-primary);
            border: 1px solid rgba(83, 131, 59, 0.18);
            border-radius: 18px;
            padding: 15px 18px;
            font-weight: 750;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pedido-cancel-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .pedido-cancel-item {
            background: var(--sg-surface-soft);
            border: 1px solid var(--sg-line);
            border-radius: 18px;
            padding: 17px;
            min-height: 90px;
            box-shadow: 0 6px 18px rgba(41, 55, 31, 0.04);
        }

            .pedido-cancel-item.full {
                grid-column: 1 / -1;
            }

        .pedido-cancel-label {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--sg-secondary);
            font-size: 0.78rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            margin-bottom: 8px;
        }

        .pedido-cancel-value {
            display: block;
            color: var(--sg-primary);
            font-size: 1rem;
            font-weight: 800;
            line-height: 1.45;
            word-break: break-word;
        }

        .estado-cancel-pendiente {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 7px 13px;
            font-size: 0.82rem;
            font-weight: 950;
            background: var(--sg-surface-tint);
            color: var(--sg-primary);
            border: 1px solid rgba(83, 131, 59, 0.18);
        }

        .pedido-cancel-actions {
            border-top: 1px solid var(--sg-line);
            margin-top: 26px;
            padding-top: 22px;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-pedido-cancel {
            border: none;
            border-radius: 14px;
            padding: 12px 20px;
            font-weight: 950;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: 0.18s ease;
        }

            .btn-pedido-cancel:hover {
                transform: translateY(-1px);
            }

        .btn-cancel-volver {
            background: #FFFFFF;
            color: var(--sg-primary);
            border: 1px solid var(--sg-line);
            box-shadow: 0 10px 20px rgba(41, 55, 31, 0.06);
        }

            .btn-cancel-volver:hover {
                background: #F5F6F2;
                color: var(--sg-primary);
                border-color: rgba(41, 63, 37, 0.20);
            }

        .btn-cancel-confirmar {
            background: var(--sg-danger);
            color: #FFFFFF;
            box-shadow: 0 12px 26px rgba(209, 111, 90, 0.24);
        }

            .btn-cancel-confirmar:hover {
                background: var(--sg-danger-hover);
                color: #FFFFFF;
            }

        @@media (max-width: 1100px) {
            .pedido-cancel-card {
                grid-template-columns: 1fr;
            }

            .pedido-cancel-side {
                min-height: 300px;
            }
        }

        @@media (max-width: 768px) {
            .pedido-cancel-body {
                padding: 24px;
            }

            .pedido-cancel-side {
                padding: 28px;
            }

            .pedido-cancel-grid {
                grid-template-columns: 1fr;
            }

            .pedido-cancel-header h1 {
                font-size: 2rem;
            }
        }
    </style>
}

<div class="pedido-cancel-page">

    <div class="pedido-cancel-header">
        <span class="pedido-cancel-badge">
            <i class="fa-solid fa-triangle-exclamation"></i>
            Confirmación requerida
        </span>

        <h1>Cancelar pedido</h1>
        <div class="pedido-cancel-line"></div>

        <p>
            El registro no será eliminado, solo cambiará a estado Cancelado.
        </p>
    </div>

    <div class="pedido-cancel-card">

        <div class="pedido-cancel-side">
            <div class="pedido-cancel-side-content">

                <div class="pedido-cancel-icon">
                    <i class="fa-solid fa-ban"></i>
                </div>

                <h2>Pedido #@Model.Id</h2>
                <div class="pedido-cancel-side-line"></div>

                <p>
                    Revisá la información antes de confirmar la cancelación.
                    Esta acción cambiará el estado del pedido.
                </p>

                <div class="pedido-cancel-info">
                    <div class="pedido-cancel-info-item">
                        <i class="fa-solid fa-mug-hot"></i>
                        Producto solicitado
                    </div>

                    <div class="pedido-cancel-info-item">
                        <i class="fa-solid fa-weight-scale"></i>
                        Cantidad registrada
                    </div>

                    <div class="pedido-cancel-info-item">
                        <i class="fa-solid fa-circle-xmark"></i>
                        Cambio a Cancelado
                    </div>
                </div>

            </div>
        </div>

        <div class="pedido-cancel-body">

            <div class="pedido-cancel-warning">
                <i class="fa-solid fa-circle-info"></i>
                <span>
                    Confirme si desea cancelar este pedido. Esta acción no elimina el registro.
                </span>
            </div>

            <div class="pedido-cancel-grid">

                <div class="pedido-cancel-item">
                    <span class="pedido-cancel-label">
                        <i class="fa-solid fa-mug-hot"></i>
                        Producto
                    </span>

                    <span class="pedido-cancel-value">
                        @(Model.ProductoNombreMostrar)
                    </span>
                </div>

                <div class="pedido-cancel-item">
                    <span class="pedido-cancel-label">
                        <i class="fa-solid fa-weight-hanging"></i>
                        Cantidad
                    </span>

                    <span class="pedido-cancel-value">
                        @Model.Cantidad kg
                    </span>
                </div>

                <div class="pedido-cancel-item">
                    <span class="pedido-cancel-label">
                        <i class="fa-solid fa-calendar-days"></i>
                        Fecha
                    </span>

                    <span class="pedido-cancel-value">
                        @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="pedido-cancel-item">
                    <span class="pedido-cancel-label">
                        <i class="fa-solid fa-phone"></i>
                        Teléfono
                    </span>

                    <span class="pedido-cancel-value">
                        @(string.IsNullOrWhiteSpace(Model.ClienteTelefono)
                            ? "Sin teléfono"
                            : Model.ClienteTelefono)
                    </span>
                </div>

                <div class="pedido-cancel-item">
                    <span class="pedido-cancel-label">
                        <i class="fa-solid fa-circle-info"></i>
                        Estado actual
                    </span>

                    <span class="estado-cancel-pendiente">
                        @Model.Estado
                    </span>
                </div>

                <div class="pedido-cancel-item full">
                    <span class="pedido-cancel-label">
                        <i class="fa-solid fa-comment-dots"></i>
                        Observación
                    </span>

                    <span class="pedido-cancel-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <form asp-action="Cancelar" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="pedido-cancel-actions">

                    <a asp-action="Index"
                           class="btn-pedido-cancel btn-cancel-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>

                    <button type="submit"
                            class="btn-pedido-cancel btn-cancel-confirmar">
                        <i class="fa-solid fa-ban"></i>
                        Confirmar cancelación
                    </button>

                </div>
            </form>

        </div>

    </div>

</div>