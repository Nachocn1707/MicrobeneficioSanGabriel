@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Editar pedido";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditar-edit-page">

    <div class="EstiloEditar-header">
        <h1>Editar EstiloEditar</h1>
        <p>Actualizá la información del EstiloEditar seleccionado.</p>
    </div>

    <div class="EstiloEditar-card">
        <div class="EstiloEditar-card-header">
            <h2>Pedido #@Model.Id</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloEditar-card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="ClienteNombre" class="form-label">Cliente</label>
                        <input asp-for="ClienteNombre" class="form-control" />
                        <span asp-validation-for="ClienteNombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ClienteTelefono" class="form-label fw-semibold">
                            Teléfono
                        </label>

                        <input asp-for="ClienteTelefono"
                               class="form-control" />

                        <span asp-validation-for="ClienteTelefono" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ProductoId" class="form-label">Producto</label>
                        <select asp-for="ProductoId" class="form-select" asp-items="ViewBag.ProductoId"></select>
                        <span asp-validation-for="ProductoId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Cantidad" class="form-label">Cantidad en kg</label>
                        <input asp-for="Cantidad" class="form-control" />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FechaPedido" class="form-label">Fecha del EstiloEditar</label>
                        <input asp-for="FechaPedido" type="date" class="form-control" />
                        <span asp-validation-for="FechaPedido" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Estado" class="form-label">Estado</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Pendiente">Pendiente</option>
                            <option value="En proceso">En proceso</option>
                            <option value="En camino">En camino</option>
                            <option value="Listo para retirar">Listo para retirar</option>
                            <option value="Completado">Completado</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Observacion" class="form-label">Observación</label>
                        <textarea asp-for="Observacion" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Observacion" class="text-danger"></span>
                    </div>
                </div>

                <div class="EstiloEditar-actions">
                    <a asp-action="Index" class="btn-volver">Volver a la lista</a>
                    <button type="submit" class="btn-guardar">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}