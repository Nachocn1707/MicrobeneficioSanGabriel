@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Editar pedido";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var fechaPedidoOriginal = ViewBag.FechaPedidoOriginal != null
        ? Convert.ToDateTime(ViewBag.FechaPedidoOriginal)
        : Model.FechaPedido;
    var fechaMinimaPedido = fechaPedidoOriginal.Date >= DateTime.Today
        ? DateTime.Today.ToString("yyyy-MM-ddTHH:mm")
        : string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditaR-page">

    <div class="EstiloEditaR-top">
        <div class="EstiloEditaR-title">
            <span class="EstiloEditaR-badge">
                <i class="fa-solid fa-pen-to-square"></i>
                Gestión de pedidos
            </span>
            <h1>Editar pedido</h1>
            <p>Actualizá los datos y estados de los pedidos registrados.</p>
        </div>
    </div>

    <div class="EstiloEditaR-card">
        <div class="EstiloEditaR-form-container">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RowVersion" />

                <div class="Estilo-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Al cambiar el estado a <strong>Completado</strong>, el sistema descuenta el stock automáticamente.
                    </span>
                </div>

                <div class="EstiloEditaR-section">
                    <h5>
                        <i class="fa-solid fa-clipboard-check"></i>
                        Detalle del pedido
                    </h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ClienteNombre" class="form-label">
                                    <i class="fa-solid fa-user label-icon"></i>
                                    Cliente
                                </label>
                                <input asp-for="ClienteNombre" class="form-control" />
                                <span asp-validation-for="ClienteNombre" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ClienteTelefono" class="form-label">
                                    <i class="fa-solid fa-phone label-icon"></i>
                                    Teléfono
                                </label>
                                <input asp-for="ClienteTelefono" class="form-control" type="tel" inputmode="numeric"
                                       maxlength="8" pattern="[0-9]{8}" placeholder="88888888"
                                       oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,8)" />
                                <span asp-validation-for="ClienteTelefono" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductoId" class="form-label">
                                    <i class="fa-solid fa-mug-hot label-icon"></i>
                                    Producto
                                </label>
                                <select asp-for="ProductoId" class="form-select" asp-items="ViewBag.ProductoId">
                                </select>
                                <span asp-validation-for="ProductoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Cantidad" class="form-label">
                                    <i class="fa-solid fa-weight-scale label-icon"></i>
                                    Cantidad en kg
                                </label>
                                <input asp-for="Cantidad" asp-format="{0:0}" class="form-control"
                                       type="text" inputmode="numeric" pattern="[0-9]+"
                                       oninput="this.value=(this.value.match(/\d+/)||[''])[0]" />
                                <span asp-validation-for="Cantidad" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="FechaPedido" class="form-label">
                                    <i class="fa-solid fa-calendar label-icon"></i>
                                    Fecha del pedido
                                </label>
                                <input asp-for="FechaPedido" type="datetime-local" class="form-control"
                                       min="@fechaMinimaPedido"
                                       data-no-past-date="true"
                                       data-today="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       data-original-date="@fechaPedidoOriginal.ToString("yyyy-MM-dd")"
                                       data-date-message="No puede seleccionar una fecha anterior a hoy." />
                                <span asp-validation-for="FechaPedido" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Estado" class="form-label">
                                    <i class="fa-solid fa-circle-info label-icon"></i>
                                    Estado
                                </label>
                                <select asp-for="Estado" class="form-select">
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="En proceso">En proceso</option>
                                    <option value="En camino">En camino</option>
                                    <option value="Listo para retirar">Listo para retirar</option>
                                    <option value="Completado">Completado</option>
                                    <option value="Cancelado">Cancelado</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Observacion" class="form-label">
                                    <i class="fa-solid fa-comment label-icon"></i>
                                    Observación
                                </label>
                                <textarea asp-for="Observacion" class="form-control" rows="4" placeholder="Digite alguna observación del pedido"></textarea>
                                <span asp-validation-for="Observacion" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="EstiloEditaR-actions">
                    <a asp-action="Index" class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                    <button type="submit" class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}