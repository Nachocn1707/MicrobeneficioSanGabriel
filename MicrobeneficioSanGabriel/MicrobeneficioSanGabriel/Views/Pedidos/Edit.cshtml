@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Editar pedido";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditar-page">
    <div class="EstiloEditar-header">
        <h1>Editar Pedidos</h1>
        <p>Actualizá los datos de los pedidos registrados.</p>
    </div>

    <div class="EstiloEditaR-card">
        <div class="EstiloEditaR-form-container">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <div class="Estilo-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Al cambiar el estado a <strong>Completado</strong>, el sistema descuenta el stock automáticamente.
                    </span>
                </div>

                <div class="EstiloEditar-section">
                    <h5>
                        <i class="fa-solid fa-clipboard-check"></i>
                        Detalle del pedido
                    </h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ClienteNombre" class="form-label">Cliente</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-user"></i>
                                    <input asp-for="ClienteNombre" class="form-control" />
                                </div>
                                <span asp-validation-for="ClienteNombre" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ClienteTelefono" class="form-label">Teléfono</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-phone"></i>
                                    <input asp-for="ClienteTelefono" class="form-control" />
                                </div>
                                <span asp-validation-for="ClienteTelefono" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductoId" class="form-label">Producto</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-mug-hot"></i>
                                    <select asp-for="ProductoId" class="form-select" asp-items="ViewBag.ProductoId">
                                    </select>
                                </div>
                                <span asp-validation-for="ProductoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Cantidad" class="form-label">Cantidad en kg</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-weight-scale"></i>
                                    <input asp-for="Cantidad" class="form-control" min="1" />
                                </div>
                                <span asp-validation-for="Cantidad" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="FechaPedido" class="form-label">Fecha del pedido</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-calendar"></i>
                                    <input asp-for="FechaPedido" type="datetime-local" class="form-control" />
                                </div>
                                <span asp-validation-for="FechaPedido" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Estado" class="form-label">Estado</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-circle-info"></i>
                                    <select asp-for="Estado" class="form-select">
                                        <option value="Pendiente">Pendiente</option>
                                        <option value="En proceso">En proceso</option>
                                        <option value="En camino">En camino</option>
                                        <option value="Listo para retirar">Listo para retirar</option>
                                        <option value="Completado">Completado</option>
                                        <option value="Cancelado">Cancelado</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Observacion" class="form-label">Observación</label>
                                <div class="input-modern textarea-modern">
                                    <i class="fa-solid fa-comment"></i>
                                    <textarea asp-for="Observacion" class="form-control" rows="5" placeholder="Digite alguna observación del pedido"></textarea>
                                </div>
                                <span asp-validation-for="Observacion" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="EstiloEditar-actions">
                    <a asp-action="Index" class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                    <button type="submit" class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}