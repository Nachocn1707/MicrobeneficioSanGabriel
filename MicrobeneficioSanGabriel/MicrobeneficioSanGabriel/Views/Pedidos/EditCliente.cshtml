@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Actualizar pedido";
    Layout = "~/Views/Shared/_ClienteLayout.cshtml";
}

<div class="client-edit-page">
    <section class="client-edit-hero">
        <div>
            <span class="client-edit-kicker">
                <i class="fa-solid fa-pen-to-square"></i>
                Pedido pendiente
            </span>

            <h1>Actualizá tu pedido</h1>

            <p>
                Cambiá los datos necesarios antes de que el microbeneficio
                comience a procesar tu compra.
            </p>
        </div>

        <div class="client-edit-hero-number">
            <small>Número de pedido</small>
            <strong>PP-@Model.Id.ToString("0000")</strong>
        </div>
    </section>

    <form asp-action="EditCliente"
          method="post"
          class="client-edit-form">

        <div asp-validation-summary="ModelOnly"
             class="client-edit-validation">
        </div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ClienteNombre" />
        <input type="hidden" asp-for="Estado" />
        <input type="hidden" asp-for="FechaPedido" />

        <div class="client-edit-layout">
            <main class="client-edit-fields-card">
                <header class="client-edit-section-head">
                    <span class="client-edit-section-icon">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </span>

                    <div>
                        <small>Información editable</small>
                        <h2>Detalles de tu compra</h2>
                        <p>Revisá cuidadosamente los datos antes de guardar.</p>
                    </div>
                </header>

                <div class="client-edit-notice">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        El estado permanece como <strong>Pendiente</strong> y no puede
                        modificarse desde el portal cliente.
                    </span>
                </div>

                <section class="client-edit-form-section">
                    <div class="client-edit-form-title">
                        <span>01</span>
                        <div>
                            <h3>Datos de contacto</h3>
                            <p>El microbeneficio utilizará este número para comunicarse con vos.</p>
                        </div>
                    </div>

                    <div class="client-edit-field-grid single">
                        <div class="client-edit-field">
                            <label asp-for="ClienteTelefono">
                                Teléfono de contacto
                            </label>

                            <div class="client-edit-control">
                                <i class="fa-solid fa-phone"></i>
                                <input asp-for="ClienteTelefono"
                                       class="form-control" type="tel" inputmode="numeric"
                                       maxlength="8" pattern="[0-9]{8}" placeholder="88888888"
                                       oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,8)" />
                            </div>

                            <span asp-validation-for="ClienteTelefono"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>
                </section>

                <section class="client-edit-form-section">
                    <div class="client-edit-form-title">
                        <span>02</span>
                        <div>
                            <h3>Tu selección</h3>
                            <p>Elegí el producto y la cantidad que necesitás.</p>
                        </div>
                    </div>

                    <div class="client-edit-field-grid">
                        <div class="client-edit-field">
                            <label asp-for="ProductoId">
                                Producto
                            </label>

                            <div class="client-edit-control">
                                <i class="fa-solid fa-mug-hot"></i>
                                <select asp-for="ProductoId"
                                        class="form-select"
                                        asp-items="ViewBag.ProductoId">
                                </select>
                            </div>

                            <span asp-validation-for="ProductoId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="client-edit-field">
                            <label asp-for="Cantidad">
                                Cantidad en kilogramos
                            </label>

                            <div class="client-edit-control">
                                <i class="fa-solid fa-weight-scale"></i>
                                <input asp-for="Cantidad" asp-format="{0:0}"
                                       class="form-control"
                                       type="text" inputmode="numeric" pattern="[0-9]+"
                                       oninput="this.value=(this.value.match(/\d+/)||[''])[0]" />
                                <span class="client-edit-unit">kg</span>
                            </div>

                            <span asp-validation-for="Cantidad"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>
                </section>

                <section class="client-edit-form-section last">
                    <div class="client-edit-form-title">
                        <span>03</span>
                        <div>
                            <h3>Información adicional</h3>
                            <p>Agregá cualquier detalle importante para preparar tu pedido.</p>
                        </div>
                    </div>

                    <div class="client-edit-field">
                        <label asp-for="Observacion">
                            Observación
                        </label>

                        <div class="client-edit-control textarea">
                            <i class="fa-solid fa-comment"></i>
                            <textarea asp-for="Observacion"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Escribí alguna observación para tu pedido"></textarea>
                        </div>

                        <span asp-validation-for="Observacion"
                              class="text-danger">
                        </span>
                    </div>
                </section>
            </main>

            <aside class="client-edit-summary-card">
                <div class="client-edit-summary-image">
                    <span><i class="fa-solid fa-mug-hot"></i></span>
                </div>

                <div class="client-edit-summary-content">
                    <span class="client-edit-summary-label">Resumen del pedido</span>
                    <h2>PP-@Model.Id.ToString("0000")</h2>

                    <dl class="client-edit-summary-list">
                        <div>
                            <dt>Estado</dt>
                            <dd><span class="pending">@Model.Estado</span></dd>
                        </div>

                        <div>
                            <dt>Fecha de solicitud</dt>
                            <dd>@Model.FechaPedido.ToString("dd/MM/yyyy")</dd>
                        </div>

                        <div>
                            <dt>Producto actual</dt>
                            <dd>@(Model.ProductoNombreMostrar)</dd>
                        </div>

                        <div>
                            <dt>Cantidad actual</dt>
                            <dd>@Model.Cantidad.ToString("0") kg</dd>
                        </div>
                    </dl>

                    <div class="client-edit-tip">
                        <i class="fa-solid fa-lightbulb"></i>
                        <p>
                            Podés editar este pedido mientras continúe en estado Pendiente.
                        </p>
                    </div>
                </div>
            </aside>
        </div>

        <div class="client-edit-actions">
            <a asp-action="Index" class="client-edit-back">
                <i class="fa-solid fa-arrow-left"></i>
                Volver a mis pedidos
            </a>

            <button type="submit" class="client-edit-save">
                <i class="fa-solid fa-floppy-disk"></i>
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
