@model MicrobeneficioSanGabriel.Models.Pedido

@{
    ViewData["Title"] = "Actualizar pedido";
    Layout = "~/Views/Shared/_ClienteLayout.cshtml";
}

<div class="container mt-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h1 class="fw-bold">Actualizar pedido</h1>
            <p class="text-muted">Solo puede modificar pedidos que estén en estado Pendiente.</p>

            <form asp-action="EditCliente">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ClienteNombre" />
                <input type="hidden" asp-for="Estado" />
                <input type="hidden" asp-for="FechaPedido" />

                <div class="mb-3">
                    <label asp-for="ClienteTelefono" class="form-label">
                        Teléfono
                    </label>

                    <input asp-for="ClienteTelefono"
                           class="form-control"
                           placeholder="Digite el número de teléfono" />

                    <span asp-validation-for="ClienteTelefono" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProductoId" class="form-label fw-semibold">Producto</label>
                        <select asp-for="ProductoId" class="form-select" asp-items="ViewBag.ProductoId"></select>
                        <span asp-validation-for="ProductoId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Cantidad" class="form-label fw-semibold">Cantidad</label>
                        <input asp-for="Cantidad" class="form-control" />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Observacion" class="form-label fw-semibold">Observación</label>
                        <textarea asp-for="Observacion" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Observacion" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Guardar cambios
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

