@model MicrobeneficioSanGabriel.ViewModels.UsuarioListadoViewModel

@{
    ViewData["Title"] = "Detalle de usuario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string rolClase = Model.Rol switch
    {
        "Administrador" => "movimiento-estado usuario-rol-admin",
        "Cliente" => "movimiento-estado usuario-rol-cliente",
        "Vendedor" => "movimiento-estado usuario-rol-vendedor",
        "Operador" => "movimiento-estado usuario-rol-operador",
        _ => "movimiento-estado usuario-rol-otro"
    };
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<section class="sg-page-head">
    <div>
        <h1>Detalle de usuario</h1>
        <p>Consultá la información registrada para este usuario.</p>
    </div>
    <div class="sg-actions">
    </div>
</section>

<section class="sg-visual-hero sg-hero-usuarios">
    <div class="sg-visual-hero-content">
        <h1>@Model.NombreCompleto</h1>
        <div class="sg-visual-line"></div>
        <span class="sg-visual-badge"><i class="fa-solid fa-user"></i> Usuario del sistema</span>
    </div>
</section>

<div class="EstiloDetalle-detalle-page">
    <div class="EstiloDetalle-premium-card">

        <div class="EstiloDetalle-premium-header">
            <h2>Información general</h2>
            <span class="movimiento-badge-top">Usuario #@Model.Id</span>
        </div>

        <div class="EstiloDetalle-premium-body">

            <div class="EstiloDetalle-detail-grid">

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">NOMBRE</span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Nombre)
                            ? "Sin nombre"
                            : Model.Nombre)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">APELLIDOS</span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Apellidos)
                            ? "Sin apellidos"
                            : Model.Apellidos)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">CORREO ELECTRÓNICO</span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Email
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">USUARIO</span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.UserName)
                            ? "Sin usuario"
                            : Model.UserName)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">TELÉFONO</span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                            ? "Sin teléfono"
                            : Model.PhoneNumber)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">ROL</span>
                    <div>
                        <span class="@rolClase">
                            @Model.Rol
                        </span>
                    </div>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver a la lista
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn-EstiloDetalle btn-EstiloDetalle-warning">
                    <i class="fa-solid fa-pen-to-square"></i>
                    Editar
                </a>

            </div>

        </div>
    </div>
</div>