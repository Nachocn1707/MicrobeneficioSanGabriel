@model MicrobeneficioSanGabriel.ViewModels.UsuarioListadoViewModel

@{
    ViewData["Title"] = "Detalle de usuario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="admin-title">Detalle de usuario</h1>
<p class="admin-subtitle">Información detallada del usuario registrado en el sistema.</p>

<div class="admin-card">
    <div class="row">
        <div class="col-md-6 mb-3">
            <strong>Correo:</strong>
            <p>@Model.Email</p>
        </div>

        <div class="col-md-6 mb-3">
            <strong>Usuario:</strong>
            <p>@Model.UserName</p>
        </div>

        <div class="col-md-6 mb-3">
            <strong>Teléfono:</strong>
            <p>@(Model.PhoneNumber ?? "Sin teléfono")</p>
        </div>

        <div class="col-md-6 mb-3">
            <strong>Rol:</strong>
            <p>
                <span class="badge bg-primary">@Model.Rol</span>
            </p>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>