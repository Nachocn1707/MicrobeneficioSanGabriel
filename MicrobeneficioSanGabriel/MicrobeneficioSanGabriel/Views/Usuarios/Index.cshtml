@model IEnumerable<MicrobeneficioSanGabriel.ViewModels.UsuarioListadoViewModel>

@{
    ViewData["Title"] = "Usuarios";

    <div class="sg-visual-hero">
    <div class="sg-visual-hero-content">
        <span class="sg-visual-badge">
            <i class="fa-solid fa-users"></i>
            Administración de acceso
        </span>

        <h1>Usuarios del sistema</h1>
        <div class="sg-visual-line"></div>

        <p>
            Gestioná cuentas, roles y accesos de los usuarios del sistema.
        </p>
    </div>
</div>

    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int totalUsuarios = Model.Count();
    int totalAdministradores = Model.Count(u => u.Rol == "Administrador");
    int totalClientes = Model.Count(u => u.Rol == "Cliente");
    int totalOtros = Model.Count(u => u.Rol != "Administrador" && u.Rol != "Cliente");
}

@section Styles {
    <style>
        .usuarios-page {
            display: grid;
            gap: 24px;
            padding-top: 10px;
        }

        .usuarios-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

            .usuarios-header h1 {
                font-size: 2.35rem;
                font-weight: 950;
                margin: 0;
                color: #2b160d;
            }

        .usuarios-title-line {
            width: 76px;
            height: 4px;
            background: #d8b36a;
            border-radius: 999px;
            margin: 12px 0;
        }

        .usuarios-header p {
            color: #6f5b4a;
            font-weight: 650;
            margin: 0;
        }

        .btn-nuevo-usuario {
            background: #198754;
            color: #fff;
            border-radius: 13px;
            padding: 11px 18px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 12px 28px rgba(25, 135, 84, 0.18);
            transition: 0.18s ease;
        }

            .btn-nuevo-usuario:hover {
                background: #157347;
                color: #fff;
                transform: translateY(-1px);
            }

        .usuarios-alert {
            border: none;
            border-radius: 18px;
            padding: 15px 18px;
            font-weight: 750;
            box-shadow: 0 12px 28px rgba(58, 33, 20, 0.08);
        }

        .usuarios-summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .usuario-summary-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 22px;
            padding: 20px;
            box-shadow: 0 16px 36px rgba(58, 33, 20, 0.08);
            position: relative;
            overflow: hidden;
        }

            .usuario-summary-card::after {
                content: "";
                position: absolute;
                right: -32px;
                bottom: -36px;
                width: 110px;
                height: 110px;
                background: rgba(243, 210, 122, 0.22);
                border-radius: 50%;
            }

        .usuario-summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #fff2d5;
            color: #a66b20;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            font-size: 18px;
        }

        .usuario-summary-label {
            color: #7a6a5d;
            font-weight: 850;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .usuario-summary-value {
            color: #2b160d;
            font-size: 1.75rem;
            font-weight: 950;
            line-height: 1.15;
        }

        .usuarios-table-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 24px;
            box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
            padding: 18px;
            overflow: hidden;
        }

        .usuarios-table-title {
            margin-bottom: 15px;
        }

            .usuarios-table-title h3 {
                margin: 0;
                font-size: 1.25rem;
                font-weight: 950;
                color: #2b160d;
            }

            .usuarios-table-title p {
                margin: 3px 0 0;
                color: #6f5b4a;
                font-weight: 650;
            }

        .usuarios-table-card table {
            margin-bottom: 0;
        }

            .usuarios-table-card table thead th {
                background: #1f2937 !important;
                color: #fff !important;
                border: none !important;
                padding: 15px 14px !important;
                font-weight: 900;
                vertical-align: middle;
            }

                .usuarios-table-card table thead th:first-child {
                    border-top-left-radius: 13px;
                }

                .usuarios-table-card table thead th:last-child {
                    border-top-right-radius: 13px;
                }

            .usuarios-table-card table tbody td {
                padding: 16px 14px !important;
                vertical-align: middle;
                border-bottom: 1px solid #ece2cf;
            }

            .usuarios-table-card table tbody tr:hover {
                background: rgba(243, 210, 122, 0.12);
            }

        .usuario-email {
            font-weight: 950;
            color: #2b160d;
        }

        .usuario-texto {
            color: #5f5147;
            font-weight: 700;
        }

        .usuario-rol {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: 0.8rem;
            font-weight: 950;
            white-space: nowrap;
        }

        .usuario-rol-admin {
            background: #e9e0ff;
            color: #5636a3;
        }

        .usuario-rol-cliente {
            background: #dff5e3;
            color: #1e7d32;
        }

        .usuario-rol-otro {
            background: #dff6fd;
            color: #0369a1;
        }

        .usuario-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            justify-content: flex-end;
            flex-wrap: wrap;
        }

            .usuario-actions .btn {
                border-radius: 10px;
                font-weight: 850;
                padding: 8px 11px;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 15px;
            color: #2b160d;
            font-weight: 700;
        }

            .dataTables_wrapper .dataTables_filter input,
            .dataTables_wrapper .dataTables_length select {
                border: 1px solid #d9c8ab;
                border-radius: 10px;
                padding: 7px 10px;
                background: white;
            }

        .dataTables_wrapper .dataTables_info {
            color: #6f5b4a;
            font-weight: 650;
            margin-top: 14px;
        }

        .dataTables_wrapper .dataTables_paginate {
            margin-top: 14px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border-radius: 10px !important;
            }

        @@media (max-width: 1200px) {
            .usuarios-summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .usuarios-header {
                flex-direction: column;
            }

            .usuarios-summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="usuarios-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show usuarios-alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show usuarios-alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="usuarios-header">
        <div>
            <h1></h1>
            <div class="usuarios-title-line"></div>
            <p>
            </p>
        </div>

        <a asp-action="Create" class="btn-nuevo-usuario">
            <i class="fa-solid fa-user-plus"></i>
            Registrar usuario
        </a>
    </div>

    <section class="usuarios-summary-grid">

        <div class="usuario-summary-card">
            <div class="usuario-summary-icon">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="usuario-summary-label">Usuarios registrados</div>
            <div class="usuario-summary-value">@totalUsuarios</div>
        </div>

        <div class="usuario-summary-card">
            <div class="usuario-summary-icon">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <div class="usuario-summary-label">Administradores</div>
            <div class="usuario-summary-value">@totalAdministradores</div>
        </div>

        <div class="usuario-summary-card">
            <div class="usuario-summary-icon">
                <i class="fa-solid fa-user"></i>
            </div>
            <div class="usuario-summary-label">Clientes</div>
            <div class="usuario-summary-value">@totalClientes</div>
        </div>

        <div class="usuario-summary-card">
            <div class="usuario-summary-icon">
                <i class="fa-solid fa-id-badge"></i>
            </div>
            <div class="usuario-summary-label">Otros roles</div>
            <div class="usuario-summary-value">@totalOtros</div>
        </div>

    </section>

    <div class="usuarios-table-card">

        <div class="usuarios-table-title">
            <h3>Listado de usuarios</h3>
            <p>Consulta, edición y administración de cuentas del sistema.</p>
        </div>

        <div class="table-responsive">

            <table id="tablaUsuarios" class="table align-middle">

                <thead>
                    <tr>
                        <th>Correo</th>
                        <th>Usuario</th>
                        <th>Teléfono</th>
                        <th>Rol</th>
                        <th class="text-end" width="280">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        string rolClase = item.Rol switch
                        {
                            "Administrador" => "usuario-rol usuario-rol-admin",
                            "Cliente" => "usuario-rol usuario-rol-cliente",
                            _ => "usuario-rol usuario-rol-otro"
                        };

                        <tr>
                            <td class="usuario-email">
                                @item.Email
                            </td>

                            <td class="usuario-texto">
                                @item.UserName
                            </td>

                            <td class="usuario-texto">
                                @(string.IsNullOrWhiteSpace(item.PhoneNumber)
                                    ? "Sin teléfono"
                                    : item.PhoneNumber)
                            </td>

                            <td>
                                <span class="@rolClase">
                                    @item.Rol
                                </span>
                            </td>

                            <td>
                                <div class="usuario-actions">

                                    <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        Editar
                                    </a>

                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">
                                        <i class="fa-solid fa-eye"></i>
                                        Detalles
                                    </a>

                                    <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm">
                                        <i class="fa-solid fa-trash"></i>
                                        Eliminar
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaUsuarios').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20],
                responsive: true
            });
        });
    </script>
}