@model MicrobeneficioSanGabriel.ViewModels.UsuarioListadoViewModel

@{
    ViewData["Title"] = "Eliminar usuario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string rolClase = Model.Rol switch
    {
        "Administrador" => "text-danger",
        "Cliente" => "text-success",
        "Vendedor" => "text-primary",
        _ => "text-secondary"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEliminar.css" />
}

<div class="sg-card border-danger">
    <h1 class="text-danger">
        <i class="fa-solid fa-user-xmark"></i>
        Eliminar usuario
    </h1>

    <p>
        <strong>Usuario:</strong> @Model.UserName<br />
        <strong>Correo:</strong> @Model.Email<br />
        <strong>Teléfono:</strong> @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Sin teléfono" : Model.PhoneNumber)<br />
        <strong>Rol:</strong> <span class="@rolClase">@Model.Rol</span>
    </p>

    <div class="alert alert-warning">
        <i class="fa-solid fa-circle-exclamation"></i>
        Esta acción eliminará al usuario del sistema de forma <strong>permanente</strong>.
        El usuario perderá el acceso al sistema y no podrá iniciar sesión.
    </div>

    @if (Model.Rol == "Administrador")
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <strong>¡Advertencia!</strong> Estás eliminando un usuario con rol de <strong>Administrador</strong>.
            Asegúrate de que haya otro administrador activo en el sistema.
        </div>
    }

    @if (Model.Rol == "Vendedor")
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-circle-info"></i>
            <strong>Vendedor:</strong> Este usuario tiene permisos de ventas.
            Eliminarlo puede afectar los registros de pedidos asociados.
        </div>
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
            <button class="btn btn-danger" type="submit">
                <i class="fa-solid fa-trash"></i> Confirmar eliminación
            </button>
        </div>
    </form>
</div>