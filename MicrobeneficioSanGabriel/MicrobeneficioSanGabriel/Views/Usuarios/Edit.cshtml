@model MicrobeneficioSanGabriel.ViewModels.UsuarioEditarViewModel

@{
    ViewData["Title"] = "Editar usuario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditar-edit-page">

    <div class="EstiloEditar-header">
        <h1>Editar usuario</h1>
        <p>Actualizar información básica y rol del usuario.</p>
    </div>

    <div class="EstiloEditar-card">

        <div class="EstiloEditar-card-header">
            <h2>@Model.Email</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>
        <div class="EstiloEditar-card-body">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>
                    <div class="col-md-6">

                        <label asp-for="PhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>
                    <div class="col-12">

                        <label asp-for="Rol"
                               class="form-label">
                        </label>

                        <select asp-for="Rol"
                                asp-items="Model.Roles"
                                class="form-select">

                            <option value="">
                                Seleccione un rol
                            </option>

                        </select>

                        <span asp-validation-for="Rol"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="EstiloEditar-actions">

                    <a asp-action="Index"
                       class="btn-volver">
                        Volver a la lista
                    </a>

                    <button type="submit"
                            class="btn-guardar">
                        Guardar cambios
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}