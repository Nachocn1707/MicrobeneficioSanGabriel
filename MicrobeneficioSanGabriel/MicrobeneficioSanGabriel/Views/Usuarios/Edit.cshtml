@model MicrobeneficioSanGabriel.ViewModels.UsuarioEditarViewModel

@{
    ViewData["Title"] = "Editar usuario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditaR-page">

    <div class="EstiloEditaR-top">
        <div class="EstiloEditaR-title">
            <span class="EstiloEditaR-badge">
                <i class="fa-solid fa-user-gear"></i>
                Gestión de usuarios
            </span>
            <h1>Editar usuario</h1>
            <p>Actualizá los datos de los usuarios registrados dentro del sistema.</p>
        </div>
    </div>

    <div class="EstiloEditaR-card">
        <div class="EstiloEditaR-form-container">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <div class="Estilo-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Verificá los datos del usuario <strong>@Model.Email</strong> antes de guardar los cambios en el sistema.
                    </span>
                </div>

                <div class="EstiloEditaR-section">
                    <h5>
                        <i class="fa-solid fa-user-check"></i>
                        Detalle del usuario
                    </h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Nombre" class="form-label">
                                    <i class="fa-regular fa-user label-icon"></i>
                                    Nombre
                                </label>
                                <input asp-for="Nombre" class="form-control" placeholder="Nombre del usuario" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Apellidos" class="form-label">
                                    <i class="fa-solid fa-user-tag label-icon"></i>
                                    Apellidos
                                </label>
                                <input asp-for="Apellidos" class="form-control" placeholder="Apellidos del usuario" />
                                <span asp-validation-for="Apellidos" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Email" class="form-label">
                                    <i class="fa-regular fa-envelope label-icon"></i>
                                    Correo
                                </label>
                                <input asp-for="Email" class="form-control" type="email" autocomplete="username"
                                       placeholder="usuario@gmail.com" />
                                <div class="form-text">Ejemplos válidos: usuario@gmail.com o usuario@hotmail.com</div>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="PhoneNumber" class="form-label">
                                    <i class="fa-solid fa-phone label-icon"></i>
                                    Teléfono
                                </label>
                                <input asp-for="PhoneNumber" class="form-control" type="tel" inputmode="numeric"
                                       maxlength="8" pattern="[0-9]{8}" placeholder="88888888"
                                       oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,8)" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Rol" class="form-label">
                                    <i class="fa-solid fa-user-shield label-icon"></i>
                                    Rol
                                </label>
                                <select asp-for="Rol" asp-items="Model.Roles" class="form-select">
                                    <option value="">Seleccione un rol</option>
                                </select>
                                <span asp-validation-for="Rol" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="EstiloEditaR-actions">
                    <a asp-action="Index" class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                    <button type="submit" class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}