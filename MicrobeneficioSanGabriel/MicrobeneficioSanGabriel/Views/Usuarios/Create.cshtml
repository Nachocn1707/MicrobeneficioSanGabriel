@model MicrobeneficioSanGabriel.ViewModels.UsuarioCrearViewModel

@{
    ViewData["Title"] = "Registrar usuario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="fw-bold">Registrar usuario</h1>
<p class="text-muted mb-4">Crear una nueva cuenta de acceso al sistema.</p>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold"></label>
            <input asp-for="Email" class="form-control" placeholder="usuario@correo.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="8888-8888" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Rol" class="form-label fw-semibold"></label>
            <select asp-for="Rol" asp-items="Model.Roles" class="form-select">
                <option value="">Seleccione un rol</option>
            </select>
            <span asp-validation-for="Rol" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                Guardar
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}