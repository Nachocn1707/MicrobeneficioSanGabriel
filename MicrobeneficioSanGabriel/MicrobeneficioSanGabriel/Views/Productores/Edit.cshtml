@model MicrobeneficioSanGabriel.Models.Productor

@{
    ViewData["Title"] = "Editar productor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditaR-top">
    <div class="EstiloEditaR-title">
        <span class="EstiloEditaR-badge">
            <i class="fa-solid fa-pen-to-square"></i>
            Actualización
        </span>
        <h1>Editar productor</h1>
        <p>Actualizá los datos y estados de los productores registrados.</p>
    </div>
</div>

<div class="sg-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <partial name="_Form" model="Model" />

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-volver">
                <i class="fa-solid fa-arrow-left me-1"></i>Cancelar
            </a>
            <button type="submit" class="btn btn-primary btn-guardar">
                <i class="fa-solid fa-floppy-disk me-2"></i>Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}