@model IEnumerable<MicrobeneficioSanGabriel.Models.Productor>
@{
    ViewData["Title"] = "Productores";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var activos = Model.Count(p => p.Activo);
    var totalFincas = Model.Sum(p => p.Fincas.Count);
    var totalLotes = Model.Sum(p => p.Lotes.Count);
}
<div class="sg-visual-hero sg-hero-productores"><div class="sg-visual-hero-content"><span class="sg-visual-badge"><i class="fa-solid fa-people-group"></i> Red de productores</span><h1>Productores registrados</h1><div class="sg-visual-line"></div><p>Controle datos de contacto, ubicaciones, fincas y lotes asociados.</p></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="sg-card"><small class="text-muted">Productores activos</small><h2>@activos</h2></div></div><div class="col-md-4"><div class="sg-card"><small class="text-muted">Fincas registradas</small><h2>@totalFincas</h2></div></div><div class="col-md-4"><div class="sg-card"><small class="text-muted">Lotes asociados</small><h2>@totalLotes</h2></div></div></div>
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">Catálogo de productores</h2><div class="d-flex gap-2"><a asp-controller="Fincas" asp-action="Create" class="btn btn-outline-success"><i class="fa-solid fa-mountain-sun me-2"></i>Nueva finca</a><a asp-action="Create" class="btn btn-success"><i class="fa-solid fa-plus me-2"></i>Nuevo productor</a></div></div>
<div class="sg-card p-3 table-responsive"><table class="table table-hover align-middle" id="tablaProductores"><thead><tr><th>Productor</th><th>Contacto</th><th>Ubicación</th><th>Fincas</th><th>Lotes</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.Nombre</strong><br/><small class="text-muted">@item.Cedula</small></td><td>@item.Telefono<br/><small class="text-muted">@(item.Correo ?? "Sin correo")</small></td><td>@item.UbicacionCompleta</td><td>@item.Fincas.Count</td><td>@item.Lotes.Count</td><td><span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">@(item.Activo ? "Activo" : "Inactivo")</span></td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="fa-solid fa-eye"></i></a><a asp-controller="Fincas" asp-action="Create" asp-route-productorId="@item.Id" class="btn btn-sm btn-outline-success" title="Agregar finca"><i class="fa-solid fa-mountain-sun"></i></a>@if(User.IsInRole("Administrador")){<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></a>}</td></tr>}</tbody></table></div>
