@model IEnumerable<MicrobeneficioSanGabriel.Models.Productor>

@{
    ViewData["Title"] = "Productores";
    <div class="sg-visual-hero sg-hero-productores">
        <div class="sg-visual-hero-content">
            <span class="sg-visual-badge">
                <i class="fa-solid fa-user-tie"></i>
                Gestión cafetalera
            </span>

            <h1>Productores registrados</h1>
            <div class="sg-visual-line"></div>

            <p>
                Administrá la información de productores, fincas, contacto y estado de registro.
            </p>
        </div>
    </div>
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int totalProductores = Model.Count();
    int productoresActivos = Model.Count(p => p.Activo);
    int productoresInactivos = Model.Count(p => !p.Activo);
    int productoresConFinca = Model.Count(p => !string.IsNullOrWhiteSpace(p.Finca));
}

@section Styles {
    <style>
        .productores-page {
            display: grid;
            gap: 24px;
            padding-top: 10px;
        }

        .productores-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

            .productores-header h1 {
                font-size: 2.35rem;
                font-weight: 950;
                margin: 0;
                color: #2b160d;
            }

        .productores-title-line {
            width: 76px;
            height: 4px;
            background: #d8b36a;
            border-radius: 999px;
            margin: 12px 0;
        }

        .productores-header p {
            color: #6f5b4a;
            font-weight: 650;
            margin: 0;
        }

        .btn-nuevo-productor {
            background: #198754;
            color: #fff;
            border-radius: 13px;
            padding: 11px 18px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 12px 28px rgba(25, 135, 84, 0.18);
            transition: 0.18s ease;
        }

            .btn-nuevo-productor:hover {
                background: #157347;
                color: #fff;
                transform: translateY(-1px);
            }

        .productores-alert {
            border: none;
            border-radius: 18px;
            padding: 15px 18px;
            font-weight: 750;
            box-shadow: 0 12px 28px rgba(58, 33, 20, 0.08);
        }

        .productores-summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .productor-summary-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 22px;
            padding: 20px;
            box-shadow: 0 16px 36px rgba(58, 33, 20, 0.08);
            position: relative;
            overflow: hidden;
        }

            .productor-summary-card::after {
                content: "";
                position: absolute;
                right: -32px;
                bottom: -36px;
                width: 110px;
                height: 110px;
                background: rgba(243, 210, 122, 0.22);
                border-radius: 50%;
            }

        .productor-summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #fff2d5;
            color: #a66b20;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            font-size: 18px;
        }

        .productor-summary-label {
            color: #7a6a5d;
            font-weight: 850;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .productor-summary-value {
            color: #2b160d;
            font-size: 1.75rem;
            font-weight: 950;
            line-height: 1.15;
        }

        .productores-table-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 24px;
            box-shadow: 0 18px 42px rgba(58, 33, 20, 0.08);
            padding: 18px;
            overflow: hidden;
        }

            .productores-table-card table {
                margin-bottom: 0;
            }

                .productores-table-card table thead th {
                    background: #1f2937 !important;
                    color: #fff !important;
                    border: none !important;
                    padding: 15px 14px !important;
                    font-weight: 900;
                    vertical-align: middle;
                }

                    .productores-table-card table thead th:first-child {
                        border-top-left-radius: 13px;
                    }

                    .productores-table-card table thead th:last-child {
                        border-top-right-radius: 13px;
                    }

                .productores-table-card table tbody td {
                    padding: 16px 14px !important;
                    vertical-align: middle;
                    border-bottom: 1px solid #ece2cf;
                }

                .productores-table-card table tbody tr:hover {
                    background: rgba(243, 210, 122, 0.12);
                }

        .productor-nombre {
            font-weight: 950;
            color: #2b160d;
        }

        .productor-texto {
            color: #5f5147;
            font-weight: 700;
        }

        .productor-finca {
            font-weight: 850;
            color: #2b160d;
        }

        .productor-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

            .productor-actions .btn {
                border-radius: 10px;
                font-weight: 850;
                padding: 8px 11px;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

        .productor-estado {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: 0.8rem;
            font-weight: 950;
            white-space: nowrap;
        }

        .productor-estado-activo {
            background: #dff5e3;
            color: #1e7d32;
        }

        .productor-estado-inactivo {
            background: #fde1df;
            color: #b42318;
        }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 15px;
            color: #2b160d;
            font-weight: 700;
        }

            .dataTables_wrapper .dataTables_filter input,
            .dataTables_wrapper .dataTables_length select {
                border: 1px solid #d9c8ab;
                border-radius: 10px;
                padding: 7px 10px;
                background: white;
            }

        .dataTables_wrapper .dataTables_info {
            color: #6f5b4a;
            font-weight: 650;
            margin-top: 14px;
        }

        .dataTables_wrapper .dataTables_paginate {
            margin-top: 14px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border-radius: 10px !important;
            }

        @@media (max-width: 1200px) {
            .productores-summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .productores-header {
                flex-direction: column;
            }

            .productores-summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="productores-page">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show productores-alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show productores-alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="productores-header">
        <div>
            <h1></h1>
            <div class="productores-title-line"></div>
            <p>
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-success">
                + Nuevo Productor
            </a>
        }

    </div>

    <section class="productores-summary-grid">

        <div class="productor-summary-card">
            <div class="productor-summary-icon">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="productor-summary-label">Productores registrados</div>
            <div class="productor-summary-value">@totalProductores</div>
        </div>

        <div class="productor-summary-card">
            <div class="productor-summary-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="productor-summary-label">Activos</div>
            <div class="productor-summary-value">@productoresActivos</div>
        </div>

        <div class="productor-summary-card">
            <div class="productor-summary-icon">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>
            <div class="productor-summary-label">Inactivos</div>
            <div class="productor-summary-value">@productoresInactivos</div>
        </div>

        <div class="productor-summary-card">
            <div class="productor-summary-icon">
                <i class="fa-solid fa-seedling"></i>
            </div>
            <div class="productor-summary-label">Con finca registrada</div>
            <div class="productor-summary-value">@productoresConFinca</div>
        </div>

    </section>

    <div class="productores-table-card">

        <div class="table-responsive">

            <table id="tablaProductores" class="table align-middle">

                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Cédula</th>
                        <th>Teléfono</th>
                        <th>Finca</th>
                        <th>Estado</th>
                        <th width="280">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        string estadoClase = item.Activo
                            ? "productor-estado productor-estado-activo"
                            : "productor-estado productor-estado-inactivo";

                        string estadoTexto = item.Activo ? "Activo" : "Inactivo";

                        <tr>

                            <td class="productor-nombre">
                                @item.Nombre
                            </td>

                            <td class="productor-texto">
                                @(string.IsNullOrWhiteSpace(item.Cedula)
                                    ? "Sin cédula"
                                    : item.Cedula)
                            </td>

                            <td class="productor-texto">
                                @(string.IsNullOrWhiteSpace(item.Telefono)
                                    ? "Sin teléfono"
                                    : item.Telefono)
                            </td>

                            <td class="productor-finca">
                                @(string.IsNullOrWhiteSpace(item.Finca)
                                    ? "Sin finca"
                                    : item.Finca)
                            </td>

                            <td>
                                <span class="@estadoClase">
                                    @estadoTexto
                                </span>
                            </td>

                            <td>
                                <div class="productor-actions">

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            Editar
                                        </a>
                                    }

                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">
                                        <i class="fa-solid fa-eye"></i>
                                        Detalles
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-trash"></i>
                                            Eliminar
                                        </a>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaProductores').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20],
                responsive: true
            });
        });
    </script>
}