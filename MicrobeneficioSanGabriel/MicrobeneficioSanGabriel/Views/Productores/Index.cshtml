@model IEnumerable<MicrobeneficioSanGabriel.Models.Productor>
@{
    ViewData["Title"] = "Productores";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var productoresLista = Model.ToList();
    var total = productoresLista.Count;
    var activos = productoresLista.Count(p => p.Activo);
    var inactivos = productoresLista.Count(p => !p.Activo);
    var totalFincas = productoresLista.Sum(p => p.Fincas?.Count ?? 0);
    var volumen = productoresLista.Sum(p => p.Lotes?.Sum(l => l.PesoKg) ?? 0);
}
<section class="sg-page-head"><div><h1>Productores</h1><p>Administración de productores, contactos y fincas asociadas.</p></div><div class="sg-actions"><a asp-action="Create" class="sg-btn gold"><i class="fa-solid fa-plus"></i>Nuevo productor</a><label class="sg-search"><i class="fa-solid fa-magnifying-glass"></i><input placeholder="Buscar productor, cédula o ubicación..." /></label></div></section>
<section class="sg-kpi-grid three"><article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-user-tie"></i></span><div><span>Productores activos</span><strong>@activos</strong><div class="sg-trend">Según estado registrado</div></div></article><article class="sg-card sg-kpi"><span class="sg-icon gold"><i class="fa-solid fa-mountain-sun"></i></span><div><span>Fincas registradas</span><strong>@totalFincas</strong><div class="sg-trend">Fincas asociadas</div></div></article><article class="sg-card sg-kpi"><span class="sg-icon green"><i class="fa-solid fa-seedling"></i></span><div><span>Kg recibidos</span><strong>@volumen.ToString("N2") kg</strong><div class="sg-trend">Suma de lotes reales</div></div></article></section>
<section class="sg-card sg-table-card"><div class="sg-panel-head"><h3>Lista de productores</h3><span class="sg-badge">@total registro(s), @inactivos inactivo(s)</span></div><div class="table-responsive"><table class="sg-table" id="tablaProductores"><thead><tr><th>Productor</th><th>Finca / Empresa</th><th>Ubicación</th><th>Teléfono</th><th>Correo</th><th>Kg recibidos</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in productoresLista){<tr><td><strong>@item.Nombre</strong><br/><small>@item.Cedula</small></td><td>@(item.Fincas.Any() ? string.Join(", ", item.Fincas.OrderBy(f => f.Nombre).Select(f => f.Nombre)) : "Sin finca asociada")</td><td>@item.UbicacionCompleta</td><td>@item.Telefono</td><td>@item.Correo</td><td>@item.Lotes.Sum(l=>l.PesoKg).ToString("N2") kg</td><td><span class="sg-badge @(item.Activo?"":"tan")">@(item.Activo?"Activo":"Inactivo")</span></td><td><span class="sg-action-icons"><a asp-action="Details" asp-route-id="@item.Id"><i class="fa-solid fa-eye"></i></a>@if(User.IsInRole("Administrador")){<a asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pen"></i></a><a asp-action="Delete" asp-route-id="@item.Id"><i class="fa-solid fa-trash"></i></a>}</span></td></tr>}</tbody></table></div></section>
