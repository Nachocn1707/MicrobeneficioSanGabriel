@model IEnumerable<MicrobeneficioSanGabriel.Models.Productor>

@{
    ViewData["Title"] = "Productores";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="contenedor-productores">

    <div class="page-header">
        <div>
            <h1>Productores</h1>
            <p>Gestión de productores registrados en el microbeneficio.</p>
        </div>

        <a asp-action="Create" class="btn btn-success">
            + Nuevo Productor
        </a>
    </div>

    <div class="admin-card">

        <table id="tablaProductores" class="table tabla-productores">

            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Cédula</th>
                    <th>Teléfono</th>
                    <th>Finca</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Nombre</td>

                        <td>@item.Cedula</td>

                        <td>@item.Telefono</td>

                        <td>@item.Finca</td>

                        <td>
                            @if (item.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>

                        <td class="acciones">

                            @if (User.IsInRole("Administrador"))
                            {
                            <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                    Editar
                                </a>
                            }

                            <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm text-white">
                                Detalles
                            </a>

                            @if (User.IsInRole("Administrador"))
                            {
                            <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaProductores').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20] ,
                responsive: true
            });
        });
    </script>
}