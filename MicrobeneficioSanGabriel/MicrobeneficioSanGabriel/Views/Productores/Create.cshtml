@model MicrobeneficioSanGabriel.Models.Productor
@{
    ViewData["Title"] = "Nuevo productor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="sg-visual-hero sg-hero-productores"><div class="sg-visual-hero-content"><span class="sg-visual-badge"><i class="fa-solid fa-seedling"></i> Gestión de productores</span><h1>Nuevo productor</h1><div class="sg-visual-line"></div><p>Registre datos de contacto y ubicación con validaciones para mantener información confiable.</p></div></div>
<div class="sg-card"><form asp-action="Create" method="post"><partial name="_Form" model="Model" /><div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-success"><i class="fa-solid fa-floppy-disk me-2"></i>Registrar productor</button></div></form></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

