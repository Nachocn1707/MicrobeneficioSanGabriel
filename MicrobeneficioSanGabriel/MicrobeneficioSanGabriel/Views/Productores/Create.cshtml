@model MicrobeneficioSanGabriel.Models.Productor

@{
    ViewData["Title"] = "Nuevo productor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaCrear.css" />
}

<div class="VistaCrear-page">

    <div class="VistaCrear-top">

        <div class="VistaCrear-title">

            <span class="VistaCrear-badge">
                Gestión de productores
            </span>

            <h1>Nuevo productor</h1>

            <p>
                Registrá productores y mantené el control
                de la trazabilidad del café.
            </p>

        </div>

    </div>

    <div class="VistaCrear-card">

        <div class="VistaCrear-side">

            <div class="VistaCrear-side-content">

                <div class="VistaCrear-icon">
                    <i class="fa-solid fa-seedling"></i>
                </div>

                <h2>Productores</h2>

                <p>
                    Gestioná la información de productores,
                    fincas y datos de contacto del sistema.
                </p>

                <div class="VistaCrear-info">

                    <div class="VistaCrear-info-item">
                        <i class="fa-solid fa-user-group"></i>
                        Gestión de productores
                    </div>

                    <div class="VistaCrear-info-item">
                        <i class="fa-solid fa-mountain-sun"></i>
                        Control de fincas
                    </div>

                    <div class="VistaCrear-info-item">
                        <i class="fa-solid fa-route"></i>
                        Trazabilidad agrícola
                    </div>

                </div>

            </div>

        </div>

        <div class="VistaCrear-form-container">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>

                <input type="hidden" asp-for="FechaRegistro" />

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="Nombre"
                               class="form-label">
                            Nombre
                        </label>

                        <div class="input-modern">

                            <i class="fa-solid fa-user"></i>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Nombre completo del productor" />

                        </div>

                        <span asp-validation-for="Nombre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Cedula"
                               class="form-label">
                            Cédula
                        </label>

                        <div class="input-modern">

                            <i class="fa-solid fa-id-card"></i>

                            <input asp-for="Cedula"
                                   class="form-control"
                                   placeholder="Número de cédula" />

                        </div>

                        <span asp-validation-for="Cedula"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Telefono"
                               class="form-label">
                            Teléfono
                        </label>

                        <div class="input-modern">

                            <i class="fa-solid fa-phone"></i>

                            <input asp-for="Telefono"
                                   class="form-control"
                                   placeholder="8888-8888" />

                        </div>

                        <span asp-validation-for="Telefono"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Finca"
                               class="form-label">
                            Finca
                        </label>

                        <div class="input-modern">

                            <i class="fa-solid fa-mountain"></i>

                            <input asp-for="Finca"
                                   class="form-control"
                                   placeholder="Nombre de la finca" />

                        </div>

                        <span asp-validation-for="Finca"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Direccion"
                               class="form-label">
                            Dirección
                        </label>

                        <div class="input-modern">

                            <i class="fa-solid fa-location-dot"></i>

                            <input asp-for="Direccion"
                                   class="form-control"
                                   placeholder="Dirección o ubicación de la finca" />

                        </div>

                        <span asp-validation-for="Direccion"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <div class="form-check form-switch mt-2">

                            <input class="form-check-input"
                                   asp-for="Activo" />

                            <label class="form-check-label"
                                   asp-for="Activo">
                                Productor activo
                            </label>

                        </div>

                    </div>

                </div>

                <div class="VistaCrear-actions">

                    <a asp-action="Index"
                           class="btn-cancelar">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>

                    <button type="submit"
                            class="btn-crear">

                        <i class="fa-solid fa-floppy-disk"></i>
                        Registrar productor

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}