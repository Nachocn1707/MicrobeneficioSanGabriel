@model MicrobeneficioSanGabriel.Models.Productor

@{
    ViewData["Title"] = "Detalle del productor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var fincas = Model.Fincas ?? new List<MicrobeneficioSanGabriel.Models.Finca>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<section class="Detalle-page-head">
    <div>
        <h1>Detalle del productor</h1>
        <p>Consultá la información general del productor registrado y sus fincas asociadas.</p>
    </div>
    <div class="Detalle-actions">
        <span class="movimiento-badge-top">
            <i class="fa-solid fa-user me-1"></i> Productor #@Model.Id
        </span>
    </div>
</section>

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-premium-card mb-4">
        <div class="EstiloDetalle-premium-header">
            <h2><i class="fa-solid fa-address-card me-2"></i> Información del Productor</h2>
        </div>

        <div class="EstiloDetalle-premium-body">
            <div class="EstiloDetalle-detail-grid">

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-id-card"></i> CÉDULA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Cedula
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-user"></i> NOMBRE COMPLETO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Nombre
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-phone"></i> TELÉFONO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Telefono
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-envelope"></i> CORREO ELECTRÓNICO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Correo) ? "Sin correo registrado" : Model.Correo)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-map-location-dot"></i> PROVINCIA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Provincia
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-location-dot"></i> CANTÓN
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Canton
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-map-pin"></i> DISTRITO
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Distrito
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-compass"></i> DIRECCIÓN EXACTA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.DireccionExacta) ? "Sin dirección especificada" : Model.DireccionExacta)
                    </span>
                </div>

            </div>
        </div>
    </div>

    <div class="EstiloDetalle-premium-card">
        <div class="EstiloDetalle-premium-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0"><i class="fa-solid fa-tree me-2"></i> Fincas asociadas</h2>
            <a asp-controller="Fincas"
               asp-action="Create"
               asp-route-productorId="@Model.Id"
               class="btn-EstiloDetalle btn-EstiloDetalle-primary text-decoration-none">
                <i class="fa-solid fa-plus me-1"></i> Agregar finca
            </a>
        </div>

        <div class="EstiloDetalle-premium-body">
            @if (fincas.Any())
            {
                <div class="row g-3">
                    @foreach (var finca in fincas)
                    {
                        <div class="col-md-6">
                            <div class="p-3 rounded-4" style="background: #ffffff; border: 1px solid var(--cliente-borde); box-shadow: 0 4px 12px rgba(41, 75, 42, 0.05);">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold mb-0" style="color: #294b2a;">
                                        <i class="fa-solid fa-mountain-sun me-1"></i> @finca.Nombre
                                    </h5>
                                    <span class="@(finca.Activa ? "movimiento-estado movimiento-entrada" : "movimiento-estado movimiento-salida")">
                                        @(finca.Activa ? "Activa" : "Inactiva")
                                    </span>
                                </div>
                                <p class="text-muted small mb-3">
                                    <i class="fa-solid fa-location-dot me-1"></i> @finca.UbicacionCompleta
                                </p>
                                <a asp-controller="Fincas"
                                   asp-action="Details"
                                   asp-route-id="@finca.Id"
                                   class="btn-EstiloDetalle btn-EstiloDetalle-primary text-decoration-none py-1 px-3 fs-7">
                                    <i class="fa-solid fa-eye me-1"></i> Ver detalle
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info border-0 rounded-4 p-3 d-flex align-items-center gap-3" style="background: rgba(41, 75, 42, 0.08); color: #294b2a;">
                    <i class="fa-solid fa-circle-info fs-4"></i>
                    <span>Este productor todavía no tiene fincas registradas. Presioná <strong>Agregar finca</strong> para asociar la primera.</span>
                </div>
            }

            <div class="EstiloDetalle-actions mt-4">
                <a asp-action="Index" class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Volver
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-EstiloDetalle btn-EstiloDetalle-warning">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Editar
                    </a>
                }
            </div>
        </div>
    </div>

</div>