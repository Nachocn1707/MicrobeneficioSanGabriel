@model MicrobeneficioSanGabriel.Models.Productor

@{
    ViewData["Title"] = "Detalles del productores";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalles del EstiloDetalle</h1>
        <p>Información registrada del EstiloDetalle cafetalero.</p>
    </div>

    <div class="EstiloDetalle-card">
        <div class="EstiloDetalle-card-header">
            <h2>@Model.Nombre</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">
            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">Nombre</span>
                    <span class="detalle-value">@Model.Nombre</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Cédula</span>
                    <span class="detalle-value">@Model.Cedula</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Teléfono</span>
                    <span class="detalle-value">@Model.Telefono</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Finca</span>
                    <span class="detalle-value">@Model.Finca</span>
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">Dirección</span>
                    <span class="detalle-value">@Model.Direccion</span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Estado</span>

                    @if (Model.Activo)
                    {
                        <span class="estado-activo">Activo</span>
                    }
                    else
                    {
                        <span class="estado-inactivo">Inactivo</span>
                    }
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">Fecha de registro</span>
                    <span class="detalle-value">@Model.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">
                <a asp-action="Index" class="btn-volver">Volver a la lista</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-editar">Editar</a>
            </div>
        </div>
    </div>

</div>