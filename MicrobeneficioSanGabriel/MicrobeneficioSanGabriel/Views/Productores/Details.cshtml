@model MicrobeneficioSanGabriel.Models.Productor

@{
    ViewData["Title"] = "Detalles del productor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string estadoClase = Model.Activo
        ? "productor-estado productor-estado-activo"
        : "productor-estado productor-estado-inactivo";

    string estadoTexto = Model.Activo ? "Activo" : "Inactivo";
}

@section Styles {
    <style>
        .productor-detalle-page {
            display: grid;
            gap: 24px;
            padding-top: 14px;
        }

        .productor-detalle-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

        .productor-detalle-title h1 {
            font-size: 2.4rem;
            font-weight: 950;
            margin: 0;
            color: #2b160d;
        }

        .productor-detalle-line {
            width: 78px;
            height: 4px;
            border-radius: 999px;
            background: #d8b36a;
            margin: 12px 0;
        }

        .productor-detalle-title p {
            color: #6f5b4a;
            font-weight: 650;
            margin: 0;
        }

        .productor-status-top {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 18px;
            padding: 14px 18px;
            box-shadow: 0 12px 28px rgba(58, 33, 20, 0.08);
            min-width: 190px;
            text-align: center;
        }

            .productor-status-top small {
                display: block;
                color: #7a6a5d;
                font-weight: 800;
                margin-bottom: 8px;
            }

        .productor-premium-card {
            background: #fffdf8;
            border: 1px solid #ead8a2;
            border-radius: 28px;
            box-shadow: 0 22px 55px rgba(58, 33, 20, 0.10);
            overflow: hidden;
        }

        .productor-premium-header {
            background: linear-gradient(135deg, #3a1f12, #7a5230);
            padding: 24px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            border-top: 5px solid #f3d27a;
        }

            .productor-premium-header h2 {
                margin: 0;
                color: #fff3c4;
                font-size: 1.8rem;
                font-weight: 950;
            }

            .productor-premium-header span {
                color: #fff8df;
                font-weight: 700;
                opacity: 0.92;
            }

        .productor-premium-body {
            display: grid;
            grid-template-columns: 1fr 0.45fr;
            min-height: 420px;
        }

        .productor-info-panel {
            padding: 30px;
        }

        .productor-side-panel {
            background: linear-gradient(180deg, rgba(22, 32, 47, 0.94), rgba(13, 22, 35, 0.96)), url("/images/dashboard/client-hero.jpg");
            background-size: cover;
            background-position: center;
            padding: 30px;
            color: #fff8df;
            display: flex;
            align-items: center;
        }

        .productor-side-box {
            width: 100%;
            background: rgba(255, 253, 248, 0.11);
            border: 1px solid rgba(255, 243, 196, 0.22);
            border-radius: 24px;
            padding: 24px;
            backdrop-filter: blur(4px);
        }

        .productor-side-icon {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.12);
            color: #fff3c4;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-bottom: 18px;
        }

        .productor-side-box h3 {
            color: #fff3c4;
            font-size: 1.45rem;
            font-weight: 950;
            margin: 0;
        }

        .productor-side-line {
            width: 70px;
            height: 4px;
            border-radius: 999px;
            background: #f3d27a;
            margin: 14px 0 18px;
        }

        .productor-side-box p {
            color: #fff8df;
            opacity: 0.95;
            font-weight: 650;
            line-height: 1.55;
            margin-bottom: 0;
        }

        .productor-detail-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .productor-detail-item {
            background: #fff8df;
            border: 1px solid #ead8a2;
            border-radius: 18px;
            padding: 17px;
            min-height: 92px;
        }

            .productor-detail-item.full {
                grid-column: 1 / -1;
            }

        .productor-detail-label {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #7a5230;
            font-size: 0.78rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            margin-bottom: 8px;
        }

            .productor-detail-label i {
                color: #a66b20;
            }

        .productor-detail-value {
            display: block;
            color: #2b160d;
            font-size: 1rem;
            font-weight: 800;
            line-height: 1.45;
            word-break: break-word;
        }

        .productor-actions {
            border-top: 1px solid #ead8a2;
            margin-top: 22px;
            padding-top: 22px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-productor {
            border: none;
            border-radius: 13px;
            padding: 11px 18px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: 0.18s ease;
        }

            .btn-productor:hover {
                transform: translateY(-1px);
            }

        .btn-productor-primary {
            background: #4a2c1a;
            color: #fff8df;
        }

            .btn-productor-primary:hover {
                background: #7a5230;
                color: #fff8df;
            }

        .btn-productor-warning {
            background: #f3b23f;
            color: #2b160d;
        }

            .btn-productor-warning:hover {
                background: #e5a22e;
                color: #2b160d;
            }

        .productor-estado {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 7px 13px;
            font-size: 0.82rem;
            font-weight: 950;
            width: fit-content;
        }

        .productor-estado-activo {
            background: #dff5e3;
            color: #1e7d32;
        }

        .productor-estado-inactivo {
            background: #fde1df;
            color: #b42318;
        }

        @@media (max-width: 1100px) {
            .productor-premium-body {
                grid-template-columns: 1fr;
            }

            .productor-side-panel {
                min-height: 300px;
            }
        }

        @@media (max-width: 768px) {
            .productor-detalle-header {
                flex-direction: column;
            }

            .productor-detail-grid {
                grid-template-columns: 1fr;
            }

            .productor-premium-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .productor-actions {
                justify-content: flex-start;
            }

            .productor-detalle-title h1 {
                font-size: 2rem;
            }
        }
    </style>
}

<div class="productor-detalle-page">

    <div class="productor-detalle-header">
        <div class="productor-detalle-title">
            <h1>Detalles del productor</h1>
            <div class="productor-detalle-line"></div>
            <p>Información registrada del productor cafetalero.</p>
        </div>

        <div class="productor-status-top">
            <small>Estado actual</small>
            <span class="@estadoClase">@estadoTexto</span>
        </div>
    </div>

    <div class="productor-premium-card">

        <div class="productor-premium-header">
            <div>
                <h2>@Model.Nombre</h2>
                <span>Microbeneficio San Gabriel</span>
            </div>

            <span>
                <i class="fa-solid fa-user-tie"></i>
                Registro de productor
            </span>
        </div>

        <div class="productor-premium-body">

            <div class="productor-info-panel">

                <div class="productor-detail-grid">

                    <div class="productor-detail-item">
                        <span class="productor-detail-label">
                            <i class="fa-solid fa-user"></i>
                            Nombre
                        </span>

                        <span class="productor-detail-value">
                            @Model.Nombre
                        </span>
                    </div>

                    <div class="productor-detail-item">
                        <span class="productor-detail-label">
                            <i class="fa-solid fa-id-card"></i>
                            Cédula
                        </span>

                        <span class="productor-detail-value">
                            @(string.IsNullOrWhiteSpace(Model.Cedula)
                                ? "Sin cédula"
                                : Model.Cedula)
                        </span>
                    </div>

                    <div class="productor-detail-item">
                        <span class="productor-detail-label">
                            <i class="fa-solid fa-phone"></i>
                            Teléfono
                        </span>

                        <span class="productor-detail-value">
                            @(string.IsNullOrWhiteSpace(Model.Telefono)
                                ? "Sin teléfono"
                                : Model.Telefono)
                        </span>
                    </div>

                    <div class="productor-detail-item">
                        <span class="productor-detail-label">
                            <i class="fa-solid fa-seedling"></i>
                            Finca
                        </span>

                        <span class="productor-detail-value">
                            @(string.IsNullOrWhiteSpace(Model.Finca)
                                ? "Sin finca"
                                : Model.Finca)
                        </span>
                    </div>

                    <div class="productor-detail-item">
                        <span class="productor-detail-label">
                            <i class="fa-solid fa-circle-info"></i>
                            Estado
                        </span>

                        <span class="@estadoClase">
                            @estadoTexto
                        </span>
                    </div>

                    <div class="productor-detail-item">
                        <span class="productor-detail-label">
                            <i class="fa-solid fa-calendar-days"></i>
                            Fecha de registro
                        </span>

                        <span class="productor-detail-value">
                            @Model.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")
                        </span>
                    </div>

                    <div class="productor-detail-item full">
                        <span class="productor-detail-label">
                            <i class="fa-solid fa-location-dot"></i>
                            Dirección
                        </span>

                        <span class="productor-detail-value">
                            @(string.IsNullOrWhiteSpace(Model.Direccion)
                                ? "Sin dirección registrada"
                                : Model.Direccion)
                        </span>
                    </div>

                </div>

                <div class="productor-actions">

                    <a asp-action="Index"
                           class="btn-productor btn-productor-primary">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver a la lista
                    </a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn-productor btn-productor-warning">
                            <i class="fa-solid fa-pen-to-square"></i>
                            Editar
                        </a>
                    }

                </div>

            </div>

            <div class="productor-side-panel">
                <div class="productor-side-box">
                    <div class="productor-side-icon">
                        <i class="fa-solid fa-seedling"></i>
                    </div>

                    <h3>Productor cafetalero</h3>
                    <div class="productor-side-line"></div>

                    <p>
                        Este registro permite relacionar productores con lotes,
                        procesos de producción y trazabilidad del café.
                    </p>
                </div>
            </div>

        </div>

    </div>

</div>