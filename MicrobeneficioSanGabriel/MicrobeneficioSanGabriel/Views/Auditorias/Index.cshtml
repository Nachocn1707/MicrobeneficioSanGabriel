@model IEnumerable<MicrobeneficioSanGabriel.Models.AuditoriaRegistro>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Auditoría";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var modulos = ViewBag.Modulos as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var usuarios = ViewBag.Usuarios as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var paginaActual = (int)(ViewBag.Page ?? 1);
    var totalPaginas = (int)(ViewBag.TotalPages ?? 1);
    var totalRegistros = (int)(ViewBag.TotalRegistros ?? 0);
    var tamanoPagina = (int)(ViewBag.PageSize ?? 8);
    var primerRegistro = totalRegistros == 0 ? 0 : ((paginaActual - 1) * tamanoPagina) + 1;
    var ultimoRegistro = Math.Min(paginaActual * tamanoPagina, totalRegistros);
    string? moduloSeleccionado = ViewBag.ModuloSeleccionado as string;
    string? usuarioIdSeleccionado = ViewBag.UsuarioIdSeleccionado as string;
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditaR-top">
    <div class="EstiloEditaR-title">
        <span class="EstiloEditaR-badge">
            <i class="fa-solid fa-pen-to-square"></i>
            Actualización
        </span>
        <h1>Registro de actividad</h1>
        <p>Consulte quién creó, modificó o eliminó información del sistema.</p>
    </div>
</div>

<form method="get" class="sg-card mb-4">
    <div class="row g-3 align-items-end">

        <div class="col-md-2">
            <label class="form-label">Módulo</label>

            <select name="modulo" class="form-select">
                <option value="">Todos los módulos</option>

                @foreach (var item in modulos)
                {
                    <option value="@item.Value" selected="@item.Selected">
                        @item.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Usuario</label>

            <select name="usuarioId" class="form-select">
                <option value="">Todos los usuarios</option>

                @foreach (var item in usuarios)
                {
                    <option value="@item.Value" selected="@item.Selected">
                        @item.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Desde</label>
            <input type="date"
                   name="fechaInicio"
                   value="@ViewBag.FechaInicio"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Hasta</label>
            <input type="date"
                   name="fechaFin"
                   value="@ViewBag.FechaFin"
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <div class="d-flex gap-2">
                <button class="btn btn-primary flex-fill" type="submit">
                    Filtrar
                </button>

                <a asp-action="Index"
                   asp-controller="Auditorias"
                   class="btn btn-outline-dark flex-fill">
                    Borrar filtro
                </a>
            </div>
        </div>

    </div>
</form>

<div class="sg-card p-3 table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Módulo</th>
                <th>Acción</th>
                <th>Detalle</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>

                    <td>
                        <strong>@item.UsuarioNombre</strong>
                    </td>

                    <td>@item.Rol</td>

                    <td>@item.Modulo</td>

                    <td>
                        <span class="badge bg-dark">
                            @item.Accion
                        </span>
                    </td>

                    <td>@item.Detalle</td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalRegistros > 0)
    {
        <nav class="sg-audit-pager" aria-label="Paginación de auditoría">
            <div class="sg-audit-pager-summary">
                Mostrando <strong>@primerRegistro-@ultimoRegistro</strong> de <strong>@totalRegistros</strong> registro(s)
            </div>

            <div class="sg-audit-pager-controls">
                @if (paginaActual > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="@(paginaActual - 1)"
                       asp-route-modulo="@moduloSeleccionado"
                       asp-route-usuarioId="@usuarioIdSeleccionado"
                       asp-route-fechaInicio="@ViewBag.FechaInicio"
                       asp-route-fechaFin="@ViewBag.FechaFin"
                       class="sg-audit-page-btn" aria-label="Página anterior">
                        <i class="fa-solid fa-chevron-left"></i> Anterior
                    </a>
                }
                else
                {
                    <span class="sg-audit-page-btn disabled" aria-disabled="true"><i class="fa-solid fa-chevron-left"></i> Anterior</span>
                }

                <div class="sg-audit-page-numbers">
                    @{
                        var inicioPagina = Math.Max(1, paginaActual - 2);
                        var finPagina = Math.Min(totalPaginas, paginaActual + 2);
                    }

                    @if (inicioPagina > 1)
                    {
                        <a asp-action="Index" asp-route-page="1" asp-route-modulo="@moduloSeleccionado" asp-route-usuarioId="@usuarioIdSeleccionado" asp-route-fechaInicio="@ViewBag.FechaInicio" asp-route-fechaFin="@ViewBag.FechaFin" class="sg-audit-page-number">1</a>
                        @if (inicioPagina > 2) { <span class="sg-audit-page-ellipsis">…</span> }
                    }

                    @for (var pagina = inicioPagina; pagina <= finPagina; pagina++)
                    {
                        if (pagina == paginaActual)
                        {
                            <span class="sg-audit-page-number active" aria-current="page">@pagina</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@pagina" asp-route-modulo="@moduloSeleccionado" asp-route-usuarioId="@usuarioIdSeleccionado" asp-route-fechaInicio="@ViewBag.FechaInicio" asp-route-fechaFin="@ViewBag.FechaFin" class="sg-audit-page-number">@pagina</a>
                        }
                    }

                    @if (finPagina < totalPaginas)
                    {
                        @if (finPagina < totalPaginas - 1) { <span class="sg-audit-page-ellipsis">…</span> }
                        <a asp-action="Index" asp-route-page="@totalPaginas" asp-route-modulo="@moduloSeleccionado" asp-route-usuarioId="@usuarioIdSeleccionado" asp-route-fechaInicio="@ViewBag.FechaInicio" asp-route-fechaFin="@ViewBag.FechaFin" class="sg-audit-page-number">@totalPaginas</a>
                    }
                </div>

                @if (paginaActual < totalPaginas)
                {
                    <a asp-action="Index"
                       asp-route-page="@(paginaActual + 1)"
                       asp-route-modulo="@moduloSeleccionado"
                       asp-route-usuarioId="@usuarioIdSeleccionado"
                       asp-route-fechaInicio="@ViewBag.FechaInicio"
                       asp-route-fechaFin="@ViewBag.FechaFin"
                       class="sg-audit-page-btn" aria-label="Página siguiente">
                        Siguiente <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
                else
                {
                    <span class="sg-audit-page-btn disabled" aria-disabled="true">Siguiente <i class="fa-solid fa-chevron-right"></i></span>
                }
            </div>

            <div class="sg-audit-pager-page">Página <strong>@paginaActual</strong> de <strong>@totalPaginas</strong></div>
        </nav>
    }
</div>