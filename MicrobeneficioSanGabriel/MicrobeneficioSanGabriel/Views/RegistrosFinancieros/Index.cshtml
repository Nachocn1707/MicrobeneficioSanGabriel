@model IEnumerable<MicrobeneficioSanGabriel.Models.RegistroFinanciero>

@{
    ViewData["Title"] = "Contabilidad";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="admin-title">Contabilidad</h1>
        <p class="admin-subtitle">Control de ingresos, gastos y balance financiero del microbeneficio.</p>
        <div class="d-flex gap-2">
            <a asp-action="ExportarExcel"
                   asp-route-fechaInicio="@ViewBag.FechaInicio"
                   asp-route-fechaFin="@ViewBag.FechaFin"
                   asp-route-tipo="@ViewBag.Tipo"
                   class="btn btn-success">
                Exportar a Excel
            </a>
            <a asp-action="Create" class="btn btn-admin-primary">
                + Nuevo registro
            </a>
        </div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="admin-card">
            <h5 class="fw-bold">Ingresos</h5>
            <h2 class="text-success">₡ @ViewBag.TotalIngresos.ToString("N2")</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="admin-card">
            <h5 class="fw-bold">Gastos</h5>
            <h2 class="text-danger">₡ @ViewBag.TotalGastos.ToString("N2")</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="admin-card">
            <h5 class="fw-bold">Balance</h5>
            <h2 class="@(ViewBag.Balance >= 0 ? "text-success" : "text-danger")">
                ₡ @ViewBag.Balance.ToString("N2")
            </h2>
        </div>
    </div>
</div>

<div class="admin-card mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Fecha inicio</label>
            <input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Fecha fin</label>
            <input type="date" name="fechaFin" value="@ViewBag.FechaFin" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Tipo</label>
            <select name="tipo" class="form-select">
                <option value="">Todos</option>
                <option value="Ingreso" selected="@(ViewBag.Tipo == "Ingreso")">Ingreso</option>
                <option value="Gasto" selected="@(ViewBag.Tipo == "Gasto")">Gasto</option>
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
        </div>
    </form>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Categoría</th>
                    <th>Descripción</th>
                    <th>Monto</th>
                    <th>Observación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No hay registros financieros.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>

                            <td>
                                @if (item.Tipo == "Ingreso")
                                {
                                    <span class="badge bg-success">Ingreso</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Gasto</span>
                                }
                            </td>

                            <td>@(item.Categoria ?? "Sin categoría")</td>
                            <td>@item.Descripcion</td>
                            <td>₡ @item.Monto.ToString("N2")</td>
                            <td>@(item.Observacion ?? "Sin observación")</td>

                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>