@model IEnumerable<MicrobeneficioSanGabriel.Models.RegistroFinanciero>

@{
    ViewData["Title"] = "Contabilidad";
    <div class="sg-visual-hero sg-hero-contabilidad">
        <div class="sg-visual-hero-content">
            <span class="sg-visual-badge">
                <i class="fa-solid fa-coins"></i>
                Gestión financiera
            </span>

            <h1>Contabilidad</h1>
            <div class="sg-visual-line"></div>

            <p>
                Administrá ingresos, egresos, registros financieros y movimientos económicos del microbeneficio.
            </p>
        </div>
    </div>
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    decimal totalIngresos = 0;
    decimal totalGastos = 0;
    decimal balance = 0;

    if (ViewBag.TotalIngresos != null)
    {
        totalIngresos = Convert.ToDecimal(ViewBag.TotalIngresos);
    }

    if (ViewBag.TotalGastos != null)
    {
        totalGastos = Convert.ToDecimal(ViewBag.TotalGastos);
    }

    if (ViewBag.Balance != null)
    {
        balance = Convert.ToDecimal(ViewBag.Balance);
    }

    string fechaInicio = ViewBag.FechaInicio != null ? Convert.ToString(ViewBag.FechaInicio) : "";
    string fechaFin = ViewBag.FechaFin != null ? Convert.ToString(ViewBag.FechaFin) : "";
    string tipoFiltro = ViewBag.Tipo != null ? Convert.ToString(ViewBag.Tipo) : "";

    int totalRegistros = Model.Count();
    int totalIngresosCantidad = Model.Count(r => r.Tipo == "Ingreso");
    int totalGastosCantidad = Model.Count(r => r.Tipo == "Gasto");
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/Contabilidad.css" />
}

<div class="finanzas-page">
    <div class="finanzas-header">
        <div>
            <h1></h1>
            <div class=""></div>
            <p>
            </p>
        </div>

        <div class="finanzas-header-actions">
            <a asp-action="ExportarExcel"
                   asp-route-fechaInicio="@fechaInicio"
                   asp-route-fechaFin="@fechaFin"
                   asp-route-tipo="@tipoFiltro"
                   class="btn-finanzas btn-finanzas-excel">
                <i class="fa-solid fa-file-excel"></i>
                Exportar a Excel
            </a>

            <a asp-action="Create" class="btn-finanzas btn-finanzas-nuevo">
                <i class="fa-solid fa-plus"></i>
                Nuevo registro
            </a>
        </div>
    </div>

    <section class="finanzas-summary-grid">

        <div class="finanzas-summary-card">
            <div class="finanzas-summary-icon">
                <i class="fa-solid fa-list-check"></i>
            </div>
            <div class="finanzas-summary-label">Registros</div>
            <div class="finanzas-summary-value">@totalRegistros</div>
        </div>

        <div class="finanzas-summary-card">
            <div class="finanzas-summary-icon">
                <i class="fa-solid fa-arrow-trend-up"></i>
            </div>
            <div class="finanzas-summary-label">Ingresos (@totalIngresosCantidad)</div>
            <div class="finanzas-summary-value success">₡ @totalIngresos.ToString("N2")</div>
        </div>

        <div class="finanzas-summary-card">
            <div class="finanzas-summary-icon">
                <i class="fa-solid fa-arrow-trend-down"></i>
            </div>
            <div class="finanzas-summary-label">Gastos (@totalGastosCantidad)</div>
            <div class="finanzas-summary-value danger">₡ @totalGastos.ToString("N2")</div>
        </div>

        <div class="finanzas-summary-card">
            <div class="finanzas-summary-icon">
                <i class="fa-solid fa-scale-balanced"></i>
            </div>
            <div class="finanzas-summary-label">Balance</div>
            <div class="finanzas-summary-value @(balance >= 0 ? "success" : "danger")">
                ₡ @balance.ToString("N2")
            </div>
        </div>

    </section>

    <div class="finanzas-filter-card">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label">Fecha inicio</label>
                <input type="date"
                       name="fechaInicio"
                       value="@fechaInicio"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Fecha fin</label>
                <input type="date"
                       name="fechaFin"
                       value="@fechaFin"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Tipo</label>
                <select name="tipo" class="form-select">
                    <option value="">Todos</option>

                    @if (tipoFiltro == "Ingreso")
                    {
                        <option value="Ingreso" selected>Ingreso</option>
                    }
                    else
                    {
                        <option value="Ingreso">Ingreso</option>
                    }

                    @if (tipoFiltro == "Gasto")
                    {
                        <option value="Gasto" selected>Gasto</option>
                    }
                    else
                    {
                        <option value="Gasto">Gasto</option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-filter"></i>
                    Filtrar
                </button>

                <a asp-action="Index" class="btn btn-secondary w-100">
                    <i class="fa-solid fa-rotate-left"></i>
                    Limpiar
                </a>
            </div>

        </form>
    </div>

    <div class="finanzas-table-card">

        <div class="table-responsive">

            <table id="tablaContabilidad" class="table align-middle">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Categoría</th>
                        <th>Descripción</th>
                        <th>Monto</th>
                        <th>Observación</th>
                        <th class="text-end" width="280">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        bool esIngreso = item.Tipo == "Ingreso";

                        string tipoClase = esIngreso
                            ? "finanzas-tipo finanzas-tipo-ingreso"
                            : "finanzas-tipo finanzas-tipo-gasto";

                        string montoClase = esIngreso
                            ? "finanzas-monto ingreso"
                            : "finanzas-monto gasto";

                        <tr>
                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                <span class="@tipoClase">
                                    @item.Tipo
                                </span>
                            </td>

                            <td class="finanzas-categoria">
                                @(string.IsNullOrWhiteSpace(item.Categoria)
                                    ? "Sin categoría"
                                    : item.Categoria)
                            </td>

                            <td class="finanzas-descripcion">
                                @(string.IsNullOrWhiteSpace(item.Descripcion)
                                    ? "Sin descripción"
                                    : item.Descripcion)
                            </td>

                            <td class="@montoClase">
                                ₡ @item.Monto.ToString("N2")
                            </td>

                            <td class="finanzas-observacion">
                                @(string.IsNullOrWhiteSpace(item.Observacion)
                                    ? "Sin observación"
                                    : item.Observacion)
                            </td>

                            <td>
                                <div class="finanzas-actions sg-action-icons justify-content-end">

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           title="Editar"
                                           aria-label="Editar">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                    }

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       title="Detalles"
                                       aria-label="Detalles">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           title="Eliminar"
                                           aria-label="Eliminar">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaContabilidad').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'
                },
                pageLength: 5,
                lengthMenu: [5, 10, 15, 20],
                responsive: true
            });
        });
    </script>
}