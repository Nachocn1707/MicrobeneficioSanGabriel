@model MicrobeneficioSanGabriel.Models.RegistroFinanciero

@{
    ViewData["Title"] = "Editar registro financiero";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categorias = new[] { "Venta", "Mantenimiento", "Transporte", "Nómina" };
    var categoriaActualEsEstandar = Array.Exists(categorias, c =>
        string.Equals(c, Model.Categoria, StringComparison.OrdinalIgnoreCase));
    var fechaOriginalRegistro = ViewBag.FechaOriginal != null
        ? Convert.ToDateTime(ViewBag.FechaOriginal)
        : Model.Fecha;
    var fechaMinimaRegistro = fechaOriginalRegistro.Date >= DateTime.Today
        ? DateTime.Today.ToString("yyyy-MM-dd")
        : string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditaR-page">

    <div class="EstiloEditaR-top">
        <div class="EstiloEditaR-title">
            <span class="EstiloEditaR-badge">
                <i class="fa-solid fa-calculator"></i>
                Contabilidad
            </span>
            <h1>Editar registro financiero</h1>
            <p>Administrá ingresos, egresos, registros financieros y movimientos económicos del microbeneficio.</p>
        </div>
    </div>

    <div class="EstiloEditaR-card">
        <div class="EstiloEditaR-form-container">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <div class="Estilo-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Asegurá que el tipo de movimiento, categoría y montos coincidan con el comprobante físico o digital correspondiente.
                    </span>
                </div>

                <div class="EstiloEditaR-section">
                    <h5>
                        <i class="fa-solid fa-scale-balanced"></i>
                        Detalle del movimiento financiero
                    </h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Tipo" class="form-label">
                                    <i class="fa-solid fa-arrow-right-arrow-left label-icon"></i>
                                    Tipo
                                </label>
                                <select asp-for="Tipo" class="form-select">
                                    <option value="">Seleccione un tipo</option>
                                    <option value="Ingreso">Ingreso</option>
                                    <option value="Gasto">Gasto</option>
                                </select>
                                <span asp-validation-for="Tipo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Categoria" class="form-label">
                                    <i class="fa-solid fa-tags label-icon"></i>
                                    Categoría
                                </label>
                                <select asp-for="Categoria" class="form-select">
                                    <option value="">Seleccione la categoría</option>
                                    <option value="Venta">Venta</option>
                                    <option value="Mantenimiento">Mantenimiento</option>
                                    <option value="Transporte">Transporte</option>
                                    <option value="Nómina">Nómina</option>
                                    @if (!string.IsNullOrWhiteSpace(Model.Categoria) && !categoriaActualEsEstandar)
                                    {
                                        <option value="@Model.Categoria">@Model.Categoria</option>
                                    }
                                </select>
                                <span asp-validation-for="Categoria" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Monto" class="form-label">
                                    <i class="fa-solid fa-coins label-icon"></i>
                                    Monto
                                </label>
                                <input asp-for="Monto" class="form-control" min="0" placeholder="Digite el monto" />
                                <span asp-validation-for="Monto" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Fecha" class="form-label">
                                    <i class="fa-regular fa-calendar-days label-icon"></i>
                                    Fecha
                                </label>
                                <input asp-for="Fecha" type="date" class="form-control"
                                       min="@fechaMinimaRegistro"
                                       data-no-past-date="true"
                                       data-today="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       data-original-date="@fechaOriginalRegistro.ToString("yyyy-MM-dd")"
                                       data-date-message="No puede seleccionar una fecha anterior a hoy." />
                                <span asp-validation-for="Fecha" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Descripcion" class="form-label">
                                    <i class="fa-regular fa-file-lines label-icon"></i>
                                    Descripción
                                </label>
                                <input asp-for="Descripcion" class="form-control" placeholder="Descripción del movimiento financiero" />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Observacion" class="form-label">
                                    <i class="fa-regular fa-comment-dots label-icon"></i>
                                    Observación
                                </label>
                                <textarea asp-for="Observacion" class="form-control" rows="4" placeholder="Observación adicional del registro"></textarea>
                                <span asp-validation-for="Observacion" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="EstiloEditaR-actions">
                    <a asp-action="Index" class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                    <button type="submit" class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}