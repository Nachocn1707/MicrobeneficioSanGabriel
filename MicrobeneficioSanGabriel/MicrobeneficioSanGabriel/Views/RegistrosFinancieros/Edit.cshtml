@model MicrobeneficioSanGabriel.Models.RegistroFinanciero

@{
    ViewData["Title"] = "Editar registro financiero";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEditar.css" />
}

<div class="EstiloEditar-edit-page">

    <div class="EstiloEditar-header">
        <h1>Editar registro financiero</h1>
        <p>Actualizá la información del ingreso o gasto registrado.</p>
    </div>

    <div class="EstiloEditar-card">

        <div class="EstiloEditar-card-header">
            <h2>@Model.Tipo</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloEditar-card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="Tipo" class="form-label">
                            Tipo
                        </label>

                        <select asp-for="Tipo" class="form-select">
                            <option value="">Seleccione un tipo</option>
                            <option value="Ingreso">Ingreso</option>
                            <option value="Gasto">Gasto</option>
                        </select>

                        <span asp-validation-for="Tipo" class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Categoria" class="form-label">
                            Categoría
                        </label>

                        <select asp-for="Categoria" class="form-select">
                            <option value="">-- Seleccione una categoría -- </option>
                            <option value="Venta"> Venta</option>
                            <option value="Mantenimiento">Mantenimiento</option>
                            <option value="transporte">transporte</option>
                            <option value="Nomina">Nómina</option>
                        </select>

                        <span asp-validation-for="Categoria" class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Monto" class="form-label">
                            Monto
                        </label>

                        <input asp-for="Monto"
                               class="form-control"
                               min="0"
                               placeholder="Digite el monto" />

                        <span asp-validation-for="Monto" class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Fecha" class="form-label">
                            Fecha
                        </label>

                        <input asp-for="Fecha"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Fecha" class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Descripcion" class="form-label">
                            Descripción
                        </label>

                        <input asp-for="Descripcion"
                               class="form-control"
                               placeholder="Descripción del movimiento financiero" />

                        <span asp-validation-for="Descripcion" class="text-danger"></span>

                    </div>

                </div>

                <div class="EstiloEditar-actions">

                    <a asp-action="Index"
                           class="btn-volver">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver a la lista
                    </a>

                    <button type="submit"
                            class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}