@using MicrobeneficioSanGabriel.Constants
@model MicrobeneficioSanGabriel.Models.RegistroFinanciero

@{
    ViewData["Title"] = "Nuevo registro financiero";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaCrear.css" />
}

<div class="VistaCreaR-page">
    <div class="VistaCreaR-top">
        <div class="VistaCreaR-title">
            <span class="VistaCreaR-badge">
                <i class="fa-solid fa-money-bill-wave"></i>
                Control financiero
            </span>
            <h1>Nuevo registro financiero</h1>
            <p>
                Registrá ingresos y gastos del Microbeneficio San Gabriel.
            </p>
        </div>
    </div>

    <div class="VistaCreaR-card">
        <div class="VistaCreaR-form-container">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="Mensaje-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Las <strong>ventas</strong> se generan automáticamente al completar un pedido. Aquí solo se registran otros ingresos y gastos.</span>
                </div>

                <div class="VistaCreaR-section">
                    <h5>
                        <i class="fa-solid fa-money-bill-wave"></i>
                        Detalle del registro financiero
                    </h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Tipo" class="form-label">Tipo</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-right-left"></i>
                                    <select asp-for="Tipo" class="form-select">
                                        <option value="">Seleccione un tipo</option>
                                        <option value="Ingreso">Ingreso</option>
                                        <option value="Gasto">Gasto</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Tipo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Categoria" class="form-label">Categoría</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-tags"></i>
                                    <select asp-for="Categoria" class="form-select">
                                        <option value="">Seleccione la categoría</option>
                                        @foreach (var categoria in CategoriasFinancieras.Manuales)
                                        {
                                            <option value="@categoria">@categoria</option>
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="Categoria" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Monto" class="form-label">Monto</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-money-bill-wave"></i>
                                    <input asp-for="Monto" class="form-control" min="0" placeholder="Digite el monto" />
                                </div>
                                <span asp-validation-for="Monto" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Fecha" class="form-label">Fecha</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-calendar-days"></i>
                                    <input asp-for="Fecha" type="date" class="form-control"
                                           min="@DateTime.UtcNow.AddHours(-6).Date.ToString("yyyy-MM-dd")"
                                           data-no-past-date="true"
                                           data-today="@DateTime.UtcNow.AddHours(-6).Date.ToString("yyyy-MM-dd")"
                                           data-original-date="@DateTime.UtcNow.AddHours(-6).Date.ToString("yyyy-MM-dd")"
                                           data-date-message="No puede seleccionar una fecha anterior a hoy." />
                                </div>
                                <span asp-validation-for="Fecha" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Descripcion" class="form-label">Descripción</label>
                                <div class="input-modern">
                                    <i class="fa-solid fa-align-left"></i>
                                    <input asp-for="Descripcion" class="form-control" placeholder="Descripción del movimiento financiero" />
                                </div>
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label asp-for="Observacion" class="form-label">Observación</label>
                                <div class="input-modern textarea-modern">
                                    <i class="fa-solid fa-comment"></i>
                                    <textarea asp-for="Observacion" class="form-control" rows="2" placeholder="Observación adicional del registro"></textarea>
                                </div>
                                <span asp-validation-for="Observacion" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="VistaCreaR-actions">
                    <a asp-action="Index" class="btn-cancelar">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver
                    </a>
                    <button type="submit" class="btn-crear">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Guardar registro
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}