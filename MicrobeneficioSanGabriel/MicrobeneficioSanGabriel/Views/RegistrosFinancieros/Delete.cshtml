@model MicrobeneficioSanGabriel.Models.RegistroFinanciero

@{
    ViewData["Title"] = "Eliminar registro financiero";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string tipoClase = Model.Tipo switch
    {
        "Ingreso" => "text-success",
        "Egreso" => "text-danger",
        _ => "text-secondary"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaEliminar.css" />
}

<div class="sg-card border-danger">
    <h1 class="text-danger">
        <i class="fa-solid fa-trash"></i>
        Eliminar registro financiero #@Model.Id
    </h1>

    <p>
        <strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy")<br />
        <strong>Tipo:</strong> <span class="@tipoClase">@Model.Tipo</span><br />
        <strong>Categoría:</strong> @(string.IsNullOrWhiteSpace(Model.Categoria) ? "Sin categoría" : Model.Categoria)<br />
        <strong>Monto:</strong> <span class="font-weight-bold">₡ @Model.Monto.ToString("N2")</span>
    </p>

    <div class="alert alert-warning">
        <i class="fa-solid fa-circle-exclamation"></i>
        Esta acción eliminará el registro contable del sistema de forma <strong>permanente</strong>.
        Esta operación puede afectar los reportes financieros y el balance del microbeneficio.
    </div>

    @if (Model.Tipo == "Ingreso")
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <strong>Ingreso registrado:</strong> Este registro afecta positivamente el balance financiero.
        </div>
    }
    else if (Model.Tipo == "Egreso")
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-circle-exclamation"></i>
            <strong>Egreso registrado:</strong> Este registro afecta negativamente el balance financiero.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Descripcion) || !string.IsNullOrWhiteSpace(Model.Observacion))
    {
        <div class="financial-details">
            @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <div class="detail-item">
                    <strong><i class="fa-solid fa-align-left"></i> Descripción:</strong>
                    <span>@Model.Descripcion</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Observacion))
            {
                <div class="detail-item">
                    <strong><i class="fa-solid fa-comment-dots"></i> Observación:</strong>
                    <span>@Model.Observacion</span>
                </div>
            }
        </div>
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
            <button class="btn btn-danger" type="submit">
                <i class="fa-solid fa-trash"></i> Confirmar eliminación
            </button>
        </div>
    </form>
</div>