@model MicrobeneficioSanGabriel.Models.RegistroFinanciero

@{
    ViewData["Title"] = "Eliminar registro financiero";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="admin-title text-danger">Eliminar registro financiero</h1>
<p class="admin-subtitle">Confirme si desea eliminar este registro financiero.</p>

<div class="admin-card">
    <div class="alert alert-warning">
        Esta acción eliminará el registro seleccionado. Verifique antes de continuar.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Fecha</dt>
        <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Tipo</dt>
        <dd class="col-sm-9">@Model.Tipo</dd>

        <dt class="col-sm-3">Categoría</dt>
        <dd class="col-sm-9">@(Model.Categoria ?? "Sin categoría")</dd>

        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>

        <dt class="col-sm-3">Monto</dt>
        <dd class="col-sm-9">₡ @Model.Monto.ToString("N2")</dd>

        <dt class="col-sm-3">Observación</dt>
        <dd class="col-sm-9">@(Model.Observacion ?? "Sin observación")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>