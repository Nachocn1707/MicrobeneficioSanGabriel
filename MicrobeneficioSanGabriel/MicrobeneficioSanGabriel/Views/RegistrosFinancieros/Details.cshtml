@model MicrobeneficioSanGabriel.Models.RegistroFinanciero

@{
    ViewData["Title"] = "Detalle financiero";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    bool esIngreso = Model.Tipo == "Ingreso";

    string estadoClase = esIngreso
        ? "estado-activo"
        : "estado-inactivo";

    string montoClase = esIngreso
        ? "detalle-monto-ingreso"
        : "detalle-monto-gasto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />

    <style>
        .detalle-monto-ingreso {
            color: #1e7d32;
            font-weight: 950;
        }

        .detalle-monto-gasto {
            color: #b42318;
            font-weight: 950;
        }
    </style>
}

<div class="EstiloDetalle-detalle-page">

    <div class="EstiloDetalle-header">
        <h1>Detalle financiero</h1>
        <p>Información detallada del registro financiero.</p>
    </div>

    <div class="EstiloDetalle-card">

        <div class="EstiloDetalle-card-header">
            <h2>@Model.Tipo</h2>
            <span>Microbeneficio San Gabriel</span>
        </div>

        <div class="EstiloDetalle-card-body">

            <div class="detalle-grid">

                <div class="detalle-item">
                    <span class="detalle-label">
                        Fecha
                    </span>

                    <span class="detalle-value">
                        @Model.Fecha.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Tipo
                    </span>

                    <span class="@estadoClase">
                        @Model.Tipo
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Categoría
                    </span>

                    <span class="detalle-value">
                        @(string.IsNullOrWhiteSpace(Model.Categoria)
                            ? "Sin categoría"
                            : Model.Categoria)
                    </span>
                </div>

                <div class="detalle-item">
                    <span class="detalle-label">
                        Monto
                    </span>

                    <span class="@montoClase">
                        ₡ @Model.Monto.ToString("N2")
                    </span>
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">
                        Descripción
                    </span>

                    <span class="detalle-value">
                        @(string.IsNullOrWhiteSpace(Model.Descripcion)
                            ? "Sin descripción"
                            : Model.Descripcion)
                    </span>
                </div>

                <div class="detalle-item full">
                    <span class="detalle-label">
                        Observación
                    </span>

                    <span class="detalle-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                       class="btn-volver">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver a la lista
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn-editar">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Editar
                    </a>
                }

            </div>

        </div>

    </div>

</div>