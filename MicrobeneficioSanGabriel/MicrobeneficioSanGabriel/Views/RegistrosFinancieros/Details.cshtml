@model MicrobeneficioSanGabriel.Models.RegistroFinanciero

@{
    ViewData["Title"] = "Detalle financiero";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    bool esIngreso = Model.Tipo == "Ingreso";

    string estadoClase = esIngreso
        ? "movimiento-estado estado-activo"
        : "movimiento-estado estado-inactivo";

    string montoClase = esIngreso
        ? "EstiloDetalle-detail-value EstiloDetalle-monto-ingreso"
        : "EstiloDetalle-detail-value EstiloDetalle-monto-gasto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<section class="Detalle-page-head">
    <div>
        <h1>Detalle financiero</h1>
        <p>Consultá la información registrada para este movimiento financiero.</p>
    </div>
    <div class="Detalle-actions">
        <span class="movimiento-badge-top">
            Registro #@Model.Id
        </span>
    </div>
</section>

<div class="EstiloDetalle-detalle-page">
    <div class="EstiloDetalle-premium-card">

        <div class="EstiloDetalle-premium-header">
            <h2>Información general</h2>
        </div>

        <div class="EstiloDetalle-premium-body">

            <div class="EstiloDetalle-detail-grid">

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-calendar-days"></i> FECHA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Fecha.ToString(Model.EsAutomatico ? "dd/MM/yyyy HH:mm" : "dd/MM/yyyy")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-arrows-left-right"></i> TIPO
                    </span>
                    <div>
                        <span class="@estadoClase">
                            @Model.Tipo
                        </span>
                    </div>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-layer-group"></i> CATEGORÍA
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Categoria)
                            ? "Sin categoría"
                            : Model.Categoria)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-coins"></i> MONTO
                    </span>
                    <span class="@montoClase">
                        ₡ @Model.Monto.ToString("N2")
                    </span>
                </div>

                @if (Model.EsAutomatico)
                {
                    <div class="EstiloDetalle-detail-item">
                        <span class="EstiloDetalle-detail-label"><i class="fa-solid fa-link"></i> ORIGEN</span>
                        <span class="EstiloDetalle-detail-value">@(Model.OrigenTipo ?? "Sistema") #@Model.OrigenId</span>
                    </div>
                    <div class="EstiloDetalle-detail-item">
                        <span class="EstiloDetalle-detail-label"><i class="fa-solid fa-user"></i> CLIENTE</span>
                        <span class="EstiloDetalle-detail-value">@(Model.Destinatario ?? "Sin cliente")</span>
                    </div>
                    <div class="EstiloDetalle-detail-item">
                        <span class="EstiloDetalle-detail-label"><i class="fa-solid fa-mug-hot"></i> PRODUCTO</span>
                        <span class="EstiloDetalle-detail-value">@(Model.ProductoNombre ?? "Sin producto")</span>
                    </div>
                    <div class="EstiloDetalle-detail-item">
                        <span class="EstiloDetalle-detail-label"><i class="fa-solid fa-weight-scale"></i> CANTIDAD</span>
                        <span class="EstiloDetalle-detail-value">@(Model.CantidadKg?.ToString("N2") ?? "0") kg</span>
                    </div>
                }

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-file-lines"></i> DESCRIPCIÓN
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Descripcion)
                            ? "Sin descripción"
                            : Model.Descripcion)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">
                        <i class="fa-solid fa-align-left"></i> OBSERVACIÓN
                    </span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver a la lista
                </a>

                @if (User.IsInRole("Administrador") && !Model.EsAutomatico)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-EstiloDetalle btn-EstiloDetalle-warning">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Editar
                    </a>
                }

            </div>

        </div>
    </div>
</div>