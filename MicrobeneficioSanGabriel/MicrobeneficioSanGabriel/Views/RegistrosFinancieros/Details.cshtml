@model MicrobeneficioSanGabriel.Models.RegistroFinanciero

@{
    ViewData["Title"] = "Detalle financiero";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="admin-title">Detalle financiero</h1>
<p class="admin-subtitle">Información detallada del registro financiero.</p>

<div class="admin-card">
    <div class="row">
        <div class="col-md-4">
            <strong>Fecha:</strong>
            <p>@Model.Fecha.ToString("dd/MM/yyyy")</p>
        </div>

        <div class="col-md-4">
            <strong>Tipo:</strong>
            <p>@Model.Tipo</p>
        </div>

        <div class="col-md-4">
            <strong>Categoría:</strong>
            <p>@(Model.Categoria ?? "Sin categoría")</p>
        </div>

        <div class="col-md-4">
            <strong>Monto:</strong>
            <p>₡ @Model.Monto.ToString("N2")</p>
        </div>

        <div class="col-md-8">
            <strong>Descripción:</strong>
            <p>@Model.Descripcion</p>
        </div>

        <div class="col-md-12">
            <strong>Observación:</strong>
            <p>@(Model.Observacion ?? "Sin observación")</p>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>