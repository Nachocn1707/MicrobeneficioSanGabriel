@model MicrobeneficioSanGabriel.Models.RegistroFinanciero

@{
    ViewData["Title"] = "Detalle financiero";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    bool esIngreso = Model.Tipo == "Ingreso";

    string estadoClase = esIngreso
        ? "movimiento-estado estado-activo"
        : "movimiento-estado estado-inactivo";

    string montoClase = esIngreso
        ? "EstiloDetalle-detail-value EstiloDetalle-monto-ingreso"
        : "EstiloDetalle-detail-value EstiloDetalle-monto-gasto";
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaDetalles.css" />
}

<section class="sg-page-head">
    <div>
        <h1>Detalle financiero</h1>
        <p>Consultá la información registrada para este movimiento financiero.</p>
    </div>
    <div class="sg-actions">
    </div>
</section>

<section class="sg-visual-hero sg-hero-financiero">
    <div class="sg-visual-hero-content">
        <h1>@Model.Tipo: ₡ @Model.Monto.ToString("N2")</h1>
        <div class="sg-visual-line"></div>
        <span class="sg-visual-badge"><i class="fa-solid fa-sack-dollar"></i> Registro financiero</span>
    </div>
</section>

<div class="EstiloDetalle-detalle-page">
    <div class="EstiloDetalle-premium-card">

        <div class="EstiloDetalle-premium-header">
            <h2>Información general</h2>
            <span class="movimiento-badge-top">Registro #@Model.Id</span>
        </div>

        <div class="EstiloDetalle-premium-body">

            <div class="EstiloDetalle-detail-grid">

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">FECHA</span>
                    <span class="EstiloDetalle-detail-value">
                        @Model.Fecha.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">TIPO</span>
                    <div>
                        <span class="@estadoClase">
                            @Model.Tipo
                        </span>
                    </div>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">CATEGORÍA</span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Categoria)
                            ? "Sin categoría"
                            : Model.Categoria)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item">
                    <span class="EstiloDetalle-detail-label">MONTO</span>
                    <span class="@montoClase">
                        ₡ @Model.Monto.ToString("N2")
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">DESCRIPCIÓN</span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Descripcion)
                            ? "Sin descripción"
                            : Model.Descripcion)
                    </span>
                </div>

                <div class="EstiloDetalle-detail-item full">
                    <span class="EstiloDetalle-detail-label">OBSERVACIÓN</span>
                    <span class="EstiloDetalle-detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Observacion)
                            ? "Sin observación"
                            : Model.Observacion)
                    </span>
                </div>

            </div>

            <div class="EstiloDetalle-actions">

                <a asp-action="Index"
                   class="btn-EstiloDetalle btn-EstiloDetalle-primary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver a la lista
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn-EstiloDetalle btn-EstiloDetalle-warning">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Editar
                    </a>
                }

            </div>

        </div>
    </div>
</div>