@page
@using MicrobeneficioSanGabriel.Models
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="auth-shell auth-compact-shell">
    <header class="auth-topbar">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-brand">
            <span class="auth-brand-mark"><i class="fa-solid fa-mug-hot"></i></span>
            <div><h1>San Gabriel</h1><span>Coffee Lab · Recuperación de acceso</span></div>
        </a>
        <nav class="auth-nav">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-nav-pill">Inicio</a>
            <a asp-page="./Login" class="auth-top-action">Volver al login</a>
        </nav>
    </header>

    <div class="auth-layout auth-compact-layout">
        <section class="auth-showcase auth-recovery-showcase">
            <span class="auth-kicker"><i class="fa-solid fa-key"></i> Recuperación segura</span>
            <h2>Recuperá el acceso a tu cuenta de forma sencilla.</h2>
            <p class="lead">Ingresá el correo asociado a tu usuario. Te enviaremos un enlace seguro para crear una nueva contraseña.</p>

            <article class="auth-floating-card auth-recovery-card">
                <span class="auth-kicker"><i class="fa-solid fa-shield-halved"></i> Proceso protegido</span>
                <h3>Tu cuenta permanece segura</h3>
                <p class="auth-feature-text">El enlace de recuperación se enviará únicamente al correo registrado en el sistema.</p>
                <div class="auth-info-list">
                    <span><i class="fa-solid fa-envelope-circle-check"></i> Verificación mediante correo</span>
                    <span><i class="fa-solid fa-clock"></i> Enlace temporal y protegido</span>
                    <span><i class="fa-solid fa-lock"></i> Nueva contraseña segura</span>
                </div>
            </article>
        </section>

        <section class="auth-form-panel">
            <div class="auth-panel-card">
                <div class="auth-card-header">
                    <span class="auth-kicker"><i class="fa-solid fa-unlock-keyhole"></i> Restablecer acceso</span>
                    <h2>Recuperar contraseña</h2>
                    <p>Escribí tu correo electrónico para recibir las instrucciones de recuperación.</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger validation-summary mb-3"></div>
                    <div class="form-group">
                        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Input.Email" class="form-control custom-input" autocomplete="email" placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-login"><i class="fa-solid fa-paper-plane"></i> Enviar enlace de recuperación</button>
                    <div class="links auth-links-centered"><a asp-page="./Login"><i class="fa-solid fa-arrow-left"></i> Volver al inicio de sesión</a></div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
