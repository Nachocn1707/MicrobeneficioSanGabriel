@page
@using MicrobeneficioSanGabriel.Models
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Recuperar contraseña";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Login_Register.css" />
}

<div class="sgl-shell">
    <div class="sgl-layout">

        <section class="sgl-showcase">
            <div class="sgl-showcase-dots"></div>
            <div class="sgl-showcase-glow"></div>

            <div class="sgl-showcase-top">
                <span class="sgl-avatar">
                    <img src="~/images/logo_san_gabriel.jpg" alt="Logo San Gabriel" />
                </span>

                <span class="sgl-badge"><i class="fa-solid fa-key"></i> Recuperación segura</span>

                <h1 class="sgl-headline">Recuperá el acceso a tu cuenta de forma <span>sencilla</span></h1>

                <div class="sgl-showcase-divider">
                    <span class="sgl-showcase-divider-icon"><i class="fa-solid fa-shield-halved"></i></span>
                </div>

                <p class="sgl-lead">
                    Ingresá el correo asociado a tu usuario. Te enviaremos un enlace seguro para crear
                    una nueva contraseña.
                </p>
            </div>

            <div class="sgl-info-list">
                <div class="sgl-info-item">
                    <span class="sgl-feature-icon"><i class="fa-solid fa-envelope-circle-check"></i></span>
                    <span>Verificación mediante correo</span>
                </div>
                <div class="sgl-info-item">
                    <span class="sgl-feature-icon"><i class="fa-solid fa-clock"></i></span>
                    <span>Enlace temporal y protegido</span>
                </div>
                <div class="sgl-info-item">
                    <span class="sgl-feature-icon"><i class="fa-solid fa-lock"></i></span>
                    <span>Nueva contraseña segura</span>
                </div>
            </div>
        </section>

        <section class="sgl-panel">
            <div class="sgl-card">

                <div class="sgl-card-header">
                    <span class="sgl-badge sgl-badge--panel"><i class="fa-solid fa-unlock-keyhole"></i> Restablecer acceso</span>
                    <h2>Recuperar contraseña</h2>
                    <p>Escribí tu correo electrónico para recibir las instrucciones de recuperación.</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="sgl-error-summary"></div>

                    <div class="sgl-field">
                        <label class="sgl-label" asp-for="Input.Email">Correo electrónico</label>
                        <div class="sgl-input-wrap">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Input.Email"
                                   class="sgl-input"
                                   autocomplete="email"
                                   placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="sgl-error-text"></span>
                    </div>

                    <button type="submit" class="sgl-btn-primary">
                        <i class="fa-solid fa-paper-plane"></i>
                        Enviar enlace de recuperación
                    </button>

                    <div class="sgl-form-links">
                        <a asp-page="./Login" class="sgl-link">
                            <i class="fa-solid fa-arrow-left"></i> Volver al inicio de sesión
                        </a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
