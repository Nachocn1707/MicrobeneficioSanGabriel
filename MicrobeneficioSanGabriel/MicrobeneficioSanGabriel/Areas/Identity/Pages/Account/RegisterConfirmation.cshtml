@page
@using MicrobeneficioSanGabriel.Models
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmá tu correo";
}

<div class="auth-shell auth-state-shell">
    <header class="auth-topbar">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-brand">
            <span class="auth-brand-mark"><i class="fa-solid fa-mug-hot"></i></span>
            <div><h1>San Gabriel</h1><span>Coffee Lab · Registro de cliente</span></div>
        </a>
        <nav class="auth-nav"><a asp-page="./Login" class="auth-top-action">Ir al login</a></nav>
    </header>

    <main class="auth-state-stage">
        <article class="auth-state-card auth-state-info">
            <div class="auth-state-icon"><i class="fa-solid fa-envelope-open-text"></i></div>
            <span class="auth-kicker"><i class="fa-solid fa-user-check"></i> Registro recibido</span>
            <h2>Confirmá tu correo</h2>
            <p>
                Enviamos un enlace de confirmación a <strong>@Model.EmailMasked</strong>.
                Debés abrirlo antes de poder iniciar sesión.
            </p>

            @if (TempData["RegistroExitoso"] is string registroExitoso)
            {
                <div class="alert alert-success mt-3" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>@registroExitoso
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.CorreoReenviado))
            {
                <div class="alert alert-success mt-3" role="alert">
                    <i class="fa-solid fa-paper-plane me-2"></i>@Model.CorreoReenviado
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorEnvioCorreo))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@Model.ErrorEnvioCorreo
                </div>
            }

            <div class="auth-state-details">
                <span><i class="fa-solid fa-envelope"></i> Revisá tu bandeja</span>
                <span><i class="fa-solid fa-folder-open"></i> Revisá Spam</span>
                <span><i class="fa-solid fa-circle-check"></i> Activá tu cuenta</span>
            </div>

            <div class="auth-state-actions">
                <form method="post" asp-page-handler="Resend" class="d-inline">
                    <input type="hidden" name="email" value="@Model.Email" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn-login auth-inline-action">
                        <i class="fa-solid fa-paper-plane"></i> Reenviar correo
                    </button>
                </form>
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="auth-secondary-action">
                    <i class="fa-solid fa-right-to-bracket"></i> Volver al login
                </a>
            </div>
        </article>
    </main>
</div>
