@page
@using MicrobeneficioSanGabriel.Models;
@model ResetPasswordModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<link rel="stylesheet"href="~/css/Login_Register.css" />

<div class="login-container">

    <div class="login-card">

        <div class="user-icon"><i class="fa-solid fa-lock"></i></div>
        <h2 class="text-center mb-2">Nueva contraseña</h2>
        <p class="text-center text-muted mb-4">Ingresá tu nueva contraseña para recuperar el acceso al sistema.</p>
        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="input-wrapper">

                <i class="fa-solid fa-envelope"></i>

                <input asp-for="Input.Email"
                       id="email"
                       class="form-control custom-input"
                       autocomplete="username"
                       placeholder="correo@ejemplo.com" />

            </div>
            <div class="form-group mb-3">

                <label class="form-label">
                    Nueva contraseña
                </label>

                <div class="input-wrapper password-field">

                    <i class="fa-solid fa-lock"></i>

                    <input asp-for="Input.Password"
                           id="password"
                           class="form-control custom-input"
                           autocomplete="new-password"
                           placeholder="Ingresá tu nueva contraseña" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('password', 'passwordIcon')">

                        <i id="passwordIcon"
                           class="fa-solid fa-eye"></i>

                    </button>
                </div>
                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>
            </div>
            <div class="form-group mb-4">

                <label class="form-label">
                    Confirmar contraseña
                </label>

                <div class="input-wrapper password-field">
                    <i class="fa-solid fa-shield-halved"></i>
                    <input asp-for="Input.ConfirmPassword"
                           id="confirmPassword"
                           class="form-control custom-input"
                           autocomplete="new-password"
                           placeholder="Repetí la contraseña" />
                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('confirmPassword', 'confirmPasswordIcon')">

                        <i id="confirmPasswordIcon"
                           class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger">
                </span>
            </div>
            <div class="validation-box">
                <div class="validation-box-title">
                    Requisitos de seguridad
                </div>

                <div id="emailMessage" class="rule-item">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Correo válido
                </div>

                <div id="length" class="rule-item">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Mínimo 8 caracteres
                </div>

                <div id="uppercase" class="rule-item">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Una mayúscula
                </div>

                <div id="lowercase" class="rule-item">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Una minúscula
                </div>

                <div id="number" class="rule-item">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Un número
                </div>

                <div id="symbol" class="rule-item">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Un símbolo
                </div>

                <div id="match" class="rule-item">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Las contraseñas coinciden
                </div>
            </div>
            <button type="submit" class="btn-login">
                CAMBIAR CONTRASEÑA
            </button>

            <div class="links">
                <a asp-page="./Login">
                    Volver al login
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
