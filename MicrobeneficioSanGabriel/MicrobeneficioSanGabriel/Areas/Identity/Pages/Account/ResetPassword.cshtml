@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="login-container">

    <div class="login-card">

        <div class="user-icon"><i class="fa-solid fa-lock"></i></div>
        <h2 class="text-center mb-2">Nueva contraseña</h2>
        <p class="text-center text-muted mb-4">Ingresá tu nueva contraseña para recuperar el acceso al sistema.</p>
        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>
            <input asp-for="Input.Code" type="hidden" />
            <div class="form-group mb-3">
                <label class="form-label">
                    Correo electrónico
                </label>
                <input asp-for="Input.Email"
                       class="form-control custom-input"
                       autocomplete="username" />
                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label">
                    Nueva contraseña
                </label>
                <input asp-for="Input.Password"
                       class="form-control custom-input"
                       autocomplete="new-password" />

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>
            </div>
            <div class="form-group mb-4">
                <label class="form-label">
                    Confirmar contraseña
                </label>
                <input asp-for="Input.ConfirmPassword"
                       class="form-control custom-input"
                       autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger">
                </span>
            </div>
            <button type="submit" class="btn-login">
                CAMBIAR CONTRASEÑA
            </button>
            <div class="links">
                <a asp-page="./Login">
                    Volver al login
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
