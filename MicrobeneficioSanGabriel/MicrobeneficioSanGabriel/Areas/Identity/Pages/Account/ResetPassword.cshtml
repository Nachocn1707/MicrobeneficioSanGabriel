@page
@using MicrobeneficioSanGabriel.Models
@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="auth-shell auth-compact-shell">
    <header class="auth-topbar">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-brand">
            <span class="auth-brand-mark"><i class="fa-solid fa-mug-hot"></i></span>
            <div><h1>San Gabriel</h1><span>Coffee Lab · Nueva contraseña</span></div>
        </a>
        <nav class="auth-nav"><a asp-page="./Login" class="auth-top-action">Volver al login</a></nav>
    </header>

    <div class="auth-layout auth-compact-layout">
        <section class="auth-showcase auth-recovery-showcase">
            <span class="auth-kicker"><i class="fa-solid fa-lock"></i> Seguridad de cuenta</span>
            <h2>Creá una contraseña nueva y segura.</h2>
            <p class="lead">Elegí una combinación que no hayas utilizado antes y que cumpla los requisitos indicados.</p>

            <article class="auth-floating-card auth-recovery-card">
                <span class="auth-kicker"><i class="fa-solid fa-shield-halved"></i> Recomendaciones</span>
                <h3>Protegé tu acceso al sistema</h3>
                <p class="auth-feature-text">Una contraseña fuerte ayuda a mantener protegidos tus datos, pedidos y operaciones.</p>
                <div class="auth-info-list">
                    <span><i class="fa-solid fa-check"></i> Combiná letras, números y símbolos</span>
                    <span><i class="fa-solid fa-check"></i> Evitá datos fáciles de adivinar</span>
                    <span><i class="fa-solid fa-check"></i> No compartás tu contraseña</span>
                </div>
            </article>
        </section>

        <section class="auth-form-panel">
            <div class="auth-panel-card">
                <div class="auth-card-header">
                    <span class="auth-kicker"><i class="fa-solid fa-key"></i> Restablecer acceso</span>
                    <h2>Nueva contraseña</h2>
                    <p>Completá los campos para recuperar el acceso a tu cuenta.</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger validation-summary mb-3"></div>
                    <input asp-for="Input.Code" type="hidden" />

                    <div class="form-group">
                        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Input.Email" id="email" class="form-control custom-input" autocomplete="username" placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password" class="form-label">Nueva contraseña</label>
                        <div class="input-wrapper password-field">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="Input.Password" id="password" class="form-control custom-input" autocomplete="new-password" placeholder="Ingresá tu nueva contraseña" />
                            <button type="button" class="password-toggle" onclick="togglePassword('password','passwordIcon')" aria-label="Mostrar u ocultar contraseña"><i id="passwordIcon" class="fa-solid fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
                        <div class="input-wrapper password-field">
                            <i class="fa-solid fa-shield-halved"></i>
                            <input asp-for="Input.ConfirmPassword" id="confirmPassword" class="form-control custom-input" autocomplete="new-password" placeholder="Repetí la contraseña" />
                            <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword','confirmPasswordIcon')" aria-label="Mostrar u ocultar confirmación"><i id="confirmPasswordIcon" class="fa-solid fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="validation-box auth-validation-box">
                        <div class="validation-box-title">Requisitos de seguridad</div>
                        <div id="emailMessage" class="rule-item"><i class="fa-solid fa-circle-xmark"></i> Correo válido</div>
                        <div id="length" class="rule-item"><i class="fa-solid fa-circle-xmark"></i> Mínimo 8 caracteres</div>
                        <div id="uppercase" class="rule-item"><i class="fa-solid fa-circle-xmark"></i> Una mayúscula</div>
                        <div id="lowercase" class="rule-item"><i class="fa-solid fa-circle-xmark"></i> Una minúscula</div>
                        <div id="number" class="rule-item"><i class="fa-solid fa-circle-xmark"></i> Un número</div>
                        <div id="symbol" class="rule-item"><i class="fa-solid fa-circle-xmark"></i> Un símbolo</div>
                        <div id="match" class="rule-item"><i class="fa-solid fa-circle-xmark"></i> Las contraseñas coinciden</div>
                    </div>

                    <button type="submit" class="btn-login"><i class="fa-solid fa-floppy-disk"></i> Cambiar contraseña</button>
                    <div class="links auth-links-centered"><a asp-page="./Login"><i class="fa-solid fa-arrow-left"></i> Volver al login</a></div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
