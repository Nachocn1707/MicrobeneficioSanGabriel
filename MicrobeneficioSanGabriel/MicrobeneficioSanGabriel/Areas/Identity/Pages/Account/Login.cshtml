@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

@section Styles {

    <link rel="stylesheet" href="~/css/Login_Register.css" />
}

<div class="sgl-shell">
    <div class="sgl-layout">

        <section class="sgl-showcase">
            <div class="sgl-showcase-dots"></div>
            <div class="sgl-showcase-glow"></div>

            <div class="sgl-showcase-top">
                <span class="sgl-avatar">
                    <img src="~/images/logo_san_gabriel.jpg" alt="Logo San Gabriel" />
                </span>

                <span class="sgl-badge"><i class="fa-solid fa-seedling"></i> Microbeneficio</span>

                <h1 class="sgl-headline">Bienvenido a <span>San Gabriel</span> Coffee Lab</h1>

                <div class="sgl-showcase-divider">
                    <span class="sgl-showcase-divider-icon"><i class="fa-solid fa-mug-saucer"></i></span>
                </div>

                <p class="sgl-lead">
                    La plataforma creada para administrar el origen, la producción, el inventario y las
                    ventas de tu café, o para que tus clientes exploren productos y trazabilidad desde
                    el portal.
                </p>
            </div>

            <div class="sgl-feature-row">
                <article class="sgl-feature">
                    <span class="sgl-feature-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
                    <strong>Inventario</strong>
                    <span>controlado</span>
                </article>
                <article class="sgl-feature">
                    <span class="sgl-feature-icon"><i class="fa-solid fa-route"></i></span>
                    <strong>Trazabilidad</strong>
                    <span>del grano a la taza</span>
                </article>
                <article class="sgl-feature">
                    <span class="sgl-feature-icon"><i class="fa-solid fa-chart-line"></i></span>
                    <strong>Negocio</strong>
                    <span>en crecimiento</span>
                </article>
            </div>
        </section>

        <section class="sgl-panel">
            <div class="sgl-card">

                <nav class="sgl-login-navigation" aria-label="Navegación del acceso">
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="sgl-back-home">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver a la página inicial
                    </a>
                </nav>

                <div class="sgl-card-header">
                    <span class="sgl-badge sgl-badge--panel"><i class="fa-solid fa-shield-halved"></i> Acceso seguro</span>
                    <h2>Iniciar sesión</h2>
                    <p>Utilizá las credenciales asignadas a tu cuenta.</p>
                </div>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">

                    @if (TempData["RegistroExitoso"] is string mensajeRegistro)
                    {
                        <div class="sgl-alert sgl-alert--success" role="alert">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>@mensajeRegistro</span>
                        </div>
                    }
                    <div asp-validation-summary="ModelOnly" class="sgl-error-summary"></div>

                    @if (Model.RequiresEmailConfirmation)
                    {
                        <div class="sgl-alert sgl-alert--warning" role="alert">
                            <i class="fa-solid fa-envelope-circle-check"></i>
                            <span>
                                La cuenta está pendiente de confirmación.
                                <a asp-page="./RegisterConfirmation"
                                   asp-route-email="@Model.EmailForConfirmation"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="sgl-alert-link">Reenviar enlace</a>.
                            </span>
                        </div>
                    }

                    <div class="sgl-field">
                        <label class="sgl-label" asp-for="Input.Email">Correo electrónico</label>
                        <div class="sgl-input-wrap">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Input.Email"
                                   class="sgl-input"
                                   autocomplete="username"
                                   placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="sgl-error-text"></span>
                    </div>

                    <div class="sgl-field">
                        <label class="sgl-label" asp-for="Input.Password">Contraseña</label>
                        <div class="sgl-input-wrap sgl-input-wrap--password">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="Input.Password"
                                   id="loginPassword"
                                   class="sgl-input"
                                   autocomplete="current-password"
                                   placeholder="Ingresá tu contraseña" />
                            <button type="button"
                                    class="sgl-toggle-visibility"
                                    onclick="sglTogglePassword('loginPassword', 'loginPasswordIcon')"
                                    aria-label="Mostrar u ocultar contraseña">
                                <i id="loginPasswordIcon" class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="sgl-error-text"></span>
                    </div>

                    <div class="sgl-row-between">
                        <label class="sgl-remember">
                            <input asp-for="Input.RememberMe" class="sgl-checkbox" />
                            <span asp-for="Input.RememberMe">Recordarme</span>
                        </label>
                        <a asp-page="./ForgotPassword" class="sgl-link">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button type="submit" class="sgl-btn-primary">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Iniciar sesión
                    </button>

                    <div class="sgl-divider"><span>o</span></div>

                    <a asp-page="./Register" class="sgl-btn-secondary">
                        <i class="fa-solid fa-user-plus"></i>
                        Crear cuenta de cliente
                    </a>

                    <div class="sgl-security-note">
                        <i class="fa-solid fa-shield-halved"></i>
                        <div>
                            <strong>Conexión protegida.</strong>
                            <span>Tus credenciales se validan de forma segura.</span>
                        </div>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Validaciones.js"></script>
}
