@page
@using MicrobeneficioSanGabriel.Models;
@model RegisterModel

@{
    ViewData["Title"] = "Registrarse";
}

<link rel="stylesheet"href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<link rel="stylesheet" href="~/css/Login_Register.css" />

<div class="login-page">

    <section class="login-brand-panel">
        <div class="brand-content">
            <div class="brand-badge">
                <i class="fa-solid fa-seedling"></i>
            </div>

            <h1>San Gabriel</h1>
            <p>Crear una cuenta</p>

            <div class="brand-line"></div>

            <span>Acceso al sistema administrativo del microbeneficio.</span>
        </div>
    </section>

    <section class="login-form-panel">
        <div class="login-card register-card">

            <div class="login-card-header">
                <div class="user-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>

                <h2>Registro</h2>
                <p>Completá los datos para crear tu cuenta.</p>
            </div>

            <form method="post" id="registerForm" asp-route-returnUrl="@Model.ReturnUrl">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary mb-3">
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Nombre"
                           class="form-control"
                           autocomplete="given-name"
                           placeholder="Nombre" />

                    <label asp-for="Input.Nombre">
                        Nombre
                    </label>

                    <span asp-validation-for="Input.Nombre"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Apellidos"
                           class="form-control"
                           autocomplete="family-name"
                           placeholder="Apellidos" />

                    <label asp-for="Input.Apellidos">
                        Apellidos
                    </label>

                    <span asp-validation-for="Input.Apellidos"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.PhoneNumber"
                           class="form-control"
                           autocomplete="tel"
                           placeholder="Teléfono" />

                    <label asp-for="Input.PhoneNumber">
                        Teléfono
                    </label>

                    <span asp-validation-for="Input.PhoneNumber"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.Email">Correo</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-envelope"></i>

                        <input asp-for="Input.Email"
                               id="email"
                               class="form-control custom-input"
                               autocomplete="username"
                               placeholder="correo@ejemplo.com" />
                    </div>

                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.Password">Contraseña</label>

                    <div class="input-wrapper password-field">
                        <i class="fa-solid fa-lock"></i>

                        <input asp-for="Input.Password"
                               id="password"
                               class="form-control custom-input"
                               autocomplete="new-password"
                               placeholder="Mínimo 8 caracteres" />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('password', 'passwordIcon')"
                                aria-label="Mostrar u ocultar contraseña">
                            <i id="passwordIcon" class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.ConfirmPassword">
                        Confirmar contraseña
                    </label>

                    <div class="input-wrapper password-field">
                        <i class="fa-solid fa-shield-halved"></i>

                        <input asp-for="Input.ConfirmPassword"
                               id="confirmPassword"
                               class="form-control custom-input"
                               autocomplete="new-password"
                               placeholder="Repetí la contraseña" />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('confirmPassword', 'confirmPasswordIcon')"
                                aria-label="Mostrar u ocultar confirmación de contraseña">
                            <i id="confirmPasswordIcon" class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="validation-box">
                    <div class="validation-box-title">
                        Requisitos de seguridad
                    </div>

                    <div id="emailMessage" class="rule-item">
                        <i class="fa-solid fa-circle-xmark"></i>
                        Correo válido
                    </div>

                    <div id="length" class="rule-item">
                        <i class="fa-solid fa-circle-xmark"></i>
                        Mínimo 8 caracteres
                    </div>

                    <div id="uppercase" class="rule-item">
                        <i class="fa-solid fa-circle-xmark"></i>
                        Una mayúscula
                    </div>

                    <div id="lowercase" class="rule-item">
                        <i class="fa-solid fa-circle-xmark"></i>
                        Una minúscula
                    </div>

                    <div id="number" class="rule-item">
                        <i class="fa-solid fa-circle-xmark"></i>
                        Un número
                    </div>

                    <div id="symbol" class="rule-item">
                        <i class="fa-solid fa-circle-xmark"></i>
                        Un símbolo
                    </div>

                    <div id="match" class="rule-item">
                        <i class="fa-solid fa-circle-xmark"></i>
                        Las contraseñas coinciden
                    </div>
                </div>

                <button type="submit"
                        class="btn-login"
                        id="btnRegister">
                    <i class="fa-solid fa-user-check"></i>
                    Registrarse
                </button>

                <div class="links register-links">
                    <a asp-page="./Login">
                        Volver al inicio de sesión
                    </a>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}