@page
@using MicrobeneficioSanGabriel.Models;
@model RegisterModel

@{
    ViewData["Title"] = "Registrarse";
}

@section Styles {

    <link rel="stylesheet" href="~/css/VistaCrear.css" />
}

<div class="sgl-shell">
    <div class="sgl-layout">

        <section class="sgl-showcase">
            <div class="sgl-showcase-dots"></div>
            <div class="sgl-showcase-glow"></div>

            <div class="sgl-showcase-top">
                <span class="sgl-avatar">
                    <img src="~/images/logo_san_gabriel.jpg" alt="Logo San Gabriel" />
                </span>

                <span class="sgl-badge"><i class="fa-solid fa-user-plus"></i> Registro</span>

                <h1 class="sgl-headline">Creá tu cuenta y descubrí café con <span>origen y trazabilidad</span></h1>

                <div class="sgl-showcase-divider">
                    <span class="sgl-showcase-divider-icon"><i class="fa-solid fa-layer-group"></i></span>
                </div>

                <p class="sgl-lead">
                    Registrate como cliente para consultar el catálogo, realizar pedidos y seguir el
                    recorrido del café desde el lote hasta el producto final.
                </p>
            </div>

            <div class="sgl-feature-row">
                <article class="sgl-feature">
                    <span class="sgl-feature-icon"><i class="fa-solid fa-shield-halved"></i></span>
                    <strong>Seguridad</strong>
                    <span>contraseña fuerte</span>
                </article>
                <article class="sgl-feature">
                    <span class="sgl-feature-icon"><i class="fa-solid fa-list-check"></i></span>
                    <strong>Orden</strong>
                    <span>sin saturación visual</span>
                </article>
                <article class="sgl-feature">
                    <span class="sgl-feature-icon"><i class="fa-solid fa-palette"></i></span>
                    <strong>Consistencia</strong>
                    <span>misma línea gráfica</span>
                </article>
            </div>
        </section>

        <section class="sgl-panel">
            <div class="sgl-card">

                <div class="sgl-card-header">
                    <span class="sgl-badge sgl-badge--panel"><i class="fa-solid fa-id-card"></i> Crear cuenta</span>
                    <h2>Registro</h2>
                    <p>Completá el formulario para crear una nueva cuenta dentro del sistema.</p>
                </div>

                <form method="post" id="registerForm" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="sgl-error-summary"></div>

                    <div class="sgl-field">
                        <label class="sgl-label" asp-for="Input.Nombre">Nombre</label>
                        <div class="sgl-input-wrap">
                            <input asp-for="Input.Nombre"
                                   class="sgl-input sgl-input--plain"
                                   maxlength="30"
                                   oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g,'')"
                                   autocomplete="given-name"
                                   placeholder="Nombre" />
                        </div>
                        <span asp-validation-for="Input.Nombre" class="sgl-error-text"></span>
                    </div>

                    <div class="sgl-field">
                        <label class="sgl-label" asp-for="Input.Apellidos">Apellidos</label>
                        <div class="sgl-input-wrap">
                            <input asp-for="Input.Apellidos"
                                   class="sgl-input sgl-input--plain"
                                   maxlength="30"
                                   oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g,'')"
                                   autocomplete="family-name"
                                   placeholder="Apellidos" />
                        </div>
                        <span asp-validation-for="Input.Apellidos" class="sgl-error-text"></span>
                    </div>

                    <div class="sgl-field">
                        <label class="sgl-label" asp-for="Input.PhoneNumber">Teléfono</label>
                        <div class="sgl-input-wrap">
                            <input asp-for="Input.PhoneNumber"
                                   class="sgl-input sgl-input--plain"
                                   autocomplete="tel"
                                   type="tel"
                                   inputmode="numeric"
                                   maxlength="8"
                                   pattern="[0-9]{8}"
                                   placeholder="88888888"
                                   oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,8)" />
                        </div>
                        <span asp-validation-for="Input.PhoneNumber" class="sgl-error-text"></span>
                    </div>

                    <div class="sgl-field">
                        <label class="sgl-label" asp-for="Input.Email">Correo electrónico</label>
                        <div class="sgl-input-wrap">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Input.Email"
                                   id="email"
                                   class="sgl-input"
                                   type="email"
                                   autocomplete="username"
                                   placeholder="usuario@gmail.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="sgl-error-text"></span>
                    </div>

                    <div class="sgl-field">
                        <label class="sgl-label" asp-for="Input.Password">Contraseña</label>
                        <div class="sgl-input-wrap sgl-input-wrap--password">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="Input.Password"
                                   id="password"
                                   class="sgl-input"
                                   autocomplete="new-password"
                                   placeholder="Mínimo 8 caracteres" />
                            <button type="button"
                                    class="sgl-toggle-visibility"
                                    onclick="sglTogglePassword('password', 'passwordIcon')"
                                    aria-label="Mostrar u ocultar contraseña">
                                <i id="passwordIcon" class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="sgl-error-text"></span>
                    </div>

                    <div class="sgl-field">
                        <label class="sgl-label" asp-for="Input.ConfirmPassword">Confirmar contraseña</label>
                        <div class="sgl-input-wrap sgl-input-wrap--password">
                            <i class="fa-solid fa-shield-halved"></i>
                            <input asp-for="Input.ConfirmPassword"
                                   id="confirmPassword"
                                   class="sgl-input"
                                   autocomplete="new-password"
                                   placeholder="Repetí la contraseña" />
                            <button type="button"
                                    class="sgl-toggle-visibility"
                                    onclick="sglTogglePassword('confirmPassword', 'confirmPasswordIcon')"
                                    aria-label="Mostrar u ocultar confirmación de contraseña">
                                <i id="confirmPasswordIcon" class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="sgl-error-text"></span>
                    </div>

                    <div class="sgl-rules">
                        <div class="sgl-rules-title">Requisitos de seguridad</div>
                        <div id="emailMessage" class="sgl-rule"><i class="fa-solid fa-circle-xmark"></i> Correo completo (ej. gmail.com o hotmail.com)</div>
                        <div id="length" class="sgl-rule"><i class="fa-solid fa-circle-xmark"></i> Mínimo 8 caracteres</div>
                        <div id="uppercase" class="sgl-rule"><i class="fa-solid fa-circle-xmark"></i> Una mayúscula</div>
                        <div id="lowercase" class="sgl-rule"><i class="fa-solid fa-circle-xmark"></i> Una minúscula</div>
                        <div id="number" class="sgl-rule"><i class="fa-solid fa-circle-xmark"></i> Un número</div>
                        <div id="symbol" class="sgl-rule"><i class="fa-solid fa-circle-xmark"></i> Un símbolo</div>
                        <div id="match" class="sgl-rule"><i class="fa-solid fa-circle-xmark"></i> Las contraseñas coinciden</div>
                    </div>

                    <button type="submit" class="sgl-btn-primary" id="btnRegister">
                        <i class="fa-solid fa-user-check"></i>
                        Registrarse
                    </button>

                    <div class="sgl-form-links">
                        <a asp-page="./Login" class="sgl-link">Volver al inicio de sesión</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Validaciones.js"></script>
}
