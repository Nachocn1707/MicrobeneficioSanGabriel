@page
@using MicrobeneficioSanGabriel.Models
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Correo de recuperación enviado";
}

<div class="auth-shell auth-state-shell">
    <header class="auth-topbar">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-brand">
            <span class="auth-brand-mark"><i class="fa-solid fa-mug-hot"></i></span>
            <div><h1>San Gabriel</h1><span>Coffee Lab · Recuperación de acceso</span></div>
        </a>
        <nav class="auth-nav"><a asp-page="./Login" class="auth-top-action">Volver al login</a></nav>
    </header>

    <main class="auth-state-stage">
        <article class="auth-state-card auth-state-info">
            <div class="auth-state-icon"><i class="fa-solid fa-envelope-circle-check"></i></div>
            <span class="auth-kicker"><i class="fa-solid fa-paper-plane"></i> Mensaje enviado</span>
            <h2>Revisá tu correo</h2>
            <p>Enviamos un enlace para restablecer tu contraseña. Abrí el mensaje y seguí las instrucciones para recuperar el acceso.</p>
            <div class="auth-state-notice"><i class="fa-solid fa-circle-info"></i><span>Si no aparece en la bandeja principal, revisá las carpetas de correo no deseado o promociones.</span></div>

            <div class="auth-state-actions">
                <a asp-page="./Login" class="auth-secondary-action"><i class="fa-solid fa-arrow-left"></i> Volver al login</a>
            </div>
        </article>
    </main>
</div>
