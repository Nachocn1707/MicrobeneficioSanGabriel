@page
@using MicrobeneficioSanGabriel.Models
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Correo de recuperación enviado";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Login_Register.css" />
}

<div class="sgl-shell">
    <div class="sgl-state-card">
        <div class="sgl-state-icon"><i class="fa-solid fa-envelope-circle-check"></i></div>

        <span class="sgl-badge sgl-badge--panel"><i class="fa-solid fa-paper-plane"></i> Mensaje enviado</span>

        <h2>Revisá tu correo</h2>
        <p>
            Enviamos un enlace para restablecer tu contraseña. Abrí el mensaje y seguí las
            instrucciones para recuperar el acceso.
        </p>

        <div class="sgl-alert sgl-alert--warning">
            <i class="fa-solid fa-circle-info"></i>
            <span>Si no aparece en la bandeja principal, revisá las carpetas de correo no deseado o promociones.</span>
        </div>

        <a asp-page="./Login" class="sgl-btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Volver al login
        </a>
    </div>
</div>
