@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Recuperación de contraseña";
}

<div class="login-container">
    <div class="login-card text-center">

        <div class="user-icon">
            <i class="fa-solid fa-envelope-circle-check"></i>
        </div>

        <h2 class="text-white mb-4">
            Correo enviado
        </h2>

        <p class="text-white">
            Hemos enviado un enlace para restablecer tu contraseña.
        </p>

        <p class="text-white">
            Revisa tu correo electrónico y sigue las instrucciones.
        </p>

        <a asp-page="./Login" class="btn-login d-inline-block text-decoration-none">
            Volver al Login
        </a>

    </div>
</div>
