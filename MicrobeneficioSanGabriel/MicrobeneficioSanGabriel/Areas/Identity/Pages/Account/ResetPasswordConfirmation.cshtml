@page
@using MicrobeneficioSanGabriel.Models
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña restablecida";
}

<div class="auth-shell auth-state-shell">
    <header class="auth-topbar">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-brand">
            <span class="auth-brand-mark"><i class="fa-solid fa-mug-hot"></i></span>
            <div><h1>San Gabriel</h1><span>Coffee Lab · Seguridad de cuenta</span></div>
        </a>
        <nav class="auth-nav"><a asp-page="./Login" class="auth-top-action">Iniciar sesión</a></nav>
    </header>

    <main class="auth-state-stage">
        <article class="auth-state-card auth-state-success">
            <div class="auth-state-icon"><i class="fa-solid fa-key"></i></div>
            <span class="auth-kicker"><i class="fa-solid fa-shield-halved"></i> Cambio completado</span>
            <h2>Contraseña actualizada</h2>
            <p>La contraseña fue restablecida correctamente. Ya podés iniciar sesión con tus nuevas credenciales.</p>
            <div class="auth-state-actions">
                <a asp-page="./Login" class="btn-login auth-inline-action"><i class="fa-solid fa-right-to-bracket"></i> Ir al login</a>
            </div>
        </article>
    </main>
</div>
